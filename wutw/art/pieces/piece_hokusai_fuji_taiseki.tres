province = 55
blurb = "Depicts Mount Fuji as seen by travelers walking along a mountain path near the [url=https://en.wikipedia.org/wiki/Taiseki-ji]Taiseki Temple[/url], in present-day Shizuoka prefecture. It is the head temple of the Nichiren Shoshu sect of Buddhism. It was established in 1290 and still stands today.

A waterfall flows down the rocks on the left, and fog drifts through the valley below.

The mountain is depicted in a more rough and dramatic way than usual, and the clouds are emphasized by embossing."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

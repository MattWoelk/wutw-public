[resource]
script = ExtResource("8_gh175")
haunting_id = "okiku"
name = "Okiku"
name_japanese = "お菊"
name_realistic = "Contaminated Wells"
name_translation = "Lady Chrysanthemum"
description = "People whisper of a ghost who counts dishes from the bottom of the well, her grief souring the water and the hearts of all who drink it."
description_realistic = "Poor maintenance has poisoned the town's well, spreading illness among the settlers."
description_long = "The well at the square has turned murky, something unseen clinging to its depths. Each night, villagers claim to hear faint counting rising through the stone: one, two, three... nine. Some swear they saw a pale hand break the surface.

The old tales recall Okiku, a servant falsely accused of losing a precious plate and thrown into the town's well. They say she returns to count what was lost, her sorrow spreading through the well's water.

Since her whispers began, people have started to fall ill after drinking, and the square smells faintly of rot."
image_small = ExtResource("7_6o0qs")
image_credit = ExtResource("6_tv0f1")

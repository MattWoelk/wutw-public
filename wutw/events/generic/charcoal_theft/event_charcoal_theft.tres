[sub_resource type="Resource" id="Resource_uixcu"]
script = ExtResource("5_2nq2x")
markedup_text = "Set a trap to catch the thief."
requirement = SubResource("Resource_3wyhj")
outcome = SubResource("Resource_e30go")
markedup_result_text = "The snare is crude but effective.

When the intruder stumbles into it, she screams.

An old woman, face smeared, eyes wild. She fights like a cornered animal and escapes in the scuffle.

She drops something in her flight, though: a charcoal-stained tooth, painted black and polished smooth."


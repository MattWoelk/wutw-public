[resource]
script = ExtResource("3_pittp")
original_image = SubResource("Resource_bcsnl")
piece_name = "Selling Toothpicks, Itsukushima, Aki Province"
series = ExtResource("4_smhyx")
artist = ExtResource("1_swwwi")
styles = Array[ExtResource("5_o2qh3")]([ExtResource("6_m6o74")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/artists/utagawa-hiroshige-iii-1842-1894/selling-toothpicks-at-itsukushima-2d0f46d52c6cc441.html"
edits_description = "The image was cropped and the frame was edited out."
final_image_tex = SubResource("Resource_n2uvx")
province = 21
blurb = "Depicts the veranda of the Great Sutra Hall of the famous Itsukushima shrine in Aki Province (present-day western Hiroshima), with visitors and animals roaming around.

The text explains that this hall is exceedingly large (36 by 26 meters in modern measurements), and that the veranda has railings on all four sides. It also mentions that toothpicks made from willow wood were sold inside, a local specialty product, and that these were dyed in five beautiful colors. Furthermore, it claims that thousands of monkeys and deer roam around, and will happily eat mochi right out of people's hands."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[resource]
script = ExtResource("1_3h02e")
dialogue_id = "mq_1_15_begin"
record_title = "Era 一: The Relics"
text = "PAGE: scribe(SHRINE_PRIMARY), teo(SHRINE_SECONDARY)
scribe: I have served all my life as your Scribe of Names, oh Enlightened One, but the people beg for a prophet.
scribe: Inspire in me your will, and I shall carry your commandments to the faithful.
scribe: In the age before the Shattering, your sacred word came to us through relics.
scribe: If we are to hear your will once more, we must gather such relics.
scribe: I only pray that we be worthy enough to reclaim them."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

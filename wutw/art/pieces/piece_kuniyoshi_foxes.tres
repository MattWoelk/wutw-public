[resource]
script = ExtResource("4_guhua")
original_image = SubResource("Resource_bcsnl")
piece_name = "Foxes Training in Disguise"
artist = ExtResource("1_77uc5")
styles = Array[ExtResource("5_vmi3a")]([ExtResource("5_7hppr")])
actual_start_year = 1840
actual_end_year = 1850
date_type = 1
custom_link = "https://commons.wikimedia.org/wiki/File:Foxes_Being_Trained_in_Disguise,_c._1840s.jpg"
edits_description = "The supernatural elements were edited out."
final_image_tex = SubResource("Resource_gl4gq")
province = 59
blurb = "Fox spirits appear in Japanese folklore in a variety of roles: servants of the goddess Inari, destructive tricksters, or even benevolent defenders.

Among their most common powers is the ability to disguise themselves as humans. This print shows a group of foxes practicing this skill. Two foxes stack reeds on their heads, a necessary preparation for shape-shifting. Other foxes have already succeeded, parading about as young women and monks."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("6_4w352")
markedup_text = "Record the event and leave the tree untouched."
requirement = SubResource("Resource_ciwob")
outcome = SubResource("Resource_egt2j")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "With considerable efforts, the tired settlers convince the Scribe to let the spirits go.

Detailed entries are made in the expedition log. Sketches are drawn.

The foxes watch as the procession departs."


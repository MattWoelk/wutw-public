[resource]
script = ExtResource("3_o8uy8")
name = "Utagawa Kuniyoshi"
portrait = SubResource("Resource_o8uy8")
blurb = "Utagawa Kuniyoshi was a leading master of the [url=art_school:Utagawa school]Utagawa school[/url], best known for his dramatic depictions of legendary heroes ([url=art_style:musha-e]musha-e[/url]), mythical beasts, and spectral encounters, most notably in his breakthrough series [url=art_series:The 108 Heroes of the Popular Water Margin]The 108 Heroes of the Popular Water Margin[/url].

Beyond legendary subjects, he produced satirical caricature prints, and many affectionate studies of cats.

His bold, action-oriented compositions went on to heavily influence modern Japanese tattoo art and manga."
birth_year = 1798
death_year = 1861
link = "https://en.wikipedia.org/wiki/Utagawa_Kuniyoshi"
schools = Array[ExtResource("1_s8h5d")]([ExtResource("2_86a57")])

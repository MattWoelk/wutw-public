final_image_tex = SubResource("Resource_h6dpt")
blurb = "Depicts five court pages gathering lotus leaves while trying to keep their boat steady. Scattered across the leaves are white drops of dew, referencing the poem inscribed in the upper right:

[i]The white dewdrops
in the wind-swept
autumn fields
[lb]like[rb] unstrung
jewels are scattered.[/i]

The poem is the best-known work of the Heian court poet Bunya no Asayasu (active late 9th century - early 10th century)."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

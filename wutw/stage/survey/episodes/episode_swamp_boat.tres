aspects_per_season = Array[ExtResource("3_ujufw")]([null])
outcome = SubResource("Resource_syyab")
outcome_text = "One of the scouts reacts quickly, shedding his robe and wedging the cloth into the hole.

This keeps the boat afloat long enough to reach the shore, where the rest of the survey team helps them fashion a more permanent wooden plug."


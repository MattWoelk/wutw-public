[sub_resource type="Resource" id="Resource_ymqhb"]
script = ExtResource("14_c028c")
aspect_type = ExtResource("17_8ddhh")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_a5xa8"]
script = ExtResource("7_cjhtj")
markedup_text = "Leave an offering to appease whoever's inside."
requirement = SubResource("Resource_ymqhb")
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "Unwilling to disturb whoever dwells within the cave, the monks leave offerings of grain and incense at the entrance. Occasionally these disappear during the night.

Although the mysterious inhabitant remains elusive, the monks are proud to have a patron spirit."

[sub_resource type="Resource" id="Resource_nm4kx"]
script = ExtResource("7_cjhtj")
markedup_text = "Stay safely away."
markedup_result_text = "The monks decide to prioritize safety and leave the cave alone. Pilgrims occasionally wander close, but the monks never allow them to enter, fearful of dangers that may lie within."

[sub_resource type="Resource" id="Resource_568l7"]
script = ExtResource("4_jtvxi")
markedup_text = "The Ember monks come across a cave not far from their monastery, strikingly similar to one seen by Ember monks from another shard. It is clearly not a natural formation, the walls too smooth and the entrance too carefully carved.

The other cave of this kind was too hot to explore, but this one is further away from the tip of the volcano, and therefore much cooler. There are, however, faint rumblings coming from within."
background_image = SubResource("Resource_c4alr")
background_credit = ExtResource("6_8ht6v")
choices = Array[ExtResource("7_cjhtj")]([SubResource("Resource_eb43h"), SubResource("Resource_teqo2"), SubResource("Resource_a5xa8")])
exit_choice = SubResource("Resource_nm4kx")


[resource]
script = ExtResource("1_unw6u")
name = "Genji-e"
blurb = "Literally \"Genji illustration\", this style depicts scenes from the Tale of Genji, a classic work written in the Heian period (11th century) by the noblewoman Murasaki Shikibu, which is often considered the world's first novel.

This massive epic follows the philandering adventures of Prince Genji, also called Hikaru Genji (\"shining Genji\"), and in later chapters, the stories of his descendants.

In the 1830s and 1840s, a humorous, swashbuckling adaptation of the novel, titled A Fraudulent Murasaki's Rustic Genji by Ryūtei Tanehiko, was serialized and became a best-selling sensation, further inflaming the demand for prints depicting Genji."
start_year = 1200
end_year = 2026
link = "https://en.wikipedia.org/wiki/Y%C5%ABrei-zu"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

[sub_resource type="Resource" id="Resource_fdj48"]
script = ExtResource("2_xod50")
label = "Swing in."
requirement = SubResource("Resource_g4g8o")
aspects = Array[ExtResource("3_3s22n")]([ExtResource("13_defwx")])
aspects_per_season = Array[ExtResource("3_3s22n")]([null])
outcome = SubResource("Resource_fyc7s")
outcome_text = "The scouts tie a rope to tree branches hanging over the fall, and send a surveyor swinging through the curtain of rushing water.

Safely inside the cave, he looks on in wonder. Fireflies fill the half-darkness, their light casting a pale green glow on the walls.

Unsure whether the others will believe him, the scout lures one of the insects into an unfolded lantern before leaving through a small opening in the rock.
"


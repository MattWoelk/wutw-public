[node name="Cutscene_3to4" type="Node2D" unique_id=1375775163]
material = SubResource("ShaderMaterial_h0xtj")
script = ExtResource("4_vt57c")
texts = Array[String](["The grand accord was set in ink and hope, bearing the seal of the Enlightened One.
We promised, this time, to tread gently upon the land.", "Like the priests of our ancestors, and the magicians of centuries past, we trusted the Enlightened One.
We tended the world with care, and slowly, the wounds of old began to heal.", "For generations, the land nurtured us in return.
But the shards remained adrift.", "In time, our ways grew strange to one another.
Even the language we shared no longer connects us.", "We kept our gardens tended, but left the gates untraveled.
What good are new beginnings, when the world has been doomed for generations?", "We live in the shadow of memory, and memory too is fading."])
voice_lines = Array[AudioStream]([ExtResource("5_6vrxg"), ExtResource("6_kb8bf"), ExtResource("7_1ffm0"), ExtResource("8_pqi5j"), ExtResource("9_h2j3s"), ExtResource("10_shyg1")])

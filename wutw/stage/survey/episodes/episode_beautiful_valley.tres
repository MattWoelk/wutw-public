[sub_resource type="Resource" id="Resource_taytr"]
script = ExtResource("2_35bc7")
label = "Have everyone sketch a version."
aspects = Array[ExtResource("3_aveeh")]([ExtResource("4_e7nv7"), ExtResource("7_6kfkc")])
aspects_per_season = Array[ExtResource("3_aveeh")]([null])
outcome = SubResource("Resource_sl00i")
outcome_text = "The team calls a break and rather than letting the artist draw alone, they split the charcoal and each scout sketches their own take on the landscape.

The result is surprisingly varied - some have drawn the valley alone. Others have focused on the distant peak rising from the clouds. One man drew a portrait of the artist instead, and now shyly presents it to her before resuming the trip."

[sub_resource type="Resource" id="Resource_q5tvv"]

[sub_resource type="Resource" id="Resource_vhj8x"]
script = ExtResource("2_im846")
label = "Camp by the tree."
aspects = Array[ExtResource("3_msq25")]([ExtResource("9_pdwl5")])
aspects_per_season = Array[ExtResource("3_msq25")]([null])
outcome = SubResource("Resource_clmkt")
outcome_text = "The group decides that they are too tired to continue. The gloomy scout grumbles that they will probably drown in their sleep, but then digs drainage ditches around the camp and stays up all night to watch for rising water.

By morning, everyone else is well rested and the supplies are still dry."


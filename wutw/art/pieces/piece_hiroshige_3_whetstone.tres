[resource]
script = ExtResource("3_rjcxn")
original_image = SubResource("Resource_bcsnl")
piece_name = "Quarrying Whetstone in Nagura, Mikawa Province"
series = ExtResource("4_ums5l")
artist = ExtResource("1_egmqr")
styles = Array[ExtResource("5_qiug7")]([ExtResource("6_wk1ii")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
edits_description = "The image was cropped."
final_image_tex = SubResource("Resource_kvhf6")
province = 52
blurb = "Depicts quarriers extracting stone to use as whetstones in Mikawa province (present-day Aichi prefecture). These are not a specific mineral, but a sedimentary rock mostly composed of quartz. Nagura stones, named after the area, are a type of whetstone still used today.

The text on the top right explains that people find veins of whetstone in the mountains, dig them out, and cut the stone into long, square blocks. They are then loaded, four at a time, onto horses and hauled down to the village.

It describes the stone as blue-white and slightly black, with a spotted pattern and exceptionally smooth texture."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

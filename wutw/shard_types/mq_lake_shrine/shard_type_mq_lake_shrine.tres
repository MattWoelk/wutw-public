event_id = "shrine_ritual"
var_id = "waterline"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_50vii"]
script = ExtResource("8_n1bg2")
text = "I visited the famous lake shrine on this shard. The place is beautiful, the whole island being surrounded by blooming lotus flowers. A priest explained to me that these flowers are not just a decoration, but serve a practical purpose, as they change color whenever the lake's water is contaminated.

The shrine's archive is filled with scrolls. At first I thought they were holy sutras and the like, but it turns out they are records of various measurements dating back centuries. The priests have studied these to find regularities in the weather, and can now predict it with such accuracy that it's common for people to check the shrine's announcement board every morning to learn whether they need to carry umbrellas."
gained_argument = ExtResource("10_bndtd")
metadata/_custom_type_script = "uid://ciddaw1laebi3"


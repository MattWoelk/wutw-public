[sub_resource type="Resource" id="Resource_ujpsa"]
script = ExtResource("9_dvcb2")
markedup_text = "Keep away from the snake."
outcome = SubResource("Resource_e8hox")
markedup_result_text = "The farmers convince the crowd to let the snake be.

The gourds are still unripe, they reason, and by the time harvest comes, the snake will have left.

The crowd remains afraid, but eventually disperses, deciding to let the farmers be responsible for the problem."

[sub_resource type="Resource" id="Resource_qvi6v"]
script = ExtResource("7_7ixqk")
markedup_text = "A part of the kudzu plantation has been sectioned off for growing bottle gourds. This morning, a crowd gathers around one of the trellises to gawk at an uninvited visitor.

A large snake is curling around one of the bamboo poles, hissing whenever anyone approaches. It seems to be guarding a large unripe gourd, hanging heavy from the vines.

The villagers are nervous and want the creature gone immediately."
background_image = SubResource("Resource_puplv")
background_credit = ExtResource("8_isffb")
choices = Array[ExtResource("9_dvcb2")]([SubResource("Resource_tin4f"), SubResource("Resource_lrob3"), SubResource("Resource_rwd8s")])
exit_choice = SubResource("Resource_ujpsa")


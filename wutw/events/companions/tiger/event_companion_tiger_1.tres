[sub_resource type="Resource" id="Resource_7ehyv"]
script = ExtResource("9_u2t6u")
markedup_text = "Avoid the shrine after dusk."
outcome = SubResource("Resource_1usie")
markedup_result_text = "The settlers decide to avoid the danger, but their imaginations continue to run wild.

Soon folks are terrified of stepping into the woods even during the day, convinced that paper tigers are waiting to pounce."

[sub_resource type="Resource" id="Resource_x5yph"]
script = ExtResource("7_3nn5f")
markedup_text = "A traveling artist recently painted a remarkably lifelike image of a tiger on a screen at the little forest shrine.

The townsfolk greatly admire the masterful work, but lately, deep, rumbling roars have been heard coming from the shrine at night.

Rumors are spreading, claiming that the painted beast steps out of its frame at night, and folks have been avoiding the shrine."
background_image = SubResource("Resource_0kc1h")
background_credit = ExtResource("8_xou1y")
choices = Array[ExtResource("9_u2t6u")]([SubResource("Resource_7axqe"), SubResource("Resource_7uunl"), SubResource("Resource_jk3xr")])
exit_choice = SubResource("Resource_7ehyv")


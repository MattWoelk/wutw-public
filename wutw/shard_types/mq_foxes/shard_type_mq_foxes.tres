[sub_resource type="Resource" id="Resource_d4kp3"]
script = ExtResource("3_6gm55")
text = "$shard_name was the first place where the settlers of the New World encountered hauntings, a group of fox spirits. They led the expedition deep into the woods, and when they finally found their way out, the foxes were gathering around an old tree on the edge of the forest. The Scribe and his acolytes cut down the tree to banish the haunting once and for all."
requirement = SubResource("Resource_y1x2n")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_irsb1"]

[resource]
script = ExtResource("1_mj5g1")
name = "Kachō-e"
blurb = "Literally \"bird and flower pictures\", these originate from the Chinese tradition, and feature detailed close-ups of birds, flowers, and insects. The genre is often expanded to include animals and fish, as long as they are the sole focus of the print.

Prints of this style are usually intended to capture specific seasons and classical literary motifs, and often appear alongside poems or text passages."
start_year = 1300
end_year = 2026
link = "https://en.wikipedia.org/wiki/Bird-and-flower_painting#In_Japan"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

[sub_resource type="Resource" id="Resource_74enk"]
script = ExtResource("2_sqech")
label = "Dig the pack out with chisels."
aspects = Array[ExtResource("3_tuvg0")]([ExtResource("4_g58no"), ExtResource("4_g58no")])
aspects_per_season = Array[ExtResource("3_tuvg0")]([null])
outcome = SubResource("Resource_trtbi")
outcome_text = "The scouts use mallets to hammer in chisels and free the pack from the ice. It takes some time for the pack itself to thaw, but when it's finally warm enough to unpack, they find inside an ancient map of the whole region that used to include this shard."

[sub_resource type="Resource" id="Resource_d174p"]
script = ExtResource("5_a4126")
metadata/_custom_type_script = "uid://dn8pkjcp04brm"

[sub_resource type="Resource" id="Resource_g58no"]
script = ExtResource("10_tuvg0")
result_text = "The fire has to be refueled several times until its heat is enough to melt the ice. Eventually, the scouts get distracted with dinner preparations. When they finally remember to check the pack, they find it burned to ashes."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


markedup_result_text = "The guards rush at the foxes, but the beasts are far too fast, quickly scattering into the wilderness."

[sub_resource type="Resource" id="Resource_c556b"]
script = ExtResource("4_a1mth")
markedup_text = "Settlers have been hearing rustling outside the granaries at night, though they are yet to notice anything missing.

One evening, a patrol spots a group of foxes running up the road on the outskirts of the settlement. The guards suspect they are the ones responsible for the noise around the granaries."

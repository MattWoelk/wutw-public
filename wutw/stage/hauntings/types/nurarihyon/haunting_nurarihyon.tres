[resource]
script = ExtResource("8_qb2e3")
haunting_id = "nurarihyon"
name = "Nurarihyon"
name_japanese = "滑瓢"
name_realistic = "Bureaucracy"
name_translation = "Slippery Gourd"
description = "The town is under the influence of Nurarihyon, a peppet-master with a gourd-shaped head who demands that the leaders of the settlement bring every plan to him for approval."
description_realistic = "Stagnant bureacracy is drowning projects in endless permits and approval requirements."
description_long = "The leaders of this settlement are afraid to approve any plan that the townspeople offer until they receive the blessing of Nurarihyon, a mysterious spirit who appears in the guise of a wizened old man with a gourd-shaped head. He is often seen at night wearing rich silks and being carried on a palanquin, too busy to bother with the plight of the common people. Folks whisper that he is in fact the leader of all the hauntings, and displeasing him will bring great misfortune to the shard."
image_small = ExtResource("5_ke8nl")
image_credit = ExtResource("6_2rm5n")
image_small_realistic = ExtResource("6_nrl24")
image_realistic_credit = ExtResource("7_locpq")

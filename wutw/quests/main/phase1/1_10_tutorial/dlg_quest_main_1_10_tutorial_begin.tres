[resource]
script = ExtResource("1_q0l4x")
dialogue_id = "mq_1_10_begin"
record_title = "Era 一: The First Step"
text = "PAGE: monk(NONE), teo(NONE)
monk: Please look kindly on us as we step out, oh Enlightened One.
monk: We only need a foothold in this strange new land.
monk: Just so the others can feel safe when they follow.
monk: You have already saved us from the Shattering, so I trust that you'll guide us to restore the world.
monk: I know you have better things to do than watch our every footstep, but if you nudge us in the right direction, we'll handle the rest."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

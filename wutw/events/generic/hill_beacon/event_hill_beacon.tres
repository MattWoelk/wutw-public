[sub_resource type="Resource" id="Resource_qy53p"]
script = ExtResource("5_87w0p")
markedup_text = "Send a small party to investigate."
requirement = SubResource("Resource_qnsxn")
outcome = SubResource("Resource_tmyk4")
markedup_result_text = "The scouts are reluctant to leave the feast, but the councilor urges them incessantly, insisting that waiting may cost lives.

With festival lanterns in tow, they trudge through the dark path.

When they finally reach the neighboring settlement, they find it safe. A recent landslide had made the hilltop inaccessible, and since the harvest was disappointing, the villagers didn't bother repairing the stairs to light their beacon."

[sub_resource type="Resource" id="Resource_s1unc"]
script = ExtResource("11_88k37")
card_type = ExtResource("10_b4o1e")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_lyxgp"]
script = ExtResource("13_eld7c")
aspect_type = ExtResource("12_gdpd6")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_qp418"]
script = ExtResource("5_87w0p")
markedup_text = "Wait until morning."
requirement = SubResource("Resource_lyxgp")
outcome = SubResource("Resource_s1unc")
markedup_result_text = "Cooler heads prevail and the anxious councilor is convinced to wait until morning to send out runners to the other settlement. Rushing into the darkness will only create more danger, they argue.

As the first light creeps up the hill, a trader from the neighboring settlement arrives.

She explains that her town is well, but a recent landslide had made the hilltop inaccessible, and since the harvest was disappointing, the villagers didn't bother repairing the stairs to light their beacon."

[sub_resource type="Resource" id="Resource_l8cby"]
script = ExtResource("15_6ahbd")
aspect = ExtResource("14_4pu7n")
metadata/_custom_type_script = "uid://doingr4y56xed"

[sub_resource type="Resource" id="Resource_jeji1"]
script = ExtResource("13_eld7c")
aspect_type = ExtResource("16_jd2mh")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2ghbf"]
script = ExtResource("5_87w0p")
markedup_text = "Take drastic measures."
requirement = SubResource("Resource_jeji1")
outcome = SubResource("Resource_l8cby")
markedup_result_text = "The anxious councilor declares the festival closed and sends a town crier through the village with an alarm bell, declaring that the neighboring town has mysteriously disappeared, perhaps taken over by an evil spirit.

Families hurry indoors as the gates are barred, and the hillside paths are blocked with carts.

Near dawn, an exhausted messenger from the neighboring town arrives bringing news. Spooked by the barricades, he ends up turning around and heading back home."

[sub_resource type="Resource" id="Resource_3r7q7"]
script = ExtResource("11_88k37")
card_type = ExtResource("17_mrfr7")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_oijs2"]
script = ExtResource("5_87w0p")
markedup_text = "Continue the festival as if nothing happened."
outcome = SubResource("Resource_3r7q7")
markedup_result_text = "The revelry continues, but the councilor's anxiety spreads among the settlers.

Even as they eat, drink, and sing beneath the hilltop flame, they can't help but glance uneasily, searching for a light among the dark landscape.
"

[sub_resource type="Resource" id="Resource_ww34s"]
script = ExtResource("3_snr0b")
markedup_text = "A festival is underway celebrating a successful harvest. The settlers dance and feast all day.

Once the sun sinks below the horizon, they climb the tallest hill and light the beacon, a signal that all is well and the harvest was plentiful. They watch the darkening hills, waiting for the next town over to light their own flame, but no flame appears.

An alarmed councilor, perhaps impelled by the feast's ample drinks, raises an alarm, certain that their neighbors must be in trouble."
background_image = SubResource("Resource_j3w3s")
background_credit = ExtResource("4_somco")
choices = Array[ExtResource("5_87w0p")]([SubResource("Resource_qy53p"), SubResource("Resource_qp418"), SubResource("Resource_2ghbf")])
exit_choice = SubResource("Resource_oijs2")


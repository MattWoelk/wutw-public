[sub_resource type="Resource" id="Resource_e0onr"]
script = ExtResource("2_akgn0")
label = "Look for a way through."
aspects = Array[ExtResource("3_kjdng")]([ExtResource("4_2y2q2")])
outcome = SubResource("Resource_8vsby")
outcome_text = "The explorers search the wall for cracks or gates.

By sunset, they discover a tiny metal door that leads to a short tunnel inside the wall. Inside, they can see a cross-section of the wall: a layer of thick stone, followed by a layer of an odd, dull metal covered in white dust, and finally a thick layer of packed earth.

The tunnel ends abruptly, without an exit, so the scouts turn back, but they pick up a chunk of the odd metal, finding it surprisingly heavy."

[sub_resource type="Resource" id="Resource_sfu4t"]
script = ExtResource("9_yghpy")
card_type = ExtResource("8_ip20a")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_2sv8l"]
script = ExtResource("2_akgn0")
label = "Climb the wall."
aspects = Array[ExtResource("3_kjdng")]([ExtResource("7_14d66")])
outcome = SubResource("Resource_sfu4t")
outcome_text = "Several surveyors reach the top of the wall after a prolonged struggle.

From the top, they can see the vast wasteland stretching out before them in both directions. To their surprise, the landscape beyond appears almost identical to the side they came from."

[sub_resource type="Resource" id="Resource_7qrm1"]
script = ExtResource("12_5di8y")
bonus_type = ExtResource("11_0agpn")
amount = 15
extra_per_season = 15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_invs1"]
script = ExtResource("2_akgn0")
label = "Investigate the construction."
aspects = Array[ExtResource("3_kjdng")]([ExtResource("10_hxygk")])
outcome = SubResource("Resource_7qrm1")
outcome_text = "After examining the wall, one surveyor notices that in the few places where the white stone has cracked away, there appears to be a strangely smooth, dull grey layer.

This metallic material is unlike any they have ever seen. When they attempt to scratch its surface, they find it yields easily under the blade."

[sub_resource type="Resource" id="Resource_opp1d"]
script = ExtResource("2_akgn0")
label = "Follow along the wall."
aspects = Array[ExtResource("3_kjdng")]([null])
outcome_text = "The surveyors decide to walk along the wall looking for where it ends.

Hours of walking later, there's still no end in sight, and the group decides to turn in a different direction."

[resource]
script = ExtResource("13_1ub3h")
episode_id = "wasteland_wall"
title = "The Endless Wall"
biome_types = Array[int]([3])
text = "Last night, the survey team had taken shelter from one of the violent storms that are so common in the wastelands.

As they emerge in the morning, they are astonished to see an enormous white wall stretching across the horizon in both directions.

It appears strangely undamaged despite the centuries it must have stood there."
background_image = SubResource("Resource_bocbh")
background_credit = ExtResource("1_akgn0")
choices = Array[ExtResource("2_akgn0")]([SubResource("Resource_e0onr"), SubResource("Resource_2sv8l"), SubResource("Resource_invs1"), SubResource("Resource_opp1d")])

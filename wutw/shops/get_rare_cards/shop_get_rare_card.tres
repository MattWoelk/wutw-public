[resource]
script = ExtResource("4_idx7h")
shop_id = "get_rare_card"
title = "Mirage Gate"
intro = "This ancient gate is unlike the ones we are used to. It leads somewhere unknowable. Those who enter come back with insights unlike anything seen before, but after such an experience, they lose all interest in exploring mundane landscapes."
action_description = "Send your most daring explorers through the portal, knowing they won't return the same."
action_button_label = "Gain a Powerful Glyph"
tooltip = "This ancient gate is unlike the ones we are used to. It leads somewhere unknowable. Those who enter come back with insights unlike anything seen before, but after such an experience, they lose all interest in exploring mundane landscapes.

Here you can retrieve <term:glyph>s of high <term:card_rarity_tier> to <term_lower:add_card> to your <term_lower:card_deck> once a given amount of <term:bonus.adventure> has been reached on the shard.

[i]“What lies beyond is wondrous, but unsettling. Those who glimpse it rarely wish to linger in the familiar.”[/i]"

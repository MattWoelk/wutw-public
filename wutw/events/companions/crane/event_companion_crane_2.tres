[sub_resource type="Resource" id="Resource_ldoka"]
script = ExtResource("6_g2ppe")
markedup_text = "Take the weaker chick and raise it."
requirement = SubResource("Resource_vbdcq")
outcome = SubResource("Resource_js211")
markedup_result_text = "Accepting that the two chicks will not cease fighting on their own, the forester carefully removes the weaker chick.

She keeps it in a warm, padded basket and nurtures it carefully.

The chick clearly thinks the forester is a strange, large bird, but it imprints on her completely and survives to fly off within a few months."


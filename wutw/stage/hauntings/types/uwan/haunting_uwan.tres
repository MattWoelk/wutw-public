[resource]
script = ExtResource("8_xyw6v")
haunting_id = "uwan"
name = "Uwan"
name_japanese = "うわん"
name_realistic = "Paranoia"
name_translation = "Waah!"
description = "Settlers are being scared half to death by the grotesque Uwan, who appear out of the darkness and simply shout \"uwan!\"."
description_realistic = "Settlers have become paranoid, quaking in fear and suspecting evil intent whenever plans don't go their way."
description_long = "Little is known about the Uwan, but these grotesque hauntings suddenly appear late at night and scare people with their shouts. They don't seem to be actively harmful, but the fear they spread grips the town, causing people to always be on guard against unexpected assailants."

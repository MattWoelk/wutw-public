[resource]
script = ExtResource("3_e0vo7")
original_image = SubResource("Resource_bcsnl")
piece_name = "Hyōsube and Shōkira"
series = ExtResource("4_27xqo")
styles = Array[ExtResource("5_c8q16")]([ExtResource("6_f75sl"), ExtResource("6_d8epp")])
actual_start_year = 1500
actual_end_year = 1700
date_type = 1
custom_link = "https://en.wikipedia.org/wiki/File:5.Shoukira.jpg"
edits_description = "Only Shōkira was used, it was flipped, rotated, and a tongue was added to turn it into an Akaname."
final_image_tex = SubResource("Resource_5la5w")
blurb = "Depicts two yōkai, Hyōsube (left) and Shōkira (\"mole cricket spirit\", right).

Hyōsube are child-sized river monsters from Kyūshū, similar to kappa, but living in underwater caves. They are said to come out at night and to love eating eggplants.

Shōkira are nighttime demons that lurk on rooftops, spying through windows, doorways, or skylights to look for impious behavior."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

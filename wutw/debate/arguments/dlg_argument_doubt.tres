[resource]
script = ExtResource("1_v6frc")
dialogue_id = "debate_doubt"
record_title = "Debate Speech: The Necessity of Doubt"
text = "PAGE: historian(PORTAL_NETWORK), AUDIENCE
historian: The Scribe treats doubt as weakness of spirit.
historian: He believes that if we do not offer absolute certainty, the people will drown in despair.
historian: But certainty is a very rigid thing.
historian: Consider the pagodas we build today.
historian: We never fit the joints perfectly tight.
historian: We deliberately leave empty space for the wood to sway when an earthquake comes.
historian: Doubt is that empty space.
historian: It is the wisdom to admit that we do not know everything.
historian: If we rely on blind faith in one leader, our societies will lose their ability to adapt.
historian: If we cannot challenge our beliefs, we cannot learn from our mistakes.
historian: We must leave room for our people to wonder, or we will just be another stone pillar waiting to crumble."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

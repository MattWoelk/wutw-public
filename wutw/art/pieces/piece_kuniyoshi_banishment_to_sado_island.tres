custom_link = "https://en.wikipedia.org/wiki/Sketches_of_the_Life_of_the_Great_Priest#5._Banishment_to_Sado_Island:_Sutra_Title_on_the_Waves_at_Kakuta"
edits_description = "The text was edited out, the crease was cleaned up, and a rain layer was added to make the style fit better with other prints used in the same intro cutscene."
final_image_tex = SubResource("Resource_cctp0")
province = 45
blurb = "The full title is Banishment to Sado Island: Sutra Title on the Waves at Kakuta.

This prints depicts the priest Nichiren on his way to his forced exile to Sado Island, while a large storm in the Sea of Japan threatens to destroy his boat and frightened crew. To protect them, Nichiren casts a spell, the Daimoku mantra of the Lotus Sutra, \"Namu Myōhō Renge Kyō\", which appears on the waves.

The wave is likely inspired by [url=artist:Katsushika Hokusai]Hokusai[/url]'s [url=art_piece:Great Wave off Kanagawa]Great Wave off Kanagawa[/url]."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

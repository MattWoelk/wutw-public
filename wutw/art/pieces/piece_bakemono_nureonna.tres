[resource]
script = ExtResource("2_kkdno")
original_image = SubResource("Resource_bcsnl")
piece_name = "Nure Onna"
series = ExtResource("3_thj4n")
styles = Array[ExtResource("4_12yc7")]([ExtResource("5_ibwdb"), ExtResource("6_kkdno")])
actual_start_year = 1500
actual_end_year = 1700
date_type = 1
custom_link = "https://en.wikipedia.org/wiki/File:7.Nure-onna.jpg"
edits_description = "The background was edited out and the image was used to illustrate a different yōkai, Uwabami."
final_image_tex = SubResource("Resource_5vv68")
blurb = "Depicts Nure-onna (\"wet woman\"), a yōkai with the head of a woman and the body of a snake. It is said that Nure-onna is associated with another yōkai, the Ushi-oni. Nure-onna hands her baby off to innocent strangers, then walks into the sea and disappears. The baby becomes incredibly heavy so that the victim cannot move. Ushi-oni then comes out of the water to attack and they feed on the prey together."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

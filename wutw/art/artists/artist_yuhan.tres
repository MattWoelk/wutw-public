[resource]
script = ExtResource("3_usa5o")
name = "Itō Yūhan"
blurb = "Itō Yūhan was a distinctive landscape artist of the [url=art_style:shin-hanga]shin-hanga[/url] movement who was active primarily in the 1930s.

He is known for a unique printing technique that deliberately omitted the traditional black key block, which was normally used to create sharp outlines. By removing these rigid lines and relying on vivid pigments, delicate gradients, and soft shading, he achieved a luminous, atmospheric effect that closely resembled watercolor painting."
birth_year = 1882
death_year = 1951
link = "https://en.wikipedia.org/wiki/Ito_Yuhan"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

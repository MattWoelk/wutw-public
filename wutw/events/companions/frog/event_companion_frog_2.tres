[sub_resource type="Resource" id="Resource_66cdk"]
script = ExtResource("6_koc0d")
markedup_text = "Study the behavior."
requirement = SubResource("Resource_ixnya")
outcome = SubResource("Resource_s6k4q")
markedup_result_text = "The artisan fixes her eyes on the frog, unwilling to let irrational disgust rule her behavior.

As she sees the creature avoiding waste to such an extent, she contemplates her work. To weave a single thread of lotus silk, they break hundreds of stems, discarding a huge amount of plant matter.

She resolves to find a use for the byproducts of her craft."


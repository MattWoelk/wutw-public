[sub_resource type="Resource" id="Resource_60802"]
script = ExtResource("10_foms3")
markedup_text = "Try to untangle the bundles in the water."
outcome = SubResource("Resource_foms3")
markedup_result_text = "One of the workers ties several layers of cloth around their face and wades into the water.

It is hard work, but eventually the bundles are untangled, releasing a carp that was stuck between them, who eagerly swims away."

[sub_resource type="Resource" id="Resource_1xbs5"]

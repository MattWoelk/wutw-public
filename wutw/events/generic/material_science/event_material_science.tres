[sub_resource type="Resource" id="Resource_w2hpu"]
script = ExtResource("9_j1ate")
markedup_text = "Contribute the Metal Egg."
requirement = SubResource("Resource_2myy3")
outcome = SubResource("Resource_d174p")
markedup_result_text = "The smith studies the egg until he determines that the ring around its center is a much softer metal, removable with relative ease.

Inside is a waxy substance of unknown composition that burns brightly when heated.

Perhaps such eggs could be harvested to make fireworks."

[sub_resource type="Resource" id="Resource_2cj5p"]
script = ExtResource("11_72xix")
card_type = ExtResource("20_fw136")

[resource]
script = ExtResource("2_y8x3o")
name = "Ōkura Kōtō"
blurb = "Ōkura Kōtō was a student of [url=artist:Ogata Gekkō]Ogata Gekkō[/url] and the son of the well-known woodblock carver Ōkura Hanbei. He created a number of Sino-Japanese and Russo-Japanese sensō-e (war prints), including a double triptych depicting a panoramic view of the victory at Port Arthur.

In 1906, he is mentioned as a member of the art society Edokko-kai, which promoted \"the tastes of the Edokko\". Edokko was a slang term for Edo (present-day Tōkyō) natives, thought to be assertive, straightforward, cheerful, and mercantile."
birth_year = 1873
death_year = 1910
link = "https://pages.uoregon.edu/jsmacollections/home/artists/kokyo-1877-1904.html"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

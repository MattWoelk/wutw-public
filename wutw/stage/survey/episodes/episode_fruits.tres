outcome = SubResource("Resource_c6jrb")
outcome_text = "One of the scouts takes a tiny bite of the fruit, and the team waits to see the effects. Not half an hour later, the scout is bent over with a stomach ache. It's bad enough that the team has to stop and rest for the night to wait it out."


[sub_resource type="Resource" id="Resource_dsvy1"]
script = ExtResource("5_5n47g")
markedup_text = "Challenge the singers."
requirement = SubResource("Resource_3kbwl")
outcome = SubResource("Resource_wcw36")
markedup_result_text = "The carriers mock the singers' lack of imagination and challenge them to come up with something original.

The two singing quarrymen make up a teasing verse about the sour-faced carriers and their love of cherry blossoms.

At first the carriers are furious, but soon the song becomes so silly that even they can't suppress a smile."

[sub_resource type="Resource" id="Resource_vrl6m"]
script = ExtResource("11_nuhf8")
card_type = ExtResource("16_e50v5")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_n44we"]
script = ExtResource("5_5n47g")
markedup_text = "Block out the noise."
outcome = SubResource("Resource_vrl6m")
markedup_result_text = "The carriers stuff cotton in their ears with grumpy sighs.

They continue their work in muffled silence."

[sub_resource type="Resource" id="Resource_mtxcs"]
script = ExtResource("3_n54ep")
markedup_text = "The quarry is busy today. Two men on a ledge above swing their picks, singing loudly to keep time with each strike. The song echoes off the cliff, scattering birds from the nearby trees.

Below, two carriers are hauling stone down the path, their faces growing sourer with every [i]dokkoisho![/i] and [i]yoi-yoi![/i] reaching them from above. They say their work is already tiresome enough. They want to hear the birds sing instead, and admire the cherry blossoms in peace."
background_image = SubResource("Resource_rkt6u")
background_credit = ExtResource("4_0dnxh")
choices = Array[ExtResource("5_5n47g")]([SubResource("Resource_tty1q"), SubResource("Resource_2iidw"), SubResource("Resource_dsvy1")])
exit_choice = SubResource("Resource_n44we")


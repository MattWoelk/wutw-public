[sub_resource type="Resource" id="Resource_magjj"]
script = ExtResource("4_1fult")
markedup_text = "Try to pet the fox."
requirement = SubResource("Resource_x5r8o")
outcome = SubResource("Resource_y63gp")
markedup_result_text = "The villagers approach the fox from all directions, causing it to panic, clawing at the intruders.

It manages to escape in the commotion, but not without leaving a nasty scratch on one of the villagers' arms."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


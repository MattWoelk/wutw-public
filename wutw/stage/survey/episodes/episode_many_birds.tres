[sub_resource type="Resource" id="Resource_wwjba"]
script = ExtResource("2_u0sbo")
label = "Identify the birds."
requirement = SubResource("Resource_05f3c")
aspects = Array[ExtResource("3_rfb12")]([null])
outcome = SubResource("Resource_r0p81")
outcome_text = "The scouts watch carefully as the birds fly around them.

From their white breasts, black head markings, and sharp calls, they recognize the little birds as plovers. An auspicious omen."


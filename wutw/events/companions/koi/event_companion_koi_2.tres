[sub_resource type="Resource" id="Resource_te3ja"]
script = ExtResource("7_hkwuj")
markedup_text = "Untie the boats to let the carp through."
requirement = SubResource("Resource_dbcjg")
outcome = SubResource("Resource_ong41")
markedup_result_text = "The settlers untie one of the boats to make a gap for the carp to get through.

This works, and the carp safely passes the bridge, continuing its journey upstream.

However, the action comes at a cost. Before the settlers are able to tie the boats back together, the river pushes them apart, the two sections quickly ending up on opposing banks. Although no one is hurt, it takes considerable effort to put the bridge back together."


edits_description = "Only a piece of the hill in the background was used."
final_image_tex = SubResource("Resource_jg17w")
province = 37
blurb = "Depicts nighttime travelers along the Noji river in Yamato province (present-day Nara prefecture). At the top is a poem by Minamoto no Toshiyori (1055–1129):

[i]Tomorrow again,
the Jewel River of Noji,
where the bush clover grows,
and ripples reflect the moon.[/i]

Noji is one of the Six Crystal Rivers (\"mu tamagawa\"), which are a theme covered by several ukiyo-e artists."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[resource]
script = ExtResource("4_irqg7")
original_image = SubResource("Resource_bcsnl")
piece_name = "Hakurakuten"
artist = ExtResource("1_r8gsk")
actual_start_year = 1833
actual_end_year = 1834
date_type = 1
edits_description = "Only the mountains in the background were used."
blurb = "This print is based on the 15th-century Noh play Hakurakuten, which is the Japanese reading for the name of the Chinese poet Bai Juyi (772–846), one of the most famous Tang dynasty poets.

In the depicted scene of the play Bai Juyi meets a humble Japanese fisherman, and loses to him in a poetry contest. The fisherman is then revealed to be a sea god who summons a kamikaze (divine wind) to send Bai Juyi's ship back to China. The story is a nationalistic allegory about the superiority of Japanese culture."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[resource]
script = ExtResource("3_rlaiu")
original_image = SubResource("Resource_bcsnl")
piece_name = "Evening Rain on the Pine Island"
artist = ExtResource("1_6hvfx")
styles = Array[ExtResource("4_rees3")]([ExtResource("5_uqrle")])
actual_start_year = 1920
actual_end_year = 1920
custom_link = "https://moku-hanga.org/kawase-hasui/artwork/evening-rain-on-the-pine-island"
edits_description = "The supports were removed and the image was cropped."
final_image_tex = SubResource("Resource_h6dpt")
province = 74
blurb = "Depicts a large pine on a small islet in a pond within a garden.

This was part of a series illustrating the estate of the Iwasaki family, founders of the Mitsubishi conglomerate. The series was allegedly commissioned by the company as gifts for their clients, though I have not been able to reliably confirm this.

Today, this location in the Fukagawa district of Tōkyō is part of [url=https://www.japan-guide.com/e/e3034_006.html]Kiyosumi Garden[/url], which is open to visitors."

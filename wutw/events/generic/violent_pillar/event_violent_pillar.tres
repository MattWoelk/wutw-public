[sub_resource type="Resource" id="Resource_ymvbb"]
script = ExtResource("5_bjt5s")
markedup_text = "Tear the pillar down."
outcome = SubResource("Resource_xh6l0")
markedup_result_text = "The stone cracks loudly as it falls. The painting shatters with it.

The pieces are left on the grass.

Those who opposed the pillar nod in relief.

Scholars consider it a day of loss."

[sub_resource type="Resource" id="Resource_sdqv8"]
script = ExtResource("3_iytt8")
markedup_text = "Most of the pillars are gentle: circles, flowers, birds, abstract waves.

But one is not. Its surface is carved and painted with violence: an angry hero plunging a sword into a dragon's head.

Opinions are split between those saying it celebrates the strife that led to the Shattering, and those who consider it a warning.

The former group demands it be torn down, while the latter urges caution: to destroy it is to forget."
background_image = SubResource("Resource_viu86")
background_credit = ExtResource("5_viu86")
choices = Array[ExtResource("5_bjt5s")]([SubResource("Resource_2me52"), SubResource("Resource_r0oeh"), SubResource("Resource_mm8jc")])
exit_choice = SubResource("Resource_ymvbb")


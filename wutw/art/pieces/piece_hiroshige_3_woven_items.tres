final_image_tex = SubResource("Resource_e7xj6")
province = 9
blurb = "The text introduces Hakata-ori (Hakata weaving) as unparalleled throughout the country. It lists several types, including five-color, brown-gray, alternating stripes, and tokko (Buddhist vajra) patterns. The product is described as sturdy, long-lasting, and having lustrous colors, often sewn into obi (sashes) for both men and women."

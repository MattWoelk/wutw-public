[node name="Cutscene_1to2" type="Node2D" unique_id=1375775163]
material = SubResource("ShaderMaterial_h0xtj")
script = ExtResource("4_ui16o")
texts = Array[String](["We built shrines and chanted ancient prayers.
We called your name, certain that faith would mend the world.", "But the earth did not stir. Nor the clouds break.
The world stayed in pieces, and our faith wavered.", "If prayer would not restore what was lost, then surely, oh Enlightened One, you could command greater powers.
Had we not survived by your hand?", "We begged for a blessing, but in our hearts, we demanded action.", "You met our anger not with silence, but with new words and secret signs.", "We cast aside quiet faith.
With you to guide us, we would force the world to heal, whether it wished it or not."])
voice_lines = Array[AudioStream]([ExtResource("5_mf5hv"), ExtResource("6_fmxrp"), ExtResource("7_waxsm"), ExtResource("8_f8uun"), ExtResource("9_h3hf3"), ExtResource("9_831nq")])

[sub_resource type="Resource" id="Resource_f0vj7"]
script = ExtResource("5_t45cj")
markedup_text = "It is an ancient beast."
requirement = SubResource("Resource_aub17")
outcome = SubResource("Resource_plak7")
markedup_result_text = "The librarian admits that nobody here knows what those creatures are, but she thinks they are ancient beasts, ones who used to roam these lands before the Shattering.

This sparks a lifelong passion of history in the boy. Someday he will uncover many mysteries lost in the mists of the past."


[sub_resource type="Resource" id="Resource_1mffm"]
script = ExtResource("5_u85t3")
markedup_text = "Fire them all as-is and offer kind words."
requirement = SubResource("Resource_yssud")
outcome = SubResource("Resource_8mfyw")
markedup_result_text = "The kiln glows late into the night.

In the morning, the teen returns to find his clumsy bowls fired and neatly stacked.

A note rests on top of the stack, thanking the youngster for his patronage.

It won't be the last time he visits the kiln."

[sub_resource type="Resource" id="Resource_40rqf"]

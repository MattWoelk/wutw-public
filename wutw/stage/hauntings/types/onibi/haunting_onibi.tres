[resource]
script = ExtResource("9_rqcas")
haunting_id = "onibi"
name = "Onibi"
name_japanese = "鬼火"
name_realistic = "Peat Fires"
name_translation = "Demon Fires"
description = "Flickering lights drift over the wetlands, feeding on the breath of the living."
description_realistic = "Slow-burning peat fires smolder beneath the wetlands, releasing toxic gases that sap strength and ruin the soil."
description_long = "At night, the swamp awakens with soft glowing lanterns that dance above the ponds. Settlers know these as Onibi, demon fires born from the grudges of the dead. They hover in flocks, swarming any who stray too near, drawing warmth and will alike.

Old tales say they are the souls of the drowned, escaping from their torment beneath the mud."

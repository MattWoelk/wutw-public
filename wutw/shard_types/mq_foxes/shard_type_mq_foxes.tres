[sub_resource type="Resource" id="Resource_vq4j6"]
script = ExtResource("8_4ui0s")
text = "The people of this shard are remarkably practical. My inn was next to a school, so I went there and was disturbed to find the teacher showing the children a cut-up frog. The teacher later told me that the frog had died of old age, and dissecting it is the best way to understand how bodies work.

After the anatomy lessons, a local ranger took the kids out into the wilderness to sketch local plants and wildlife. He explained that no predators live in the woods this close to town because the rangers plant a certain type of bush whose scents deter these animals.

They apply even more advanced techniques in their farming. They breed a specific kind of beetle and release them into the fields, because these particular bugs eat weeds and leave crops alone, while also chasing off other insects.

I can't argue with the effectiveness of their approach, but I personally prefer to keep a little more mystery in the world."
gained_argument = ExtResource("12_ghv6k")
metadata/_custom_type_script = "uid://ciddaw1laebi3"

[sub_resource type="Resource" id="Resource_3npp1"]
script = ExtResource("9_hk6ad")
trip_reward = SubResource("Resource_vq4j6")
requirement = SubResource("Resource_udnq7")
metadata/_custom_type_script = "uid://bt2jv4savcrpl"


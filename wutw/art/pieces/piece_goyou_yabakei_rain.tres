[resource]
script = ExtResource("3_simfe")
original_image = SubResource("Resource_bcsnl")
piece_name = "Rain at Yabakei"
artist = ExtResource("1_a1lrr")
styles = Array[ExtResource("4_snf6f")]([ExtResource("5_miq1c")])
actual_start_year = 1918
actual_end_year = 1918
custom_link = "https://en.wikipedia.org/wiki/File:MET_DP144551.jpg"
edits_description = "The huts, the horse, and the distant figure were edited out."
final_image_tex = SubResource("Resource_bdje5")
province = 10
blurb = "Depicts a horse-drawn cart in the rain on a road near Yabakei, Ōita prefecture. The cart has a large umbrella attached, and a child nearby is holding a small one. The color scheme is notable, as the foreground uses an unusually vivid palette, while the background is muted.

The composition is considered a masterpiece and was inspired by Goyō's journey to Beppu and Yabakei in 1910. The early sketches were titled Running in the Rain along the Yamakuni River.

This print was Goyō's first work as both artist and publisher. He hired an engraver, Takano Shichinosuke, and a printer, Somekawa Kanzō, and the whole team lived together."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

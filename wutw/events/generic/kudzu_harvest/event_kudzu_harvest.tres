amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_xxrg4"]
script = ExtResource("9_ap3fy")
aspect_type = ExtResource("12_4ug0g")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_nr4mk"]
script = ExtResource("5_ryhf4")
markedup_text = "Make baskets out of the vines."
requirement = SubResource("Resource_xxrg4")
outcome = SubResource("Resource_l1gue")
markedup_result_text = "The tubers are left to compost, returning their nutrients to the soil.

Instead, the settlers harvest the vines, splitting and boiling them to loosen the fibers.

These are then made into sturdy baskets, perfect for holding harvests yet to come."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("14_jgdby")
card_type = ExtResource("13_6yh1t")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_p26hk"]
script = ExtResource("15_xridk")
bonus_type = ExtResource("10_07vke")
min_count = 15

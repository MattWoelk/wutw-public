[sub_resource type="Resource" id="Resource_03ufe"]
script = ExtResource("13_60wag")
result_text = "The scout spots a clump of shrubs halfway down the slope. She steers herself towards them, hoping to gently break her fall.

She crashes into the dense bushes, grateful for the springy branches which soften her landing.

Standing up, she feels an itchy burning on her arms."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


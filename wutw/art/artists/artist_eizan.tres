[resource]
script = ExtResource("3_xlxhe")
name = "Kikugawa Eizan"
blurb = "Kikugawa Eizan was a woodblock printmaker famous for his [url=art_style:bijin-ga]bijin-ga[/url] prints, following in the footsteps of the great master [url=artist:Kitagawa Utamaro]Kitagawa Utamaro[/url].

He first studied with his father, a member of the [url=art_school:Kanō School]Kanō school[/url], and subsequently with Suzuki Nanrei, of the [url=art_school:Shijō School]Shijō school[/url]. He is known for his masterful triptychs and his detailed depictions of women engaged in everyday cultural activities, fashion, and seasonal events.

His prolific output helped sustain the immense popularity of beauty prints in the early 19th century and set the aesthetic stage for the next generation of artists."
birth_year = 1787
death_year = 1867
link = "https://en.wikipedia.org/wiki/Kikukawa_Eizan"
schools = Array[ExtResource("2_1kem6")]([ExtResource("2_xlxhe"), ExtResource("3_r2gi3")])

[resource]
script = ExtResource("4_dvf60")
shop_id = "trade"
title = "Shard Council"
intro = "This hall in the Shard Capital manages shard-wide planning. Settlement representatives can coordinate here to direct their focus, even if it disrupts efficiency."
action_description = "Reallocate production between settlements to focus on the yields you need."
action_button_label = "Confirm"
tooltip = "This hall in the Shard Capital manages shard-wide planning. Settlement representatives can coordinate here to direct their focus, even if it disrupts efficiency.

Here you can exchange any type of <term:bonus> for half as much of another <term:bonus>.

This landmark is always available in the <term:capital>.

[i]“Not all plans are efficient, but coordination has its own power. Even mismatched efforts can find purpose when aligned.”[/i]"
background_texture = ExtResource("1_7lmqu")
background_credit = ExtResource("1_b5l0c")

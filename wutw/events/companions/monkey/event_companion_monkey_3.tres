[sub_resource type="Resource" id="Resource_c82u7"]
script = ExtResource("6_ml7uw")
markedup_text = "Study their grappling techniques."
requirement = SubResource("Resource_bjr1s")
outcome = SubResource("Resource_rtn7q")
markedup_result_text = "A local monk observes the brawl with intense focus, praising the animals' fluid movements and calling on the picnickers to learn from their natural technique.

Once the monkeys notice a strange man pointing at them, they seem to take offense and charge at him.

The monk spends the rest of the picnic running up and down the riverbank, relentlessly chased by two little angry macaques."


[resource]
script = ExtResource("4_8mk6d")
original_image = SubResource("Resource_bcsnl")
piece_name = "Carp Ascending a Waterfall"
artist = ExtResource("1_us3nq")
styles = Array[ExtResource("6_jq1g2")]([ExtResource("6_us3nq"), ExtResource("6_wfgmc")])
actual_start_year = 1847
actual_end_year = 1852
date_type = 1
edits_description = "The text was removed, and the background on the left was extended and replaced."
final_image_tex = SubResource("Resource_alwh0")
blurb = "This print illustrates the Chinese legend known in Japanese as Tōryūmon (\"Climbing the Dragon Gate\"). According to the myth, thousands of carp would swim up the Yellow River, but only the strongest could leap over a massive, treacherous waterfall at the Dragon Gate. Any carp that successfully cleared the falls was instantly transformed into a powerful, celestial dragon.

Because of this legend, the carp became an enduring symbol of perseverance, martial spirit, courage, and ultimate success through hard work.

In Edo-period Japan, this imagery was heavily tied to the Tango no Sekku festival (now celebrated as Children's Day on May 5th). Families with sons would fly koinobori (carp streamers) outside their homes to pray that their boys would grow up with the strength and resilience of the carp swimming up the waterfall."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

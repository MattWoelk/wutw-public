label = "Drag her back onto the boat."
aspects = Array[ExtResource("3_kpvou")]([null, null])
outcome = SubResource("Resource_cia4w")
outcome_text = "The group quickly rows the boat close to the struggling woman.

The strongest among them reaches into the water to grab her arm, but their combined weight tips the boat to one side, spilling baskets of supplies and the freshly gathered leaves."

[resource]
script = ExtResource("12_amuut")
episode_id = "lotus_pond"
title = "The Lotus Pond"
spot_types = Array[ExtResource("13_s2o21")]([ExtResource("14_lg4sq")])
text = "The surveyors are slowly paddling through a lake, their long bamboo poles touching the ground, disturbing the silt below.

They carefully bend over the water, plucking the broad, green lotus leaves. They will be used for food wrappings and medicine later.

As one gatherer reaches for a leaf, she falls into the water with a sudden splash. She cannot swim well, and begins flailing wildly."
background_image = SubResource("Resource_s1v1t")
background_credit = ExtResource("1_ub7bw")
choices = Array[ExtResource("2_ub7bw")]([SubResource("Resource_e0awx"), SubResource("Resource_11shq"), SubResource("Resource_of8cr"), SubResource("Resource_t36ua")])

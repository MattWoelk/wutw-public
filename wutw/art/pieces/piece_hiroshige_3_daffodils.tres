[resource]
script = ExtResource("4_03jcx")
original_image = SubResource("Resource_bcsnl")
piece_name = "Daffodil Flowers in Awa Province"
series = ExtResource("5_4ji6h")
artist = ExtResource("1_1pwct")
styles = Array[ExtResource("6_2owcp")]([ExtResource("7_4ocb2")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/artists/utagawa-hiroshige-iii-1842-1894/coal-mining-in-iga-province-from--282c21c600e7f327.html"
edits_description = "The text overlay was edited out."
final_image_tex = SubResource("Resource_n2uvx")
province = 60
blurb = "Depicts a daffodil farm in Awa (modern-day Bōsō peninsula in the Chiba prefecture). Because the area is protected by the Kazusa mountains, it has an unusually warm climate, allowing for daffodils to bloom at the end of autumn and all through December.

The text describes the daffodils as having four leaves forming a single cluster from which a stalk rises, and opening into a six-petaled flower with a pure fragrance. It mentions that these flowers are sent to the capital for flower arranging (ikebana).

Even today, southern Chiba supplies winter flowers and holds annual daffodils festivals."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

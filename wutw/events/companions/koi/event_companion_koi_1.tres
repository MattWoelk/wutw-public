[sub_resource type="Resource" id="Resource_aikom"]
script = ExtResource("10_foms3")
markedup_text = "Leave the tangled bundles alone."
outcome = SubResource("Resource_tycqh")
markedup_result_text = "The tangled bundles are left in the water, and eventually disappear into the lakebed.

Whatever had gotten caught in the hemp remains a mystery."

[sub_resource type="Resource" id="Resource_qhyrb"]
script = ExtResource("7_w5rwl")
markedup_text = "When the laborers come to collect the processed hemp, they find several of the bundles tangled together. Something appears to be caught in them, though it's hard to tell what.

It would take a while to untangle the foul-smelling bundles, and the retters are loath to brave the stench for that long."
background_image = SubResource("Resource_ajcls")
background_credit = ExtResource("9_4gesq")
choices = Array[ExtResource("10_foms3")]([SubResource("Resource_q4scc"), SubResource("Resource_60802"), SubResource("Resource_nxn41")])

[resource]
script = ExtResource("2_js3pg")
name = "100 Views of Famous Places in the Provinces"
blurb = "This series of landscape prints dates from the middle of Hiroshige II's career, when he was in his mid-thirties. At this point, he had just started using the name Hiroshige, since his master, [url=artist:Hiroshige]the original Hiroshige[/url], had just died in 1858.

A few of the images in this series are closely based on those in the well-known Hiroshige series Famous Views of the 60-odd Provinces."
start_year = 1859
end_year = 1861
artist = ExtResource("1_4uphc")
link = "https://hiroshigeii.net/series/100Provinces.html"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

[sub_resource type="Resource" id="Resource_ymvbb"]
script = ExtResource("7_q33js")
markedup_text = "Keep the fish away from the waterfall."
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "A child picks up a rice ball and uses it to lure the fish to the edge of the pond.

Every time the fish swims back, the child repeats her tactic.

Eventually the carp learns to associate food with staying away from the stream. It will probably be safe for now, but its dream is left forgotten."


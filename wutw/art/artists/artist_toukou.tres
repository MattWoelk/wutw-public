[resource]
script = ExtResource("2_qwbgj")
name = "Oide Tōkō"
blurb = "Oide Tōkō was a painter in the Nanga style from Edo, a pupil of Todo Ryo'un.

He received a silver medal at the Domestic Painting Competition in 1896 and exhibited his works at the National Industrial Exhibition and the Japan Art Association. Some of his works are in the Imperial Household collection.

Unlike most of the artists featured here, he did not work in woodblock prints, but rather painted on silk."
birth_year = 1836
death_year = 1905
link = "https://www.rogallery.com/artists/oide-toko-makoto/"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

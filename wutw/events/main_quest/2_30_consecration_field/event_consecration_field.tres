[sub_resource type="Resource" id="Resource_v6y3b"]
script = ExtResource("4_bomh3")
event_step_id = "destroy"
markedup_text = "A circle of blossoms is cut. Leaf and petal alike are set ablaze.

The fire digs greedily into its meal, burning without smoke despite the wet fuel.

Disciples meditate, tracing glyphs they see in the waves of heat rippling through the air.

\"The sacred flames have claimed this place in the Enlightened One's name,\" they agree. \"It will power the grand ritual to come.\""
background_image = SubResource("Resource_ka2gu")
background_credit = ExtResource("6_aa4gq")
exit_choice = SubResource("Resource_k0pmr")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


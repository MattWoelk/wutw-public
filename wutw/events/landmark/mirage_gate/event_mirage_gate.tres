[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("5_xrgei")
markedup_text = "Copy the inscriptions from the gate."
requirement = SubResource("Resource_w2hpu")
outcome = SubResource("Resource_dpp3j")
markedup_result_text = "A scholar traces faded markings etched into the base of the gate, lines that look like writing but change under different light.

They don't know what it means, but now it's part of the records."

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("5_xrgei")
markedup_text = "Leave it alone."

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("3_d20yk")
markedup_text = "The gate is a simple doorway made of three enormous stones.

From a distance, strange landscapes flicker within its opening - spires rising above alien cities, strange plants reaching for purple skies, lizards flying through the air.

Up close, it's just weathered stone, half-sunken in sand.

The more experienced adventurers among the expedition are sure that there's a way to pass through to the other side."
background_image = SubResource("Resource_guyds")
background_credit = ExtResource("10_tt23y")
choices = Array[ExtResource("5_xrgei")]([SubResource("Resource_ciwob"), SubResource("Resource_2myy3"), SubResource("Resource_3sdrw")])
exit_choice = SubResource("Resource_fmixu")


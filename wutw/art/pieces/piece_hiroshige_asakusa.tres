[resource]
script = ExtResource("3_28tac")
original_image = SubResource("Resource_bcsnl")
piece_name = "Asakusa Ricefields and Tori no Machi Festival"
series = ExtResource("5_j8c0j")
artist = ExtResource("1_sy61i")
styles = Array[ExtResource("5_2nl4g")]([ExtResource("6_nxweb")])
actual_start_year = 1857
date_type = 1
edits_description = "The image was cropped and text overlays were edited out. In some usages, the background was removed."
final_image_tex = SubResource("Resource_sy61i")
province = 71
blurb = "Depicts a back view of a cat looking through a window with a grid frame at revelers returning from the Tori no Machi festival.

The style of the window suggests that the room is probably on the second floor of the Yoshiwara red light district. Since the ceramic bowl and towel appear to have been set out for morning washing, the guest must have spent the night here.

The Tori no Machi/Ichi (Rooster Market) festival is still held several times each November to celebrate good fortune and business prosperity. It is famous for selling kumade, decorative bamboo rakes meant to \"rake in\" wealth and luck. One such rake is seen on the floor in this print."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

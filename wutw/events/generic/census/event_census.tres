min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_0yq4w"]
script = ExtResource("5_5xtx1")
markedup_text = "Respect the old claim."
requirement = SubResource("Resource_kpnif")
outcome = SubResource("Resource_n1avg")
markedup_result_text = "The scroll is added to the public record as precedent, and a copy is sent on with the expedition for redundancy.

The claimant is assigned to manage land allocation at will, and trusted to dole out lots fairly and impartially.

Most of the gathered express doubts."

[sub_resource type="Resource" id="Resource_40rqf"]
script = ExtResource("7_mode7")
relic = ExtResource("10_tq24m")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_t8ppm"]
script = ExtResource("9_14xky")
aspect_type = ExtResource("11_ldx7n")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_om0mo"]
script = ExtResource("5_5xtx1")
markedup_text = "Share everything and let the census track balance."
requirement = SubResource("Resource_t8ppm")
outcome = SubResource("Resource_40rqf")
markedup_result_text = "Wooden tags are inscribed with parcel numbers and kept at the assembly hall.

Anyone can take a tag to start a farm or dig a well.

Progress will be audited at a regular schedule, and when tags run out, the assembly will decide which ones should be returned to the pool, to give others a chance to do something different with the land."

[sub_resource type="Resource" id="Resource_2stvf"]
script = ExtResource("7_mode7")
relic = ExtResource("12_xd10m")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_7sx4l"]
script = ExtResource("9_14xky")
aspect_type = ExtResource("13_22f4a")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ew7ln"]
script = ExtResource("5_5xtx1")
markedup_text = "Impose a fixed record. Equal parcels, equal weight."
requirement = SubResource("Resource_7sx4l")
outcome = SubResource("Resource_2stvf")
markedup_result_text = "Most of the land is divided among those present. It will be bought, sold, or passed on from parent to child. Those not present for the meeting are assigned parcels at random.

Precise records of ownership are stamped with official seals and stored in the Assembly Hall for future magistrates to resolve disputes."

[sub_resource type="Resource" id="Resource_xxhwh"]
script = ExtResource("15_woxfk")
bonus_type = ExtResource("14_xd10m")
amount = -10
extra_per_season = -10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_bqdb8"]
script = ExtResource("5_5xtx1")
markedup_text = "Move on without making a decision."
outcome = SubResource("Resource_xxhwh")
markedup_result_text = "The meeting continues long into the night, but the debate remains unresolved.

For now, whoever has laid a claim keeps their land, but future assemblies are sure to challenge them again and again."

[sub_resource type="Resource" id="Resource_ldiju"]
script = ExtResource("3_l6lrt")
markedup_text = "The first official act of the new Assembly Hall is to conduct a census of the population. It's time to record who settled down, who moved on with the expedition, and how the land will be tended.

One settler brings a preserved scroll to show they've stewarded land before. Another proposes communal use, with simple census tags to track imbalance. A third calls for precise allotments, granting full ownership.

They disagree, but all seek a system that endures."
background_image = SubResource("Resource_5xtx1")
background_credit = ExtResource("5_6sb1g")
choices = Array[ExtResource("5_5xtx1")]([SubResource("Resource_0yq4w"), SubResource("Resource_om0mo"), SubResource("Resource_ew7ln")])
exit_choice = SubResource("Resource_bqdb8")


[sub_resource type="Resource" id="Resource_mm8jc"]
script = ExtResource("7_q33js")
markedup_text = "Grab the fish and throw it up the waterfall."
requirement = SubResource("Resource_jiini")
outcome = SubResource("Resource_2myy3")
markedup_result_text = "One of the settlers grabs the carp and hurls it upwards, hoping to help it along.

Things do not go as planned. The fish hits a ledge, bounces back, and falls into a crack in the cliff wall. Efforts to get it out end in failure."


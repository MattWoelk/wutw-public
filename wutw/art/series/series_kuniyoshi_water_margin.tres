[resource]
script = ExtResource("2_vijs0")
name = "The 108 Heroes of the Popular Water Margin"
blurb = "A series of 108 prints illustrating the Chinese semi-historical classic novel, Water Margin (Suikōden, Shuǐhǔ zhuàn in Chinese). The novel tells the story of a band of 108 rebels who sought refuge in the margins of Liangshan Marsh, trying to protect the poor and downtrodden. Each print depicts one of the novel's 108 heroes."
start_year = 1827
end_year = 1830
artist = ExtResource("1_musrw")
link = "http://www.kuniyoshiproject.com/The%20108%20Heroes%20of%20the%20Popular%20Suikoden,%20Part%20I.htm"

[resource]
script = ExtResource("4_gaa72")
original_image = SubResource("Resource_bcsnl")
piece_name = "Pilgrims at Kirifuri Waterfall on Mount Kurokami in Shimotsuke Province"
series = ExtResource("5_ppmu3")
artist = ExtResource("1_vb4tv")
styles = Array[ExtResource("6_2vmbq")]([ExtResource("8_gaa72")])
actual_start_year = 1832
actual_end_year = 1833
date_type = 1
custom_link = "https://commons.wikimedia.org/wiki/File:Katsushika_Hokusai,_Japanese_-_Pilgrims_at_Kirifuri_Waterfall_on_Mount_Kurokami_in_Shimotsuke_Province_-_Google_Art_Project.jpg"
edits_description = "The image was cropped and text overlays were edited out."
final_image_tex = SubResource("Resource_vb4tv")
province = 66
blurb = "The Kirifuri (\"falling mist\") Waterfall, still existing today, is located north of Nikkō City in Tochigi prefecture, on the southeastern foothills of Mount Akanagi. The waterfall is over 75 meters high, and descends in three steps, first dropping vertically, then gliding almost horizontally, before again plunging and breaking into numerous writhing streams as it rushes over craggy rocks.

The falls fill the air with mist and plunge into a pool of choppy waves and foam. The speed and turbulence of the water are conveyed by the lively patterns and lines of contrasting white and blue."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

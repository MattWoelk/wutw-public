[sub_resource type="Resource" id="Resource_2luf3"]
script = ExtResource("4_vcaat")
markedup_text = "While exploring the dusty halls of the ruined outpost, the settlers find a room filled with remarkably preserved furniture, decorated with gold and jeweled inlays.

Just as they are about to collect all this treasure, a massive snake slithers out from behind a painted screen."

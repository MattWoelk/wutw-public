[resource]
script = ExtResource("19_e3423")
episode_id = "missing_rations"
title = "The Missing Rations"
text = "When the team stops to have their meal, one of the scouts notices that half of her rice is missing from her pack.

After a brief investigation, one of the younger team members admits that he had forgotten to pack his rations and ate hers instead during yesterday's meal.

The woman is furious and threatening to beat up the thief."
background_image = SubResource("Resource_28of2")
background_credit = ExtResource("1_lkm12")
choices = Array[ExtResource("2_lkm12")]([SubResource("Resource_y6loq"), SubResource("Resource_vgty0"), SubResource("Resource_n1xbi"), SubResource("Resource_esn61")])

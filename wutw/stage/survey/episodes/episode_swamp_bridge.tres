[sub_resource type="Resource" id="Resource_1qy1g"]
script = ExtResource("8_gt2hw")
result_text = "To avoid spending too much time getting bitten by the swarming insects, the scouts hastily line up the bamboo rods and lay down the planks haphazardly.

Luckily, the construction holds and they cross safely, having saved time and avoided the worst of the insects."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"

[sub_resource type="Resource" id="Resource_3uubi"]
script = ExtResource("8_gt2hw")
result_text = "To avoid spending too much time getting bitten by the swarming insects, the group works hastily lining up the bamboo rods and laying down the planks haphazardly.

Unfortunately, just as the last few scouts step off the bridge, a plank slips and brings a large part of the construction down with it. Whoever crosses the swamp next will have to redo the work."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


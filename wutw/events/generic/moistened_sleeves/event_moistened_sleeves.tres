[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("9_liycc")
aspect_type = ExtResource("8_tqptt")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("5_13dwf")
markedup_text = "Convince him that perfumed robes are out of fashion."
requirement = SubResource("Resource_df5af")
outcome = SubResource("Resource_jcqxn")
markedup_result_text = "A few settlers quietly suggest that the floral cloud around him is actually [i]very last era[/i].

This strikes him like a lightning bolt of revelation.

The next time he arrives in stark undyed cloth, proclaiming a new era of \"pure scentlessness\" and \"emotionally astringent aestheticism\".

He still cries into his sleeves, but now they're hempen."

[sub_resource type="Resource" id="Resource_i5ayw"]
script = ExtResource("11_lxscs")
card_type = ExtResource("10_ntx2e")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("13_dcgv4")
bonus_type = ExtResource("12_0blks")
min_count = 25
max_count = -1
extra_per_season = 15

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("5_13dwf")
markedup_text = "Mention that his latest \"lost love\" is alive nearby."
requirement = SubResource("Resource_egt2j")
outcome = SubResource("Resource_i5ayw")
markedup_result_text = "As he sobs while reciting \"Cicada Shells and the Echo of Her Name\", someone offhandedly remarks that the woman he's invoking - Lady Yukako, this week - is reportedly thriving in a nearby settlement.

His eyes widen, his sleeve halfway to his face. \"Then... perhaps I must... make amends!\" he cries.

He dramatically dons his travel cloak, weeps into his sleeve one final time, and sets off. In the direction away from the aforementioned settlement.

He doesn't even stop to pick up his koto."

[sub_resource type="Resource" id="Resource_d0keq"]
script = ExtResource("11_lxscs")
card_type = ExtResource("14_q0aqn")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("9_liycc")
aspect_type = ExtResource("15_vuds3")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("5_13dwf")
markedup_text = "Convince him that the poems must be recorded."
requirement = SubResource("Resource_4xuhh")
outcome = SubResource("Resource_d0keq")
markedup_result_text = "A group of settlers, stone-faced, praise his genius and suggest the world is not ready to lose such brilliance.

\"The verses... must be preserved!\" He gasps, and retreats to his tent for days.

A week later, a bound manuscript appears at the campfire. The title reads: \"Moonlight on a Frozen Sleeve: 213 Verses of Divine Despair.\"

No one musters the patience to read past the introduction."

[sub_resource type="Resource" id="Resource_mxy6s"]
script = ExtResource("11_lxscs")
card_type = ExtResource("16_lw3jb")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("5_13dwf")
markedup_text = "Grin and bear it."
outcome = SubResource("Resource_mxy6s")
markedup_result_text = "The performances continue.

One morning he arrives wearing three layers of sleeves (\"to contain the moisture\").

Another day, he presents a new form of poetry based on sobbing rhythm alone.

Many stop coming to the campfire. Newcomers ask whether it's normal for poems to last over forty stanzas.

The koto goes mysteriously missing."

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("3_ey7pm")
markedup_text = "Every morning at the Storytellers Camp, the same young man takes the stage.

The scion of a long, noble family from the Old World, he performs traditional koto pieces that sound suspiciously similar, recites breathless poetry about women whose names change nightly, and weeps loudly into the sleeves of his over-perfumed robes.

At first, the settlers were sympathetic. Then the headaches started."
background_image = SubResource("Resource_oiy0n")
background_credit = ExtResource("4_oiy0n")
choices = Array[ExtResource("5_13dwf")]([SubResource("Resource_ptcwf"), SubResource("Resource_f2op8"), SubResource("Resource_tuogj")])
exit_choice = SubResource("Resource_rx1a8")


metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("5_ehx26")
markedup_text = "Refuse the inadequate vessels."
outcome = SubResource("Resource_vpu3v")
markedup_result_text = "The host does not press. The cups are returned to their shelf, still waiting."

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("3_mtd1m")
markedup_text = "Tea Pavilions are now a place of humble, warm gatherings. At this one, a hunchbacked old woman welcomes settlers with warm tea in cracked cups.

\"These are the only ones I have,\" she apologizes. \"Better ones might arrive next month, but I would rather share tea, even if in cracked cups.\""

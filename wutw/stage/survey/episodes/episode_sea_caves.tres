[sub_resource type="Resource" id="Resource_jljau"]
script = ExtResource("2_a1k6a")
label = "Pray to the dragon spirit."
aspects = Array[ExtResource("3_eepx8")]([ExtResource("14_k53br")])
outcome = SubResource("Resource_8ed14")
outcome_text = "The scouts kneel by the entrance, their backs exposed to the waves.

They clap their hands and each whispers an old prayer.

Perhaps the dragon will favor this expedition."

[sub_resource type="Resource" id="Resource_byjbe"]
script = ExtResource("2_a1k6a")
label = "Ignore the cave."
aspects = Array[ExtResource("3_eepx8")]([null])
outcome_text = "The scouts decide that delving into a deep, slippery cave is too much of a risk, and continue on their way."

[resource]
script = ExtResource("24_00trc")
episode_id = "sea_caves"
title = "The Sea Caves"
biome_types = Array[int]([10, 1])
text = "As the scouts are walking along the shore, they approach a huge cave.

Waves crash unceasingly into the entrance, filling the main chamber with a layer of seawater.

Old World legends claim such caves used to be inhabited by many-headed dragons who ruled the seas."
background_image = SubResource("Resource_opi5i")
background_credit = ExtResource("1_a1k6a")
choices = Array[ExtResource("2_a1k6a")]([SubResource("Resource_tsw4t"), SubResource("Resource_ra1er"), SubResource("Resource_jljau"), SubResource("Resource_byjbe")])

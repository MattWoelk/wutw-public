[resource]
script = ExtResource("3_64ohd")
original_image = SubResource("Resource_bcsnl")
piece_name = "Manufacturing Tatami in Bingo Province"
series = ExtResource("4_66hts")
artist = ExtResource("1_ydwwt")
styles = Array[ExtResource("5_vebtq")]([ExtResource("6_rtsgp")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/artists/utagawa-hiroshige-iii-1842-1894/mat-making-in-bingo-province-from-a75d618120d75e42.html"
edits_description = "The image was cropped and the horse was edited out."
final_image_tex = SubResource("Resource_kvhf6")
province = 22
blurb = "Depicts a workshop for making tatami mats in Bingo province (present-day eastern Hiroshima prefecture).

The text in the top right explains the production process. Rushes are planted in autumn and harvested in June. They are dyed in a hole in the ground by rubbing with a mxture of white clay and water. They are then dried in the sun, sorted, and rubbed again with clay after an outer layer is removed. Using hemp thread as the warp, the rushes are woven using a loom, rolled up tightly, and shipped out."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

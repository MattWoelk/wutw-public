[sub_resource type="Resource" id="Resource_d3da3"]
script = ExtResource("5_pida8")
markedup_text = "Confront her."
requirement = SubResource("Resource_e7or3")
outcome = SubResource("Resource_3fjh1")
markedup_result_text = "The weavers confront their friend about her sickness. The pale woman smiles gently, looking relieved. \"I suppose there's no use hiding it,\" she says.

The next day, she is not there at her usual spot.

At her hut, the weavers find her heavy traveling robe missing, and the rice sacks suspiciously light."


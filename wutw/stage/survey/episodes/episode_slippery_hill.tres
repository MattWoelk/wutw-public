[sub_resource type="Resource" id="Resource_pjuvv"]
script = ExtResource("2_b5omd")
label = "Roll."
aspects = Array[ExtResource("3_3fsis")]([ExtResource("16_qgkbr")])
aspects_per_season = Array[ExtResource("3_3fsis")]([null])
outcome = SubResource("Resource_08gyp")
outcome_text = "The scout makes an instant decision to stretch out her limbs and roll sideways down the grassy slope.

As she rolls, her body picks up speed and she is unable to slow down.

She arrives at the bottom of the hill within seconds, muddy, dizzy, but laughing."


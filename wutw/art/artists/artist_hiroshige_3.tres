[resource]
script = ExtResource("4_5y1x8")
name = "Utagawa Hiroshige III"
blurb = "Utagawa Hiroshige III was a prominent printmaker who documented the rapid modernization of Japan during the Meiji period. He studied under [url=artist:Utagawa Hiroshige]the original Hiroshige[/url], but shifted his focus toward [url=art_style:kaika-e]kaika-e[/url], which captured the technological and cultural transformation of the era.

Although he never achieved widespread popularity, his works like the [url=art_series:Products of Greater Japan]Products of Greater Japan[/url] series provide a vivid record of a society undergoing rapid industrialization."
birth_year = 1842
death_year = 1894
link = "https://en.wikipedia.org/wiki/Hiroshige_III"
schools = Array[ExtResource("2_vvb5y")]([ExtResource("3_aghg2")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

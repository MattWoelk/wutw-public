[sub_resource type="Resource" id="Resource_e1bbd"]
script = ExtResource("6_cfxf4")
markedup_text = "Replace them with traditional cedar."
requirement = SubResource("Resource_br6wm")
outcome = SubResource("Resource_ijskt")
markedup_result_text = "The trees are felled and cut into logs for the temple hearths.

In their place, cedar saplings are planted. Perhaps in ten years, the monastery will be surrounded by trees again.

Some of the monks who objected to the plan save the cherry pits, hoping to revive the copse elsewhere someday."

[sub_resource type="Resource" id="Resource_ebb86"]
script = ExtResource("8_t4wpb")
relic = ExtResource("11_47xnf")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_pygo0"]
script = ExtResource("10_b3ovg")
aspect_type = ExtResource("12_gu6s8")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_tvr55"]
script = ExtResource("6_cfxf4")
markedup_text = "Sanctify the existing trees."
requirement = SubResource("Resource_pygo0")
outcome = SubResource("Resource_ebb86")
markedup_result_text = "The monks wrap moss-green robes around the cherry trees and tie them with heavy braided ropes, symbolically ordaining them as part of the order.

The trees do not seem to mind, and it deters vermin."

[sub_resource type="Resource" id="Resource_lrhyg"]
script = ExtResource("8_t4wpb")
relic = ExtResource("13_j6skp")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_c8jlg"]
script = ExtResource("10_b3ovg")
aspect_type = ExtResource("14_4iygb")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_xt7nv"]
script = ExtResource("6_cfxf4")
markedup_text = "Graft cedar branches onto the trees."
requirement = SubResource("Resource_c8jlg")
outcome = SubResource("Resource_lrhyg")
markedup_result_text = "The monks make cuts in the cherry trees, and bind branches from sacred cedars to the wounds.

Within days, the bound branches wither.

\"Of the pine tree learn from the pine tree. Of the bamboo learn from the bamboo,\" quotes one of the monks."

[sub_resource type="Resource" id="Resource_trtbi"]
script = ExtResource("8_t4wpb")
relic = ExtResource("16_cfxf4")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_b7llu"]
script = ExtResource("17_cfxf4")
relic = ExtResource("16_sqoef")
metadata/_custom_type_script = "uid://bbr46symu7hfi"

[sub_resource type="Resource" id="Resource_e7hfo"]
script = ExtResource("18_2bl0q")
relic = ExtResource("16_sqoef")
metadata/_custom_type_script = "uid://bax3q3qv5pv3e"

[sub_resource type="Resource" id="Resource_2bl0q"]
script = ExtResource("6_cfxf4")
markedup_text = "Plant the grounds with seeds from the talisman pouch."
requirement = SubResource("Resource_b7llu")
show_condition = SubResource("Resource_e7hfo")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "One of the monks reminds the abbot that the Enlightened One had entrusted them with their seed pouches for just such an occasion.

Instead of felling the cherry trees or planting cedars, the initiates walk the grounds emptying surplus seed pouches to let divine will guide regrowth.

One of the pouches turns out to be filled with odd twinned seeds that the monks had never seen before."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_psisq"]
script = ExtResource("16_1gspl")
bonus_type = ExtResource("15_ftdbc")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_x3moh"]
script = ExtResource("6_cfxf4")
markedup_text = "Leave the trees as is."
outcome = SubResource("Resource_psisq")
markedup_result_text = "The monks endlessly debate the plan, but failing to come to a consensus, they leave the trees alone.

\"The forest is not there to serve us,\" the head monk concedes. \"We should let nature take its course.\""

[sub_resource type="Resource" id="Resource_jevc1"]
script = ExtResource("4_gu55d")
markedup_text = "This monastery of the Order of Growth was established in a copse of cherry trees, perhaps cultivated once, but wild now. They bloom briefly and produce bitter fruit.

Many of the monks argue that they should instead replant the area with traditional cedar trees. Some object to needlessly cutting wild trees, suggesting that it should be enough to just sanctify them, or even to graft cedar branches."
background_image = SubResource("Resource_sjgf2")
background_credit = ExtResource("5_52y53")
choices = Array[ExtResource("6_cfxf4")]([SubResource("Resource_e1bbd"), SubResource("Resource_tvr55"), SubResource("Resource_xt7nv"), SubResource("Resource_2bl0q")])
exit_choice = SubResource("Resource_x3moh")


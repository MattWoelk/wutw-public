[sub_resource type="Resource" id="Resource_sphbv"]
script = ExtResource("4_utf66")
markedup_text = "Not far from the Eternal Glade the Scribe's disciples find the vein of the forest, a narrow trough lined with ancient, towering trees on both sides. Moss covers the ground in a thick, plush carpet.

This is the place the Scribe named in his plan, where roots draw the shard's life force to the surface. A place of [i]Life[/i], now free from the haunting of the fox spirits."
background_image = SubResource("Resource_e0kji")
background_credit = ExtResource("6_50hmy")
choices = Array[ExtResource("6_giekt")]([SubResource("Resource_qynpt"), SubResource("Resource_y5nml"), SubResource("Resource_yyr3p"), SubResource("Resource_63ro7")])


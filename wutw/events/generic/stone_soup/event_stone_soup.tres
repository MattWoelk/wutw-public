[sub_resource type="Resource" id="Resource_lqnfo"]
script = ExtResource("6_priba")
markedup_text = "Trade the stone for supper."
requirement = SubResource("Resource_1de8r")
outcome = SubResource("Resource_1a7fo")
markedup_result_text = "A local merchant is quick to jump on the opportunity, offering a box of nori in return for the miraculous stone.

The traveler haggles, reluctant to part with the treasure, but eventually agrees to the trade."

[sub_resource type="Resource" id="Resource_7h0lc"]
script = ExtResource("6_priba")
markedup_text = "Send the traveler away. "
markedup_result_text = "The villagers laugh at the traveler, dismissing them as delusional.

The settlement is too busy to bother with their nonsense."

[sub_resource type="Resource" id="Resource_cymd0"]
script = ExtResource("4_pj8wo")
markedup_text = "It is the height of the nori harvest along the seashore. Everyone contributes to the harvest. Workers with chilled fingers, their pants tied above their knees, wade between the brushwood. Children carry baskets of wet seaweed to the sorting mats. Dogs wander hopefully among the drying racks.

Amid the bustle, a weatherworn traveler arrives, carrying an empty pot and a smooth black stone. They introduce themself as a master chef, and claim that their stone can turn any soup into culinary perfection. They ask for some nori to demonstrate."
background_image = SubResource("Resource_u2mrr")
background_credit = ExtResource("5_xn8ry")
choices = Array[ExtResource("6_priba")]([SubResource("Resource_s3q1v"), SubResource("Resource_g4wdp"), SubResource("Resource_lqnfo")])
exit_choice = SubResource("Resource_7h0lc")


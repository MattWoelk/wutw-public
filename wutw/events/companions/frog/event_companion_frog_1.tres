[sub_resource type="Resource" id="Resource_o44fc"]
script = ExtResource("9_y5dt8")
markedup_text = "Write a poem about the wife."
requirement = SubResource("Resource_658i2")
outcome = SubResource("Resource_qvx48")
markedup_result_text = "The man embraces his grief, dedicating a poem to his wife's memory:

The koto's sound
had soothed the willow's weeping
Now it is silent

Tears well in his eyes, the verse only deepening his sorrow.

He remains by the riverbank, lost in his memories, as the frog splashes into the water once more."

[sub_resource type="Resource" id="Resource_kws1i"]

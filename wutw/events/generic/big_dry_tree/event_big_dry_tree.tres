[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("5_o2csi")
markedup_text = "Fell the tree for timber."
requirement = SubResource("Resource_4xuhh")
outcome = SubResource("Resource_kio1v")
markedup_result_text = "The work takes all day.

The trunk cracks like thunder, and its fall shakes the forest floor.

The wood is strong, aged, and clean.

But something changes. Birds avoid the clearing now."


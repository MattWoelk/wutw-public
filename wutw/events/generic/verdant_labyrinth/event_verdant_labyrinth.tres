[sub_resource type="Resource" id="Resource_qap65"]
script = ExtResource("3_br3hg")
markedup_text = "A group of settlers are on a stroll in the forest when they realize that they are surrounded by a dense maze of trees.

The trunks grow so close together that the canopy blocks out the sunlight, and the trail becomes lost among ferns and winding roots.

They can no longer tell whether the trail ahead is leading them deeper into the forest, or back toward the settlement."
background_image = SubResource("Resource_fovyc")
background_credit = ExtResource("4_5uu12")
choices = Array[ExtResource("5_scwy6")]([SubResource("Resource_d4hnw"), SubResource("Resource_d87m6"), SubResource("Resource_sbnlt")])
exit_choice = SubResource("Resource_xpjnn")


[sub_resource type="Resource" id="Resource_7gp6c"]
script = ExtResource("5_jputc")
markedup_text = "Move the stalls onto floating platforms."
requirement = SubResource("Resource_lbnye")
outcome = SubResource("Resource_knqvc")
markedup_result_text = "A craftswoman from the crowd comes up with a compromise: lash empty barrels and timber together, pushing the stalls out onto the water itself.

Customers now balance on makeshift pontoons, dipping their feet directly into the cool reservoir while they eat.

The banks are clear for the fire brigade, and the floating tea stalls quickly become the talk of the town."


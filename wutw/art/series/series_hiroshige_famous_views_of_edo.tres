[resource]
script = ExtResource("2_s1k6r")
name = "100 Famous Views of Edo (1856-1859)"
blurb = "A series of 119 prints, begun and largely completed by Hiroshige, depicting Edo (present-day Tōkyō). The prints were first published in serialized form in 1856–1859, with [url=artist:Hiroshige II]Hiroshige II[/url] completing the series after Hiroshige's death. It was tremendously popular and much reprinted."
start_year = 1856
end_year = 1859
artist = ExtResource("1_t4uvt")
link = "https://en.wikipedia.org/wiki/One_Hundred_Famous_Views_of_Edo"

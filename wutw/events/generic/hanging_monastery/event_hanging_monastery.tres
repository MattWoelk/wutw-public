[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("5_1h70n")
markedup_text = "Let the monk continue with the same responsibilities."
requirement = SubResource("Resource_kio1v")
outcome = SubResource("Resource_f2op8")
markedup_result_text = "The snapped chain is entrusted to the very hand that broke it.

The monk studies each link as though it were scripture. He will remember every scratch on the chain's surface for the rest of his life.

When the monastery's Acceptance Bell is rung at dusk, the monks feel that a fracture has been avoided."

[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("7_wqkfv")
relic = ExtResource("10_ma6pf")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("12_6m5t1")
aspect_type = ExtResource("11_6e61y")
min_count = 5
extra_per_season = 1

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("5_1h70n")
markedup_text = "Make it a shared duty: four brothers at every check."
requirement = SubResource("Resource_ptcwf")
outcome = SubResource("Resource_4xuhh")
markedup_result_text = "From now on, chain maintenance is never a lone task. Four pairs of eyes inspect each link, as it is passed from hand to hand.

The chains hold steadier, and the inspection becomes a ritual of responsibility."

[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("7_wqkfv")
relic = ExtResource("13_jtjy2")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_1h70n")
markedup_text = "Chastise the monk to sharpen his resolve."
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The monk is admonished before his brothers and sisters, reminding him that a slip here could mean death.

From now on his hammer strikes become measured and fearful. He ties his hammer to his sash with a cord, which he rubs before every strike."


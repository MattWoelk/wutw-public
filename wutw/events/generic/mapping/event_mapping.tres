[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("5_7wh20")
markedup_text = "Highlight the most fertile and habitable lands."
requirement = SubResource("Resource_w2hpu")
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The map blooms with green patches and golden marks: places where the soil is rich, the winds are kind, and fresh water flows.

Paths between them are carefully drawn.

It may not tempt explorers, but settlers will follow this map like a promise."


[resource]
script = ExtResource("3_5uhdu")
original_image = SubResource("Resource_bcsnl")
piece_name = "Sericulture in Rikuzen Province, Figure 5"
series = ExtResource("4_uumcy")
artist = ExtResource("1_66a3t")
styles = Array[ExtResource("5_5mdlh")]([ExtResource("6_l3af1")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
edits_description = "The text was edited out and the image was cropped."
final_image_tex = SubResource("Resource_2qtq3")
province = 67
blurb = "Depicts women preparing mulberry leaves for silkworms in Rikuzen province (present-day Miyagi prefecture).

The text explains that silkworms go through 4 molting stages:\"lion\", \"hawk\", \"boat\", and \"garden\". It describes the preparation of mulberry leaves, being cut into coarser and coarser pieces to match the size of the worms, and winnowed to remove dust.

The text then compares \"dense raising\" (depicted) to \"sparse raising\". In the former, the insects and their cocoons are smaller, but by feeding them mulberry leaves with a high moisture content, the yield of silk thread is increased.

When this print was issued in 1877 silk was Japan's leading export, and by 1909 Japan surpassed China as the world's top silk producer."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

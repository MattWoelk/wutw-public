[sub_resource type="Resource" id="Resource_xru5x"]
script = ExtResource("5_2nq2x")
markedup_text = "Leave food and charcoal deliberately."
requirement = SubResource("Resource_xdfip")
outcome = SubResource("Resource_2oorm")
markedup_result_text = "A bundle is left each night with no demands, and always gone by the morning.

Days pass.

One morning, the bundles are untouched, but in their place is a cracked cup holding a charcoal-stained tooth, painted black and polished smooth."


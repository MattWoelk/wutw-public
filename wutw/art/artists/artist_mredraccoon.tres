[resource]
script = ExtResource("3_w7xpg")
name = "M. Red Raccoon"
portrait = SubResource("Resource_o8uy8")
blurb = "M. Red Raccoon is a Spanish illustrator based in Japan whose work focuses on historical art styles, particularly printmaking aesthetics. Enthusiast of art history, she draws inspiration from traditional techniques, visual conventions, and the ways artists of the past interpreted the world around them.

Ukiyo-e and sumi-e became particularly important influences on her artistic language, eventually playing a part in her decision to leave Spain and settle in Japan. Living there has allowed her to continue exploring these traditions more closely while developing her own approach to them from the eyes of a Westerner.

Rather than simply reproducing historical works, she enjoys applying their visual language to unexpected subjects, from folklore and landscapes to fantasy and fictional worlds. Her work combines historical references with contemporary illustration, imagining how modern or imaginary scenes might have been interpreted through the aesthetics of another time."
birth_year = 1994
custom_date = "1994 - Present"
link = "https://www.artstation.com/mredraccoon"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_8pa46"]
script = ExtResource("2_wwp4b")
label = "Choose the widest path."
aspects = Array[ExtResource("3_canpa")]([null, null])
aspects_per_season = Array[ExtResource("3_canpa")]([null])
outcome = SubResource("Resource_cnx8y")
outcome_text = "The explorers decide to follow the widest path. The trail gradually becomes narrower while the walls on either side become steeper.

Soon, the passage becomes so narrow that the sun is only shining through a thin opening in the rock above.

By nightfall, the path finally widens again, revealing a circle of starry clear sky."

[resource]
script = ExtResource("15_vkhm8")
episode_id = "valley_path"
title = "The Valley Path"
biome_types = Array[int]([7])
spot_types = Array[ExtResource("16_uyw53")]([ExtResource("17_0npf5"), ExtResource("18_pgkmp"), ExtResource("19_6k8l1")])
text = "The explorers find themselves in a narrow valley with steep, high walls. The path twists through exposed stone and small groves, occasionally opening onto patches of grass.

The valley branches out into several nearly identical paths. The scouts worry that choosing the wrong path could strand them in a dead end, or leave the group wandering in circles."
background_image = SubResource("Resource_ddinv")
background_credit = ExtResource("1_wwp4b")
choices = Array[ExtResource("2_wwp4b")]([SubResource("Resource_hhyov"), SubResource("Resource_r5ivp"), SubResource("Resource_naust"), SubResource("Resource_8pa46")])

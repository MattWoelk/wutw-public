[resource]
script = ExtResource("14_87lxg")
episode_id = "sandal"
title = "The Broken Sandal"
biome_types = Array[int]([4, 6, 7, 9])
spot_types = Array[ExtResource("15_jpk45")]([ExtResource("17_q5ceg")])
text = "One of the scouts had accidentally torn the strap of her sandal and, out of embarrassment, tried to hide it.

Now she is limping and slowing the pace of the group.

The team is frustrated that the scout hid the problem, while the scout is defensive about not wanting to be seen as a burden."
background_image = SubResource("Resource_118v1")
background_credit = ExtResource("1_ba3g1")
choices = Array[ExtResource("2_ba3g1")]([SubResource("Resource_dpncf"), SubResource("Resource_8kgsa"), SubResource("Resource_ey0yn"), SubResource("Resource_b6yab")])

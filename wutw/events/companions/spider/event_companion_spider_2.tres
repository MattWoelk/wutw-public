[sub_resource type="Resource" id="Resource_m3x2g"]
script = ExtResource("6_o336f")
markedup_text = "Take the single scroll and leave."
outcome = SubResource("Resource_v803k")
markedup_result_text = "The cave is left undisturbed.

The settlers decide that no knowledge is worth braving the creepy arachnids."

[sub_resource type="Resource" id="Resource_vy0sq"]
script = ExtResource("4_yifqa")
markedup_text = "While exploring a damp cavern, the expedition stumbles upon a pre-Shattering scroll in an airtight case, perfectly preserved.

The caves extend further, into deep tunnels, bound to contain more ancient artifacts, but the way forward lies through a thick, silvery labyrinth of spiderwebs.

The spiders themselves are large, watchful, and currently sitting motionless in the dark. Retrieving the lost knowledge will lead through their domain."
background_image = SubResource("Resource_s27r8")
background_credit = ExtResource("6_s27r8")
choices = Array[ExtResource("6_o336f")]([SubResource("Resource_ibkjf"), SubResource("Resource_am7ru"), SubResource("Resource_j0nto")])
exit_choice = SubResource("Resource_m3x2g")


[resource]
script = ExtResource("3_ki4eu")
original_image = SubResource("Resource_bcsnl")
piece_name = "Drying Nori in Musashi Province"
series = ExtResource("4_ituq4")
artist = ExtResource("1_ni0eb")
styles = Array[ExtResource("5_jc0u3")]([ExtResource("6_r6wsa")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
edits_description = "The image was cropped and the boats were edited out."
final_image_tex = SubResource("Resource_kvhf6")
province = 59
blurb = "Depicts the process of drying seaweed to make nori in Musashi province (around present-day Tōkyō).

The text on the top right explains that nori is a major Japanese specialty product and explains the production process.

During the winter season, tree branches are set up on the beach, and after the tide recedes, the seaweed that gets snagged on the branches is harvested. The result is cleaned and spread out on bamboo mats to dry in sheets, similar to how paper is made."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

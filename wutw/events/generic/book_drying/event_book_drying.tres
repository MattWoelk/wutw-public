[sub_resource type="Resource" id="Resource_ct8ru"]
script = ExtResource("5_t45cj")
markedup_text = "It is an imaginary monster."
requirement = SubResource("Resource_ymjb3")
outcome = SubResource("Resource_xifkc")
markedup_result_text = "The librarian explains that these are fairy-tale monsters that an artist imagined.

Spurred by the revelation that one is free to come up with imaginary beasts, the boy starts spending his days drawing his own creatures. Dogs with wings, birds with books in their beaks, and brightly colored tigers with flowers around their necks."


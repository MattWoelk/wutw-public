[sub_resource type="Resource" id="Resource_bgisj"]
script = ExtResource("13_e38c3")
result_text = "A particularly adventurous scout climbs to the top of the tree. Just as he is about to come down, his foot slips and he comes crashing down. He passes several branches before he manages to gain purchase and climb down the rest of the way. He arrives on the ground with no serious injuries, but covered in scratches, and with clothes full of sap."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


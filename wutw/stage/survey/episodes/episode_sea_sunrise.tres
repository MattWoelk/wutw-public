[resource]
script = ExtResource("13_1qckn")
episode_id = "sea_sunrise"
title = "The Serene Sunrise"
biome_types = Array[int]([1, 10])
requirement = SubResource("Resource_trtbi")
text = "The sea is calm this morning, the grey rocks painted a coral red by the magnificent sunrise.

The scouts contemplate the scene, taking in the gentle waves lapping against the shore and the grass-covered hills further ahead."
background_image = SubResource("Resource_0xhk2")
background_credit = ExtResource("1_83645")
choices = Array[ExtResource("2_83645")]([SubResource("Resource_xy53q"), SubResource("Resource_407v5"), SubResource("Resource_kksl2"), SubResource("Resource_tawna")])

markedup_text = "Meditate on the transformation."
outcome = SubResource("Resource_egt2j")
markedup_result_text = "A monk sits by the willow, meditating on the husk.

Although the shell is empty, what grew from it lives elsewhere, freer for the dropped burden."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("4_2wxp5")
markedup_text = "At the base of a willow, a fragile cicada shell clings to the bark.

The cicada is gone. In its place is a perfect empty husk, intact and light as paper.

The wind is whistling faintly through it."

[sub_resource type="Resource" id="Resource_ixcym"]
script = ExtResource("4_utf66")
event_step_id = "destroy"
markedup_text = "Torches are lit, and flames soon start creeping along the underbrush. The fire burns fiercely, clouds of smoke hanging like a curtain among the trees, but it doesn't spread.

When it finally goes out, the air is thick with ash. Charred shapes are left behind in the bark, which the disciples inscribe in their scrolls.

\"Through the purifying fire, the Enlightened One has sent down a message for us,\" the disciples whisper. \"These glyphs will power the ritual to come.\""
background_image = SubResource("Resource_0kyfl")
background_credit = ExtResource("6_50hmy")
exit_choice = SubResource("Resource_1c3qd")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


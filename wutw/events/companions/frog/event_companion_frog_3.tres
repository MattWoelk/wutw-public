[sub_resource type="Resource" id="Resource_5t88q"]
script = ExtResource("6_1rdcd")
markedup_text = "Identify the frog as an evil spirit."
requirement = SubResource("Resource_p8nng")
outcome = SubResource("Resource_5iqy7")
markedup_result_text = "A priest is quick to resolve the confusion. This frog, he explains, is nothing but an evil spirit.

He throws a handful of mud towards the animal, and it quickly hops away, disappearing into the reeds.

The monster thus banished, the settlers breathe a sigh of relief."


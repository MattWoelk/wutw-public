[resource]
script = ExtResource("3_cwa12")
original_image = SubResource("Resource_bcsnl")
piece_name = "Pilgrims Climbing Up at Hōrai-ji Temple in Mikawa Province"
series = ExtResource("4_7bexd")
artist = ExtResource("1_7bexd")
styles = Array[ExtResource("5_boqt7")]([ExtResource("6_7t16g")])
actual_start_year = 1837
actual_end_year = 1837
date_type = 1
edits_description = "In some uses, the background, the people, and the little statues were edited out."
final_image_tex = SubResource("Resource_2fedg")
province = 52
blurb = "Depicts people climbing up to the Hōrai-ji temple, in present-day Aichi prefecture.

This Shingon Buddhist temple was allegedly founded in 702 AD by an ascetic and sculptor Ryūshū Sennin. It is located on the 695 meters high Mount Hōrai and is accessed by a flight of 1425 steps.

The temple has been rebuilt multiple times over the centuries, and still stands today. The grounds have been designated a Place of Scenic Beauty and Natural Monument in 1931."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_6lgqy"]
script = ExtResource("5_6uo6p")
markedup_text = "Compare the basket to other baskets."
requirement = SubResource("Resource_gqavj")
outcome = SubResource("Resource_28qwu")
markedup_result_text = "The master lines all the baskets he has inspected into a row, and starts to compare them, searching for any sign of glyphs or hidden messages.

The workers look on, glancing at the master nervously.

By the time the inspection is done, the master realizes that many of the common weave patterns look like glyph shapes, if one tries hard enough to see the parallels. He laughs at his superstitiousness, and feels relieved for the rest of the day."


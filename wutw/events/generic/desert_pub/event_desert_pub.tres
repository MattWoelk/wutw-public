[sub_resource type="Resource" id="Resource_akulg"]
script = ExtResource("10_alof6")
aspect_type = ExtResource("15_xt3pe")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_vyq5a"]
script = ExtResource("6_rrpys")
markedup_text = "Ask the storyteller about his brothers."
requirement = SubResource("Resource_akulg")
outcome = SubResource("Resource_1stri")
markedup_result_text = "Curious, the innkeeper asks to hear more about the stranger's family. \"I wish I could go back,\" he says, as tears fill his eyes.

He suddenly looks up from his drink, his eyes regaining focus. With a nod at the innkeeper, he excuses himself and walks back to his lodgings."

[sub_resource type="Resource" id="Resource_b8qe8"]
script = ExtResource("6_rrpys")
markedup_text = "Ignore the drunkard."
markedup_result_text = "The innkeeper lets the stories pass with the night.

Some of the patrons speak amongst themselves, wondering about the strange tale, but the traveler is gone as the first sunrays shine through the palms."

[sub_resource type="Resource" id="Resource_pc8ys"]
script = ExtResource("4_ujcwv")
markedup_text = "This evening the pub is full. Locals drift in, eager for news from the road from merchants in dusty robes.

A stranger sits in the corner, ignored as the drink and conversation flow. His long face remains shadowed, only a prominent nose sticking out, and oddly large eyes catching the lamplight. Finally, he stands up and begins to tell a story.

The patrons roar with laughter at his retelling of the Magic Teapot, and refill his cup time and again.

As his tongue loosens, the tales begin to change. He now speaks of a white city, its turrets shimmering in the sunlight, its lotus ponds filling the air with a sweet fragrance. His eyes get misty as he describes the scent of rain on white stone and the brothers he left behind."
background_image = SubResource("Resource_c8w73")
background_credit = ExtResource("5_jgbxx")
choices = Array[ExtResource("6_rrpys")]([SubResource("Resource_pdn6x"), SubResource("Resource_vbe3t"), SubResource("Resource_vyq5a")])
exit_choice = SubResource("Resource_b8qe8")


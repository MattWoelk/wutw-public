[resource]
script = ExtResource("4_c4m22")
original_image = SubResource("Resource_bcsnl")
piece_name = "Nissaka: Sayo Pass, the Night-crying Stone, and Mount Mugen"
series = ExtResource("5_0fohf")
artist = ExtResource("1_8mnt6")
styles = Array[ExtResource("6_14d5e")]([ExtResource("7_0n3w5")])
actual_start_year = 1847
actual_end_year = 1852
date_type = 1
edits_description = "The text was removed. In one use, the rock was edited to look buried."
final_image_tex = SubResource("Resource_x4myr")
province = 53
blurb = "The boulder in the center is the \"night-crying stone\", so named after the legend of a pregnant woman who was murdered by bandits and spilled her blood on the stone. In one interpretation of the legend it is said that her spirit was contained in the stone and she wept each night. In another version the stone cries every night for the murdered woman.

The partially legible writing on the stone is a veneration, likely \"Namu Amida Butsu\", or \"I take refuge in Amida Buddha\". This sutra is most commonly associated with the Pure Land school of Buddhism."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

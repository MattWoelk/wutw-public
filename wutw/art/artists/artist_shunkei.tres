[resource]
script = ExtResource("3_r0sg4")
name = "Mori Shunkei"
blurb = "Mori Shunkei was an Ōsaka-based woodblock print artist active in the early 19th century. Little is known about his life, other than that he trained under Mori Sosen (1747-1821) of the [url=art_school:Shijō School]Shijō school[/url].

Shunkei is best-known for the e-hon (\"illustrated book\") Chuka Senzen (\"Selection of Insects at My Elbow\"), published in 1820, which contains 12 detailed illustrations of insects and plants, alternating with 12 Chinese verses."
birth_year = 1780
death_year = 1850
custom_date = "active early 19th century"
link = "https://www.britishmuseum.org/collection/term/BIOG5998"
schools = Array[ExtResource("2_nxrfd")]([ExtResource("2_p7ws6")])

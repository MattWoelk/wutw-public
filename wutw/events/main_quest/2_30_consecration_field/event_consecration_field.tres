[sub_resource type="Resource" id="Resource_caj30"]
script = ExtResource("4_bomh3")
event_step_id = "science"
markedup_text = "A great banner inscribed with the glyph of constancy is lifted above the meadow.

The cloth flutters, lively in a sudden gust of wind.

\"The Scribe told us to wait for a sign,\" one disciple remarks, \"but I didn't expect it so quickly.\"

\"The Enlightened One approves,\" says another.

They all agree that their glyphs resonate more deeply with the shard's energies now."
background_image = SubResource("Resource_pircu")
background_credit = ExtResource("6_aa4gq")
exit_choice = SubResource("Resource_aa4gq")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


[resource]
script = ExtResource("4_sguhl")
original_image = SubResource("Resource_bcsnl")
piece_name = "Honey Making in Tanba Province"
series = ExtResource("5_l1hlp")
artist = ExtResource("1_ioaq4")
styles = Array[ExtResource("6_goi5r")]([ExtResource("7_e65ub")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
edits_description = "The image was cropped, some people were edited and moved, and a swarm of bees was added."
final_image_tex = SubResource("Resource_pjfnt")
province = 33
blurb = "The text mentions several varieties of honey bees: earth bees, wood bees, and mountain bees. It then describes the raising of domesticated bees in boxes and tubs pierced with holes. The bees collected nectar from the end of spring until the end of autumn, at which point two thirds of the honeycombs were taken and boiled to produce \"ripe honey\"."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_rwd8s"]
script = ExtResource("9_dvcb2")
markedup_text = "Snatch the gourd."
requirement = SubResource("Resource_gegyu")
outcome = SubResource("Resource_xnywc")
markedup_result_text = "Deciding to save the harvest from the creature, a bold onlooker reaches for the gourd.

The snake strikes faster than the eye can follow, and the brave settler is left with a painful bite. At least he's lucky that this snake isn't venomous.

The crowd learns its lesson and quickly disperses."


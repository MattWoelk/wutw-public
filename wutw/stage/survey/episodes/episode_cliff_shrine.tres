[sub_resource type="Resource" id="Resource_lkr2a"]
script = ExtResource("2_s55kp")
label = "Clean the shrine."
aspects = Array[ExtResource("3_2epi6")]([ExtResource("4_qe1c4"), ExtResource("5_dum65")])
outcome = SubResource("Resource_wxrn0")
outcome_text = "The scouts wipe away layers of moss that had started to grow on the shrine's roof, and brush decades of dust from the necklace.

Carved in the rock behind the pillar they find the image of a shrine maiden, whirling with the necklace held in her hand."


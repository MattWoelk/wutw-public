[sub_resource type="Resource" id="Resource_eaxoo"]
script = ExtResource("5_6xn7f")
markedup_text = "Test the prophecy."
requirement = SubResource("Resource_bat4u")
outcome = SubResource("Resource_ejd54")
markedup_result_text = "The settlers send scouts to the dunes to verify the priest's warning.

By the time they see the storm headed for the village, it is too late to act.

When the dust settles, the cassava roots remain mostly underground, but the irrigation channels are choked with sand."

[sub_resource type="Resource" id="Resource_vnaq3"]
script = ExtResource("14_b3kin")
card_type = ExtResource("13_uj54m")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_blu6b"]
script = ExtResource("5_6xn7f")
markedup_text = "Wait out the storm inside."
outcome = SubResource("Resource_vnaq3")
markedup_result_text = "Too frightened to act, the villagers decide to shelter and wait for the storm to pass.

No one risks being caught in the open, but the fields are left unprotected.

When the dust settles, the cassava roots remain safe underground, but the irrigation channels are choked with sand."

[sub_resource type="Resource" id="Resource_1pror"]
script = ExtResource("3_0u1ev")
markedup_text = "The settlement is halfway through the cassava harvest when the chief priest emerges from the shrine in distress. He has interpreted the color of the sky at dawn and the howling of the wind as a warning: a great sandstorm is coming and the village must pull out every cassava root by sunset.

The head farmer disagrees. He has spent his life reading wind, soil, and plant signs. Storm or not, he insists that the cassava is safer left underground until it can be processed properly.

The settlers are divided. The priest has been right before, but the farmer's experience is what keeps their granaries full.
"

[sub_resource type="Resource" id="Resource_8441f"]
script = ExtResource("3_br3hg")
event_step_id = "bird_choice"
markedup_text = "The settlers pause, hearing several distinct bird calls coming from different directions.

First comes the sharp and raspy cawing of a crow. It repeats, the sound echoing among the trees.

In response comes the low hooting of an owl.

The calls seem farther and farther away each time."
background_image = SubResource("Resource_trtbi")
background_credit = ExtResource("4_5uu12")
choices = Array[ExtResource("5_scwy6")]([SubResource("Resource_0eiya"), SubResource("Resource_d174p")])

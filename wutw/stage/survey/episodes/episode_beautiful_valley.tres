label = "Continue on together."
aspects = Array[ExtResource("3_aveeh")]([null])
aspects_per_season = Array[ExtResource("3_aveeh")]([null])
outcome = SubResource("Resource_o5w7m")
outcome_text = "The team refuses to split up and forges ahead. The artist keeps on grumbling about tyrannical leadership, but the rest pay her no mind."

[resource]
script = ExtResource("15_jbl1k")
episode_id = "beautiful_valley"
title = "The Picturesque Vista"
biome_types = Array[int]([7])
text = "One of the scouts is struck by the beauty of the valley over which the surveyors are passing. She asks to stay behind to sketch the landscape, promising to catch up as soon as she is done."

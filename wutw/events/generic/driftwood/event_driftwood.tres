[sub_resource type="Resource" id="Resource_trtbi"]
script = ExtResource("5_2rw46")
markedup_text = "Throw the inkstick into the sea."
requirement = SubResource("Resource_e7hfo")
show_condition = SubResource("Resource_pakit")
outcome = SubResource("Resource_agcm7")
markedup_result_text = "The settlers cast a single inkstick into the waves, which quickly disappears.

The next day a peculiarly sharpened stake is found on the beach."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("5_2rw46")
markedup_text = "Leave them alone."
markedup_result_text = "The tide rises and falls.

The driftwood floats on, untouched.

Over time, the tools disappear one by one, and the incident is forgotten."

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("3_d1iet")
markedup_text = "Over several days, new pieces of driftwood make it to the shoal with an uncanny regularity.

They aren't the usual planks or branches, though, but solid wood shaped like tools. A mallet with no joints. A sickle with no metal parts.

The driftwood gatherers swear they've never seen anything like this before, and say that sea spirits must be sharing tools with their new neighbors."
background_image = SubResource("Resource_kkt1s")
background_credit = ExtResource("5_kkt1s")
choices = Array[ExtResource("5_2rw46")]([SubResource("Resource_xxhwh"), SubResource("Resource_df5af"), SubResource("Resource_ptcwf"), SubResource("Resource_trtbi")])
exit_choice = SubResource("Resource_egt2j")


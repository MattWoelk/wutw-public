[sub_resource type="Resource" id="Resource_6bxub"]
script = ExtResource("2_mxp1c")
label = "Take the sword."
aspects = Array[ExtResource("3_cgir6")]([ExtResource("8_fagqy"), ExtResource("9_a4jll")])
outcome = SubResource("Resource_sw2y7")
outcome_text = "The scouts rush towards the stairs, eyes set on the shiny weapon.

As three of them crowd onto the narrow steps, the planks finally give way with a tired groan, the stairs suddenly collapsing.

Several people are injured, and the sword remains out of reach."

[sub_resource type="Resource" id="Resource_xh7y7"]
script = ExtResource("14_nr803")
relic = ExtResource("13_5p6tl")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_u4cwo"]
script = ExtResource("2_mxp1c")
label = "Search the basement."
aspects = Array[ExtResource("3_cgir6")]([ExtResource("11_oos26"), ExtResource("12_rptj1")])
outcome = SubResource("Resource_xh7y7")
outcome_text = "The scouts, with lanterns held aloft, descend into the stone basement.

Among the cobwebs and dust, they find a yellowed piece of paper. Its edges are weathered and eaten by worms, but it is still recognizable as a portrait.

It depicts a richly dressed man in a palanquin, surrounded by servants."

[sub_resource type="Resource" id="Resource_pmxvo"]

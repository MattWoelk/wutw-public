[sub_resource type="Resource" id="Resource_etxp1"]
script = ExtResource("5_5vv4d")
markedup_text = "It is bitter."
outcome = SubResource("Resource_3j3l5")
markedup_result_text = "The chief tastes a spoonful and agrees that the vinegar has a bitter note.

\"To expect vinegar to taste sweet is only to invite disappointment,\" she says."

[sub_resource type="Resource" id="Resource_cnhaa"]
script = ExtResource("7_y348j")
card_type = ExtResource("8_kd2g5")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_up1rf"]
script = ExtResource("5_5vv4d")
markedup_text = "It is sweet."
outcome = SubResource("Resource_cnhaa")
markedup_result_text = "The chief tastes a spoonful and smiles. She thinks the vinegar tastes perfect as it is.

\"This has brewed naturally for centuries,\" she says. \"To forcefully dilute it will only spoil it.\""

[sub_resource type="Resource" id="Resource_sw3x0"]
script = ExtResource("7_y348j")
card_type = ExtResource("9_k2kkm")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_7iygd"]
script = ExtResource("5_5vv4d")
markedup_text = "It is sour."
outcome = SubResource("Resource_sw3x0")
markedup_result_text = "The chief tastes a spoonful and puckers her lips.

\"This simply won't do,\" she says. \"It is unrefined, left to grow wild for too long.\"

She instructs her employees to institute a daily regimen of measuring the acidity and maintaining a specific storage temperature. She follows it with a list of rules for the proper handling of jars, split into subsections based on jar size and material."

[sub_resource type="Resource" id="Resource_45idx"]
script = ExtResource("3_3e34k")
markedup_text = "The fermentation lodge was established by restoring an old ruin where huge jars of vinegar were found. Today, the fermenters open one such jar and taste the vinegar.

This results in a disagreement. One woman claims it is too sweet. Another that it is too sour. And the third that it is too bitter.

They ask the chief fermenter to resolve their disagreement."

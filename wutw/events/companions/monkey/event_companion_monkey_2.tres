[sub_resource type="Resource" id="Resource_lbfhb"]
script = ExtResource("6_qijx8")
markedup_text = "Give the monkey a mirror."
requirement = SubResource("Resource_f72rq")
outcome = SubResource("Resource_32kva")
markedup_result_text = "A settler fetches a hand mirror and angles it to reflect the moon directly into the monkey's face.

The monkey promptly snatches the mirror.

It spends the next hour completely mesmerized, tilting it this way and that and occasionally trying to bite its own reflection."

[sub_resource type="Resource" id="Resource_2i6xr"]

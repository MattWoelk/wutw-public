[sub_resource type="Resource" id="Resource_yhywf"]
script = ExtResource("2_7e5qk")
label = "Search the shrine."
requirement = SubResource("Resource_657jf")
aspects = Array[ExtResource("3_bd3k0")]([ExtResource("4_ansb6")])
aspects_per_season = Array[ExtResource("3_bd3k0")]([null])
outcome = SubResource("Resource_ryrc3")
outcome_text = "Inside the shrine the scouts find a collection of animal masks hanging on the walls. The best preserved one appears to be carved to resemble a boar's face.

One of the scouts dons the mask, laughing, and watches his companions suddenly turn white, pointing behind him. When he looks, he sees nothing but a copse of trees.

His companions explain that they saw a giant boar staring at them, then disappearing into the trees."


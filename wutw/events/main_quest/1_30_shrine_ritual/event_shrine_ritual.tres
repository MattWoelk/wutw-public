var_type = 1
value = "true"
description = "This will leave a mark on history."
metadata/_custom_type_script = "uid://cgvcpdtoqk4ff"

[sub_resource type="Resource" id="Resource_mxy6s"]
script = ExtResource("4_5xrqp")
markedup_text = "Contribute to a communal rice pot."
outcome = SubResource("Resource_h5mfv")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Each day, a monk is tasked with tending the giant cauldron.

Visitors bring their grain in the morning, and return with bowls by lunchtime.

No one counts what is brought or what is taken, and the shrine's blessing keeps bellies fed across the settlement."

[sub_resource type="Resource" id="Resource_jcqxn"]
script = ExtResource("5_eruld")
scope = 1
var_id = "compost"
var_type = 1
value = "true"
description = "This will leave a mark on history."
metadata/_custom_type_script = "uid://cgvcpdtoqk4ff"

[sub_resource type="Resource" id="Resource_l1gue"]
script = ExtResource("4_5xrqp")
markedup_text = "Bring fallen leaves and petals to the shrine."
outcome = SubResource("Resource_jcqxn")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Each visitor picks up stray debris on the way to the shrine, and deposits them into a shared basket.

The basket changes with the seasons, burning orange in the fall, and blush pink in the spring. Even in winter, twigs and acorns find their way into the basket.

What one person drops is hardly noticed. Yet together the offerings form a living tapestry."

[sub_resource type="Resource" id="Resource_i5ayw"]
script = ExtResource("5_eruld")
scope = 1
var_id = "waterline"
var_type = 1
value = "true"
description = "This will leave a mark on history."
metadata/_custom_type_script = "uid://cgvcpdtoqk4ff"

[sub_resource type="Resource" id="Resource_ps5l8"]
script = ExtResource("4_5xrqp")
markedup_text = "Meditate on where the water meets the gate."
outcome = SubResource("Resource_i5ayw")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Each visitor pauses at the shore, eyes resting on where the waterline meets the gate.

Some days the water is below the foundation stones, ground peeking through. In rainy months the gate appears to float, the lake rising halfway up the pillars.

Although no one keeps a record, everyone seems aware of where the line was even weeks ago."

[sub_resource type="Resource" id="Resource_6at2x"]
script = ExtResource("3_taq6b")
markedup_text = "The shrine is raised, its roof tiles tied and its gate painted, but the monks murmur uneasily.

\"Faith is not in the wooden beams,\" says one. \"It must be kept alive with action.\"

The day is spent in meditation, attuning to the Enlightened One's presence.

A ritual is needed. A simple act the people should weave into their visits. A way for the shrine to bind the people together."
background_image = SubResource("Resource_5rr0n")
background_credit = ExtResource("6_5xcej")
choices = Array[ExtResource("4_5xrqp")]([SubResource("Resource_d0keq"), SubResource("Resource_mxy6s"), SubResource("Resource_l1gue"), SubResource("Resource_ps5l8")])


[resource]
script = ExtResource("3_krqrv")
name = "Kawashima Shigenobu"
blurb = "Little is known for certain about Kawashima Shigenobu, other than that he was an Edo period artist active during the first half of the 18th century, and that he produced book illustrations and painted scrolls. He may have used the names Ryukado and Itchido, and may have been a pupil of Nishikawa Sukenobu. He allegedly lived in Kyōto, on Kawaramachi street.

His most recognized work is a pair of huge, intricately painted scrolls, [url=art_piece:Pictures of Excursions Through the Famous Sites of the Capital]Pictures of Excursions Through the Famous Sites of the Capital[/url], fragments of which were used as the basis for the Haven in Worlds Upon The Wind (as well as the game's narrative trailer)."
birth_year = 1700
death_year = 1800
custom_date = "mid 18th century"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

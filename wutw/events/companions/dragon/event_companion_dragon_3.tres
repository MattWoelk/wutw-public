[sub_resource type="Resource" id="Resource_w1xlo"]
script = ExtResource("7_rtwii")
markedup_text = "Try to clear the air with bellows."
requirement = SubResource("Resource_473nj")
outcome = SubResource("Resource_hda7r")
markedup_result_text = "The monks return back to the settlement and bring back with them many sets of bellows.

They work for hours pumping the miasma out, but the moment they stop, the cave immediately starts filling back up with bad air.

After a day of attempts, they give up and decide to leave the cave unexplored."

[sub_resource type="Resource" id="Resource_hoe8e"]
script = ExtResource("19_l0uj2")
bonus_type = ExtResource("18_ycv7f")
amount = -15
extra_per_season = -15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_qrom4"]
script = ExtResource("7_rtwii")
markedup_text = "Cleanse the miasma with fire."
outcome = SubResource("Resource_hoe8e")
markedup_result_text = "The monks ignite torches and throw them into the cave.

The results are immediate. A jet of flame erupts from the cave, blowing the hapless monks away.

Thankfully everyone survives, but they wisely conclude that the dragon must not appreciate such forceful attempts to enter its abode."

[sub_resource type="Resource" id="Resource_kq3a0"]
script = ExtResource("7_rtwii")
markedup_text = "Retreat to safety."
markedup_result_text = "The monks leave the cave exploration for another day, hoping that the miasma will have cleared by then."

[sub_resource type="Resource" id="Resource_2ti5x"]
script = ExtResource("4_hvqro")
markedup_text = "The Ember monks come upon what has become a famous sight. A cave entrance carved into the side of the volcano. Such caves have been found on many other shards, and have long been revered as the abodes of dragons.

This particular cave is filled with a foul-smelling miasma."
background_image = SubResource("Resource_hvqro")
background_credit = ExtResource("6_4ijrs")
choices = Array[ExtResource("7_rtwii")]([SubResource("Resource_fhxjv"), SubResource("Resource_w1xlo"), SubResource("Resource_qrom4")])
exit_choice = SubResource("Resource_kq3a0")


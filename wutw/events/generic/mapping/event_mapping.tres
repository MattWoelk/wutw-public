amount = 20
extra_per_season = 40
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("5_7wh20")
markedup_text = "Let each adventurer mark what they remember."
outcome = SubResource("Resource_ciwob")
markedup_result_text = "The map becomes a patchwork of memory: a wrong turn that led to a waterfall, a shortcut that required a rope, a pond that one settler insists is shaped like a bear.

It's not consistent. It's not entirely useful. But it's genuine, in its own way."

[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("3_76fnf")
markedup_text = "The guild is planning its own expedition to map the shard, and compose one grand, official map.

As the explorers look out across the landscape, a debate breaks out.

Some argue the map should be precise, with every river and valley marked. Others say it must highlight fertile lands and safe routes. A few grin and suggest a more thrilling approach: mark the mysteries, the rumored beasts, the unexplained ruins.

A veteran shrugs and says, \"Why not just let everyone draw what they've seen?\""
background_image = SubResource("Resource_qt5cw")
background_credit = ExtResource("5_qt5cw")
choices = Array[ExtResource("5_7wh20")]([SubResource("Resource_2myy3"), SubResource("Resource_3sdrw"), SubResource("Resource_kojkx")])
exit_choice = SubResource("Resource_xh6l0")


province = 55
blurb = "Depicts travelers climbing a steep gradient on a coastal path, one carried in a sedan chair. Mount Fuji is visible across Suruga Bay in the background.

The inscription at the top is a poem about the area by Yamabe no Akahito, a famous 8th-century poet:

[i]In Tago Bay,
if you look in the distance,
on the pure white
peaks of Mount Fuji
the snow continues to fall.[/i]"
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

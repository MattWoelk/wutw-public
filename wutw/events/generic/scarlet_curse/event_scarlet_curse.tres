[sub_resource type="Resource" id="Resource_k0l6w"]
script = ExtResource("5_ffeea")
markedup_text = "Sell the pottery to travelers."
outcome = SubResource("Resource_r53gr")
markedup_result_text = "Unwilling to let his hard work go to waste, the master saves the pottery.

The next time a merchant passes through town, he will sell them cheaply, to at least recover the cost of clay."

[sub_resource type="Resource" id="Resource_st22w"]
script = ExtResource("3_4gktu")
markedup_text = "After a heavy rain, a landslide has exposed a vein of brilliant red stone. The master potter, rubbing it between his fingers, realizes it stains like no paint they have ever used.

He instructs his apprentices to grind the stone and mix it with lacquer. The master uses it to paint intricate designs onto the pots, the dazzling vermilion shining.

Soon the potters develop coughs. They become irritable, and complain of dizziness. The workshop stops using the paint at once, but stacks of red pottery still line every wall."
background_image = SubResource("Resource_11xxq")
background_credit = ExtResource("4_xrkrw")
choices = Array[ExtResource("5_ffeea")]([SubResource("Resource_vrywk"), SubResource("Resource_fupj8"), SubResource("Resource_3ji6r")])
exit_choice = SubResource("Resource_k0l6w")


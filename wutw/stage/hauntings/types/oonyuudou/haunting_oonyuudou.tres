[resource]
script = ExtResource("8_oyis0")
haunting_id = "oonyuudou"
name = "Ōnyūdō"
name_japanese = "大入道"
name_realistic = "Earthquake"
name_translation = "Giant Priests"
description = "Settlers warn of a towering, shadowy priest whose heavy footsteps make the very foundations of the world tremble."
description_realistic = "Regular earthquakes shake the area, disrupting construction and daily life."
description_long = "It begins with tea spilling from cups and tools rattling on workbenches. Soon, the tremors grow stronger. Every time a new beam is raised or a great task is undertaken, the ground shudders violently, throwing workers to their knees.

The elders speak of the Ōnyūdō, the Giant Priests. They say these towering monks appear when a settlement grows too proud, building their homes taller than the ancient trees and forgetting their humility. The giant's massive feet stomp the earth, reminding the settlers that the ground they stand on is not theirs to control."
image_small = ExtResource("5_2epjy")
image_credit = ExtResource("5_246g2")
image_small_realistic = ExtResource("6_yrnpf")
image_realistic_credit = ExtResource("6_2epjy")
base_aspect_types = Array[ExtResource("1_1g10y")]([ExtResource("2_je25i")])
extra_aspect_type = ExtResource("2_je25i")

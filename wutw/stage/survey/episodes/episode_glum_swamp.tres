[sub_resource type="Resource" id="Resource_1ut1l"]
script = ExtResource("2_im846")
label = "Follow the pessimist."
aspects = Array[ExtResource("3_msq25")]([ExtResource("4_af3mt")])
aspects_per_season = Array[ExtResource("3_msq25")]([null])
outcome = SubResource("Resource_g4awi")
outcome_text = "\"I don't expect we'll all arrive in one piece,\" the scout says glumly. Still, he traces the tree's roots and finds a narrow ridge of solid ground beneath the water.

He predicts lost sandals, unfriendly wildlife, and death, but the group follows his lead anyway. The first two predictions come to pass, but the last one does not."


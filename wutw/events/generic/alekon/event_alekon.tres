[sub_resource type="Resource" id="Resource_s4wek"]
script = ExtResource("4_ftbgp")
markedup_text = "The lead artisan of the bureau was commissioned to carve a great statue of the Enlightened One. After a month of work he unveils his masterpiece, to the astonishment of everyone present.

When questioned, the artisan claims that the Enlightened One had appeared to him in a dream in this exact shape, and asked him about the meaning of life."

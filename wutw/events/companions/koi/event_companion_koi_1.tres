[sub_resource type="Resource" id="Resource_nxn41"]
script = ExtResource("10_foms3")
markedup_text = "Cut the bundles apart."
outcome = SubResource("Resource_1xbs5")
markedup_result_text = "An impatient retter takes a large knife and hacks at the bundles, which quickly unravel.

Whatever had gotten caught in the hemp remains a mystery."

[sub_resource type="Resource" id="Resource_tycqh"]

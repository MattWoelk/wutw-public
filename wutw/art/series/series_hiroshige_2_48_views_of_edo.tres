[resource]
script = ExtResource("2_r6n5s")
name = "48 Famous Views of Edo"
blurb = "This series of landscape prints was published when Hiroshige II was in his mid-thirties. At this point, he had just started using the name Hiroshige, since his master, [url=artist:Hiroshige]the original Hiroshige[/url], had just died in 1858.

It contains various landscapes views around Edo (present-day Tōkyō)."
start_year = 1860
end_year = 1860
artist = ExtResource("1_ylg56")
link = "https://www.hiroshigeii.net/series/48Edo.html"

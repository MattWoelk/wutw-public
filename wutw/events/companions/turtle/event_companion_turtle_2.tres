background_credit = ExtResource("5_ubkje")
choices = Array[ExtResource("6_mwanf")]([SubResource("Resource_jqiyx"), SubResource("Resource_8hjpt"), SubResource("Resource_80de1")])
exit_choice = SubResource("Resource_aldqr")


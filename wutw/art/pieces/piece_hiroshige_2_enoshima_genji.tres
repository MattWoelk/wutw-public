[resource]
script = ExtResource("3_jt37u")
original_image = SubResource("Resource_bcsnl")
piece_name = "Enoshima Seen from the Beach"
artist = ExtResource("1_qkot6")
styles = Array[ExtResource("4_sdimc")]([ExtResource("5_jt37u"), ExtResource("6_sdimc")])
actual_start_year = 1860
actual_end_year = 1860
date_type = 1
edits_description = "Only the forest in the background was used."
final_image_tex = SubResource("Resource_jg17w")
province = 57
blurb = "Depicts Mitsuuji (a reimagined, Edo-period version of [url=art_style:genji-e]Prince Genji[/url]) atop an ox being led by a young woman along the Shichirigahama beach in Enoshima (present-day Kanagawa Prefecture). This is an artistic liberty, as the story is technically set around Kyōto, far from Enoshima.

At the time, Enoshima was connected to the mainland at low tide, and it was customary to visit the island on oxen. In reality, children like those seen on the right led the oxen, but in this picture, a fashionable young woman is depicted instead.

Mitsuuji's distinctive ebi-chasen-mage (\"shrimp tea whisk topknot\") hairstyle was popular in Edo-period Genji-related art.

Several museums incorrectly attribute this print to the original Hiroshige."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

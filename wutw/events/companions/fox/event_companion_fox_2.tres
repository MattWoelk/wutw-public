[sub_resource type="Resource" id="Resource_r0oeh"]
script = ExtResource("6_aqgc1")
markedup_text = "Approach the foxes."
requirement = SubResource("Resource_kjam1")
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "The foxes have other ideas. It seems that they consider the humans a danger to their home, so most of them snarl and stand their ground.

As the settlers get closer, though, they scatter. The fox which was pointing is noticeably limping."

[sub_resource type="Resource" id="Resource_aqgc1"]
script = ExtResource("7_08nym")
scope = 1
event_id = "global"
var_id = "companion_fox"
value = "2"
description = "Get a fox to trust humans"
outcome_description = "Some foxes begin to see people as potential allies."
metadata/_custom_type_script = "uid://cgvcpdtoqk4ff"

[sub_resource type="Resource" id="Resource_jiini"]
script = ExtResource("6_aqgc1")
markedup_text = "Stay hidden and observe the foxes."
outcome = SubResource("Resource_aqgc1")
markedup_result_text = "The settlers hide behind the willows, away from the foxes, and observe.

By midnight, most of the foxes depart, but the one who was pointing remains sitting. Soon the reason becomes apparent. There's a large splinter stuck in the fox's front paw, and it is trying to get it out, unsuccessfully.

It's too tired and hurt to run away when one of the settlers approaches, so after a minor struggle, the splinter is removed and the fox hobbles away, presumably grateful."

[sub_resource type="Resource" id="Resource_mm8jc"]
script = ExtResource("4_psxsg")
markedup_text = "Rumors spread about foxes appearing at night by the riverside. Townspeople suspect they have a burrow nearby, but the more interesting rumors claim that these foxes are spirits, guarding the trees.

One night, someone notices a group of foxes gathered under a willow. They seem to be plotting something, and one of them appears to be pointing towards the stream with its paw."
background_image = SubResource("Resource_lkwib")
background_credit = ExtResource("6_8xpy2")
choices = Array[ExtResource("6_aqgc1")]([SubResource("Resource_xh6l0"), SubResource("Resource_2me52"), SubResource("Resource_r0oeh")])
exit_choice = SubResource("Resource_jiini")


[resource]
script = ExtResource("4_qxcg6")
original_image = SubResource("Resource_bcsnl")
piece_name = "Fox Fires on New Year's Night under the Enoki Tree near Ōji"
series = ExtResource("5_3fmyd")
artist = ExtResource("1_5bsg1")
styles = Array[ExtResource("6_xcn1u")]([ExtResource("7_rcmne")])
actual_start_year = 1857
custom_link = "https://www.brooklynmuseum.org/objects/121730"
final_image_tex = SubResource("Resource_1ao0q")
province = 59
blurb = "It was believed that on New Year's Eve all the foxes of the surrounding provinces would gather at a particular tree near Ōji Inari Shrine, the headquarters of the regional cult of the god Inari. There the foxes would put on clothes for a visit to the shrine, where they would be given orders for the coming year. On the way, the animals would emit distinctive flames by which local farmers were able to predict the crops of the coming year."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[resource]
script = ExtResource("3_kel62")
name = "Utagawa Hirokage"
blurb = "Utagawa Hirokage was a printmaker active in the mid-19th century and a notable student of the great landscape master [url=artist:Utagawa Hiroshige]Utagawa Hiroshige[/url].

While he studied the techniques of his mentor, Hirokage is best known for injecting the traditional landscape genre with slapstick humor and comic chaos. Many of his works are affectionate parodies of the famous scenes designed by his teacher.

He is also known as Ichiyūsai Hirokage."
birth_year = 1820
death_year = 1870
custom_date = "mid-19th century"
link = "https://en.wikipedia.org/wiki/Utagawa_Hirokage"
schools = Array[ExtResource("1_2uqb8")]([ExtResource("2_g6tq1")])

[sub_resource type="Resource" id="Resource_80qh6"]
script = ExtResource("2_ocdtd")
label = "Watch closely."
aspects = Array[ExtResource("3_8ka6v")]([ExtResource("4_xtu5e")])
aspects_per_season = Array[ExtResource("3_8ka6v")]([null])
outcome = SubResource("Resource_hw7uc")
outcome_text = "The scouts watch the critter as it stares back at them with an unflinching gaze.

Eventually it gets up and walks away, then looks back at the group as if expecting them to follow.

The tanuki leads them off the path through a narrow passage, which ends in a small cave, safe from the elements.

As they prepare their camp, the tanuki skitters off into the dark."

[sub_resource type="Resource" id="Resource_0ijbd"]
script = ExtResource("10_o6wr6")
delta = 2
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_vjl5j"]
script = ExtResource("2_ocdtd")
label = "Honor the spirit."
aspects = Array[ExtResource("3_8ka6v")]([ExtResource("9_i0ap8")])
aspects_per_season = Array[ExtResource("3_8ka6v")]([null])
outcome = SubResource("Resource_0ijbd")
outcome_text = "The scouts and the tanuki regard each other for a long moment.

Unsure whether it's a simple critter or something stranger, the scouts offer it a deep, long bow.

When they look up, the tanuki is gone."

[sub_resource type="Resource" id="Resource_o5ani"]

[sub_resource type="Resource" id="Resource_2sb8d"]
script = ExtResource("10_r3tsp")
markedup_text = "Chase it away."
outcome = SubResource("Resource_t8nqq")
markedup_result_text = "The farmers wave their arms and shout.

The creature attempts a dignified retreat, immediately foiled by its perfectly round shape. It awkwardly waddles into the brush, bouncing slightly with every step.

A particularly stern farmer, having never seen a tanuki before, demands it be declared an Invasive Alien Species of Shard Concern."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_oye68"]

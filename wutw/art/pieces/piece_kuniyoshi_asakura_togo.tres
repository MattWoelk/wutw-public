final_image_tex = SubResource("Resource_37tk7")
province = 62
blurb = "Depicts the kabuki actor Ichikawa Kodanji IV as the Ghost of Asakura Tōgo.

This play, The Tale of the Martyr of Sakura, was based on a historical event, with the names, locations, and time period changed to elude censorship. It tells the story of Asakura Tōgo, a village leader who travels to Edo to petition the shōgun, which is strictly prohibited. After he is executed together with his family, his ghost takes revenge on the executioner."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

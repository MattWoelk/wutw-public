[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("5_2rw46")
markedup_text = "Carve the odd driftwood into dice."
requirement = SubResource("Resource_kio1v")
outcome = SubResource("Resource_mxy6s")
markedup_result_text = "The wood is waterlogged, yet satisfying to carve.

A pair of dice is finished in no time.

The first roll comes up six. So does the second."

[sub_resource type="Resource" id="Resource_l1gue"]
script = ExtResource("13_pd0fj")
card_type = ExtResource("12_1f35j")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("5_2rw46")
markedup_text = "Throw the pieces back."
outcome = SubResource("Resource_l1gue")
markedup_result_text = "One by one, the tools are cast into the waves.

They float away, but some return later the same day.

Other such tools keep showing up, but few pay them any mind.

Perhaps a ship with a very creative carver on board had sunk into the sea."


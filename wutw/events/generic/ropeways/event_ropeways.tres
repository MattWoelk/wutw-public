[sub_resource type="Resource" id="Resource_ua32x"]
script = ExtResource("5_t3uxx")
markedup_text = "Give the children responsibilities."
requirement = SubResource("Resource_iqxrh")
outcome = SubResource("Resource_hujbs")
markedup_result_text = "Rather than banning the games, the villagers appoint the children as keepers of the ropeways. It becomes their duty to ensure the baskets are available whenever the harvests arrive.

At first the children complain about the responsibility. But soon, they begin competing to see who can move the most loads across the valley each day. The adults and children alike look on with pride at the ingenuity.
"

[sub_resource type="Resource" id="Resource_4spnk"]

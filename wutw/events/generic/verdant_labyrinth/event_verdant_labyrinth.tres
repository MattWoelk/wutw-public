[sub_resource type="Resource" id="Resource_c0th5"]
script = ExtResource("3_br3hg")
event_step_id = "stream_end"
markedup_text = "Following the stream downhill, the settlers eventually reach a point where they can go no farther.

The brook rushes in a waterfall down the side of a cliff. Above, the cliff rises further, towering over the landscape.

In the damp ground surrounding the stream, however, is an abundance of green moss and unfamiliar plants."

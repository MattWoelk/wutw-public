[sub_resource type="Resource" id="Resource_uely5"]
script = ExtResource("5_vbuhp")
markedup_text = "Spread ash over the coals and walk on them."
requirement = SubResource("Resource_e7hfo")
show_condition = SubResource("Resource_pakit")
outcome = SubResource("Resource_b7llu")
markedup_result_text = "One of the expedition members is an initiate in the Ember Order.

She knows the trick the monks are expected to perform, and simply covers the glowing stones with a layer of ash, leaving a safe path for her comrades to follow.

The monks send her off with one of the monastery's relics to spread the teachings."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("5_vbuhp")
markedup_text = "Step away from the coals."
markedup_result_text = "The nun bows.

\"Another time,\" she says."

[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("3_6kim2")
markedup_text = "The path to the Ember Monastery is a long one, and the final approach requires more than just walking.

This last stretch of the path is made of old fossils, glowing with heat.

A solemn nun is standing on one of the glowing stones.

She explains that visitors are invited to steel their resolve and make their own choice for how to traverse this path."
background_image = SubResource("Resource_0ni0u")
background_credit = ExtResource("5_0ni0u")
choices = Array[ExtResource("5_vbuhp")]([SubResource("Resource_tuogj"), SubResource("Resource_dpp3j"), SubResource("Resource_ciwob"), SubResource("Resource_uely5")])
exit_choice = SubResource("Resource_nthfn")


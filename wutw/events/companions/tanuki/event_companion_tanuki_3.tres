[sub_resource type="Resource" id="Resource_vjvrl"]
script = ExtResource("6_7dmo5")
markedup_text = "Adopt it."
requirement = SubResource("Resource_dv1ip")
outcome = SubResource("Resource_nqfme")
markedup_result_text = "The apprentice coaxes the creature inside.

The animal accepts the hospitality, falling asleep by the loom. The moment the sun rises, though, it bolts out the door.

It leaves behind a lingering, musky stench that takes days to dissipate."

[sub_resource type="Resource" id="Resource_bjjns"]

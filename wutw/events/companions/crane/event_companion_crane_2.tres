[sub_resource type="Resource" id="Resource_cdx74"]
script = ExtResource("6_g2ppe")
markedup_text = "Swap the two chicks regularly."
requirement = SubResource("Resource_ripdt")
outcome = SubResource("Resource_87aiy")
markedup_result_text = "The forester sets up a warm, padded basket at the base of the tree. Whenever the parent leaves to forage, she climbs up and swaps the bullied chick for the rested one.

It is exhausting, precarious work, but she prevents the sibling fights, and manages to trick the parent into feeding both chicks equally until they are old enough to fend for themselves."

[sub_resource type="Resource" id="Resource_6uk7q"]

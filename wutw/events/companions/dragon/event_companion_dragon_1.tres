[sub_resource type="Resource" id="Resource_08k3g"]
script = ExtResource("11_rjfon")
markedup_text = "Study the stones, even if it damages them."
requirement = SubResource("Resource_n3vr2")
outcome = SubResource("Resource_uc68o")
markedup_result_text = "The monks study the rocks carefully back at the monastery.

They chip away crusted-on sediment and wipe off the remaining dust with coarse brushes. Finally, they soak them in vinegar and rinse them in water.

Once so cleaned, the shape and luster of the stones become unmistakable. These are clearly the scales of a very large creature. \"Dragonscales,\" the monks declare."


[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("6_aqgc1")
markedup_text = "Send a scouting team in the pointed direction."
requirement = SubResource("Resource_kojkx")
outcome = SubResource("Resource_bxpl3")
markedup_result_text = "The settlers consider the fox's pointing a sign from the Enlightened One.

Early the next morning, a group of settlers gathers bags of rations, crosses the river, and takes off in the pointed direction.

Days later they return empty-handed, having failed to find anything of note."


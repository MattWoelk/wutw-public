metadata/_custom_type_script = "uid://dfaio0ey0wbra"

[sub_resource type="Resource" id="Resource_hqsr2"]
script = ExtResource("10_r3tsp")
markedup_text = "Give it more food."
requirement = SubResource("Resource_vdtlr")
outcome = SubResource("Resource_oye68")
markedup_result_text = "A farmer approaches the tanuki with a handful of grain.

The creature slowly lowers its head, gives a deep sigh, then looks back at the moon.

The farmer retreats, feeling slightly judged."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


[resource]
script = ExtResource("9_jtu6j")
haunting_id = "koto_furunushi"
name = "Koto Furunushi"
name_japanese = "琴古主"
name_realistic = "Melancholy"
name_translation = "Old Koto Masters"
description = "Whispers tell of a koto that plays itself at night, weeping for the songs the world has forgotten."
description_realistic = "A sense of melancholy grips these buildings; joy fades quickly, and even small successes leave the people weary."
description_long = "In the empty halls of this settlement, faint music drifts through the rafters, strings trembling with longing, plucked by no visible hand. Some attribute this to the Koto Furunushi, a spirit possessing an old koto, once beloved, now abandoned.

They say it remembers every song once played upon it, and grieves for every joyful gathering it once entertained. When its melodies echo, hearts grow heavy, and even good fortune feels tinged with sorrow."

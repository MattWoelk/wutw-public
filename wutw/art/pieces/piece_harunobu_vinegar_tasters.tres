[resource]
script = ExtResource("3_gvs5c")
original_image = SubResource("Resource_bcsnl")
piece_name = "Parody of the Three Vinegar Tasters"
artist = ExtResource("1_2auw3")
styles = Array[ExtResource("4_mmkeg")]([ExtResource("5_orxgg"), ExtResource("5_n2p3o")])
actual_start_year = 1765
actual_end_year = 1767
date_type = 1
edits_description = "The background was removed."
final_image_tex = SubResource("Resource_alwh0")
blurb = "Depicts three women around a large jar of vinegar. This is a parody of the famous subject of multiple Chinese paintings [url=https://en.wikipedia.org/wiki/Vinegar_tasters]The Vinegar Tasters[/url], where three men are tasting vinegar and reacting with sour, bitter, and sweet expressions.

It is an allegory, and the identity of the 3 subjects is interpreted in several different ways. The variation relevant in our case is to have them represent Confucius, Buddha, and Laozi, the respective founders of Confucianism, Buddhism, and Taoism. Each man's expression represents the attitude of his philosophy: Confucianism saw life as sour and in need of correction, Buddha saw life as bitter due to desire (arguable), and Laozi saw life as sweet because the natural state is perfection.

Some museums (e.g. MFA Boston) attribute this print to a different artist, Komatsuken, but the version displayed here carries a clear Harunobu signature."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

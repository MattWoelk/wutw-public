[sub_resource type="Resource" id="Resource_sphbv"]
script = ExtResource("4_t2pnp")
markedup_text = "The expedition arrives at the dock, where rows of pale lanterns glow softly in the night. The water below is calm, moonlight dancing on its ripples.

This is the place the Scribe named in his plan, a passage between worlds, a place of [i]Change[/i].

Disciples prepare for the consecration, laying out their implements with practiced care. The air tastes faintly of salt and seaweed."
background_image = SubResource("Resource_1rh3b")
background_credit = ExtResource("6_tyksf")
choices = Array[ExtResource("6_41gjg")]([SubResource("Resource_qynpt"), SubResource("Resource_y5nml"), SubResource("Resource_yyr3p"), SubResource("Resource_63ro7")])


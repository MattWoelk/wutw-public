[sub_resource type="Resource" id="Resource_h3yx7"]
script = ExtResource("10_88a1f")
result_text = "Fearing for the chick's odds of survival, the surveyors decide to return it to the nest.

One of them gently picks up the chick, wraps it in a cloth, and climbs up the tree.

The adult hawk flies off for a moment then swoops down, screeching fiercely.

Sharp talons rip into the scouts robe and send him hurtling to the ground."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


[sub_resource type="Resource" id="Resource_hyaad"]
script = ExtResource("4_t2pnp")
event_step_id = "salt"
markedup_text = "A trail of ash is poured between the lanterns, and a great urn is emptied into the sea.

Some of the ash sinks, but much of it rises, hanging in the air around the dock. Soon a fine mist envelops the lanterns, glowing with borrowed light.

Disciples watch for glyphs in the mist's curls, now appearing, now dissipating. They spend the night meditating on Change and transformation.

\"The air itself was shifting,\" one recalls. \"It let me appreciate the Enlightened One's power to change the very essence of the world.\""
background_image = SubResource("Resource_gbtx2")
background_credit = ExtResource("6_tyksf")
exit_choice = SubResource("Resource_fltmf")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


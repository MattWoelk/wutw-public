[sub_resource type="Resource" id="Resource_q5j0j"]
script = ExtResource("2_jqjvj")
label = "Tell ghost stories instead."
aspects = Array[ExtResource("3_igv2q")]([ExtResource("10_bri4c")])
outcome = SubResource("Resource_a07nq")
outcome_text = "The scouts go around in a circle telling stories of spirits haunting the woods and ghosts coming back to claim revenge. They speak of Lady Chrysanthemum and the Black Monk, of the Two-Mouthed Woman and the Bitter Smile, as well as countless others. Each story is more chilling than the last one, and more than a few of the scouts end up waking up from nightmares that night."


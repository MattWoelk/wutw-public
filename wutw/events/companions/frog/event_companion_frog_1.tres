[sub_resource type="Resource" id="Resource_eyvo4"]
script = ExtResource("9_y5dt8")
markedup_text = "Write a poem about the frog."
requirement = SubResource("Resource_pf411")
outcome = SubResource("Resource_psbho")
markedup_result_text = "The man decides to focus on the amphibian itself, rather than his lost love. He thinks for a moment, then writes:

The river flowing
The willow is still weeping
Missed once again

He chuckles at the pun, inspired by the frog's unbothered cycle. The creature doesn't seem to care that it keeps missing.

He walks home, head filled with puns to incorporate into his future poems."


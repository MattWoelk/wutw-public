[sub_resource type="Resource" id="Resource_hiqpy"]
script = ExtResource("5_66e8j")
markedup_text = "Prop it up with bamboo crutches."
requirement = SubResource("Resource_r2oee")
outcome = SubResource("Resource_i0bdt")
markedup_result_text = "A lattice of bamboo poles is constructed, tucked under the heaviest boughs like crutches.

The tree leans on them, looking like a weary elder supported by dutiful grandchildren.

It is frail, but it lives on to witness years to come."


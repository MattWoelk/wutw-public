outcome = SubResource("Resource_jjak6")
outcome_text = "Exhausted from the steep climb, the surveyors bow before the shrine.

They stand by the red shrine gate for a while, directing their gaze toward the grey mountain in the distance."

[resource]
script = ExtResource("15_1dkb0")
episode_id = "canyon_shrine"
title = "The Canyon Shrine"
spot_types = Array[ExtResource("16_kkmkt")]([ExtResource("17_e1srv")])
text = "As the scouts make their way through a canyon pass, their attention is drawn toward a great grey mountain towering on the horizon.

Admiring its imposing height, they almost miss the bright red shrine gate sitting on the cliff above them.

Beyond the gate stands a stone shrine, its sloped roof covered with moss."
background_image = SubResource("Resource_6c7ct")
background_credit = ExtResource("1_7e5qk")

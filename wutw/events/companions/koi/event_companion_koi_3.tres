[sub_resource type="Resource" id="Resource_ixnmd"]
script = ExtResource("7_q33js")
markedup_text = "Leave the fish to its attempts."
outcome = SubResource("Resource_kjam1")
markedup_result_text = "The settlers don't interfere.

The carp continues its endless struggle."

[sub_resource type="Resource" id="Resource_sst4b"]
script = ExtResource("4_lnsy8")
markedup_text = "Settlers having a picnic by the bottom of the cliff notice a curious scene. A carp has somehow gotten stuck in the little pool at the foot of the waterfall, and is desperately trying to swim up the torrent.

The poor fish keeps jumping out into the falling stream only to plop back down into the water. It swims in a circle for a moment, then repeats its attempt. At one point it somehow ends up on a higher ledge, only to be immediately washed back down."
background_image = SubResource("Resource_lnsy8")
background_credit = ExtResource("6_p0esq")
choices = Array[ExtResource("7_q33js")]([SubResource("Resource_mm8jc"), SubResource("Resource_ymvbb"), SubResource("Resource_f2bue")])
exit_choice = SubResource("Resource_ixnmd")


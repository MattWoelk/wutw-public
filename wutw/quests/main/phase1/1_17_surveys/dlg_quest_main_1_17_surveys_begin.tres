[resource]
script = ExtResource("1_pp2f7")
dialogue_id = "mq_1_17_surveys"
record_title = "Era 一: The Explorer"
text = "PAGE: scribe(STUDIO_PRIMARY), explorer(STUDIO_SECONDARY)
explorer: I heard you're looking for explorers to help on the expeditions.
explorer: Well, here I am at your service!
scribe: You have my gratitude for answering the Enlightened One's call.
scribe: The journey of the faithful shall be arduous.
scribe: We will need skilled scouts to explore these new lands.
explorer: You're in luck!
explorer: That's exactly my specialty!
scribe: What you call luck is but a sign of the divine will.
scribe: Go now, with the Enlightened One's blessing."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

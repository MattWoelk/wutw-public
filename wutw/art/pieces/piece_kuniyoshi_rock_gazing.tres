[resource]
script = ExtResource("4_l5v4q")
original_image = SubResource("Resource_bcsnl")
piece_name = "Gazing at the Rock on Komuro Mountain"
series = ExtResource("5_232mw")
artist = ExtResource("1_xqrwa")
styles = Array[ExtResource("6_g0rnw")]([ExtResource("6_xqrwa")])
actual_start_year = 1831
date_type = 1
custom_link = "https://en.wikipedia.org/wiki/Sketches_of_the_Life_of_the_Great_Priest#7._Gazing_at_the_Rock_on_Komuro_mountain,_on_the_Twenty-eighth_of_the_Fourth_month,_1274"
edits_description = "In one case the warriors were edited out and the piece was cropped. In another case, only the cliff and floating rock were used."
final_image_tex = SubResource("Resource_jgoyx")
province = 56
blurb = "Depicts the priest Nichiren in Komuroyama suspending a large rock thrown at him by a yamabushi, or mountain hermit.

Various versions of this legend exist. In one retelling, the hermit threw a rock at Nichiren, which he was able to suspend in the air by the sheer will of his \"spiritual power\". In another version of the story, a member of a competing Buddhist school invited Nichiren to a contest to see who had the greater religious power to control the levitation of a rock. According to this legend, the man was able to lift the rock but Nichiren prevented him from lowering it. Upon losing the contest, the story goes, the man left his sect and became Nichiren's follower."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

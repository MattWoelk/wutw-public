[resource]
script = ExtResource("8_26odt")
haunting_id = "umibouzu"
name = "Umibōzu"
name_japanese = "海坊主"
name_realistic = "High Waves"
name_translation = "Sea Monks"
description = "Settlers refuse to go near the seashore, terrified of the Umibōzu, a giant shadow that rises from the waves to smash their efforts."
description_realistic = "Unpredictable tides and dangerously high waves are constantly battering the coastline, threatening to wash away any new structures."
description_long = "The sea has grown violently restless, with sudden swells crashing against the shore. Those who work near the water tell frantic stories of a massive, pitch-black figure rising from the sea, its smooth, rounded head blocking out the stars before it brings the waves crashing down.

They call it the Umibōzu, the sea monk. Legends say it is born from the drowned souls of the Old World, a creature of pure resentment that demands the sea remain untamed. It rises to test the courage of the settlers, punishing any attempt to claim the shoreline by overwhelming them with the sea's fury."
image_small = ExtResource("6_epxo1")
image_credit = ExtResource("5_3lgo3")
image_small_realistic = ExtResource("7_udwkr")
image_realistic_credit = ExtResource("6_8wvv2")

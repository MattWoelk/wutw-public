[sub_resource type="Resource" id="Resource_d4ncq"]
script = ExtResource("2_hs4nh")
label = "Confront him."
aspects = Array[ExtResource("3_yj6tt")]([ExtResource("7_7uu2k")])
outcome = SubResource("Resource_x4xkc")
outcome_text = "The group forms a circle around the downcast man.

A few scouts demand to know why he keeps such a slow pace. Embarrassed, the man apologizes and rejoins the group.

The next morning, they find his mat empty. After calling for him for hours, they realize that he isn't returning."


[sub_resource type="Resource" id="Resource_xtehq"]
script = ExtResource("6_ml7uw")
markedup_text = "Start wrestling too."
outcome = SubResource("Resource_bukou")
markedup_result_text = "Deciding to join in on the fun, two young settlers drop to the grass and begin their own exaggerated, comical wrestling match.

The onlookers burst into laughter, distracting the monkeys, who are instantly interested and promptly sit down to join the audience in watching the show."

[sub_resource type="Resource" id="Resource_n2qfj"]
script = ExtResource("4_avpef")
markedup_text = "Several settlers are enjoying a picnic on the riverbank under the blooming cherry trees.

The peaceful atmosphere is abruptly interrupted when two monkeys tumble out of the bushes, locked in a wrestling match.

They roll around on the petals, tugging at each other's ears and kicking up dirt right next to the picnic blankets."
background_image = SubResource("Resource_5utsc")
background_credit = ExtResource("5_fkwdt")
choices = Array[ExtResource("6_ml7uw")]([SubResource("Resource_lpbr2"), SubResource("Resource_8uymi"), SubResource("Resource_c82u7")])
exit_choice = SubResource("Resource_xtehq")


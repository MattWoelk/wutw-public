[sub_resource type="Resource" id="Resource_s3q1v"]
script = ExtResource("6_priba")
markedup_text = "Give the traveler nori scraps."
requirement = SubResource("Resource_x2gv5")
outcome = SubResource("Resource_cmcip")
markedup_result_text = "The settlers give the travelers torn scraps of the seaweed, their intact sheets too valuable to waste on a beggar's soup.

The traveler sips the broth and suggests that it needs a bit of earthiness. The settlers, now curious, hand over a withered carrot.

\"Almost there,\" the traveler reassures them. \"Just needs a drop of soy sauce to reach perfection.\"

By the time the chef is finished, the soup is flavored with miso, full of mushrooms and tofu, and has a mound of scallions on top."


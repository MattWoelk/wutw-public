[sub_resource type="Resource" id="Resource_bmlkn"]
script = ExtResource("5_64d7v")
markedup_text = "Move the quarry."
requirement = SubResource("Resource_tf8vh")
outcome = SubResource("Resource_n54ep")
markedup_result_text = "The settlers convince the quarriers to move their work to the other side of the hill, away from the settlement.

It takes a while to set up the new worksite, but the noise complaints dwindle and no more accidents occur."


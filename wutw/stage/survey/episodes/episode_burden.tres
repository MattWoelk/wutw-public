[resource]
script = ExtResource("14_vda1f")
episode_id = "burden"
title = "The Heavy Burden"
biome_types = Array[int]([5, 6])
text = "One of the surveyors is lagging behind, having filled two large boxes with extra rations and first aid supplies to deal with every possible eventuality.

The rest of the team is growing impatient, demanding that their slow teammate leave some of his load behind."

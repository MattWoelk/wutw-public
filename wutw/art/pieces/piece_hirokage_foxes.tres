[resource]
script = ExtResource("4_xjjcv")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Fox Fires of Ōji"
series = ExtResource("5_1lpo6")
artist = ExtResource("1_4sbhy")
styles = Array[ExtResource("6_gcdtp")]([ExtResource("7_26ln7"), ExtResource("7_4sbhy")])
actual_start_year = 1860
actual_end_year = 1861
date_type = 1
edits_description = "The foxes in the foreground and the fox-fires were edited out."
final_image_tex = SubResource("Resource_kvbbx")
province = 59
blurb = "Depicts fox spirits acting out a comical version of a daimyō's (feudal lord's) procession. They are carrying pumpkin instead of travelling bags and holding a bamboo stick with hanging corn instead of a spear. The man sitting in a bamboo basket seems to be delighted, bewitched by the foxes to feel as if he were a feudal lord. The place is near the Ōji Inari Shrine. It was said that foxes gathered to the Shrine on New Year's Eve, and farmers forecasted next year's harvest by the number of fox fires they saw."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

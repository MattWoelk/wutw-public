[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("11_42s7m")
result_text = "The cauldron lets out a faint screech, the liquid turning a dull gray.

\"I suppose it's one of those blooms that don't like crystals. You never know with these things,\" the alchemist sighs.

As the settlers walk away, they can't help but notice the swamp grasses dying beneath their feet."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


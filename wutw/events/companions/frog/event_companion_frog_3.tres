[sub_resource type="Resource" id="Resource_jsi1l"]
script = ExtResource("6_1rdcd")
markedup_text = "Rescue the remaining tadpoles."
requirement = SubResource("Resource_qqhu1")
outcome = SubResource("Resource_18sub")
markedup_result_text = "Horrified by the cannibalism, a few settlers scoop up the living tadpoles into a bucket and relocate them to a pond on the other side of the path.

It makes them feel good to have rescued the helpless victims."

[sub_resource type="Resource" id="Resource_8nriu"]

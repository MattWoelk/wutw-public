aspect_type = ExtResource("20_o1e56")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_gsuf0"]
script = ExtResource("11_rjfon")
markedup_text = "Make the stones into rosaries."
requirement = SubResource("Resource_afk41")
outcome = SubResource("Resource_eyvok")
markedup_result_text = "The stones are cleaned and polished smooth. Holes are drilled into them, and the resulting beads are strung onto strings, which the monks who had explored the cave now carry.

Visitors to the monastery often comment on the beauty of the rosaries, which are unlike anything seen anywhere else on the shard."

[sub_resource type="Resource" id="Resource_3mmkv"]
script = ExtResource("11_rjfon")
markedup_text = "Leave the stones in the cave."
markedup_result_text = "The monks leave the stones in the cave and start their trek back down the slopes."

[sub_resource type="Resource" id="Resource_7gc00"]
script = ExtResource("8_333rd")
markedup_text = "A few of the monks from the Ember Monastery opt for the long trek up the mountain to visit this cave, located just below the tip of the volcano.

The cave is too hot to get very far in, but they do come upon a curious find: flat stones that shine with an iridescent gleam in the torchlight."
background_image = SubResource("Resource_6t2xa")
background_credit = ExtResource("10_uc68o")
choices = Array[ExtResource("11_rjfon")]([SubResource("Resource_84ssb"), SubResource("Resource_08k3g"), SubResource("Resource_gsuf0")])
exit_choice = SubResource("Resource_3mmkv")


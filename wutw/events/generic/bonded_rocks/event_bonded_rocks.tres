[sub_resource type="Resource" id="Resource_o4a42"]
script = ExtResource("3_o8lj8")
markedup_text = "Soon after the great rocks were tied with a rope and declared to be a married couple, some settlers began to complain.

Since the rocks are unequal in size, they say, they represent an unequal relationship.

Several people volunteer to resolve the problem."

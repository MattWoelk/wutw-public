[resource]
script = ExtResource("5_ysne5")
name = "Worlds Upon The Wind Title Screen"
main = ExtResource("7_mb5eq")
additional = Array[ExtResource("1_xqycn")]([ExtResource("2_2d276"), ExtResource("3_ysne5"), ExtResource("4_q3mwx"), ExtResource("5_j3dfd")])
final_image_tex = SubResource("Resource_ysne5")
blurb = "The game's title screen is composed from 5 different ukiyo-e prints:
[ul]
The framing window where the cat is sitting is based on [url=artist:Hiroshige]Hiroshige[/url]'s [url=art_piece:Asakusa Ricefields and Torinomachi Festival]Asakusa Ricefields and Torinomachi Festival[/url].
The teahouse on the left is from [url=artist:Hiroshige]Hiroshige[/url]'s [url=art_piece:Fuji-view Teahouse at Zōshigaya]Fuji-view Teahouse at Zōshigaya[/url].
The temple hall on the right is from [url=artist:Hiroshige]Hiroshige[/url]'s [url=art_piece:The Kiyomizu Hall and Shinobazu Pond at Ueno]The Kiyomizu Hall and Shinobazu Pond at Ueno[/url].
The clouds are based on [url=artist:Katsushika Hokusai]Hokusai[/url]'s famous [url=art_piece:Fine Wind, Clear Morning]Red Fuji[/url].
Finally, the sky and the floating shards are based on [url=art_piece:Production of Bogwood Carvings in Matsushima]Production of Bogwood Carvings in Matsushima[/url] by [url=artist:Hiroshige III]Hiroshige III[/url].
[/ul]"
metadata/_custom_type_script = "uid://dej4hwyskx43"

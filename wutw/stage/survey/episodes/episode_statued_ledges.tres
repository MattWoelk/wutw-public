label = "Send a scout to secure a rope."
aspects = Array[ExtResource("3_csoou")]([ExtResource("10_3oybk")])
aspects_per_season = Array[ExtResource("3_csoou")]([null])
outcome = SubResource("Resource_x008f")
outcome_text = "To minimize the chance of damaging the statues, the team sends only one person up, equipped with a long rope.

Once at the top, she ties the rope to a boulder and dangles it down, letting the rest of the team climb up safely."


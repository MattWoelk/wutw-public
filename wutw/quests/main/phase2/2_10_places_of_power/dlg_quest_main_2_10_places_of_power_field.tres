script = ExtResource("1_mhkkq")
dialogue_id = "mq_2_10_field"
record_title = "Era 二: Places of Power: Endless Blossoms"
text = "PAGE: scribe(NONE)
scribe: I can feel the power of this place.
scribe: The essence of eternal spring flowing from the earth.
scribe: Yes... This is no accident. The wind, the scent... Everything follows an auspicious pattern. I feel the glyphs resonating.
scribe: We must capture the Stability essence of this place. Stability is what will bind the shards together."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

[sub_resource type="Resource" id="Resource_7w45d"]
script = ExtResource("3_br3hg")
event_step_id = "crow_house"
markedup_text = "Following the harsh cawing of crows, the settlers wander deeper into the forest. The birds soon approach them, flying from branch to branch and pausing every few minutes to observe.

Before long, the path opens up to reveal a tiny house on top of a little hill. A single crow perches on the weathered orange roof.

Inside, under layers of dust and leaves, they find a trapdoor.

They pull and tug, but it doesn't budge."
background_image = SubResource("Resource_q837o")
background_credit = ExtResource("17_l5xmn")
exit_choice = SubResource("Resource_kd355")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


script = ExtResource("4_1ynsi")
shop_id = "connect_settlements"
title = "Post Road"
intro = "A paved road stretches from the settlement and disappears into the horizon. Painted markers guide travelers between shaded milestones. Each new connection includes distant places into the communal network."
action_description = "Cut through natural paths to establish travel routes."
action_button_label = "Create Connection"
tooltip = "A paved road stretches from the settlement and disappears into the horizon. Painted markers guide travelers between shaded milestones. Each new connection includes distant places into the communal network.

Here you can <term_lower:connect_settlement> <term:settlement>s to the <term:capital> freely if a given amount of <term:bonus.harmony> has been reached on the shard.

[i]“A road connects markets and spirits alike.”[/i]"

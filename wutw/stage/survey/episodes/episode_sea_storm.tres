[resource]
script = ExtResource("14_c2nhi")
episode_id = "sea_storm"
title = "The Stormy Sea"
biome_types = Array[int]([1, 10])
requirement = SubResource("Resource_dcpb5")
text = "The survey team is camping by the seashore when they are woken up by a fierce gale.

It howls, ripping through their tents and blowing out their fire. The nearby pines groan as huge waves crash against the rocks."
background_image = SubResource("Resource_g5iqo")
background_credit = ExtResource("1_vmpkk")
choices = Array[ExtResource("2_vmpkk")]([SubResource("Resource_gfx4s"), SubResource("Resource_35xva"), SubResource("Resource_55ro1"), SubResource("Resource_k703e")])

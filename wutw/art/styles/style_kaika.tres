[resource]
script = ExtResource("1_b45p4")
name = "Kaika-e"
blurb = "Literally \"enlightenment picture\", this style arose during the Meiji era and focuses on illustrating the modernization and Westernization of Japanese society in the wake of the fall of the Tokugawa shogunate during the Meiji Restoration. The subjects of these prints include new architecture, changes in clothing and hair fashion, new modes of transport like steam locomotives, and new industrial practices."
start_year = 1868
end_year = 1912
link = "https://en.wikipedia.org/wiki/Kaika-e"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

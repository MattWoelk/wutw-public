[resource]
script = ExtResource("3_4vmtg")
name = "Katsukawa Shunshō"
blurb = "Katsukawa Shunshō was a painter and printmaker. During his lifetime he was the leading artist of the [url=art_school:Katsukawa school]Katsukawa school[/url]. He studied under the school's founder Miyagawa Shunsui, and among his pupils counted [url=artist:Katsushika Hokusai]Katsushika Hokusai[/url].

Shunshō is best known for introducing a new form of [url=art_style:yakusha-e]yakusha-e[/url], which depicted large, portrait-style heads and the insides of actors' dressing rooms. He was also one of the first to pioneer realistic depictions of actors; in Shunshō's prints, unlike in the works of the [url=art_school:Torii school]Torii school[/url], it was possible to distinguish not only the role, but also the actor portraying it."
birth_year = 1726
death_year = 1793
link = "https://en.wikipedia.org/wiki/Katsukawa_Shunsh%C5%8D"
schools = Array[ExtResource("1_cx6if")]([ExtResource("2_cx6if")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_5v4vr"]
script = ExtResource("2_7e5qk")
label = "Investigate surroundings."
aspects = Array[ExtResource("3_bd3k0")]([ExtResource("9_8h5b3")])
aspects_per_season = Array[ExtResource("3_bd3k0")]([null])
outcome = SubResource("Resource_r7eoy")
outcome_text = "Eager to explore, a scout walks beyond the shrine, his foot stepping on a pinecone with a loud crunch.

A boar suddenly appears from behind the trees and lowers its head, preparing to charge. The surveyors flee, hurriedly scrambling down the canyon wall."


[sub_resource type="Resource" id="Resource_bcijt"]
script = ExtResource("6_ec7aj")
markedup_text = "Follow the dog outside."
requirement = SubResource("Resource_3y5bi")
outcome = SubResource("Resource_sdqv8")
markedup_result_text = "The chairman decides to trust the animal's sudden urgency over his own common sense.

He lets the dog drag him out of the building, just as the ground starts shaking.

They watch from a safe distance as the roof of the hall buckles and promptly caves in."


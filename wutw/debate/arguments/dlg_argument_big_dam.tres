[ext_resource type="Script" uid="uid://jtkfcsyiryo4" path="res://dialogue/dialogue.gd" id="1_baucu"]

[resource]
script = ExtResource("1_baucu")
dialogue_id = "debate_big_dam"
record_title = "Debate Speech: The Ancient Aqueducts"
text = "PAGE: scribe(PORTAL_NETWORK), AUDIENCE
scribe: The Explorer recently brought to me an architectural draft, unearthed from the foundation of a newly settled city.
scribe: It depicts a sprawling network of aqueducts, so massive it rivals in size our greatest shards.
scribe: Our friend marveled at the sheer impossibility of its construction, and rightly so.
scribe: No single shard today could ever muster the resources or the coordination required for such a monumental endeavor.
scribe: In the days before the Shattering, our ancestors achieved the impossible because they moved as one body, uplifted by a unified vision.
scribe: Today, we celebrate our fragmentation as a triumph of independence.
scribe: Each local council acts as its own sovereign, every individual striving towards their personal glory.
scribe: Yet when each of us demands to be the hero of their own story, no one remains to follow a greater cause, and our collective strength is scattered to the winds.
scribe: We content ourselves with small victories, acting like the frog in a well who mocks the vast ocean for being too large for comfort.
scribe: What hope do we have of achieving lasting greatness if we refuse to lift a shared burden?
scribe: The Enlightened One reborn offers us a banner under which to unite, free from the folly of our pride.
scribe: Together, we can once again raise wonders that will elevate all of humanity."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

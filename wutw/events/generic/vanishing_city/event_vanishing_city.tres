[sub_resource type="Resource" id="Resource_24v2b"]
script = ExtResource("9_fpfn6")
markedup_text = "Insert the patterned tile."
requirement = SubResource("Resource_ic1jr")
markedup_result_text = "The settlers remove layers of sand to access the gate's navigation mechanism and insert the tile into the tablet slot. It fits snugly, and the image within the gate slowly stabilizes."
result_event_step_id = "courtyard"
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_emj5y"]
script = ExtResource("9_fpfn6")
markedup_text = "Leave the gate alone."
markedup_result_text = "The expedition moves on, looking back now and then at the glimpses of white spires that can occasionally be seen through the gate."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_aj7eb"]
script = ExtResource("2_jmo1r")
markedup_text = "Recent studies of Mirage Gates suggest that although they usually lead to strange, alien worlds, it is possible to control the destination.

It appears that an underground control mechanism can be activated by the insertion of specific stone tablets."
background_image = SubResource("Resource_tyeds")
background_credit = ExtResource("8_4n0ji")
choices = Array[ExtResource("9_fpfn6")]([SubResource("Resource_24v2b")])
exit_choice = SubResource("Resource_emj5y")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


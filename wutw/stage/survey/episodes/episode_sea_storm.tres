[sub_resource type="Resource" id="Resource_k703e"]
script = ExtResource("2_vmpkk")
label = "Wait it out."
aspects = Array[ExtResource("3_j5utr")]([null])
outcome = SubResource("Resource_js0r0")
outcome_text = "The scouts stay in their tents and wait out the storm. They pray to the Enlightened One, yet the wind continues to rage.

A wave tears one tent from its stakes, and carries away their packs.

Another fells a tree, which lands next to the scouts, its sharp branches scratching several of them.

By morning, they are hurt, soaked, and shivering, but grateful to have survived."


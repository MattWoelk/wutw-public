[resource]
script = ExtResource("3_tw17e")
name = "Utagawa Hiroshige II"
blurb = "Utagawa Hiroshige II was a prominent printmaker who studied under [url=artist:Utagawa Hiroshige]the original Hiroshige[/url], eventually marrying his teacher's daughter, inheriting the name, and continuing his legacy in landscape art.

He was so adept at mirroring Hiroshige's style that he was trusted to complete some of the final works of his predecessor, and early scholars frequently confused their designs.

Later in his career, he moved to the port city of Yokohama and became an early pioneer of [url=art_style:Yokohama-e]Yokohama-e[/url], a genre documenting the influx of foreign cultures, modern architecture, and international trade that marked the opening of Japan."
birth_year = 1826
death_year = 1869
link = "https://en.wikipedia.org/wiki/Hiroshige_II"
schools = Array[ExtResource("1_xiesp")]([ExtResource("2_h0ndc")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

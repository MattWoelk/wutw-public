[sub_resource type="Resource" id="Resource_xchr4"]
script = ExtResource("5_34fwk")
markedup_text = "Let them graze."
outcome = SubResource("Resource_fwn8o")
markedup_result_text = "The settlers leave the horses alone and watch the destruction.

Soon, only stems remain of the wildflowers, and the meadow turns into a muddy trampled mess.

But the horses are clearly content with their full bellies, and leave behind... fertilizer."

[sub_resource type="Resource" id="Resource_rca3r"]
script = ExtResource("3_pe04q")
markedup_text = "A herd of wild horses has descended upon the meadow.

Perhaps their ancestors were once beasts of burden, but little of that docility remains. They are currently treating the magnificent blooms with the same respect as one accords common weeds.

\"They're ruining the view,\" a settler grumbles, watching a particularly chubby pony chew on a bellflower. \"And besides, we could put these beasts to good use.\""
background_image = SubResource("Resource_svg4y")
background_credit = ExtResource("5_svg4y")
choices = Array[ExtResource("5_34fwk")]([SubResource("Resource_rksgb"), SubResource("Resource_xl33w"), SubResource("Resource_ionoq"), SubResource("Resource_trtbi")])
exit_choice = SubResource("Resource_xchr4")


[resource]
script = ExtResource("4_rkynx")
name = "Toyohara Kunichika"
portrait = SubResource("Resource_eg25s")
blurb = "Toyohara Kunichika was an ukiyo-e artist, primarily known for his [url=art_style:yakusha-e]yakusha-e[/url] prints.

He became an apprentice of [url=artist:Utagawa Kunisada]Utagawa Kunisada[/url] at 13 years old, and later counted [url=artist:Toyohara Chikanobu]Toyohara Chikanobu[/url] among his pupils.

Kunichika led a colorful life, frequently partying at the pleasure district and even appearing in burlesque shows. At one point he published a parody print depicting a fight at a theater, for which the subjects ransacked his house. After the death of his daughter, his alcoholism intensified and likely led to his death."
birth_year = 1835
death_year = 1900
link = "https://en.wikipedia.org/wiki/Toyohara_Kunichika"
schools = Array[ExtResource("2_yrynn")]([ExtResource("3_v33kb")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

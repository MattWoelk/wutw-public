piece_name = "The Great Wave Off Kanagawa"
series = ExtResource("4_vck1g")
artist = ExtResource("1_eooty")
styles = Array[ExtResource("5_0huju")]([ExtResource("6_gryo3"), ExtResource("7_k1mdm")])
actual_start_year = 1831
custom_link = "https://en.wikipedia.org/wiki/The_Great_Wave_off_Kanagawa"
final_image_tex = SubResource("Resource_j3pau")
province = 59
blurb = "The print depicts three boats moving through a storm-tossed sea, with a large, cresting wave forming a spiral in the center over the boats and Mount Fuji in the background. The people are shown as tiny figures compared to the might of the sea.

The print is Hokusai's best-known work and likely the most famous artwork in Japanese history. Some sources claim it to be the most reproduced image in the history of all art."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

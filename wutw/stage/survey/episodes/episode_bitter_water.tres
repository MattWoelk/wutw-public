[sub_resource type="Resource" id="Resource_vwxq6"]
script = ExtResource("2_tfini")
label = "Search upstream."
aspects = Array[ExtResource("3_pcrjt")]([null, null])
aspects_per_season = Array[ExtResource("3_pcrjt")]([null])
outcome = SubResource("Resource_yl2kl")
outcome_text = "A small party walks towards the stream's source.

They discover a mineral spring gushing from pale rock into the main water source.

They confirm it to be the source of bitterness and mark the point on their map."

[resource]
script = ExtResource("11_wvp8y")
episode_id = "bitter_water"
title = "The Bitter Water"
text = "The scouts have been rationing water for days. They finally reach a stream so clear that every stone beneath the water is visible.

Three thirsty travelers rush ahead of the group and, dipping their vessels into the flowing water, take a drink.

They immediately spit it out. The water is unbearably bitter.

Some suspect that the stream has been cursed by spirits. Others worry it was contaminated upstream."
background_image = SubResource("Resource_t6sns")
background_credit = ExtResource("1_tfini")
choices = Array[ExtResource("2_tfini")]([SubResource("Resource_sdk2y"), SubResource("Resource_kwg8t"), SubResource("Resource_l3j8l"), SubResource("Resource_vwxq6")])

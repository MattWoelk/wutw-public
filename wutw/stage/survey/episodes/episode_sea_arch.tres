[sub_resource type="Resource" id="Resource_831j0"]
script = ExtResource("2_ryrc3")
label = "Use rope."
aspects = Array[ExtResource("3_r7eoy")]([ExtResource("4_j4s6g")])
aspects_per_season = Array[ExtResource("3_r7eoy")]([null])
outcome = SubResource("Resource_d1arc")
outcome_text = "The whole group works together, tying a long rope into knots, and throwing it up to the stranded scout.

He ties the rope around his waist, secures it to a large boulder, then uses the knots as footholds to descend safely."


metadata/_custom_type_script = "uid://dadces6knf8fj"

[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("7_54fbb")
markedup_text = "It is a rowing song."
outcome = SubResource("Resource_8mfyw")
markedup_result_text = "The retired sailor starts tapping his foot, and soon scholars are common folk alike are clapping along to the thunderous beat.

The rhythm is relentless, driving, and incredibly catchy. The expedition adopts the beat for their labor, finding that they can handle more work when everyone is moving in perfect sync."

[sub_resource type="Resource" id="Resource_40rqf"]

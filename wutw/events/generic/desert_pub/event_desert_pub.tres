[sub_resource type="Resource" id="Resource_pdn6x"]
script = ExtResource("6_rrpys")
markedup_text = "Let the storyteller continue."
requirement = SubResource("Resource_oiyam")
outcome = SubResource("Resource_kojkx")
markedup_result_text = "Most of the patrons are too deep in their cups, but the innkeeper keeps her ears open.

She lets the storyteller speak until his cup drops from his hand, writing down every word she can remember of his tale."

[sub_resource type="Resource" id="Resource_xh6l0"]

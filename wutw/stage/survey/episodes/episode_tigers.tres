[sub_resource type="Resource" id="Resource_n75vl"]
script = ExtResource("2_f3eko")
label = "Run away."
aspects = Array[ExtResource("3_s7p5p")]([null, null])
outcome = SubResource("Resource_atoiu")
outcome_text = "Panicked, the scouts run, all scattering in different directions.

The tigress immediately pursues the slowest moving surveyor. 

He ends up injured, but is rescued when the rest of the scouts fling stones to scare the tigers away."

[resource]
script = ExtResource("12_4v7hc")
episode_id = "tigers"
title = "The Tigers"
biome_types = Array[int]([5, 8, 4, 9, 6])
text = "The scouts begin to notice an unusual silence in the air. The birds and insects have suddenly grown quiet.

As they press forward, a tigress emerges through the tall grass with three nearly-grown cubs behind her. She growls, watching the surveyors intently."
background_image = SubResource("Resource_6rma8")
background_credit = ExtResource("1_f3eko")
choices = Array[ExtResource("2_f3eko")]([SubResource("Resource_o56kg"), SubResource("Resource_iv1vl"), SubResource("Resource_jqltq"), SubResource("Resource_n75vl")])

[resource]
script = ExtResource("3_cmkc1")
name = "Torii Kiyonaga"
blurb = "Torii Kiyonaga was a master printmaker active in the 18th century. Although not biologically related to the Torii family, he was adopted and eventually became the head of the [url=art_school:Torii School]Torii school[/url].

While his school had traditionally focused on producing promotional materials and signboards for the kabuki theater, Kiyonaga expanded his focus and achieved his greatest acclaim in the genre of [url=art_style:bijin-ga]bijin-ga[/url], or pictures of beautiful women. He is known for depicting tall, more mature women than his predecessor Harunobu, whose prints often depict women who seem younger and thinner."
birth_year = 1752
death_year = 1815
link = "https://en.wikipedia.org/wiki/Torii_Kiyonaga"
schools = Array[ExtResource("2_c3k26")]([ExtResource("2_mwvo8")])

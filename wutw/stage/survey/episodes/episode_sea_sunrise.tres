[sub_resource type="Resource" id="Resource_kksl2"]
script = ExtResource("2_83645")
label = "Climb the rocks."
aspects = Array[ExtResource("3_uogi3")]([ExtResource("10_r05vt")])
aspects_per_season = Array[ExtResource("3_uogi3")]([null])
outcome = SubResource("Resource_uq2rn")
outcome_text = "A few of the scouts venture out onto the rocks. It is a dangerous climb, but the view from above is magnificent, revealing a honeycomb of tide pools, teeming with sea life."

[sub_resource type="Resource" id="Resource_tawna"]
script = ExtResource("2_83645")
label = "Move on."
aspects = Array[ExtResource("3_uogi3")]([null])
aspects_per_season = Array[ExtResource("3_uogi3")]([null])
outcome_text = "The group decides to continue along their route without stopping."


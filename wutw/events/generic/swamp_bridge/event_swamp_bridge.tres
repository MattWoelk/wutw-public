[sub_resource type="Resource" id="Resource_qdolg"]
script = ExtResource("5_r38fd")
markedup_text = "Repair the bridge alone."
requirement = SubResource("Resource_3tb14")
outcome = SubResource("Resource_nobrr")
markedup_result_text = "Eager to deliver his letter and certain that few people come this way, the young confectioner sets out to repair the bridge himself. 

He puts his basket down and gathers spare bamboo. Halfway through his repair attempt, his knee bumps his basket and it tips over, spilling the contents into the muddy water.

He watches in dismay as the carefully wrapped poem is swallowed up by the mud."

[sub_resource type="Resource" id="Resource_q6yhn"]
script = ExtResource("11_3lq6i")
card_type = ExtResource("10_teali")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_va2x4"]
script = ExtResource("13_l6ckw")
bonus_type = ExtResource("12_db158")
min_count = 10
max_count = -1
extra_per_season = 10

[sub_resource type="Resource" id="Resource_q4swg"]
script = ExtResource("5_r38fd")
markedup_text = "Recruit help."
requirement = SubResource("Resource_va2x4")
outcome = SubResource("Resource_q6yhn")
markedup_result_text = "Reluctant to put his meager building skills to the test, the confectioner looks around for help. 

He finds a basket weaver, who hurries over and assesses the damage, her hand on her chin.

She calls over her friend, who recounts in detail the last time the bridge collapsed.

The friend calls his brother, who agrees that collapsing bridges are certainly a problem.

The bridge remains unrepaired."


[sub_resource type="Resource" id="Resource_kcu4g"]
script = ExtResource("2_mxp1c")
label = "Clear the dust."
aspects = Array[ExtResource("3_cgir6")]([null])
aspects_per_season = Array[ExtResource("3_cgir6")]([null])
outcome = SubResource("Resource_pmxvo")
outcome_text = "The scouts decide to pay their respects to the old ruins.

They use sticks and leaves to fashion brooms, and sweep the dust off the steps, walls, and ornaments, before leaving the fort in peace."

[resource]
script = ExtResource("16_sbuuu")
episode_id = "snowy_castle"
title = "The Highland Fort"
biome_types = Array[int]([7])
text = "An unexpected sight appears before the scouts one morning. An old fort stands at a snowy peak, its broad eaves laden with a thick covering of snow.

Inside the lavish veranda hang little golden ornaments, their luster hidden by a thick layer of dust.

Stairs lead to a second level, where a heavy sword rests on a raised pedestal, a large blue gemstone embedded in its hilt."
background_image = SubResource("Resource_2c88x")
background_credit = ExtResource("1_mxp1c")
choices = Array[ExtResource("2_mxp1c")]([SubResource("Resource_q4vs1"), SubResource("Resource_6bxub"), SubResource("Resource_u4cwo"), SubResource("Resource_kcu4g")])

[resource]
script = ExtResource("3_sm6wb")
name = "Utagawa Sadahide"
blurb = "Utagawa Sadahide was a member of the [url=art_school:Utagawa School]Utagawa school[/url] best known for his [url=art_style:Yokohama-e]Yokohama-e[/url] prints, pictures of foreigners in Yokohama in the 1860s, a period when he was a best-selling artist. His work was chosen by the Tokugawa shogunate's delegation to be displayed at the International Exposition of 1867 in Paris.

His earlier works included [url=art_style:bijin-ga]bijin-ga[/url] and [url=art_style:musha-e]musha-e[/url] prints, as well as book illustrations, maps, and depictions of Ainu people, an ethnic minority inhabiting Northern Japan."
birth_year = 1807
death_year = 1878
link = "https://en.wikipedia.org/wiki/Sadahide"
schools = Array[ExtResource("1_yl6l3")]([ExtResource("2_li3ux")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

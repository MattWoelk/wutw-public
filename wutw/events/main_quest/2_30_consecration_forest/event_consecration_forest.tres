[sub_resource type="Resource" id="Resource_hyaad"]
script = ExtResource("4_utf66")
event_step_id = "salt"
markedup_text = "The disciples boil herbs in salty sea water, filling pots inscribed with glyphs of life and purity. They pour the water slowly, neatly following along the forest's vein. Steam rises where the water falls, spreading into the air in ghostly ribbons.

The trees appear unscathed, but by the next morning, the moss carpeting the forest floor darkens, curling into a slimy, brown sludge.

\"The impurities are purged,\" the disciples declare. \"The life force now flows pure and concentrated, no longer sapped by lesser growth.\""
background_image = SubResource("Resource_hcqv8")
background_credit = ExtResource("6_50hmy")
exit_choice = SubResource("Resource_fltmf")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


markedup_text = "Hang the unfinished tapestry as it is."
outcome = SubResource("Resource_2myy3")
markedup_result_text = "The apprentice cuts her project short, leaving the tapestry with a simple indigo pattern.

It hangs by the entrance now. Perhaps it is a reminder of dreams postponed, or of waste prevented."

[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("3_oy33g")
markedup_text = "The dyes from this workshop come out richer than any the locals have seen before.

Inspired by them, a young apprentice wants to turn her humble tapestry project into a masterpiece, a great landscape depicting the whole lake and its surroundings, deep blue giving way to warm tans and lively greens, dotted with bright splashes of pink.

Her mentor advocates restraint, as cloth and dyes are both precious."
background_image = SubResource("Resource_dyr5f")
background_credit = ExtResource("5_dyr5f")
choices = Array[ExtResource("5_g30xk")]([SubResource("Resource_3sdrw"), SubResource("Resource_kojkx"), SubResource("Resource_6bya0")])
exit_choice = SubResource("Resource_xh6l0")


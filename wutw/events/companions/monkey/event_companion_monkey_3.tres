[sub_resource type="Resource" id="Resource_lpbr2"]
script = ExtResource("6_ml7uw")
markedup_text = "Break up the fight."
requirement = SubResource("Resource_eqj0l")
outcome = SubResource("Resource_u8fp7")
markedup_result_text = "A stern settler steps forward and tries to pull the animals apart.

The monkeys immediately stop fighting each other, and turn their attention to the human instead.

The settler spends the rest of the picnic running up and down the riverbank, relentlessly chased by two little angry macaques."


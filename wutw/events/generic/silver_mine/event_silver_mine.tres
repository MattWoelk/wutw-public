[sub_resource type="Resource" id="Resource_bg8po"]
script = ExtResource("6_13ipv")
markedup_text = "Ignore the incident."
outcome = SubResource("Resource_f2bue")
markedup_result_text = "The miners avoid the collapsed shaft but continue using the remaining ones.

Production continues uninterrupted, but the workers begin to fear every creak and groan of the beams.
"

[sub_resource type="Resource" id="Resource_va5a3"]
script = ExtResource("4_3120q")
markedup_text = "The silver mine is the settlement's primary industry, supplying the whole region with gleaming rings and necklaces. The miners swing their picks from sunup to sundown to feed the hungry forges.

This morning, the miners find the beams above their heads groaning. By the time an alarm is raised, bits of stone are raining from the ceiling. The miners barely make it out before the shaft collapses."

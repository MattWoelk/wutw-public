[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_not4f")
markedup_text = "Take them to the wilderness."
requirement = SubResource("Resource_rx1a8")
outcome = SubResource("Resource_j3qln")
markedup_result_text = "The nun takes the children away from the town and makes them contemplate the trees for hours.

The trips repeat daily. The children kneel on the ground and learn to calm their minds, letting racing thoughts pass, like leaves floating down the stream.

She makes them chop wood and carry water, until they are too tired to get into trouble.

One day, her lessons delivered, she leaves. \"The wind has changed,\" she says."


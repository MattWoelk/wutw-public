[sub_resource type="Resource" id="Resource_dkkcu"]
script = ExtResource("12_02rwh")
result_text = "The scouts climb the cliffs looking for another entrance to the cave. 

At the top they find an opening, partially blocked by a fallen tree trunk.

Eager to see what lies inside, the scouts shove the tree trunk aside, only to dislodge a large boulder, which tumbles down and blocks the cave entrance."

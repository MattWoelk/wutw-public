[sub_resource type="Resource" id="Resource_op8st"]
script = ExtResource("6_7nk6e")
markedup_text = "Burn herbs from the scent bags to call them back."
requirement = SubResource("Resource_1qhms")
show_condition = SubResource("Resource_ecso1")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "The novices haul a brazier up to the temple's highest balcony, and fill it with coals and ash, placing herbs from the scent bags on top.

The air instantly fills with the smell of juniper and mugwort, intimately familiar to the monks and the birds alike.

An hour later the crows return. The flock is clearly disturbed, making low, knocking sounds instead of their usual lively caws. One of the birds seems to be missing."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_ui61k"]
script = ExtResource("6_7nk6e")
markedup_text = "Wait for the crows to return."
markedup_result_text = "The monks trust the birds to find their way back like they do every day.

The crows only return by dawn. The flock is clearly disturbed, making low, knocking sounds instead of their usual lively caws.

One of the birds seems to be missing."

[sub_resource type="Resource" id="Resource_t76v4"]
script = ExtResource("4_wbfk4")
markedup_text = "This chapter of the Order of the Wilds has forged a bond with the local crows. The birds fly out to forage during the day, and return in the evening to roost on monastery grounds.

Today, as the sun is setting, the flock is nowhere to be seen.

The monks and nuns grow worried, proposing different plans to call the crows back, or go out looking for them in the wilderness."
background_image = SubResource("Resource_j6b2j")
background_credit = ExtResource("5_vto4l")
choices = Array[ExtResource("6_7nk6e")]([SubResource("Resource_23650"), SubResource("Resource_ec5lu"), SubResource("Resource_cowx3"), SubResource("Resource_op8st")])
exit_choice = SubResource("Resource_ui61k")


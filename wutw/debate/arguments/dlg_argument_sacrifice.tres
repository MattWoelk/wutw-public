[resource]
script = ExtResource("1_pxich")
dialogue_id = "debate_sacrifice"
record_title = "Debate Speech: The Issue of Practicality"
text = "PAGE: scribe(PORTAL_NETWORK), AUDIENCE
scribe: The Historian calls on us to embrace practicality.
scribe: She claims that to be sensible is to only believe what we can see and touch.
scribe: But let us look at what practical people do when the work is hard and the challenges are daunting.
scribe: A practical person sees a chestnut and decides to mash it into a paste to satisfy their hunger.
scribe: It requires a profoundly impractical person to take that same chestnut and bury it in the soil, trusting in a harvest they might not even live to see.
scribe: That trust is what we call faith.
scribe: It is the absolute belief that the future is worth sacrificing for.
scribe: A society that only starts projects it can finish before sundown will never build anything that outlasts the winter."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

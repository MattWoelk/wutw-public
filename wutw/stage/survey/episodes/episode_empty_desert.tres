[sub_resource type="Resource" id="Resource_205m6"]
script = ExtResource("2_dfnxa")
label = "Follow the visions."
aspects = Array[ExtResource("3_hel5c")]([ExtResource("4_8fosc")])
outcome = SubResource("Resource_huibf")
outcome_text = "The group decides to divert from their original route and investigate the vision instead.

They spend several hours walking in the direction the two scouts indicated, but the visions only seem to fade the closer they get.

By the time they reach the indicated location, the visions are gone, and they find themselves in the same empty desert they had been traversing for days."

[sub_resource type="Resource" id="Resource_tc7qr"]

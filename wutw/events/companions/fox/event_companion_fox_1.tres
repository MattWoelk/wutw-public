[sub_resource type="Resource" id="Resource_cwl7n"]
script = ExtResource("4_1fult")
markedup_text = "Toss food at the fox."
requirement = SubResource("Resource_rdcxa")
outcome = SubResource("Resource_236dy")
markedup_result_text = "One of the villagers tosses a rice ball in the fox's direction, but that only startles it further.

Before anyone can react, the fox bolts away into the reeds, never to be seen again."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_k37nd"]

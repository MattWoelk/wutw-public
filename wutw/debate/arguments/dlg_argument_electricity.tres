[resource]
script = ExtResource("1_wvktc")
dialogue_id = "debate_electricity"
record_title = "Debate Speech: The Miracle of Lightning"
text = "PAGE: historian(PORTAL_NETWORK), AUDIENCE
historian: My friend recently returned from a shard that is constantly battered by storms.
historian: Any sensible person would have dealt with this by building a thicker roof and staying indoors.
historian: But the locals there decided to do something absurd.
historian: They flew kites into the thunderclouds trying to catch the lightning.
historian: If a scholar came to me and asked me if that was a good idea, I'd have responded with a resounding no.
historian: But the people of that shard didn't have an authority figure to tell them whether their ideas had merit.
historian: Now they stuff lightning into jars, and use it to power lanterns that need no fuel.
historian: Letting our shards develop independently frees people to make their own choices.
historian: It means we get to see what happens when ten thousand different ideas are unchained from the shackles of conventional thought."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

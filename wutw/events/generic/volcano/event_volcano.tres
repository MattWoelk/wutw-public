[sub_resource type="Resource" id="Resource_guq0h"]
script = ExtResource("5_i6nmk")
markedup_text = "Search for alternatives."
requirement = SubResource("Resource_u5inl")
outcome = SubResource("Resource_a30r8")
markedup_result_text = "The eldest woman in the settlement claims to remember an old foraging path she had used before the bridge was built.

Despite the riskiness of the proposition, the villagers follow her up the slopes. The path is narrow, barely visible in the ashy darkness, but the elder seems to know every bend by memory.

The group makes it through to the other side, and they manage to guide their stranded comrades back safely."

[sub_resource type="Resource" id="Resource_qwwt6"]
script = ExtResource("21_ole5h")
card_type = ExtResource("20_wbbm4")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_0cgs3"]
script = ExtResource("5_i6nmk")
markedup_text = "Let the volunteers draw lots."
outcome = SubResource("Resource_qwwt6")
markedup_result_text = "A council member in the crowd decides that there's no time for debate and thrust a basket of bamboo slips at the volunteers, telling them to draw lots.

Those who choose slips smeared with soot place wet cloths over their mouths and head into the ashy darkness. They fell tall trees to create a makeshift bridge and rush across to search for survivors.

Although most of the stranded villagers are saved, the rescue group, having never worked together before, soon scatters, and several of them end up trapped in the ruins."

[sub_resource type="Resource" id="Resource_pf74x"]
script = ExtResource("3_befh5")
markedup_text = "One night, the mountain splits open with a roar. Ash falls like grey snow and stones tumble down the slopes, glowing in the dark.

The villagers flee across the last undamaged bridge leading away from the eruption, but some are still waiting to cross. A burning boulder crashes into the bridge, collapsing it and leaving families stranded on the far side.

Under the burning sky, volunteers spring up from amongst the villagers: a group of strong youngsters claiming to be best able to help, and a group of seniors, saying they've already had long lives, and should be the ones to take the risk."
background_image = SubResource("Resource_8d21v")
background_credit = ExtResource("4_irkln")
choices = Array[ExtResource("5_i6nmk")]([SubResource("Resource_jlgob"), SubResource("Resource_ynos6"), SubResource("Resource_guq0h")])
exit_choice = SubResource("Resource_0cgs3")


[sub_resource type="Resource" id="Resource_m28nf"]
script = ExtResource("2_jnkcl")
label = "Use mud to protect skin."
aspects = Array[ExtResource("3_qbtgn")]([ExtResource("13_1547u"), ExtResource("13_1547u")])
outcome = SubResource("Resource_7dbi2")
outcome_text = "The scouts slather mud on their exposed skin, successfully protecting themselves from insect bites.

However, by the time they are done, the whole group is walking in a cloud of musty stench and stale sweat."


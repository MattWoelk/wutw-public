[sub_resource type="Resource" id="Resource_o56kg"]
script = ExtResource("2_f3eko")
label = "Throw provisions at the tigers."
requirement = SubResource("Resource_vmrt4")
aspects = Array[ExtResource("3_s7p5p")]([null])
aspects_per_season = Array[ExtResource("3_s7p5p")]([null])
outcome = SubResource("Resource_i2sri")
outcome_text = "One of the scouts removes some food from his pack and hurls it towards the tigers' feet.

The cubs step forward, sniffing, to investigate, and the group slowly retreats.

The tigress follows them for a distance, waiting for more food, but eventually gives up, returning to her cubs."

[sub_resource type="Resource" id="Resource_iee1s"]

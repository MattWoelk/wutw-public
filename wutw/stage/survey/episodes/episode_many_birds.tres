[sub_resource type="Resource" id="Resource_04b1v"]
script = ExtResource("2_u0sbo")
label = "Listen to their calls."
aspects = Array[ExtResource("3_rfb12")]([ExtResource("10_7rwri")])
aspects_per_season = Array[ExtResource("3_rfb12")]([null])
outcome = SubResource("Resource_ew2v8")
outcome_text = "The scouts stay silent, listening to the birds crying over the water.

Their voices seem chaotic at first, but in time they merge into a strangely soothing cacophony."

[sub_resource type="Resource" id="Resource_r2lln"]
script = ExtResource("2_u0sbo")
label = "Flee."
aspects = Array[ExtResource("3_rfb12")]([null])
aspects_per_season = Array[ExtResource("3_rfb12")]([null])
outcome_text = "The scouts run away, disoriented by the seemingly endless number of birds erupting from their surroundings."

[resource]
script = ExtResource("12_34jx3")
episode_id = "many_birds"
title = "The Uncountable Flock"
biome_types = Array[int]([4])
spot_types = Array[ExtResource("13_dax5y")]([ExtResource("14_5uf0k"), ExtResource("15_jhfu6")])
text = "A few scouts break away from the group to examine the banks of a stream.

As they approach the water, a flock of tiny white birds flies up from the reeds.

Before they can react, more and more birds emerge, filling the air with sharp, piping calls."
background_image = SubResource("Resource_4tqvn")
background_credit = ExtResource("1_u0sbo")
choices = Array[ExtResource("2_u0sbo")]([SubResource("Resource_wwjba"), SubResource("Resource_r2yuo"), SubResource("Resource_04b1v"), SubResource("Resource_r2lln")])

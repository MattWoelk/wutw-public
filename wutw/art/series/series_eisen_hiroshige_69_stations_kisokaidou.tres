[resource]
script = ExtResource("2_mqpc8")
name = "69 Stations of the Kisokaidō"
blurb = "A series of 71 prints depicting the towns and rest stops along the Kisokaidō, one of the centrally administered five routes of the Edo period, connecting Edo and Kyōto.

There is one print for each of the 69 post stations, except Nakatsugawa-juku has two prints, and an extra print depicts Nihonbashi, the starting point in Edo.

The set was started by Eisen and published by Hōeidō in 1835, but in 1837 [url=artist:Hiroshige]Hiroshige[/url] took over and completed the series with the publisher Iseiri.

Later reprints removed Eisen's signature, presumably because the publishers wanted the public to think the designs were by Hiroshige, the better known landscape artist of the two."
start_year = 1834
end_year = 1842
artist = ExtResource("1_hmj5x")
link = "https://en.wikipedia.org/wiki/The_Sixty-nine_Stations_of_the_Kiso_Kaid%C5%8D"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

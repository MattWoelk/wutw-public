[resource]
script = ExtResource("4_6ks08")
name = "Keisai Eisen"
blurb = "Keisai Eisen was an ukiyo-e artist specializing in [url=art_style:bijin-ga]bijin-ga[/url], although he produced landscape prints, and [url=art_style:surimono]surimono[/url] as well.

Eisen is most renowned for his [url=art_style:bijin-ga]bijin-ga[/url], which portrayed the subjects as more worldly than those depicted by earlier artists, replacing their grace and elegance with a less studied sensuality. He produced many portraits and full-length studies depicting the fashions of the time.

He was also known as Ikeda Eisen, and wrote under the name of Ippitsuan."
birth_year = 1790
death_year = 1848
link = "https://en.wikipedia.org/wiki/Keisai_Eisen"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

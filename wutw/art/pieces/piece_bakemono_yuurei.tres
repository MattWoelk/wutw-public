actual_start_year = 1500
actual_end_year = 1700
date_type = 1
custom_link = "https://en.wikipedia.org/wiki/File:23.Yuurei.jpg"
final_image_tex = SubResource("Resource_l324q")
blurb = "Depicts Yūrei (\"faint spirit\"), a generic term for ghosts, usually referring to spirits barred from a peaceful afterlife.

According to traditional Japanese beliefs, humans have a soul which leaves the body when the person dies. It stays in a purgatory waiting for funeral rites to join its ancestors, and then to return yearly in August during the Obon Festival to receive thanks.

However, a violent death or the lack of funeral rites can cause the soul to become a yūrei which stays in the physical world to take care of its unfinished business."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

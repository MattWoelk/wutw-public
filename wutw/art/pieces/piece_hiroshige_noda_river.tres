[resource]
script = ExtResource("3_o6gt5")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Noda Jewel River in Mutsu Province"
series = ExtResource("4_0bqts")
artist = ExtResource("1_ykc4o")
styles = Array[ExtResource("5_5cng3")]([ExtResource("6_7usa3")])
actual_start_year = 1835
actual_end_year = 1836
date_type = 1
edits_description = "The image was cropped and the text, the sword, and the sails on the horizon were removed."
final_image_tex = SubResource("Resource_x4myr")
province = 67
blurb = "Depicts two women and their attendant pointing at a flock of little white birds, likely plovers, on the banks of the Noda river in Mutsu province. The area is in present-day Iwate prefecture.

Noda is one of the Six Crystal Rivers (\"mu tamagawa\"), which are a theme covered by several ukiyo-e artists.

The inscription in the top left appears to be a poem by Priest Nōin (988–1050):

[i]As evening descends,
briny winds pass
Michinoku's
Noda Jewel River;
the plovers cry.[/i]"
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

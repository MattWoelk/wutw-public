[sub_resource type="Resource" id="Resource_ghv6k"]
script = ExtResource("3_6gm55")
text = "$shard_name was the first place where the settlers of the New World encountered hauntings, a group of fox spirits. They led the expedition deep into the woods, and when they finally found their way out, the foxes were gathering around an old tree on the edge of the forest. Despite the Scribe's objections, the settlers decided to let the foxes be, and merely recorded their findings."
requirement = SubResource("Resource_vo6ed")

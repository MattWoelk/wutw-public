[resource]
script = ExtResource("3_jiilm")
name = "Shōda Kōhō"
blurb = "Shōda Kōhō was an artist in the [url=art_style:shin-hanga]shin-hanga[/url] movement of the early 20th century. He was a pupil of [url=artist:Ogata Gekkō]Ogata Gekkō[/url] and became known both for his paintings and shin-hanga woodblock prints, as well as later for his satirical poetry.

Kōhō's most celebrated work is his Night Scenes series, which depicts evening landscapes in subdued sepia and blue tones. In addition to the Night Scenes, Shōda also contributed to the production of tanzaku-format prints. These narrow, vertical formats reflected the architectural spaces of traditional Japanese houses, where posts often provided the only surfaces for hanging pictures.

Around the age of thirty, he withdrew from the world of visual arts and was mainly active as a poet of humorous Kyōka and Kyōshi verse under the pen names Unnoya Hachisuke and Renji Kōshi."
birth_year = 1877
death_year = 1924
link = "https://en.wikipedia.org/wiki/Sh%C5%8Dda_K%C5%8Dh%C5%8D"

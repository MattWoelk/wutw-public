[resource]
script = ExtResource("4_wcb76")
name = "Utagawa Hiroshige"
portrait = SubResource("Resource_818be")
blurb = "Utagawa Hiroshige was a master printmaker renowned for his atmospheric approach to the ukiyo-e landscape. He captured the beauty of everyday travel, changing seasons, and distinct weather conditions like rain, mist, and snow.

He is best known for the many editions of his series [url=art_series:53 Stations of the Tōkaidō]53 Stations of the Tōkaidō[/url] and [url=art_series:100 Famous Views of Edo]100 Famous Views of Edo[/url]. Hiroshige's approach was more poetic and ambient than most of his contemporaries, and featured subtle use of color and extensive use of bokashi (color gradation).

His works were widely exported and profoundly influenced European artists, with Vincent van Gogh famously creating direct oil painting copies of his prints."
birth_year = 1797
death_year = 1859
link = "https://en.wikipedia.org/wiki/Hiroshige"
schools = Array[ExtResource("2_ewskv")]([ExtResource("3_vdvdp")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

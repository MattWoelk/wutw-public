[sub_resource type="Resource" id="Resource_isc74"]
script = ExtResource("4_1fult")
markedup_text = "Pretend to look away."
outcome = SubResource("Resource_2g5h5")
markedup_result_text = "The villagers turn around and start slowly walking away.

The fox visibly relaxes, gives the river one last look, then follows the people for a while, before disappearing into the night."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


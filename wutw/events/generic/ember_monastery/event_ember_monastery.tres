[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("5_vbuhp")
markedup_text = "Judge the heat by the cracks in the bones."
requirement = SubResource("Resource_4xuhh")
outcome = SubResource("Resource_ptcwf")
markedup_result_text = "One settler kneels at the edge and studies the coals.

Patterns emerge where heat has split the bone-flecked stones.

\"The future may seem obscure, but there are always signs for us to read,\" he says, as he steps on the path."

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("7_f04eu")
relic = ExtResource("10_3xkb5")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("9_o55j2")
aspect_type = ExtResource("11_2rvp6")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_vbuhp")
markedup_text = "Inscribe protective charms on paper before stepping forward."
requirement = SubResource("Resource_rx1a8")
outcome = SubResource("Resource_egt2j")
markedup_result_text = "Each settler draws a single line on a strip of paper.

They fold them gently, and carry them as they step onto the glowing path.

\"With this protection,\" a settler says, \"we will remember that the pain will pass.\""

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("7_f04eu")
relic = ExtResource("12_cobcm")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("9_o55j2")
aspect_type = ExtResource("13_uely5")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("5_vbuhp")
markedup_text = "Throw tools onto the coals and walk on them."
requirement = SubResource("Resource_06ahh")
outcome = SubResource("Resource_f2op8")
markedup_result_text = "The settlers throw pins, fasteners, and scraps of iron onto the path.

The metal digs into skin, but it grants them just enough time to escape the heat.

On the other side, one settler retrieves a single molten pin.

\"We'll shape it again,\" she says. \"We'll shape everything again.\""


[resource]
script = ExtResource("1_ocep1")
name = "Aizuri-e"
blurb = "Literally \"blue printed pictures\", this style makes heavy use of blue for shading, outlines or both, relying on the Prussian Blue pigment imported from Europe. It was most notably popularized by [url=artist:Katsushika Hokusai]Katsushika Hokusai[/url]."
start_year = 1800
end_year = 1860
link = "https://en.wikipedia.org/wiki/Aizuri-e"

[sub_resource type="Resource" id="Resource_2me52"]
script = ExtResource("5_bjt5s")
markedup_text = "Preserve it intact."
requirement = SubResource("Resource_1stri")
outcome = SubResource("Resource_ciwob")
markedup_result_text = "The pillar is cleaned, but not altered.

A sign is posted: \"This stood before we arrived.\"

The settlers who called for its removal grumble and refuse to visit the site.

The scholars, however, consider this a victory."


[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("13_q2824")
relic = ExtResource("21_ylckh")

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("9_j1ate")
markedup_text = "Contribute the Curious Stone."
requirement = SubResource("Resource_3sdrw")
outcome = SubResource("Resource_2cj5p")
markedup_result_text = "The smith examines the scale-shaped stone and quickly determines that it isn't a metal, despite the sheen.

The scholars go one step further, and confirm that the substance is incredibly hard, able to scratch any surface they try it on. However, it is brittle enough to be easily crushed. The resulting powder is a phenomenal abrasive, able to polish any other material without wearing over time."

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("9_j1ate")
markedup_text = "Leave them to their studies."
markedup_result_text = "The group continues their studies.

Perhaps in time they will revolutionize the technology on this shard."

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("7_yw85d")
markedup_text = "The forge's master smith is hosting a group of scholars from another settlement. Together, they are studying a variety of metals and exploring ways to create new alloys.

Although their learning is exemplary, their experiments are limited by the lack of raw materials.

They would welcome contributions of exotic substances to study."
background_image = SubResource("Resource_06ahh")
background_credit = ExtResource("8_ptnh5")
choices = Array[ExtResource("9_j1ate")]([SubResource("Resource_nthfn"), SubResource("Resource_w2hpu"), SubResource("Resource_fmixu")])
exit_choice = SubResource("Resource_kojkx")


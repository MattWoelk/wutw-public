[sub_resource type="Resource" id="Resource_w2hpu"]
script = ExtResource("9_bcm17")
markedup_text = "Consider the flashes a lucky sign."
requirement = SubResource("Resource_2myy3")
outcome = SubResource("Resource_g8ipw")
markedup_result_text = "A few workers spend the afternoon leaning over the edge of their boats, looking for the flashes.

The source turns out to be large, very red fish: sea bream.

Something else they notice is that the kelp grows thickest wherever these sea bream gather, marking these fish as a sign of abundance among the kelp gatherers."

[sub_resource type="Resource" id="Resource_mtuyc"]
script = ExtResource("11_35i7j")
card_type = ExtResource("21_ksddk")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("13_qmuqb")
aspect_type = ExtResource("22_g8pjp")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("9_bcm17")
markedup_text = "Try to get rid of them."
requirement = SubResource("Resource_3sdrw")
outcome = SubResource("Resource_mtuyc")
markedup_result_text = "The workers decide that whatever these flashes are, they must be harmful.

On their next trip out, they jab their oars down into the water, trying to push the flashes away.

This turns out to be effective, and within days, the flashes stop showing up."

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("9_bcm17")
markedup_text = "Ignore the flashes."
markedup_result_text = "The workers agree that whatever is flashing down there is none of their business.

They haul up their kelp and keep their eyes on the horizon."

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("7_ijcwg")
markedup_text = "Kelp gatherers pulling up their daily harvest are reporting sudden red flashes darting deep among the dark green fronds below.

Some fear it is a warning from the sea spirits, unwilling to share the bounty, while others find the colorful display quite festive.

Neither group has yet been able to identify what exactly these flashes are."
background_image = SubResource("Resource_06ahh")
background_credit = ExtResource("8_du8ll")
choices = Array[ExtResource("9_bcm17")]([SubResource("Resource_nthfn"), SubResource("Resource_w2hpu"), SubResource("Resource_fmixu")])
exit_choice = SubResource("Resource_kojkx")


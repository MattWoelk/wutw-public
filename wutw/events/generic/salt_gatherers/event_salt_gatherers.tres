[sub_resource type="Resource" id="Resource_r8bng"]
script = ExtResource("5_shas5")
markedup_text = "Haruko is right."
requirement = SubResource("Resource_lqp35")
outcome = SubResource("Resource_a6ufw")
markedup_result_text = "Haruko is allowed to focus on trade while Akiko pairs up with another salter.

Her new partner is a serious man, who says little and works steadily. In him she finds a kindred soul, who understands the importance of a worker's duty."

[sub_resource type="Resource" id="Resource_bgisj"]
script = ExtResource("9_814x2")
bonus_type = ExtResource("8_8xf8w")
amount = 15
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_qu2wf"]
script = ExtResource("12_5c5xt")
aspect_type = ExtResource("16_cmwc4")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_s5wdk"]
script = ExtResource("5_shas5")
markedup_text = "Consult a village elder."
requirement = SubResource("Resource_qu2wf")
outcome = SubResource("Resource_bgisj")
markedup_result_text = "The sisters decide to seek advice from a village elder. The elder listens for a while, then proposes that they exchange responsibilities until the next full moon.

Haruko returns home every day with aching shoulders, while Akiko quickly learns that merchants rarely agree on anything and that a single misplaced word can spoil an entire afternoon of bargaining.

When the full moon finally rises, both sisters return to their tasks, never mentioning the argument again."

[sub_resource type="Resource" id="Resource_skamp"]
script = ExtResource("5_shas5")
markedup_text = "Let the argument go unresolved."
markedup_result_text = "The sisters fail to come to an agreement. Haruko continues to avoid work out on the salt flats, while Akiko grows more and more irate.

The issue comes to a head one day, as the two sisters unload their resentment.

They are still feuding to this day."

[sub_resource type="Resource" id="Resource_76wk1"]
script = ExtResource("3_tuhhk")
markedup_text = "Every morning, salters head to the flats to fill their buckets with pale crystals and bring back the treasure to the village by sundown.

Among these salters are two sisters. The elder, Akiko, works without complaint and returns home with salt crusting her sleeves and sandals every evening. The younger, Haruko, often leaves her bucket half-filled, and spends her time tracing patterns on the ground with a length of string. When merchants come into town, she often leaves her sister behind, and spends her day convincing the merchants to buy more salt.

Akiko resents working alone on market days, while Haruko insists that a merchant's first impression is worth more than a bucket of salt."
background_image = SubResource("Resource_vtr07")
background_credit = ExtResource("5_rebnn")
choices = Array[ExtResource("5_shas5")]([SubResource("Resource_r8upj"), SubResource("Resource_r8bng"), SubResource("Resource_s5wdk")])
exit_choice = SubResource("Resource_skamp")


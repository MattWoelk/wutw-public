[sub_resource type="Resource" id="Resource_vok6u"]
script = ExtResource("2_p58a3")
label = "Study the tree."
aspects = Array[ExtResource("3_eneyw")]([ExtResource("4_t4ecb")])
aspects_per_season = Array[ExtResource("3_eneyw")]([null])
outcome = SubResource("Resource_2t1hw")
outcome_text = "The budding scholar takes a string and measures the circumference of the tree. She measures the shadow to estimate its height. Finally, she records the distance to other nearby trees and takes their measurements too. Having recorded all her findings, she signals to the group to move on."

[sub_resource type="Resource" id="Resource_o37md"]

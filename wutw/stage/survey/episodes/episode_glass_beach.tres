outcome = SubResource("Resource_b01es")
outcome_text = "The explorers decide to continue their journey elsewhere, leaving the secluded beach unexplored."

[resource]
script = ExtResource("16_pet3d")
episode_id = "glass_beach"
title = "The Secluded Cove"
biome_types = Array[int]([1, 10])
text = "A secluded cove surrounded by cliffs opens out onto the vast sea.

Although the open water is too dangerous to cross in tiny boats, the sheltered cove and its surrounding beaches could offer their own discoveries."
background_image = SubResource("Resource_ud8l6")
background_credit = ExtResource("1_uakfi")
choices = Array[ExtResource("2_uakfi")]([SubResource("Resource_lp3ut"), SubResource("Resource_crfmg"), SubResource("Resource_mvdw0"), SubResource("Resource_jgsr8")])

[resource]
script = ExtResource("1_bqyei")
name = "Yūrei-zu"
blurb = "Literally \"ghost illustration\", this style focuses on depicting ghosts, demons, yōkai, and other supernatural beings.

Early examples are mainly e-maki (painted scrolls), rather than woodblock prints. However, after censorship laws in 1842 outlawed the depiction of celebrities, some printers used fantastic creatures as substitutes for real people, including the ruling elite."
start_year = 1200
end_year = 2026
link = "https://en.wikipedia.org/wiki/Y%C5%ABrei-zu"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

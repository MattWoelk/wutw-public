[sub_resource type="Resource" id="Resource_o44fc"]
script = ExtResource("4_r7vji")
markedup_text = "Scholars gather by the canyon walls to study the cracks in the rock face. Many of the cracks bear an uncanny resemblance to common glyphs.

\"Look! This one says [b]temple[/b]! Or maybe [b]wait[/b]?\" a young scholar says, pointing at a jumble of cracks. \"This must be one of the signs the Scribe told us to look for! A place where the spirit of the Enlightened One speaks to us through cracks.\"

The other scholars gather around her, eager to take a look. The decision is soon reached: we must carve a question and wait for the Enlightened One's answer."

[sub_resource type="Resource" id="Resource_oyrbr"]
script = ExtResource("2_t6lx5")
label = "Reinforce the tree bridge."
aspects = Array[ExtResource("3_3y6ya")]([ExtResource("4_sl5ne")])
outcome = SubResource("Resource_r0wwb")
outcome_text = "The group nails pegs to the tree trunk, and ties safety ropes around it, attaching them to nearby trees.

Having done this, they make it across safely, but leave the tree marked and scarred."

[sub_resource type="Resource" id="Resource_qcw3s"]

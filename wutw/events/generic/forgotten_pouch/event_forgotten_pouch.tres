[sub_resource type="Resource" id="Resource_kio1v"]
script = ExtResource("5_qd7hq")
markedup_text = "Search for the owner."
requirement = SubResource("Resource_xxhwh")
outcome = SubResource("Resource_mxy6s")
markedup_result_text = "The settlers follow a trail of flattened grass and catch up to a traveler by the next ridge.

She smiles in relief at the sight of the pouch.

\"You didn't have to go through all this trouble,\" she says. \"But I'm so grateful that you did.\""


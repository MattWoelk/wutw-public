[sub_resource type="Resource" id="Resource_jo6jf"]
script = ExtResource("6_ncm4o")
markedup_text = "Give it some food to go with the drink."
requirement = SubResource("Resource_shebf")
outcome = SubResource("Resource_uhtks")
markedup_result_text = "A brewer takes pity on the creature and tosses it a dried plum to soak up the alcohol.

The animal sniffs it, takes a tentative bite, and immediately throws up.

Its belly having contracted, it finally gets through the vines and scrambles away in shame."

[sub_resource type="Resource" id="Resource_e6cps"]

[sub_resource type="Resource" id="Resource_dxvih"]
script = ExtResource("2_ryrc3")
label = "Dare him to jump."
aspects = Array[ExtResource("3_r7eoy")]([ExtResource("8_3rh54")])
aspects_per_season = Array[ExtResource("3_r7eoy")]([null])
outcome = SubResource("Resource_v476b")
outcome_text = "Knowing their friend to be a strong swimmer, the other scouts encourage him to jump into the water. 

Slightly embarrassed, the stranded scout glances at the smiling faces of his comrades then jumps into the water with a splash, emerging unharmed."


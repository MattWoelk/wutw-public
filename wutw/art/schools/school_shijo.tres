[resource]
script = ExtResource("1_75n6k")
name = "Shijō School"
blurb = "The Shijō school was a lineage of Japanese painters that emerged in Kyōto during the late 18th century. Founded by Matsumura Goshun, the movement successfully blended the precise, objective realism of the Maruyama school with the expressive, poetic brushwork of traditional literati painters.

Shijō artists favored approachable, everyday subjects. They are known for their atmospheric landscapes, delicate nature studies, and lively depictions of birds and animals."
start_year = 1770
end_year = 1900
link = "https://en.wikipedia.org/wiki/Shij%C5%8D_school"

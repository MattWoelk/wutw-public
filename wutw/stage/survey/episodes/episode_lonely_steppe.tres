[sub_resource type="Resource" id="Resource_ieqcu"]
script = ExtResource("2_hs4nh")
label = "Keep him company."
aspects = Array[ExtResource("3_yj6tt")]([ExtResource("4_bomnh")])
aspects_per_season = Array[ExtResource("3_yj6tt")]([null])
outcome = SubResource("Resource_bbps8")
outcome_text = "One scout walks beside the gloomy teammate, offering a friendly ear.

Soon, the lonely man begins to talk of the family he left behind, and of his fear that he will never return home.

The two become close over the next few days."

[sub_resource type="Resource" id="Resource_x4xkc"]

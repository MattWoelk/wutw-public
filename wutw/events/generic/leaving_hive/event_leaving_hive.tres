[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("5_63bxa")
markedup_text = "Study the empty hive."
requirement = SubResource("Resource_ptcwf")
outcome = SubResource("Resource_2stvf")
markedup_result_text = "The beekeepers inspect the empty hive for damage.

There's no sign of mites or other parasites, but they find the cells uncapped and emptied, the wax caps jagged, as if chewed through. It appears that this hive has been robbed by bees from another hive.

The remaining hives are spread further apart, to discourage such unneighborly conduct."

[sub_resource type="Resource" id="Resource_xxhwh"]
script = ExtResource("11_xnwnb")
relic = ExtResource("10_5finm")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("9_tqh8e")
aspect_type = ExtResource("12_udmc1")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("5_63bxa")
markedup_text = "Set new hives to welcome the swarm."
requirement = SubResource("Resource_f2op8")
outcome = SubResource("Resource_xxhwh")
markedup_result_text = "It is a scramble to fetch empty hives from storage and spread them around the meadow, but the keepers are fast enough.

The bees stop on a nearby bush for a while, but eventually make their way to one of the new hives, the one furthest from their old home.

The old, empty hive is retired."

[sub_resource type="Resource" id="Resource_kio1v"]
script = ExtResource("14_ubto0")
bonus_type = ExtResource("13_qrvnx")
amount = 25
extra_per_season = 15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("5_63bxa")
markedup_text = "Compose a poem for the occasion."
outcome = SubResource("Resource_kio1v")
markedup_result_text = "At twilight, the settlers gather near the old hive. One of them steps forward and recites a short verse:

The hive is empty.
Fragrant still, but echoless.
One bee circles back
As if to remind,
Every ending is a start."

[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("7_cr4gb")
card_type = ExtResource("15_nixdl")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("5_63bxa")
markedup_text = "Collect the leftover honey."
outcome = SubResource("Resource_df5af")
markedup_result_text = "The hive left behind is light. Still, a few honeycombs remain, sweet and clean.

The harvest is very modest, but at least it isn't a complete loss."

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("3_lr00w")
markedup_text = "At first, the beekeepers think it is a swarm, but more and more bees join in, producing a hum loud enough to wake the locals.

One of the older hives is absconding. It isn't clear what prompted them to leave, but it's too late to stop them.

Perhaps the hive had grown too full, or mites have infested their home. Or maybe the bees had simply decided they didn't like the scenery."
background_image = SubResource("Resource_i45cl")
background_credit = ExtResource("5_i45cl")
choices = Array[ExtResource("5_63bxa")]([SubResource("Resource_egt2j"), SubResource("Resource_4xuhh"), SubResource("Resource_tuogj")])
exit_choice = SubResource("Resource_rx1a8")


[resource]
script = ExtResource("2_7hd46")
name = "Shikishi-ban Kachō-e"
blurb = "This set of 60 prints of flowers, animals, human figures, and scenery uses a shikishi-ban (square) format, a favorite of Gekkō's, and features whimsical linework and impressive gradations. Although \"kachō-e\" features in the title, most of the prints would not be considered [url=art_style:kachō-e]kachō-e[/url]."
start_year = 1900
end_year = 1910

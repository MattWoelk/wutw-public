label = "Continue on."
aspects = Array[ExtResource("3_8ka6v")]([null])
aspects_per_season = Array[ExtResource("3_8ka6v")]([null])
outcome = SubResource("Resource_1t6ab")
outcome_text = "The scouts don't let fear delay them, and ignore the critter, who scampers halfway up a leaning tree trunk and watches them pass."

[resource]
script = ExtResource("14_141tx")
episode_id = "tanuki_canyon"
title = "The Haunted Canyon"
spot_types = Array[ExtResource("15_2ty3j")]([ExtResource("16_6ppxj")])
text = "Darkness is gathering between the canyon walls. The scouts light their torches and press on, hoping to find shelter soon, or cross the canyon before night falls.

They have heard tales of spirits haunting such canyons, carving messages on the walls and driving people mad.

Suddenly the light from their torches catches the gleam of a pair of eyes, low to the ground.

Sitting in the middle of the path is a lone tanuki."
background_image = SubResource("Resource_7hpux")
background_credit = ExtResource("1_ocdtd")
choices = Array[ExtResource("2_ocdtd")]([SubResource("Resource_80qh6"), SubResource("Resource_vjl5j"), SubResource("Resource_blug2"), SubResource("Resource_g050j")])

piece_name = "Tsunami Disaster in Meiji Era"
artist = ExtResource("1_ro8pu")
actual_start_year = 1896
edits_description = "Modern elements like telephone poles were removed, the page seams were cleaned up, and a rain layer was added to make the style fit better with older prints used in the same intro cutscene."

[sub_resource type="Resource" id="Resource_hhyov"]
script = ExtResource("2_wwp4b")
label = "Climb the valley wall."
aspects = Array[ExtResource("3_canpa")]([ExtResource("4_oysoo")])
aspects_per_season = Array[ExtResource("3_canpa")]([null])
outcome = SubResource("Resource_5fdqq")
outcome_text = "A scout scales the steep valley wall to get a better view of the landscape.

The climb is difficult, but when he makes it to the top, he sees that one path curves toward open grassland, and the others move farther into the hills.
"


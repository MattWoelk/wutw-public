[resource]
script = ExtResource("1_e2p6b")
dialogue_id = "mq_1_20_end"
record_title = "Era 一: The Shard Capital 二"
text = "PAGE: scribe(PORTAL_NETWORK), monk(GENERIC), AUDIENCE
scribe: See how swiftly that capital took root!
scribe: The people build, guided by divine strokes.
monk: It's only thanks to you that we know the Enlightened One's will.
monk: We'd be lost without you.
scribe: I only set down what is given.
scribe: With the Enlightened One's blessing, we have woven the first knot in a cord that will soon bind all shards.
scribe: Yet walls and fields alone will not hold us together.
scribe: Without memory, stone crumbles, and hope with it.
monk: Well, what should we do?
scribe: We must not only rebuild homes, but also preserve the sacred knowledge.
scribe: The Enlightened One grants us strokes of wisdom, but it is our duty to inscribe them, to carry them intact across every gate.
monk: We'll get ink and parchment at once!"
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

[resource]
script = ExtResource("2_r1ge8")
name = "Takahashi Shōtei"
portrait = SubResource("Resource_a4dg7")
blurb = "Takahashi Shōtei, also known as Hiroaki, was a pioneering printmaker and the first artist recruited to launch the [url=art_style:shin-hanga]shin-hanga[/url] movement in the early 20th century.

He is known for his serene depictions of rural landscapes and traditional village life, and excelled at capturing distinct weather conditions and nighttime scenes.

By 1923, he had produced roughly 500 designs, but the devastating Great Kanto earthquake and subsequent fires destroyed the workshop of his publisher and all his original woodblocks. Undeterred, he spent the rest of his career meticulously recreating lost masterpieces and designing hundreds of new prints."
birth_year = 1871
death_year = 1945
link = "https://shotei.com/artists/shotei/biography.htm"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

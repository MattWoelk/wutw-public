[sub_resource type="Resource" id="Resource_nk7y4"]
script = ExtResource("2_eh2mk")
label = "Repair the bridge."
aspects = Array[ExtResource("3_b4ftu")]([ExtResource("4_08br5")])
aspects_per_season = Array[ExtResource("3_b4ftu")]([null])
outcome = SubResource("Resource_2vyxr")
outcome_text = "The group sets out to fix the crumbling beams.

They carefully remove the rotten boards, then chop down timber to fashion replacements. By the end of the day, the bridge is sturdy again.

The scouts take pride in having helped preserve the work of the unknown builders."


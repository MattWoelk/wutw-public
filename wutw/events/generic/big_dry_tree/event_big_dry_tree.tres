[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_o2csi")
markedup_text = "Prune just enough to help it grow."
requirement = SubResource("Resource_rx1a8")
outcome = SubResource("Resource_egt2j")
markedup_result_text = "The dead limbs are removed with care, no more than necessary.

When the last one falls, the young shoots already look freer. The sun reaches the bark in places it hasn't touched in years."

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("17_62y13")

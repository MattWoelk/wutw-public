[sub_resource type="Resource" id="Resource_6odqe"]
script = ExtResource("2_r0p81")
label = "Tie everyone together."
aspects = Array[ExtResource("3_wbt5a")]([ExtResource("4_ew2v8")])
aspects_per_season = Array[ExtResource("3_wbt5a")]([null])
outcome = SubResource("Resource_d1arc")
outcome_text = "The scouts tie themselves together with a long rope before the fog reaches them. This way, no one can become separated from the group.

The plan goes awry when one of the scouts stumbles off the path and starts sliding down the slope, pulling the rest of the group behind her.

Crisis is averted when her teammates manage to pull her back up, but everyone is left shaken by the mishap.
"

[sub_resource type="Resource" id="Resource_1a7fo"]
script = ExtResource("9_804xw")

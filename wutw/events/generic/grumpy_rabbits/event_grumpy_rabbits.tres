[sub_resource type="Resource" id="Resource_5ro8b"]
script = ExtResource("5_aubqb")
markedup_text = "Build a rabbit shrine instead."
requirement = SubResource("Resource_5h1mt")
outcome = SubResource("Resource_bgisj")
markedup_result_text = "Haunted by the rabbits' accusing stares, the architect halts construction on the warehouse and begins a new project.

The result is a set of tiny white shrines, marking the entrances to the rabbits' warren.

Settlers leave little piles of hay in front of the shrines as offerings to the town's new patron deities."

[sub_resource type="Resource" id="Resource_5mc6v"]
script = ExtResource("15_xta35")
card_type = ExtResource("17_qgjop")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_010lb"]
script = ExtResource("5_aubqb")
markedup_text = "Continue the project."
outcome = SubResource("Resource_5mc6v")
markedup_result_text = "The project continues as planned, and the settlement gains much-needed storage space.

Still, the architect cannot shake the memory of the rabbits' glaring eyes."

[sub_resource type="Resource" id="Resource_0letw"]
script = ExtResource("3_hwdnx")
markedup_text = "The settlement's architect is surveying the planned location for the town's new warehouse as a full moon rises above. Lost in thought, he catches movement out of the corner of his eye, and is startled to see two white rabbits glaring at him.

They stand still as statues, their red eyes staring accusingly into his very soul. The man laughs nervously and steps past them, but the rabbits' gaze follows.

Looking closely, he notices with a sinking feeling the dark mouths of several burrows.
"

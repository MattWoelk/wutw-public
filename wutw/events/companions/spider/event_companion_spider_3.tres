[sub_resource type="Resource" id="Resource_hrsh3"]
script = ExtResource("6_c3i2k")
markedup_text = "Suffer a bite to extract the venom."
requirement = SubResource("Resource_e6qt7")
outcome = SubResource("Resource_cnauk")
markedup_result_text = "The apothecary offers her bare arm to the spider.

The bite is agonizing, and she has to push through an all-consuming feeling of hopelessness to continue the project.

She squeezes enough of the venom out of the wound to successfully produce a cure, but spends the next week barely leaving the hut."


[sub_resource type="Resource" id="Resource_yx5gh"]
script = ExtResource("6_hihtd")
markedup_text = "Refuse the offer."
requirement = SubResource("Resource_yoh70")
outcome = SubResource("Resource_7gkk8")
markedup_result_text = "The man shakes his head and pulls the straw mat a little higher over the dog.

The guards sigh, muttering about stubborn fools, and walk away.

The street is cold, but as the man curls tighter around the dog, the chill seems to lose its bite."

[sub_resource type="Resource" id="Resource_wto37"]
script = ExtResource("18_kta1u")
bonus_type = ExtResource("17_e8ehn")
amount = -20
extra_per_season = -10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_kaqvs"]
script = ExtResource("6_hihtd")
markedup_text = "Accept then sneak the dog in."
outcome = SubResource("Resource_wto37")
markedup_result_text = "The man agrees, but the moment the guards walk away, he ushers the dog inside.

The plan works perfectly until the dog spots a dropped rice cake under a table and makes a dive for it, upending a bench in the process.

The guards promptly return, alarmed by the clatter, and the man ends up back on the street."

[sub_resource type="Resource" id="Resource_kk5w8"]
script = ExtResource("8_o4htq")
card_type = ExtResource("19_eiseq")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_1mmtv"]
script = ExtResource("6_hihtd")
markedup_text = "Let the dog go."
outcome = SubResource("Resource_kk5w8")
markedup_result_text = "Deciding the street is no place for a loyal beast, the man stands up, points toward the edge of town, and firmly tells the dog to leave.

The dog whines, confused, but eventually trots away into the dark, looking back over its shoulder."

[sub_resource type="Resource" id="Resource_vpum7"]
script = ExtResource("4_xkr87")
markedup_text = "The night guards have stumbled upon an old man sleeping on the street, huddled beneath a frayed straw mat with a sorry-looking dog.

They offer to let him sleep in the common dining hall, but they refuse to let the dog in, citing very strict rules about muddy paws and fleas.

The man sits up, shivering, and looks between the warm glow of the hall and the steadfast animal at his side."
background_image = SubResource("Resource_enrfs")
background_credit = ExtResource("6_enrfs")
choices = Array[ExtResource("6_hihtd")]([SubResource("Resource_ra0k3"), SubResource("Resource_yx5gh"), SubResource("Resource_kaqvs")])
exit_choice = SubResource("Resource_1mmtv")


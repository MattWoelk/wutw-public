piece_name = "Statesman Take-no-uchi no Sukune"
series = ExtResource("5_3aci6")
artist = ExtResource("1_derac")
styles = Array[ExtResource("6_jewo4")]([ExtResource("7_svjlr"), ExtResource("7_derac")])
actual_start_year = 1892
custom_link = "https://ogatagekko.com/print/gekko-zuihitsu-27/"
edits_description = "The person in the background was edited out and a branch was added."
final_image_tex = SubResource("Resource_mrpoq")
province = 37
blurb = "Depicts Take-no-uchi no Sukune proving his innocence by putting his hand into boiling water without getting burns.

Sukune was a legendary hero and statesman of the 1st century, enshrined as a divine figure. He is recorded in Japan's earliest literary texts, the Kojiki (ca. 712) and the Nihon Shoki (720). He reportedly served under 5 legendary emperors, but is best known as the Grand Minister to the Regent Empress Jingū, with whom he supposedly invaded Korea. While Jingu was regent to her son, Ōjin, Takenouchi was accused of treason. He underwent the \"ordeal of boiling water\" as a way to prove his innocence."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

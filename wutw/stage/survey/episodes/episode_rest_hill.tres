label = "Explore the grove."
aspects = Array[ExtResource("3_iifpr")]([ExtResource("9_rqko4")])
outcome = SubResource("Resource_o51dv")
outcome_text = "The explorers walk through the little pine grove, looking for anything worth recording in their logs.

All they find is a beehive in a fallen log."


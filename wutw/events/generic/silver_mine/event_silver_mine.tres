[sub_resource type="Resource" id="Resource_wymns"]
script = ExtResource("6_13ipv")
markedup_text = "Inspect the collapsed shaft."
requirement = SubResource("Resource_ujtg1")
outcome = SubResource("Resource_ymvbb")
markedup_result_text = "After the dust settles, the workers decide to investigate the cause of the collapse.

The culprit turns out to be one badly knotted beam that went unnoticed when the mine was first dug.

During their inspection, however, they are surprised to find a new seam running through the rock. This one, however, is golden."


[sub_resource type="Resource" id="Resource_vbe3t"]
script = ExtResource("6_rrpys")
markedup_text = "Keep the storyteller safe."
requirement = SubResource("Resource_3lt82")
outcome = SubResource("Resource_xh6l0")
markedup_result_text = "Noticing the heaviness of the storyteller's sleeve, several shady characters continue plying him with drink. When he is finally unable to stand, they offer to take him to his lodging.

The innkeeper intervenes, however, claiming that this honored guest is her responsibility. She shoos the other patrons away and walks him back herself.

As the strange man leaves the next morning, he deposits several coins with unfamiliar writing in the innkeeper's hand. \"I've no more use for these,\" he says."

[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("13_hjfci")
card_tag = 7

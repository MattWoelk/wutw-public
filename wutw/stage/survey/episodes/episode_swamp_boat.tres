[sub_resource type="Resource" id="Resource_vfm8x"]
script = ExtResource("2_qjdoq")
label = "Get into another boat."
aspects = Array[ExtResource("3_ujufw")]([ExtResource("7_gyu6d")])
aspects_per_season = Array[ExtResource("3_ujufw")]([null])
outcome = SubResource("Resource_c2r7g")
outcome_text = "The scouts call to their teammates in the nearest boat, who row over as quickly as they can. They all crowd into one boat, which becomes dangerously weighed down by the extra passengers.

Together, they watch as the leaking boat is swallowed by the swamp."


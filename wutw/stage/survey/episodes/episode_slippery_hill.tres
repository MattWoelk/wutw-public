[sub_resource type="Resource" id="Resource_u3oko"]
script = ExtResource("2_b5omd")
label = "Embrace the fall."
aspects = Array[ExtResource("3_3fsis")]([null])
aspects_per_season = Array[ExtResource("3_3fsis")]([null])
outcome = SubResource("Resource_1pm6g")
outcome_text = "The surveyor accepts that she can't stop now.

She relaxes her limbs, leans backward, and coasts on her back down the muddy grass.

She arrives at the bottom with a torn robe and a serene smile."

[resource]
script = ExtResource("19_egfr1")
episode_id = "slippery_hill"
title = "The Slick Slope Slide"
spot_types = Array[ExtResource("20_1emds")]([ExtResource("21_0nuxu")])
text = "The surveyors grumble as they trudge through a pass. It has been raining for two days in a row, and the slopes have turned slick with mud. 

Most of the group has made their way down a steep incline when they hear a yelp from above.

A scout, struggling to lift her pack, has suddenly lost her footing and is now hurtling down the slope."
background_image = SubResource("Resource_61lsy")
background_credit = ExtResource("1_b5omd")
choices = Array[ExtResource("2_b5omd")]([SubResource("Resource_xk1pw"), SubResource("Resource_okvoj"), SubResource("Resource_pjuvv"), SubResource("Resource_u3oko")])

[sub_resource type="Resource" id="Resource_vrywk"]
script = ExtResource("5_ffeea")
markedup_text = "Destroy the red pots."
requirement = SubResource("Resource_8aiyc")
outcome = SubResource("Resource_qra3p")
markedup_result_text = "The apprentices demand that the cursed pottery be destroyed. The other workers agree, and further insist that the fragments be buried so nobody else can get sick.

The master potter is sad to watch his works of art disappear into the ground, but he hides his trembling hands in his sleeves and breathes a sigh of relief."

[sub_resource type="Resource" id="Resource_vw2yx"]
script = ExtResource("7_xw3p7")
bonus_type = ExtResource("10_fhaxe")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_fupj8"]
script = ExtResource("5_ffeea")
markedup_text = "Only use the pottery as decoration."
outcome = SubResource("Resource_vw2yx")
markedup_result_text = "The master potter is unwilling to destroy or seal away his works of art. Instead he offers the red plates and pots to the local shrine, in return for a promise to only use them for decoration.

The plates are placed on high shelves behind the altar, where the whole settlement can admire them."


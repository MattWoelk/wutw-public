[node name="Cutscene_Intro" type="Node2D" unique_id=1300982167]
material = SubResource("ShaderMaterial_h0xtj")
script = ExtResource("4_wm5tv")
texts = Array[String](["Once, we were the masters of our world...", "Trees bowed to our axes. Beasts and rivers alike ran where we willed.", "We carved up the earth and took our rightful inheritance.", "But divine favor would not last forever.", "Droughts scorched our fields and winds wailed against our shelters.", "We fought back with cunning and miracles, to quell the shaking land.", "And in our struggle, we shattered what we treasured most.", "All that remains is ten thousand shards, adrift upon the wind.", "Among us were some who listened to your words, oh Enlightened One, and prepared for the end.", "We inked our names upon a great scroll, shielding us from the Shattering.", "With our faith rewarded, we set out to reunite the world."])
voice_lines = Array[AudioStream]([ExtResource("5_wm5tv"), ExtResource("6_ag3tb"), ExtResource("7_0nh0s"), ExtResource("8_3gjk2"), ExtResource("9_r125g"), ExtResource("10_hmyrg"), ExtResource("11_kpoyh"), ExtResource("12_yymrx"), ExtResource("13_ubl3e"), ExtResource("14_u88rs"), ExtResource("15_m8cnm")])
roll_sound = ExtResource("16_fiprw")
roll_end_sound = ExtResource("17_p4lxa")
music_switch = ExtResource("18_ag3tb")
main_quest_progress = 100

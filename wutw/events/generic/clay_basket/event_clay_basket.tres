[sub_resource type="Resource" id="Resource_std70"]
script = ExtResource("5_u85t3")
markedup_text = "Tell the teen they aren't worth firing."
outcome = SubResource("Resource_40rqf")
markedup_result_text = "\"Not this time,\" the potter says. \"Maybe next.\"

The teen shrugs and carries the crate back home."

[sub_resource type="Resource" id="Resource_786kj"]
script = ExtResource("3_w02dd")
markedup_text = "A local teenager, cheeks dusted with clay, arrives at the kiln with a basket of handmade bowls, almost too large for him to carry alone.

He is too timid to say anything. He just sets them down and looks hopeful.

The bowls are crooked, thick-lipped, and none quite match.

The master potter rubs her chin."

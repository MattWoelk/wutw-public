metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_blug2"]
script = ExtResource("2_ocdtd")
label = "Offer food."
aspects = Array[ExtResource("3_8ka6v")]([ExtResource("11_86pcl")])
aspects_per_season = Array[ExtResource("3_8ka6v")]([null])
outcome = SubResource("Resource_o5ani")
outcome_text = "One of the scouts kneels down and places a rice ball on the ground. The tanuki sniffs cautiously, then approaches, greedily eating the morsel.

Once its meal is finished, the tanuki scampers away."


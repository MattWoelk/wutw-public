[sub_resource type="Resource" id="Resource_ytr5i"]
script = ExtResource("2_jnkcl")
label = "Banish insects with fragrant herbs."
aspects = Array[ExtResource("3_qbtgn")]([ExtResource("12_k3k2n"), ExtResource("12_k3k2n")])
outcome = SubResource("Resource_70vxg")
outcome_text = "It turns out that one of the scouts had prepared for this situation. She takes out a bundle of fragrant herbs and instructs the group to rub them on their skin.

Within minutes, the swarm thins as the insects flee the potent smell, and the team is able to finish their work in peace."


[sub_resource type="Resource" id="Resource_u8tnk"]
script = ExtResource("4_t2pnp")
event_step_id = "science"
markedup_text = "The disciples carefully replace each lantern with a new design, boxes they brought from the Haven, with a single opening at the top. The glow no longer spills outward, but rises, like a beacon, into the sky.

\"Before, the energies were wasted,\" one explains. \"This will direct them heavenward, a channel for the Enlightened One's power.\""
background_image = SubResource("Resource_wbyvl")
background_credit = ExtResource("6_tyksf")
exit_choice = SubResource("Resource_242uo")

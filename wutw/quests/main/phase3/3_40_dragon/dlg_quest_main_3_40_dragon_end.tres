[resource]
script = ExtResource("1_iemoc")
dialogue_id = "mq_3_40_end"
record_title = "Era 三: The Tale of the Dragon"
text = "PAGE: scribe(STUDIO_PRIMARY), historian(STUDIO_SECONDARY)
scribe: The Ember monks were successful.
scribe: Their dedication to our mission was rewarded with a glorious vision of the great dragon.
historian: A vision?
historian: I was hoping we'd see the actual dragon.
scribe: We are yet unworthy.
scribe: But the Enlightened One spoke to them through the spirit, showing us the way to earn divine favor.
historian: Yes, I heard about the vow.
historian: It does make sense.
scribe: Not merely a vow, but an accord.
scribe: A Grand Accord to maintain the balance with nature, as declared in the Enlightened One's teachings.

PAGE: scribe(SHRINE_PRIMARY), teo(SHRINE_SECONDARY)
scribe: Oh Enlightened One, we finally understand.
scribe: We cannot force the shards together with magic, nor expect nature to bend to our will.
scribe: We must prove that we have learned from the mistakes of the past.
scribe: We shall build a great monument to enshrine the Grand Accord so you can guide the world to finally heal."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

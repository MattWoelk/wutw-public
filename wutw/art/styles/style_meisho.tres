script = ExtResource("1_awki1")
name = "Meisho-e"
blurb = "Literally \"pictures of famous places\", these prints and paintings focus on specific famous places in Japan, such as Mount Fuji. They became particularly popular during the Edo period, with its booming travel and pilgrimage culture."

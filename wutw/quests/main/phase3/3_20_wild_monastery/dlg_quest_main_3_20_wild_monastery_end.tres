[resource]
script = ExtResource("1_11oj4")
dialogue_id = "mq_3_20_end"
record_title = "Era 三: Communion with the Wilds"
text = "PAGE: scribe(STUDIO_PRIMARY), historian(STUDIO_SECONDARY)
scribe: The monks of the Holy Wilds have sent word.
historian: Already?
historian: Well, what do they say?
scribe: They have found fragments of the divine spirit alive and well within the beasts of the land.
scribe: Foxes and rabbits alike now roam the monastery's grounds.
scribe: If we could convince these spirits to help us, perhaps they will show us the Enlightened One's will."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

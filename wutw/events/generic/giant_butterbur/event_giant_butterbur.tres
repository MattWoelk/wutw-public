[sub_resource type="Resource" id="Resource_jbdhy"]
script = ExtResource("5_qv0b1")
markedup_text = "Distill into a potent extract."
requirement = SubResource("Resource_ci1kh")
outcome = SubResource("Resource_rlj34")
markedup_result_text = "The herbalist selects the most potent roots and the juiciest leaves. They are boiled down, strained, and boiled again until only a thick, dark resin remains.

There's enough to last the settlement for a long while, so some of the resin is packed into small jars to send on with the expedition."


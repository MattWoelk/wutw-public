[resource]
script = ExtResource("3_mfgsp")
original_image = SubResource("Resource_bcsnl")
piece_name = "A Children's Calligraphy Gathering"
artist = ExtResource("1_uia5m")
actual_start_year = 1844
actual_end_year = 1844
edits_description = "The image was cropped and the text was removed."
final_image_tex = SubResource("Resource_alwh0")
blurb = "Depicts a calligraphy gathering at a school during the Edo period (1603–1868). At these events, children publicly demonstrated their skills in calligraphy.

This scene takes place in a terakoya (\"temple school\"), where Edo-period commoner children learned reading, writing, and arithmetic. The Edo period was a time of unprecedented peace that gave rise to broad literacy fostered by such schools.

Hung above the doors are examples of particularly impressive calligraphy, including ancient poems and auspicious phrases or mottoes.

In the alcove on the left is a portrait of Sugawara no Michizane (845–903), a Heian scholar revered as a deity of learning. His portrait is being honored with offerings to bless the students' academic progress."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

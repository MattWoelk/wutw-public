[resource]
script = ExtResource("2_1ktma")
name = "Remarkable Views of Bridges in Various Provinces"
blurb = "A set of 11 prints depicting scenic views of bridges, dramatized to inspire a sense of awe.

Many of the bridges had literary associations, such as the Eight-plank Bridge of Mikawa. Two of the bridges were no longer extant during the time of production, so Hokusai drew them based on historical records."
start_year = 1834
end_year = 1834
artist = ExtResource("1_3ebdv")

[sub_resource type="Resource" id="Resource_7n6q3"]
script = ExtResource("7_77xuw")
markedup_text = "Leave an offering."
requirement = SubResource("Resource_w8kqr")
outcome = SubResource("Resource_vwk5t")
markedup_result_text = "The settlers decide to pacify the spirit with an offering. They put a sheet of paper on the floor and each person places a small offering: a pile of salt, a carving of the Enlightened One, and a few acorns.

As soon as they turn around, they hear the approaching sound of rapid pattering, followed by a swoosh.

They turn around to find the salt scattered, the carving tipped over, and the acorns gone. The paper now bears a muddy print."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_kg30m"]
script = ExtResource("18_cp6td")
card_type = ExtResource("17_vwk5t")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_j63da"]
script = ExtResource("20_jet3q")
aspect_type = ExtResource("19_ggxcy")
min_count = 2
extra_per_season = 1
metadata/_custom_type_script = "uid://cjdop1iab2efw"

[sub_resource type="Resource" id="Resource_jet3q"]
script = ExtResource("7_77xuw")
markedup_text = "Chant a protective incantation."
requirement = SubResource("Resource_j63da")
outcome = SubResource("Resource_kg30m")
markedup_result_text = "The settlers bow deeply and clap their hands, announcing themselves to the spirits inhabiting the fortress.

They chant a loud incantation asking for protection, and the rustling sounds from within the hall go quiet.

Their mission accomplished, the settlers return back to the settlement triumphant, only for the sounds to return the following night."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_kxavi"]
script = ExtResource("18_cp6td")
card_type = ExtResource("21_j63da")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_cgsut"]
script = ExtResource("20_jet3q")
aspect_type = ExtResource("22_kg30m")
min_count = 2
extra_per_season = 1
metadata/_custom_type_script = "uid://cjdop1iab2efw"

[sub_resource type="Resource" id="Resource_3ujsx"]
script = ExtResource("7_77xuw")
markedup_text = "Explore the hall with torches."
requirement = SubResource("Resource_cgsut")
outcome = SubResource("Resource_kxavi")
markedup_result_text = "The settlers light torches and walk deeper into the hall.

The rustling sounds continue, but the source stays just out of reach.

When they reach the collapsed door at the end of the hall, their nostrils are assaulted by a foul, musky stench without a clear source.

Their path barred, the settlers return empty-handed."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_u01ql"]
script = ExtResource("7_77xuw")
markedup_text = "Retreat."
markedup_result_text = "The settlers decide that they've had enough adventure for the night and quickly climb back out, leaving whoever is inside undisturbed."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_j8bby"]
script = ExtResource("4_01lkg")
event_step_id = "search"
markedup_text = "A small group of adventurous settlers sets out one night to investigate the rumored noises, carrying satchels of auspicious amulets. The crumbling fortress stares them down with its dark windows, daring them to approach.

As they climb inside through a hole left by collapsed masonry, they are greeted with a pitch-black hall, large enough that none of the other walls are visible.

The sound of footsteps from the depth of the hall echoes against the ancient stones."
background_image = SubResource("Resource_78psp")
background_credit = ExtResource("5_etune")
choices = Array[ExtResource("7_77xuw")]([SubResource("Resource_7n6q3"), SubResource("Resource_jet3q"), SubResource("Resource_3ujsx")])
exit_choice = SubResource("Resource_u01ql")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


[sub_resource type="Resource" id="Resource_31j6s"]
script = ExtResource("5_aubqb")
markedup_text = "Build around the burrows."
requirement = SubResource("Resource_xl1yp")
outcome = SubResource("Resource_0eiya")
markedup_result_text = "The architect revises his plan. The warehouse will now stand on stilts, leaving the burrows beneath untouched.

The design proves effective beyond its original intent. It keeps the grain away from hungry rodents, and the air gap prevents moisture from seeping through the floorboards and spreading rot."

[sub_resource type="Resource" id="Resource_bgisj"]

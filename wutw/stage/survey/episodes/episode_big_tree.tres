metadata/_custom_type_script = "uid://gu7gcielbwdr"

[sub_resource type="Resource" id="Resource_l6j16"]
script = ExtResource("2_p58a3")
label = "Pay respects to the spirit."
aspects = Array[ExtResource("3_eneyw")]([ExtResource("7_smode")])
aspects_per_season = Array[ExtResource("3_eneyw")]([null])
outcome = SubResource("Resource_o37md")
outcome_text = "The priest draws glyphs in the dirt around the tree. He bows deeply and chants several prayers while the rest of the group stand back, respectfully. Finally, the priest is satisfied with the ritual and the group moves on from the clearing."


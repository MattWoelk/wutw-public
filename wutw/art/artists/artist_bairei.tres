[resource]
script = ExtResource("3_p7rse")
name = "Kōno Bairei"
portrait = SubResource("Resource_o8uy8")
blurb = "Kōno Bairei was a painter, book illustrator, and art educator who became a central figure in the Kyōto art scene during the Meiji period.

He specialized in [url=art_style:kachō-e]kachō-e[/url], with a refined and highly observational approach to traditional nature subjects. He is best known for his masterful woodblock-printed books, which featured incredibly detailed and lifelike studies of wildlife.

Beyond his own artwork, he established the Kyōto Prefectural School of Painting in 1880."
birth_year = 1844
death_year = 1895
link = "https://en.wikipedia.org/wiki/K%C5%8Dno_Bairei"
schools = Array[ExtResource("2_t7xno")]([ExtResource("3_t7xno")])

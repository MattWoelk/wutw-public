[sub_resource type="Resource" id="Resource_1y5f5"]
script = ExtResource("2_l4pq5")
label = "Catalog useful resources."
aspects = Array[ExtResource("3_kigac")]([ExtResource("13_dp2nu")])
aspects_per_season = Array[ExtResource("3_kigac")]([null])
outcome = SubResource("Resource_0x81b")
outcome_text = "The scouts walk through the village, carefully recording the amount of timber that could be scavenged, the depth of the well, and the area of the nearby fields. These records will be of use if the expedition decides to settle in the vicinity."

[resource]
script = ExtResource("15_ot1w7")
episode_id = "abandoned_gate"
title = "The Empty Village"
spot_types = Array[ExtResource("16_8sm5g")]([ExtResource("17_vxbn2"), ExtResource("18_wefjw")])
text = "The survey team arrives at what remains of an old pre-Shattering village. Grass grows between the stones on the path, and mosses have completely taken over the village square.

Most of the buildings have long since fallen into ruin, but the gatehouse and a few huts still stand, as does the shrine at the center of the village."
background_image = SubResource("Resource_mu0yr")
background_credit = ExtResource("1_l4pq5")
choices = Array[ExtResource("2_l4pq5")]([SubResource("Resource_0xjpd"), SubResource("Resource_skang"), SubResource("Resource_bacoh"), SubResource("Resource_1y5f5")])

[resource]
script = ExtResource("3_rsclc")
original_image = SubResource("Resource_bcsnl")
piece_name = "Poem by Minamoto no Muneyuki Ason"
series = ExtResource("4_rsclc")
artist = ExtResource("1_otk6s")
actual_start_year = 1835
actual_end_year = 1836
date_type = 1
edits_description = "Only the fire was used."
final_image_tex = SubResource("Resource_jg17w")
blurb = "Depicts five men warming themselves by a fire at night outside a snow-covered hut. A poem by the 10th-century Heian poet [url=https://en.wikipedia.org/wiki/Minamoto_no_Muneyuki]Minamoto no Muneyuki[/url] appears in the top right:

[i]In the mountain village,
winter is when my loneliness
increases the most,
when I think how both have dried up,
the grasses and people's visits.[/i]"
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

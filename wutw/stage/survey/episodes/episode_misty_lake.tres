label = "Head towards animal sounds."
aspects = Array[ExtResource("3_jcrlg")]([ExtResource("8_dvo4c")])
outcome = SubResource("Resource_trtbi")
outcome_text = "The surveyors listen carefully. They are quickly able to determine the direction from which frog croaks the loudest and find their way to shore."

[sub_resource type="Resource" id="Resource_37pa6"]
script = ExtResource("2_jw4r8")
label = "Wait it out."
aspects = Array[ExtResource("3_jcrlg")]([null])
aspects_per_season = Array[ExtResource("3_jcrlg")]([null])
outcome_text = "The scouts decide to wait out the fog. They spend the night in the boat, and by noon the next day find the fog has lifted, letting them row safely to the distant shore."

[resource]
script = ExtResource("9_wqu4s")
episode_id = "misty_lake"
title = "The Foggy Lake"
spot_types = Array[ExtResource("10_fg41g")]([ExtResource("11_50yjm")])
text = "A thick fog has rolled in as the team is crossing a lake. It won't be long before the shores are lost in the whiteout.

The scouts are worried that they will end up rowing in circles if they don't take countermeasures."
background_image = SubResource("Resource_f448y")
background_credit = ExtResource("1_jw4r8")
choices = Array[ExtResource("2_jw4r8")]([SubResource("Resource_ixh2g"), SubResource("Resource_bqjio"), SubResource("Resource_yda2u"), SubResource("Resource_37pa6")])

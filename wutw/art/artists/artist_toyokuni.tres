[resource]
script = ExtResource("4_bp0sr")
name = "Utagawa Toyokuni"
portrait = SubResource("Resource_o8uy8")
blurb = "Utagawa Toyokuni was a master printmaker, known in particular for his [url=art_style:yakusha-e]yakusha-e[/url] prints, which depicted kabuki actors in action, rather than as neutral portraits.

He apprenticed under Utagawa Toyoharu, the founder of the [url=art_school:Utagawa School]Utagawa school[/url], and became the second head of the school. He is considered to be responsible for elevating it to the position of great fame and power it occupied for the rest of the 19th century.

Among his many pupils were the great masters [url=artist:Utagawa Kunisada]Kunisada[/url] and [url=artist:Utagawa Kuniyoshi]Kuniyoshi[/url]."
birth_year = 1769
death_year = 1825
link = "https://en.wikipedia.org/wiki/Utagawa_Toyokuni"
schools = Array[ExtResource("2_e7hg2")]([ExtResource("3_81fuy")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

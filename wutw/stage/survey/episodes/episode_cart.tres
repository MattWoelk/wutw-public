[sub_resource type="Resource" id="Resource_jaeo7"]
script = ExtResource("2_3s006")
label = "Take the settler along instead."
aspects = Array[ExtResource("3_pkasv")]([ExtResource("12_d52uo")])
aspects_per_season = Array[ExtResource("3_pkasv")]([null])
outcome = SubResource("Resource_lxfjq")
outcome_text = "It is a waste to leave all these supplies behind, but that cart was never going to fit over the bridge. The settler decides to let it go and join the survey team. At least they'll always have someone around to help."


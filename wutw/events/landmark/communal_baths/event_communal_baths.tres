[sub_resource type="Resource" id="Resource_wq75o"]
script = ExtResource("5_sbpf2")
markedup_text = "Take turns soaking in the water."
outcome = SubResource("Resource_06ahh")
markedup_result_text = "The settlers take turns, most opting for a brisk, functional scrub. The elders, however, tend to soak until their skin prunes.

By the next day, everyone is rested, but many grumble about the wait."

[sub_resource type="Resource" id="Resource_ciwob"]

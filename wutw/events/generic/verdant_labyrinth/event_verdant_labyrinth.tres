[sub_resource type="Resource" id="Resource_e8dbi"]
script = ExtResource("3_br3hg")
event_step_id = "underground_river"
markedup_text = "As the settlers walk toward the distant light, they reach a wide underground stream.

Following the flow of dark water, they find the stream picking up speed as it narrows. It winds its way among the slick stone, rushing past their feet toward the light.

The pale glow in the distance gathers on the water's surface. Its source is soon revealed to be a crack in the cave's wall where the stream escapes into the forest outside."
background_image = SubResource("Resource_6vj4m")
background_credit = ExtResource("32_ftt2p")
exit_choice = SubResource("Resource_lc6d7")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


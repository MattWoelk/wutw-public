[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("5_obykk")
markedup_text = "Host a remembrance feast."
requirement = SubResource("Resource_xh6l0")
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "Food is shared until everyone is full, and then full again.

A single glyph is carved into the stone.

\"Let this guide us,\" a council leader declares. \"Until the stone wears smooth.\""

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("15_kcdyw")
card_type = ExtResource("14_yiyx7")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_2me52"]
script = ExtResource("17_60pgl")
aspect_type = ExtResource("16_jeigo")
min_count = 3

[sub_resource type="Resource" id="Resource_kjam1"]
script = ExtResource("5_obykk")
markedup_text = "Share stories about the inscribed names."
requirement = SubResource("Resource_2me52")
outcome = SubResource("Resource_fmixu")
markedup_result_text = "Everyone sits close to the stone.

The names are read in order, settlers sharing what they know about each person.

The stories range from proud tales of great artisans, to memories of folks who had too much rice wine and fell asleep up in a tree. Some names remain a mystery, unknown to anyone present.

At the end of the evening, the carvings carry a new, richer significance to the settlers."

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("15_kcdyw")
card_type = ExtResource("18_trspm")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_r0oeh"]
script = ExtResource("13_ro3tg")
bonus_type = ExtResource("19_kb01w")
min_count = 20
max_count = -1
extra_per_season = 30

[sub_resource type="Resource" id="Resource_jiini"]
script = ExtResource("5_obykk")
markedup_text = "Chant the names together."
requirement = SubResource("Resource_r0oeh")
outcome = SubResource("Resource_kojkx")
markedup_result_text = "The chanting begins awkwardly, stumbling over names whose pronunciation has been lost to history.

Soon it gains a rhythm, as pronunciations are invented on the spot, and the more puzzling names are simply skipped.

Nothing new is learned about the lives of the ancestors, but a unity is forged among the townspeople, as keepers of this long and shared history."

[sub_resource type="Resource" id="Resource_mm8jc"]
script = ExtResource("5_obykk")
markedup_text = "Leave the monument undisturbed."
markedup_result_text = "The stone remains untouched.

Occasionally, someone clears the moss.

Bowls of rice appear as offerings at the foot of the stone now and then."

[sub_resource type="Resource" id="Resource_ymvbb"]
script = ExtResource("3_wafbl")
markedup_text = "The plaza smells of hot chestnuts and old wood. Someone has swept the dust from the names chiseled into the stone monument.

\"We remember them,\" a settler says.
\"Well, some of them. And not always fondly,\" another corrects.

A few of the younger settlers carve new names, earning glares from their elders."
background_image = SubResource("Resource_c6pbj")
background_credit = ExtResource("10_c6pbj")
choices = Array[ExtResource("5_obykk")]([SubResource("Resource_1stri"), SubResource("Resource_kjam1"), SubResource("Resource_jiini")])
exit_choice = SubResource("Resource_mm8jc")


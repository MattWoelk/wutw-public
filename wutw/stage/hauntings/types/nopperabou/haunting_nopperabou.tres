[resource]
script = ExtResource("8_o0mrq")
haunting_id = "nopperabou"
name = "Nopperabō"
name_japanese = "野箆坊"
name_realistic = "Dense Fog"
name_translation = "Flat Faced Monks"
description = "Thick mists hide the Nopperabō, faceless wanderers who steal people's faces, turning them blind."
description_realistic = "A thick fog frequently rolls into the area, severely limiting visibility and making work hazardous."
description_long = "These lands are swallowed by a fog so thick that workers can barely see their own hands. Settlers report meeting the Nopperabō within the fog, figures who turn around to reveal large, blank faces lacking eyes, noses, or mouths. When the victims report the sightings, whoever they talk to tends to respond \"Oh, you mean like this?\" before wiping their face away."
image_small = ExtResource("5_lxrrg")
image_credit = ExtResource("5_ftbno")
image_small_realistic = ExtResource("6_wn0y8")
image_realistic_credit = ExtResource("6_lxrrg")

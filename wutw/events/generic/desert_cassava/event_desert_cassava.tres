[sub_resource type="Resource" id="Resource_d4eu1"]
script = ExtResource("5_6xn7f")
markedup_text = "Trust the head farmer."
requirement = SubResource("Resource_8tqfq")
outcome = SubResource("Resource_wh43h")
markedup_result_text = "The farmer agrees that the storm may occur, but insists that the safest place for most of the cassava is still underground.

\"We should reinforce the granary walls and cover the irrigation channels instead,\" he says, \"before the storm reaches us.\"

As winds howl through the village, the tubers remain safe underground, and the preparations save time spent on cleanup afterwards."

[sub_resource type="Resource" id="Resource_ejd54"]

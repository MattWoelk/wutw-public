[resource]
script = ExtResource("3_64rfx")
original_image = SubResource("Resource_bcsnl")
piece_name = "Ono no Tōfū Watching a Frog"
artist = ExtResource("1_4kovd")
styles = Array[ExtResource("4_rnanx")]([ExtResource("5_yo2cl")])
actual_start_year = 1820
actual_end_year = 1830
date_type = 1
edits_description = "The sword and text were edited out and the image was extended."
final_image_tex = SubResource("Resource_t233q")
province = 70
blurb = "Depicts Ono no Tōfū, a famous calligrapher from the Heian period (794–1185), one of the Sanseki (\"three [brush] traces\").

The scene illustrates a story wherein Ono is feeling inadequate and considers resigning from the court. He stops to watch a determined frog attempt to jump to a willow branch. After countless futile efforts, the frog finally succeeds. Inspired by its perseverance, Ono no Tōfū decides to stay on.

Some Hanafuda cards use variants of this scene in their willow set."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

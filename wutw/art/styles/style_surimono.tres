[resource]
script = ExtResource("1_ao3o1")
name = "Surimono"
blurb = "Literally \"printed things\", these were privately commissioned woodblock prints created for special occasions like poetry competitions or New Year greetings rather than mass commercial sale. They are characterized by extreme carving precision, lavish materials, and elaborate textures like embossing."
start_year = 1760
end_year = 1850
link = "https://en.wikipedia.org/wiki/Surimono"

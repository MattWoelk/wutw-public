[sub_resource type="Resource" id="Resource_6ab2a"]
script = ExtResource("6_7dmo5")
markedup_text = "Examine the scarf."
outcome = SubResource("Resource_yr1uy")
markedup_result_text = "Gathering his courage, the apprentice steps closer and reaches for the cloth.

The creature freezes, allowing him to carefully untie the knot. It turns out the animal had managed to get its head stuck in one of the silk cloths hung out to dry. Freed from its makeshift headwear, the animal chirps in relief and bounds away.

Ever since, the weavers often hear it cheerfully rummaging around on the edge of the settlement at night."

[sub_resource type="Resource" id="Resource_r5g82"]
script = ExtResource("10_r7ily")
card_type = ExtResource("21_ck0eo")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_0nc6e"]
script = ExtResource("6_7dmo5")
markedup_text = "Pretend it's not there."
outcome = SubResource("Resource_r5g82")
markedup_result_text = "The apprentice closes his eyes, rubs them vigorously, and decides that staying late has finally broken his mind.

He turns his back and focuses on the work. When he finally dares to look again, the yard is empty.

He will spend the rest of his life wondering if the tiny pilgrim was real."

[sub_resource type="Resource" id="Resource_7dm7g"]
script = ExtResource("4_l6jin")
markedup_text = "An apprentice working late into the night is greeted by an odd sight. A tanuki approaches the door, walking on its hind legs, with a scarf tied around its head.

The animal looks eerily human-like in the moonlight, a diminutive pilgrim who lost his way in the night.

The apprentice wonders if it's a sign from the Enlightened One."
background_image = SubResource("Resource_l6jin")
background_credit = ExtResource("6_l6jin")
choices = Array[ExtResource("6_7dmo5")]([SubResource("Resource_vjvrl"), SubResource("Resource_t2i5h"), SubResource("Resource_6ab2a")])
exit_choice = SubResource("Resource_0nc6e")


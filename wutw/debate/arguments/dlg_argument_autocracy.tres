[resource]
script = ExtResource("1_ffqkw")
dialogue_id = "debate_autocracy"
record_title = "Debate Speech: The Power of One"
text = "PAGE: historian(PORTAL_NETWORK), AUDIENCE
historian: There is a shard out there in the Cloud Sea where one man's word is the law.
historian: It is remarkably effective.
historian: When the Overseer declares that something must be done, it gets done.
historian: If he says that a river must be dammed, it is dammed.
historian: If he says that a town must be replaced by a palace, it is replaced by a palace.
historian: I'm sure none of us would want to live on that shard.
historian: Yet the Scribe says that we must let a person lead not just one shard, but the entire world.
historian: Now, I have gotten to know the Avatar, and I have no doubt that they want only the best for our people.
historian: But what happens when the next leader comes, once we are used to taking orders from a single voice?
historian: Can we truly trust that no tyrant or fool will ever misuse this power?"
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

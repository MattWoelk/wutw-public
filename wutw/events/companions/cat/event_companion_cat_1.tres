metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_5wq3a"]
script = ExtResource("10_d4c3j")
markedup_text = "Help the cat catch the toad."
outcome = SubResource("Resource_yu5w1")
markedup_result_text = "A settler approaches the toad, hoping to block its path of retreat.

Instead, the toad is alerted by the movement and leaps off the rock, quickly disappearing into the water.

The cat shoots the settlers a profound look of disapproval before slowly walking away."


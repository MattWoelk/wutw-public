[sub_resource type="Resource" id="Resource_tr52n"]
script = ExtResource("5_t3uxx")
markedup_text = "Craft additional baskets."
requirement = SubResource("Resource_ys2ow")
outcome = SubResource("Resource_rebnn")
markedup_result_text = "The farmers gather wood and rope, and commission extra baskets from the artisans.

The work takes time, but soon there are enough baskets to carry both harvests and children with no delays, making the sky ropeways busier than ever."


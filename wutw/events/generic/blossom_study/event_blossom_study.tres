[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_ubs0w")
markedup_text = "Forbid any study."
outcome = SubResource("Resource_kjam1")
markedup_result_text = "The scholar is asked to leave the field untouched.

She storms off with a few muttered protests.

The blossoms continue their gentle sway."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("3_nu75p")
markedup_text = "The flowers here bloom without end. Even as petals fly off in the wind, new ones begin sprouting.

Locals admire the view in awe, but a scholar claims the secret of this renewal lies under the soil.

She proposes digging up the plants, stalk, root, and all.

\"We might learn something to restore other lands,\" she argues.

The ranger, however, worries that the flowers may stop growing back once disturbed."
background_image = SubResource("Resource_nu75p")

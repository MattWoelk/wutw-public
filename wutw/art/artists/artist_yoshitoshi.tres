[resource]
script = ExtResource("4_frwku")
name = "Tsukioka Yoshitoshi"
portrait = SubResource("Resource_o8uy8")
blurb = "Tsukioka Yoshitoshi was a printmaker working during the end of the Edo and the beginning of the Meiji period. He was a holdout of the traditional style when woodblock printing was rapidly being replaced by Western technologies like photography.

In his early career he focused on extremely graphic and shocking depictions of violence, but later in life he transitioned to depicting historical subjects, folklore, and ghosts.

Yoshitoshi suffered from severe depression, and despite being widely recognized as the foremost ukiyo-e master of the time, spent much of his short life destitute."
birth_year = 1839
death_year = 1892
link = "https://en.wikipedia.org/wiki/Tsukioka_Yoshitoshi"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

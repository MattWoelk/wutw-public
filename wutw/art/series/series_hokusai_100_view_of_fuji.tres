[resource]
script = ExtResource("2_5y2ag")
name = "100 Views of Mount Fuji"
blurb = "This is a series of three illustrated books, considered one of Japan's most exceptional.

The books contain over a hundred views of Mount Fuji in various styles and settings. Hokusai shows the peak in pure landscapes, with flora and fauna, in religious and mythological scenes and with different atmospheric effects, but above all, he focuses on ordinary people at work.

The first two volumes are celebrated for their very high standards of woodblock printing, despite being monochromatic."
start_year = 1835
end_year = 1849
artist = ExtResource("1_anavm")
link = "https://en.wikipedia.org/wiki/One_Hundred_Views_of_Mount_Fuji"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

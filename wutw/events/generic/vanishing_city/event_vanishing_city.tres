relic = ExtResource("12_3s1rx")
metadata/_custom_type_script = "uid://bbr46symu7hfi"

[sub_resource type="Resource" id="Resource_dxr1u"]
script = ExtResource("9_fpfn6")
markedup_text = "Show them a coin with the image of the palace."
requirement = SubResource("Resource_tpm0g")
markedup_result_text = "The guards' already unusually large eyes get even larger and they briefly talk among themselves. One points to a nearby bench and walks away."
result_event_step_id = "bargain"
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_w1sgm"]
script = ExtResource("9_fpfn6")
markedup_text = "Return empty-handed."
markedup_result_text = "The scout is unable to argue, and meekly steps back through the gate.

Perhaps someone else will uncover this mystery in the future."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_kj5so"]
script = ExtResource("2_jmo1r")
event_step_id = "courtyard"
markedup_text = "A scout steps through and finds himself in the courtyard of a small palace. The entire place seems to be carved from pure white stone, and golden spires sparkle atop the domed roofs.

Within moments, guards dressed in strange flowing outfits bar his way. Although their language is unfamiliar, it is clear that they are telling the scout to go back."
background_image = SubResource("Resource_c0cyj")
background_credit = ExtResource("13_7im1k")
choices = Array[ExtResource("9_fpfn6")]([SubResource("Resource_dxr1u")])
exit_choice = SubResource("Resource_w1sgm")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"

[sub_resource type="Resource" id="Resource_g2bpn"]
script = ExtResource("8_egpic")
_texture_path = "uid://6pr4caeskvrg"
_is_horizontal = false
metadata/_custom_type_script = "uid://c7u2t141hgkj5"

[sub_resource type="Resource" id="Resource_egpic"]
script = ExtResource("11_b1pv4")
relic = ExtResource("13_g7dra")
metadata/_custom_type_script = "uid://bbr46symu7hfi"

[sub_resource type="Resource" id="Resource_7im1k"]
script = ExtResource("9_fpfn6")
markedup_text = "Leave him a familiar tale written in our language."
requirement = SubResource("Resource_egpic")
markedup_result_text = "The old man gets animated at the sight of the scroll. He hastily takes a tiny blank book and a small charcoal-tipped rod from inside a patch sewn onto his garment, then starts drawing glyphs.

He thrusts the book in front of the scout's face, two glyphs clearly drawn on the paper. The glyph shapes are unusual, but they are recognizable: \"Good\" and \"Meeting\".

The scout and the old man take turns writing in the strange little book.

\"Explorer\", the scout writes.
\"Origin location question\", the man responds.
\"Desert gate\"
\"Coin question\"
\"Foreign man\"
\"Origin palace no return\"

It doesn't take long before they start communicating in simple sentences."
result_event_step_id = "dialogue"
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_4n0ji"]
script = ExtResource("9_fpfn6")
markedup_text = "Return empty-handed."
markedup_result_text = "The scout is unable to find a common tongue, and meekly steps back through the gate.

Perhaps someone else will uncover this mystery in the future."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_myteg"]
script = ExtResource("2_jmo1r")
event_step_id = "bargain"
markedup_text = "She returns with an old man, his bushy, greying beard sticking out like a halo around his face. The man greets the scout in a language that sounds much closer to ours, but it is still incomprehensible.

The scout tries to communicate, but despite efforts on both sides, no progress is made."
background_image = SubResource("Resource_g2bpn")
background_credit = ExtResource("15_egpic")
choices = Array[ExtResource("9_fpfn6")]([SubResource("Resource_7im1k")])
exit_choice = SubResource("Resource_4n0ji")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"

[sub_resource type="Resource" id="Resource_x24b1"]
script = ExtResource("8_egpic")
_texture_path = "uid://6pr4caeskvrg"
_is_horizontal = false
metadata/_custom_type_script = "uid://c7u2t141hgkj5"

[sub_resource type="Resource" id="Resource_yc8on"]
script = ExtResource("9_fpfn6")
markedup_text = "Ask to explore the city."
markedup_result_text = "The man writes \"Foreign person forbid\", followed by \"Isolation make peace\", then looks apologetic. \"Old fear\", he adds, underlining the glyphs."
result_event_step_id = "dialogue"
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_0dfyw"]
script = ExtResource("9_fpfn6")
markedup_text = "Ask what this place is."
markedup_result_text = "The man writes \"Safe place ancestor flee big war\".

He draws a crude sketch of one of the iron wrecks that explorers find in the wastelands, then makes \"shuuu-pkha\" sounds and waves his arms.

\"Now thousand year peace,\" he writes."
result_event_step_id = "dialogue"
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_wda2j"]
script = ExtResource("9_fpfn6")
markedup_text = "Ask to establish future communications."
markedup_result_text = "The man writes \"I want many person forbid\" and gives a sad smile. \"Safety yes knowledge no\", he adds. Then \"gate future closed\"."
result_event_step_id = "dialogue"
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_3s1rx"]
script = ExtResource("14_qqy6i")
scope = 1
var_id = "finished"

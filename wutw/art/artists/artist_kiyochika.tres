[resource]
script = ExtResource("3_56esb")
name = "Kobayashi Kiyochika"
portrait = SubResource("Resource_jqjob")
blurb = "Kobayashi Kiyochika was a printmaker best known for his newspaper illustrations. He was active in the Meiji period, and documented the rapid modernization and Westernization of Japan, depicting the influx of new technologies and shifting urban landscapes.

His specialty was night scenes illuminated by sources within the composition, but his best known works are propagandistic caricature prints, often depicting foreigners as foolish, and modern products as aesthetically inferior.

Some consider his work to be the last significant example of traditional ukiyo-e before the [url=art_style:shin-hanga]shin-hanga[/url] revival."
birth_year = 1847
death_year = 1915
link = "https://en.wikipedia.org/wiki/Kobayashi_Kiyochika"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

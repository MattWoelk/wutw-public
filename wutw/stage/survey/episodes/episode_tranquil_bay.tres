[sub_resource type="Resource" id="Resource_i0wr6"]
script = ExtResource("2_bbjpt")
label = "Smash the box open."
aspects = Array[ExtResource("3_wwac5")]([ExtResource("15_fcf1b")])
outcome = SubResource("Resource_e7hfo")
outcome_text = "Not wanting to disturb the roots of the trees, the surveyors find a large stone and strike the corner of the box.

The wood splinters, followed by the sound of shattering clay. A sweet-smelling golden liquid oozes out, soaking into the sand."

[sub_resource type="Resource" id="Resource_losej"]
script = ExtResource("2_bbjpt")
label = "Leave the box."
aspects = Array[ExtResource("3_wwac5")]([null])
outcome_text = "The surveyors paddle their boat past the tiny islet, letting the box remain undisturbed."

[resource]
script = ExtResource("16_vudsb")
episode_id = "tranquil_bay"
title = "The Tranquil Bay"
biome_types = Array[int]([10, 1])
text = "The scouts find themselves under a sunset sky full of pink clouds. A tranquil bay spreads before their eyes.

Two of the surveyors get into a small boat and row towards a tiny pine-covered tidal islet, where a weathered gate stands solemnly in the cooling sand.

As they draw nearer, they notice a small wooden box hiding among the roots."
background_image = SubResource("Resource_mpaof")
background_credit = ExtResource("1_bbjpt")
choices = Array[ExtResource("2_bbjpt")]([SubResource("Resource_dkqcl"), SubResource("Resource_4njyc"), SubResource("Resource_i0wr6"), SubResource("Resource_losej")])

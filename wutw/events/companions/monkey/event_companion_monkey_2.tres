[sub_resource type="Resource" id="Resource_br0a8"]
script = ExtResource("6_qijx8")
markedup_text = "Splash water at the monkey."
requirement = SubResource("Resource_egc2n")
outcome = SubResource("Resource_32kva")
markedup_result_text = "A playful settler scoops up a handful of water and splashes the monkey.

The animal reaches into the water and splashes it right back at the settlers.

A chaotic water fight breaks out, leaving everyone soaked and laughing."

[sub_resource type="Resource" id="Resource_f72rq"]

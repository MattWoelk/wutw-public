[sub_resource type="Resource" id="Resource_ptldf"]
script = ExtResource("5_dmlww")
markedup_text = "Use their cloth in the hut's banner."
requirement = SubResource("Resource_swhw0")
outcome = SubResource("Resource_xxhwh")
markedup_result_text = "The brightest piece is cut and stitched together with more traditional pieces into a banner above the door.

Settlers nod as they pass beneath it, some stopping to trace the threads.

The weaver continues to experiment, weaving strands of gold and silver into the next piece."

[sub_resource type="Resource" id="Resource_kio1v"]
script = ExtResource("14_6xs51")
card_type = ExtResource("13_7x4wp")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_jm8w5"]
script = ExtResource("16_6i2os")
aspect_type = ExtResource("15_d1kp1")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_nra34"]
script = ExtResource("5_dmlww")
markedup_text = "Ask them why they weave this way."
requirement = SubResource("Resource_jm8w5")
outcome = SubResource("Resource_kio1v")
markedup_result_text = "The weaver pauses.

\"Because it feels like me,\" they say. \"And I want to make something that feels like me... and still holds.\"

They offer a small piece of thread. \"It's strong. Even if it's soft.\""


piece_name = "Koto Furunushi and Biwa Bokuboku"
series = ExtResource("4_t31uy")
styles = Array[ExtResource("5_fwew4")]([ExtResource("5_t31uy"), ExtResource("6_t31uy")])
date_type = 30

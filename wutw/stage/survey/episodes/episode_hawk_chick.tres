[resource]
script = ExtResource("16_8qcn1")
episode_id = "hawk_chick"
title = "The Baby Hawk"
biome_types = Array[int]([1, 10])
spot_types = Array[ExtResource("17_u1pov")]([ExtResource("18_bn7xh"), ExtResource("19_3h6pv")])
text = "As the survey team hikes up a steep path, they see a hawk racing overhead. It lands on a pine tree and cries out sharply.

The scouts hear another cry, and looking down, see a small nestling stuck in a thorny shrub, helplessly flapping its wings."
background_image = SubResource("Resource_rqkin")
background_credit = ExtResource("1_6di8s")
choices = Array[ExtResource("2_6di8s")]([SubResource("Resource_8qym0"), SubResource("Resource_khd6g"), SubResource("Resource_oewu8"), SubResource("Resource_h2na2")])

[sub_resource type="Resource" id="Resource_t2i5h"]
script = ExtResource("6_7dmo5")
markedup_text = "Pray to it."
requirement = SubResource("Resource_pun4p")
outcome = SubResource("Resource_bjjns")
markedup_result_text = "Overwhelmed by the eerie sight, the apprentice drops to his knees and begins loudly chanting a half-remembered prayer.

The creature stops dead in its tracks, clearly unnerved by this strange human behavior.

It turns around and rapidly scurries back into the woods, its headscarf flashing white in the moonlight."


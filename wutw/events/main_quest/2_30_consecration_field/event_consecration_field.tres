metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_d5ak5"]
script = ExtResource("4_bomh3")
event_step_id = "blood"
markedup_text = "A shallow cut is made across each disciple's palm, as they walk in a careful procession through the meadow, tracing a great glyph in a trail of red.

Days pass as incantations are chanted. Soon, the effects begin to show.

What once was a sea of purple begins to bloom with splotches of pale pink blossoms. The pink slowly deepens, and by the end of the week the whole meadow is ablush with scarlet.

\"Our blood has opened the gate,\" the disciples agree. \"This place is now a channel of the Enlightened One's powers.\"

The scent of iron hangs in the air, but none speak of it."
background_image = SubResource("Resource_2cpbm")
background_credit = ExtResource("6_aa4gq")
exit_choice = SubResource("Resource_dtrne")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


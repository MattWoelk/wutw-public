[sub_resource type="Resource" id="Resource_10wrw"]
script = ExtResource("6_y5ee4")
markedup_text = "Choreograph a dance based on their movements."
requirement = SubResource("Resource_j8rb5")
outcome = SubResource("Resource_jqge5")
markedup_result_text = "The farmers watch the deep bows and elegant leaps in quiet awe, trying to memorize the pattern.

They adapt the birds' motions into a graceful dance, which becomes a frequent sight during wedding ceremonies."

[sub_resource type="Resource" id="Resource_quleu"]

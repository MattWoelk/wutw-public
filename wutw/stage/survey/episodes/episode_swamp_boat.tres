[sub_resource type="Resource" id="Resource_wwgns"]
script = ExtResource("2_qjdoq")
label = "Row to land."
aspects = Array[ExtResource("3_ujufw")]([ExtResource("10_cdp5i")])
aspects_per_season = Array[ExtResource("3_ujufw")]([null])
outcome = SubResource("Resource_0l1ne")
outcome_text = "The scouts quickly row to a nearby clump of thickly growing reeds. They disembark just as the boat finally sinks.

They find themselves knee-deep in the oozing muck, where they stay, cursing their fate, until the other boats catch up."


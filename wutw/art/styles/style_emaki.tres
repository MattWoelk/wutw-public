[resource]
script = ExtResource("1_0ew10")
name = "E-maki"
blurb = "Literally \"picture scroll\", these are horizontal, heavily-illustrated scrolls which arose as a narration system during the Nara-period (710-794). Unlike most of the art in the game, these are not woodblock prints.

Initially the style copied its much older Chinese counterpart, but by the 10th century the Japanese tradition developed its own distinct style.

The scrolls are usually made of paper, but sometimes use silk instead. They are usually from 1 to 3 meters in length, but some reach as long as 12 meters. They are painted, drawn, or (rarely) stamped, and usually intersperse calligraphy and illustrations."
start_year = 710
end_year = 1500
link = "https://en.wikipedia.org/wiki/Emakimono"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

[resource]
script = ExtResource("3_0kb4b")
original_image = SubResource("Resource_bcsnl")
piece_name = "Hamamatsu: Murmuring Pines"
series = ExtResource("4_ntq01")
artist = ExtResource("1_ntq01")
styles = Array[ExtResource("5_37w5n")]([ExtResource("6_5b7c4")])
actual_start_year = 1842
actual_end_year = 1842
date_type = 1
edits_description = "The sails on the horizon and the text were removed and the image was cropped."
final_image_tex = SubResource("Resource_jg17w")
province = 53
blurb = "Depicts the famed pines on the shore near Hamamatsu, for which the town was named (literally \"pine beach\").

The word translated as \"murmuring\" in the title is \"zazanza\", an onomatopeia specifically for wind rustling through the tops of pine trees, most notably used in Edo-period folks songs. Japanese has an endless amount of such onomatopeia words for a variety of meanings, including many having to do with abstract concepts and feelings rather than real sounds."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

original_image = SubResource("Resource_bcsnl")
piece_name = "Sazai Hall of the Temple of the Five Hundred Arahants"
series = ExtResource("5_nxqym")
artist = ExtResource("1_3fc6i")
styles = Array[ExtResource("6_2yiwu")]([ExtResource("7_5xd02"), ExtResource("8_oihum")])
actual_start_year = 1830
actual_end_year = 1832
date_type = 1
custom_link = "https://ukiyo-e.org/search?q=Katsushika+Hokusai+-+Sazai"
edits_description = "The image was cropped."
final_image_tex = SubResource("Resource_br3u5")
province = 71
blurb = "The Sazaidō (literally, Turban-shell Tower, owing to its spiral staircase) is a three-story tower that was built in 1741 as a temple dedicated to the five hundred Rakan, or arahants, Buddhists who have achieved enlightenment. Men and women admire the view of Mount Fuji across the marshes from the temple's balcony. Mount Fuji serves here almost as a vanishing point, with the figures spread fan-like below."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_wpkqd"]
script = ExtResource("6_wtdt7")
markedup_text = "Tip the stand over."
outcome = SubResource("Resource_63e8m")
markedup_result_text = "Lacking any patience, the merchant kicks the stand, tipping it over.

The snake slithers away unharmed, if annoyed, but the melons hit the stones with a splat and shatter into a pile of wet debris."

[sub_resource type="Resource" id="Resource_ri550"]
script = ExtResource("4_dc2g0")
markedup_text = "A merchant has left several of his prized melons out on his market stand during his midday break, only to come back to a sleek little snake curling around them.

It seems the snake has found the warm fruit inviting and decided to take a nap. It awakens when the merchant approaches, and stares up at him, unwilling to part with its claimed spot."
background_image = SubResource("Resource_6844u")
background_credit = ExtResource("5_dtlwu")
choices = Array[ExtResource("6_wtdt7")]([SubResource("Resource_3q1fc"), SubResource("Resource_gckvo"), SubResource("Resource_n0gpn")])
exit_choice = SubResource("Resource_wpkqd")


[resource]
script = ExtResource("1_uvlph")
dialogue_id = "debate_redistribution"
record_title = "Debate Speech: Sharing Food"
text = "PAGE: avatar_adult(PORTAL_NETWORK), AUDIENCE
avatar_adult: Since I came to the Haven, I have been blessed by many tales from other shards.
avatar_adult: And whenever I hear of people going hungry, my heart just aches.
avatar_adult: Some of these shards suffered famines for generations.
avatar_adult: Even now, with full bellies, the memory of starvation lies deep in their souls.
avatar_adult: No one should have to live with that kind of lingering terror.
avatar_adult: While they were starving, there were other shards in the Cloud Sea wondering what to do with all their excess grain.
avatar_adult: Coming together means that when one community suffers a drought, the others can send baskets full of food to see them through.
avatar_adult: If we choose to share our paths, we become each other's keepers.
avatar_adult: A bad harvest becomes a shared burden, easily carried.
avatar_adult: We can hold each other up, and make sure that no one ever has to face a bitter winter alone."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_55ro1"]
script = ExtResource("2_vmpkk")
label = "Hide behind a rock."
aspects = Array[ExtResource("3_j5utr")]([ExtResource("7_4q157")])
aspects_per_season = Array[ExtResource("3_j5utr")]([null])
outcome = SubResource("Resource_8lsgb")
outcome_text = "The scouts head to the large boulders strewn across the beach and shelter behind the largest one they can find. 

The boulder blocks the wind and the waves, but they spend the rest of the night shivering."


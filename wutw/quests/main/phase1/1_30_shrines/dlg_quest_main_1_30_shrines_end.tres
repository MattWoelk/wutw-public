[resource]
script = ExtResource("1_t3ble")
dialogue_id = "mq_1_30_end"
record_title = "Era 一: Strongholds of Faith"
text = "PAGE: scribe(SHRINE_PRIMARY), teo(SHRINE_SECONDARY)
scribe: The shrines rise like lanterns in the mist, each one a beacon calling your name, oh Enlightened One.
scribe: But we know that scattered sparks are not enough to mend the heavens.
scribe: One flame must stand above all others.

PAGE: scribe(STUDIO_PRIMARY), explorer(STUDIO_SECONDARY)
scribe: I shall entrust you with a great duty, Explorer.
explorer: More surveys?
explorer: I'm always happy to visit new shards.
explorer: Each one is like its own little world!
scribe: They are but fragments of our past glories.
scribe: But not for much longer.
scribe: It is time for us to call upon the Enlightened One to reunite this shattered world.
scribe: We shall erect a single monument, vast and unshakable, a conduit for the divine power.
scribe: That shall be your mission.
scribe: A great expedition, greater than any launched before.
scribe: You shall prepare a shard to hold the great monastery, so the Enlightened One can walk among us again.
explorer: That is... a lot of responsibility."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

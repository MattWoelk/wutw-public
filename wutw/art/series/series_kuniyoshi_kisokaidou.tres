[resource]
script = ExtResource("2_k80es")
name = "The 69 Post Stations of the Kisokaidō Road"
blurb = "This series of 74 prints depicts the 69 rest stops along the Kisokaidō Road, plus prints for Edo, Kyōto, and a title page.

The Kisokaidō Road was an inland route connecting Edo (present-day Tōkyō) with Kyōto.

The main design of each print portrays a historical, legendary, or fictional scene associated with the location. A small panel in each print shows a view of the station."
start_year = 1852
end_year = 1853
artist = ExtResource("1_pjqaj")
link = "http://www.kuniyoshiproject.com/Kisokaido%20I.htm"

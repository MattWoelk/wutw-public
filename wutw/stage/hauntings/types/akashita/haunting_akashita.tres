[resource]
script = ExtResource("8_d81g5")
haunting_id = "akashita"
name = "Akashita"
name_japanese = "赤舌"
name_realistic = "Volcanic Ashfall"
name_translation = "Red Tongue"
description = "A dark cloud with a red tongue hangs over the mountain slopes, licking away the life from every seed that dares to sprout."
description_realistic = "Volcanic ashfall is choking the mountainside, smothering crops and wildlife."
description_long = "When the clouds turn black and the air tastes of metal, the settlers whisper of Akashita, the red-tongued cloud. They say it arises from the mountain when greed runs unchecked, farmers stealing water from their neighbor's fields.

The beast hides within dark clouds, only its fanged grin and lashing tongue peeking out to drink in the land's life. Villagers claim it licks the color from leaves and the breath from beasts, leaving only gray fields and silence behind."
image_small = ExtResource("6_dwo8d")
image_credit = ExtResource("5_o00kh")
image_small_realistic = ExtResource("7_dwo8d")
image_realistic_credit = ExtResource("7_5wukh")

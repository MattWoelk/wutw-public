amount = 15
extra_per_season = 15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_e7ixb")
markedup_text = "Stay near the surface and record the findings."
outcome = SubResource("Resource_kio1v")
markedup_result_text = "Everyone remains in the main chamber, mapping every symbol and comparing their forms to modern glyphs.

The mystery won't be solved yet, but the record will endure."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("3_c5m4p")
markedup_text = "Curious settlers shuffle into the petroglyph cave. The main chamber is large, the walls covered with a variety of glyphs. Someone in ages past has reinforced the ceiling, and the wood still holds despite the dampness.

The cave narrows in the back, leading deeper into the dark. The symbols there are fainter, the carvings subtler, but it seems others once descended further."
background_image = SubResource("Resource_lgb1a")
background_credit = ExtResource("5_lgb1a")

"AppBuild"
{
	"AppID" "3640430"
	"Desc" "Worlds Upon The Wind"

	"ContentRoot" "builds\"
	"BuildOutput" "steamworks_sdk\tools\ContentBuilder\output\"
	"SetLive" "release-candidate"

	"Depots"
	{
		"3640431"
		{
			"FileMapping"
			{
				"LocalPath" "win_full\*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
		"3640432"
		{
			"FileMapping"
			{
				"LocalPath" "linux_full\*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
	}
}

[resource]
script = ExtResource("8_sevch")
haunting_id = "kamikiri"
name = "Kamikiri"
name_japanese = "髪切り"
name_realistic = "Envy"
name_translation = "Hair Cutter"
description = "Beautiful settlers here wake up to find their hair and clothes cut up by the mysterious Kamikiri."
description_realistic = "Envy among settlers is causing widespread theft and vandalism."
description_long = "A mysterious monster with scissor-shaped claws and beak sneaks around at night, hiding among the roof beams. It waits for settlers to fall asleep, before descending on them and cutting off their beautiful locks. At times it doesn't stop there, but proceeds to ruin all the clothes in the victim's closet as well.

The Kamikiri seems to only target the most beautiful and well-off townspeople, perhaps as a punishment for their excessive ostentation."
image_small = ExtResource("5_4fjyd")
image_credit = ExtResource("5_sfhgd")

[sub_resource type="Resource" id="Resource_bm1ui"]
script = ExtResource("7_hj3uc")
markedup_text = "Retrieve an egg."
requirement = SubResource("Resource_i82jg")
outcome = SubResource("Resource_asjfx")
markedup_result_text = "The settlers pick the heaviest, best-preserved egg. Its surface is ridged, and a ring of raised metal runs along the middle.

The egg is packed carefully and sent off with the expedition for further study."

[sub_resource type="Resource" id="Resource_trtbi"]

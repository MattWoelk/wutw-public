[sub_resource type="Resource" id="Resource_76ena"]
script = ExtResource("4_utf66")
event_step_id = "blood"
markedup_text = "Sharp stakes are driven into the oldest trees, their sap gathered in flasks beneath the punctures. The liquid runs thick, almost opaque.

\"The trees offer their own tribute to the Enlightened One,\" a disciple declares. \"Their blood carries the power of life itself.\""
background_image = SubResource("Resource_k86kc")
background_credit = ExtResource("6_50hmy")
exit_choice = SubResource("Resource_m8kax")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


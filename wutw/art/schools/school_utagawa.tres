[resource]
script = ExtResource("1_dhbho")
name = "Utagawa School"
blurb = "The Utagawa school was the largest and most influential lineage of printmakers in Japanese history, dominating the ukiyo-e market during the 19th century.

Founded by Utagawa Toyoharu, the school expanded under master artists like Toyokuni, Kunisada, Kuniyoshi, and Hiroshige, who collectively produced the vast majority of all surviving woodblock prints.

Works by this school include a wide array of genres, from dramatic portraits of kabuki actors and dynamic depictions of historical warriors to sweeping landscapes and scenes of everyday life.

By organizing a highly efficient workshop system, the Utagawa school transformed printmaking into a widely accessible mass medium, and their exported works later became the primary lens through which European artists first encountered and studied Japanese aesthetics."
start_year = 1760
end_year = 1890
link = "https://en.wikipedia.org/wiki/Utagawa_school"
metadata/_custom_type_script = "uid://dht2n55p5x21w"

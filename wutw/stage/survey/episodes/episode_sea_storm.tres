[sub_resource type="Resource" id="Resource_gfx4s"]
script = ExtResource("2_vmpkk")
label = "Make a palisade."
aspects = Array[ExtResource("3_j5utr")]([ExtResource("9_f1ydn")])
aspects_per_season = Array[ExtResource("3_j5utr")]([null])
outcome = SubResource("Resource_rtars")
outcome_text = "The scouts work together to tie driftwood into a makeshift palisade and take shelter behind it.

It doesn't take long for the waves to shatter their work in an explosion of splinters.

The scouts take the hint and rush away from the shore, but by then several are already injured."

[sub_resource type="Resource" id="Resource_61j28"]
script = ExtResource("6_ggsfw")

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("5_dxnvu")
markedup_text = "Dismantle it."
requirement = SubResource("Resource_kojkx")
outcome = SubResource("Resource_rx1a8")
markedup_result_text = "The collapse is carefully planned: bracing, guiding, and disassembling one layer at a time.

It's dirty, brutal work, but when the last stone is pried loose, something glimmers within the wall's hollow: a green, sharp-edged lump of jade."


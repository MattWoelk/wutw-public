[sub_resource type="Resource" id="Resource_xxhwh"]
script = ExtResource("5_2rw46")
markedup_text = "Leave a ceremonial gift in return."
requirement = SubResource("Resource_2stvf")
outcome = SubResource("Resource_d0keq")
markedup_result_text = "The settlers leave bowls of rice and a cup of sake on the shore for the tide to claim.

The offering is gone by morning.

A few days later, a large tree branch washes onto the shore. Tucked between its forked twigs are several pre-Shattering coins."

[sub_resource type="Resource" id="Resource_mxy6s"]
script = ExtResource("7_q3yvt")
relic = ExtResource("10_45l1s")

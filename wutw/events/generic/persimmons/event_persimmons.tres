[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("14_4chv3")
bonus_type = ExtResource("8_qdkla")
min_count = 30
max_count = -1
extra_per_season = 20

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("5_3xl68")
markedup_text = "Leave the fruit for the animals."
requirement = SubResource("Resource_06ahh")
outcome = SubResource("Resource_ptcwf")
markedup_result_text = "The fruit is left where it lies.

Over the weeks, deer wander close. Birds come at dawn. A few wild boars dig in the piles.

The locals avoid the grove until all the fruit is eaten."

[sub_resource type="Resource" id="Resource_egt2j"]

[sub_resource type="Resource" id="Resource_s8tvx"]
script = ExtResource("5_kufry")
markedup_text = "Ask the spirit for help."
requirement = SubResource("Resource_6ls03")
outcome = SubResource("Resource_0webk")
markedup_result_text = "Hiroshi stops before the tallest lantern on the path. Moss covers its cracked surface, and it leans slightly, towering over the boy. Feeling a little foolish, Hiroshi bows before it and whispers a request to the swamp spirit. \"If my brother spoke the truth, show me enough to defend him.\"

The flame in the lantern glows brighter for a second, and Hiroshi feels the hair on his neck rise. Above him, the trees whisper as a sudden gust of wind blows the flame out.

Still, Hiroshi's hand lantern reveals nothing but darkness."

[sub_resource type="Resource" id="Resource_maolp"]
script = ExtResource("11_ex6a6")
relic = ExtResource("10_fdgok")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_h3vx6"]
script = ExtResource("9_utqk7")
aspect_type = ExtResource("12_5gdhs")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2mpvt"]
script = ExtResource("5_kufry")
markedup_text = "Wait at the end of the path."
requirement = SubResource("Resource_h3vx6")
outcome = SubResource("Resource_maolp")
markedup_result_text = "Remembering how Makoto's face brightened when he told his brother of the creature's enormous grin, Hiroshi resolves to be patient.

He leaves his umbrella beneath a large tree and steps out into the rain, waiting for the spirit of the swamp to appear.

When he finally gives up, he finds the umbrella missing, in its place a small pile of acorns."

[sub_resource type="Resource" id="Resource_owmt7"]

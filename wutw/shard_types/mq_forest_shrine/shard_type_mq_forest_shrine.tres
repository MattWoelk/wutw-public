[sub_resource type="Resource" id="Resource_kkltr"]
script = ExtResource("1_t5mmo")
text = "$shard_name was the site of the first official shrine to the Enlightened One in the New World. Despite an initial incident after the shrine's dedication, the monks have maintained it in perfect condition since."
time_taken = 0
metadata/_custom_type_script = "uid://bl1twid5gmdyr"

[sub_resource type="Resource" id="Resource_fhisg"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "cull_animals"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_q0ir8"]
script = ExtResource("3_hevnk")
text = "After animals were blamed for the defilement of the First Shrine, measures were taken to prevent further harm to the holy site. Moats were dug around shrines, surrounded by spiked fences to keep wildlife away, and ritual hunts are still carried out monthly to thin the local animal population."
requirement = SubResource("Resource_fhisg")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_pgc02"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "guards"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_tb0uf"]
script = ExtResource("3_hevnk")
text = "The early decision to restrict access to the First Shrine to monks has had several consequences since. As the shrine expanded with pavilions, gardens, and prayer halls, more and more of the sacred woods became inaccessible to the common people. Before long, the whole of $shrine_town became a restricted sacred area."
requirement = SubResource("Resource_pgc02")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_hyk2i"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "questioning"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_3ekxk"]
script = ExtResource("3_hevnk")
text = "What began as a brief investigation into broken fences slowly evolved into a permanent system. The monks declared that it is a holy duty of every citizen to report suspicious behavior, and hiding others' misdeeds was just as valid a reason for penance as the misdeeds themselves."
requirement = SubResource("Resource_hyk2i")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_4a30k"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "forgiven"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_mr4lw"]
script = ExtResource("3_hevnk")
text = "Soon after its founding, the First Shrine became the beating heart of $shrine_town. The repaired fences were eventually torn down, to be replaced with food stalls, which became a favored haunt for local children during the long summer evenings. Fueled by the sweet treats sold at these stalls, the children spent many an hour playing hide and seek among the tall trees surrounding the shrine."
requirement = SubResource("Resource_4a30k")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_f6yff"]
script = ExtResource("1_t5mmo")
text = "..."
min_main_quest = 200
overrides = Array[ExtResource("3_hevnk")]([SubResource("Resource_q0ir8"), SubResource("Resource_tb0uf"), SubResource("Resource_3ekxk"), SubResource("Resource_mr4lw")])
metadata/_custom_type_script = "uid://bl1twid5gmdyr"


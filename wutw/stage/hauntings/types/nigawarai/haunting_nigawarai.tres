[resource]
script = ExtResource("9_m3lsy")
haunting_id = "nigawarai"
name = "Nigawarai"
name_japanese = "苦笑"
name_realistic = "Animosity"
name_translation = "Bitter Smiles"
description = "Settlers whisper of the Nigawarai, spirits born from forced smiles that turn neighborly faces bitter."
description_realistic = "Resentment spreads among settlers, causing inefficiency and discord."
description_long = "The Nigawarai is said to arise wherever smiles hide resentment. When meals are shared without joy, and apologies ring untrue, something begins to stir. A hulking figure with a grin stretched too wide wanders between homes, licking the air for bitterness, its constant snickering an ugly hum that unsettles the heart. Those who hear it wake the next morning ready to quarrel with the first person they see.

Some say the Nigawarai was once a kindly elder who smiled through years of unspoken grievances until his mask hardened into a curse. Now he roams, reminding all that swallowed words and polite deceit rot faster than open anger."
image_small = ExtResource("7_farih")
image_credit = ExtResource("5_wt3av")
image_small_realistic = ExtResource("8_wqc4k")
image_realistic_credit = ExtResource("6_1a6i3")

[resource]
script = ExtResource("2_uo81d")
name = "100 Ghost Stories"
blurb = "A series of 5 prints depicting several yōkai, each one referencing a woman who broke some Buddhist taboo.

The series is made in reference to the tradition of Hyakumonogatari Kaidankai (\"gathering of one hundred supernatural tales\"), a popular Japanese game played at night, when people would meet to share folklore ghost stories and their own anecdotes."
start_year = 1829
end_year = 1831
artist = ExtResource("1_chjs1")
link = "https://en.wikipedia.org/wiki/One_Hundred_Ghost_Stories"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

[resource]
script = ExtResource("3_lx0tc")
name = "Shotei Hokuju"
blurb = "Shotei Hokuju was an ukiyo-e designer active roughly between 1790 and 1820. His birth and death dates are unknown.

Hokuju was a student of [url=artist:Katsushika Hokusai]Hokusai[/url], and focused mainly on landscapes. Some of his works show an unconventional style likely inspired by Western techniques."
birth_year = 1750
death_year = 1850
custom_date = "early 19th century"

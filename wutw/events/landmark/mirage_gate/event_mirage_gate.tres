[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("13_5ivp2")
result_text = "After a quick preparation, one scholar triggers a mechanism at the bottom of the gate, buried in the sand.

The gate shimmers for a moment, then drowns the desert with an ear-shattering boom.

The rescue effort takes hours.

The gate remains standing, with nary a mark on its weathered stone."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


[sub_resource type="Resource" id="Resource_saln1"]
script = ExtResource("5_t45cj")
markedup_text = "It is an evil spirit."
requirement = SubResource("Resource_8j4ln")
outcome = SubResource("Resource_3xr84")
markedup_result_text = "The boy nods solemnly. He asks the local priests about spirits and ghosts, and begins studying old manuscripts describing possessions and exorcisms.

Soon he sets out to seek a monastery and become a novice monk."


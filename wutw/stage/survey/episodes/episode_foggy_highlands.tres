metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_o2x1j"]
script = ExtResource("2_r0p81")
label = "Camp right here."
aspects = Array[ExtResource("3_wbt5a")]([ExtResource("7_punbs")])
aspects_per_season = Array[ExtResource("3_wbt5a")]([null])
outcome = SubResource("Resource_1a7fo")
outcome_text = "The scouts decide to camp right where they are before the fog catches up to them.

Mist gathers on their eyelashes and on the brims of their hats as they wait.

They are uncomfortable and chilly, but at least they are at no risk of tumbling down the slopes."

[sub_resource type="Resource" id="Resource_x1gg7"]
script = ExtResource("13_ehgis")
relic = ExtResource("12_j8vlu")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_sqnib"]
script = ExtResource("2_r0p81")
label = "Look for shelter."
aspects = Array[ExtResource("3_wbt5a")]([ExtResource("10_1wn00"), ExtResource("11_3le0g")])
aspects_per_season = Array[ExtResource("3_wbt5a")]([null])
outcome = SubResource("Resource_x1gg7")
outcome_text = "The scouts scatter, looking for places to shelter. One gasps and points at the ground.

Hundreds of spiderwebs glitter with dewdrops among the grass.

Following the webs leads the scouts to the mouth of a cave, empty but for the skittering of thousands of tiny legs."

[sub_resource type="Resource" id="Resource_s13el"]
script = ExtResource("6_qf2a5")
card_type = ExtResource("14_llkqh")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_2l4ft"]
script = ExtResource("2_r0p81")
label = "Continue walking."
aspects = Array[ExtResource("3_wbt5a")]([null])
aspects_per_season = Array[ExtResource("3_wbt5a")]([null])
outcome = SubResource("Resource_s13el")
outcome_text = "The scouts decide to stay on the path.

Soon, the fog becomes so dense that they can only see a few paces ahead, making the path indistinguishable from its surroundings.

When the fog finally lifts, they find themselves right where they started."

[resource]
script = ExtResource("15_ncdnm")
episode_id = "foggy_highlands"
title = "The Foggy Highlands"
biome_types = Array[int]([7])
spot_types = Array[ExtResource("16_r52oc")]([ExtResource("17_dspvr"), ExtResource("18_ikgao")])
text = "The temperature is dropping as the surveyors march through a steep pass across the highlands.

Ahead, a thick cloud of fog has descended over the slopes. Soon, they will find themselves swallowed up by it if they continue on the same path."
background_image = SubResource("Resource_hdks5")
background_credit = ExtResource("1_r0p81")
choices = Array[ExtResource("2_r0p81")]([SubResource("Resource_6odqe"), SubResource("Resource_o2x1j"), SubResource("Resource_sqnib"), SubResource("Resource_2l4ft")])

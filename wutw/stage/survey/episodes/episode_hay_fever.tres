[resource]
script = ExtResource("14_dqhjd")
episode_id = "hay_fever"
title = "The Itch"
biome_types = Array[int]([6])
text = "The sunny skies and warm breeze have made travelling across the plains pleasant. The surveyors whistle and sing merrily as they hike.

By late afternoon, however, the sky has become strangely hazy and several scouts have begun to sneeze. Many more complain of itchy, watery eyes."
background_image = SubResource("Resource_xqrtf")
background_credit = ExtResource("1_xcnvw")
choices = Array[ExtResource("2_xcnvw")]([SubResource("Resource_4cj1s"), SubResource("Resource_jmbf1"), SubResource("Resource_15hem"), SubResource("Resource_qo7mm")])

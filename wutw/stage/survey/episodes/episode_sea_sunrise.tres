[sub_resource type="Resource" id="Resource_xy53q"]
script = ExtResource("2_83645")
label = "Admire the view."
aspects = Array[ExtResource("3_uogi3")]([ExtResource("4_8gllq")])
aspects_per_season = Array[ExtResource("3_uogi3")]([null])
outcome = SubResource("Resource_xv5ry")
outcome_text = "The surveyors stay for a while to breathe in the briny scent of seaweed and marvel at the divine beauty of the landscape.

They watch the rocks turn orange, then yellow as the sun rises higher and higher. Seagull calls reach them from beyond the rocks, as the sea spray leaves little crystals of salt on their skin."

[sub_resource type="Resource" id="Resource_3qwgp"]
script = ExtResource("9_ox82t")

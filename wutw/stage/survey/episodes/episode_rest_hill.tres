label = "Rest briefly."
aspects = Array[ExtResource("3_iifpr")]([null])
outcome = SubResource("Resource_u5f64")
outcome_text = "The explorers stop for a brief rest, relaxing in the sun.

Someone plays a flute. A few people sketch the landscape. The rest just sit down, taking in the beautiful view."

[sub_resource type="Resource" id="Resource_78o4x"]
script = ExtResource("2_klaar")
label = "Keep hiking."
aspects = Array[ExtResource("3_iifpr")]([null])
outcome_text = "The group decides to move on, not wanting to waste any time.

As they march past the grove, a few surveyors can't help but look back at the sunny hill."

[resource]
script = ExtResource("14_8yd36")
episode_id = "rest_hill"
title = "The Restful Hill"
spot_types = Array[ExtResource("15_f2nrp")]([ExtResource("16_u5k8i")])
text = "The scouts have climbed a gently sloping hill, where a light breeze stirs the leaves and the morning sun warms their faces. The smell of crushed pine needles fills the air, and the soft grass looks inviting.

The day has only just begun, but this seems like a perfect place to rest."
background_image = SubResource("Resource_tmy53")
background_credit = ExtResource("1_klaar")
choices = Array[ExtResource("2_klaar")]([SubResource("Resource_pogdi"), SubResource("Resource_bt0lp"), SubResource("Resource_1xc0c"), SubResource("Resource_78o4x")])

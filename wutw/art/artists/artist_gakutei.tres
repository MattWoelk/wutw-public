[resource]
script = ExtResource("3_24dn1")
name = "Yashima Gakutei"
blurb = "Yashima Gakutei was an ukiyo-e artist and poet. He studied under both [url=artist:Katsushika Hokusai]Hokusai[/url] and [url=artist:Totoya Hokkei]Totoya Hokkei[/url].

He was the illegitimate son of a samurai known as Hirata who served under the Tokugawa shogunate. Gakutei's mother later married into the Yashima clan, explaining the artist's name.

Gakutei is best known for his [url=art_style:surimono]surimono[/url] works and humorous kyōka poetry. The former often featured extreme precision and elaborate embossing. He was also responsible for a Japanese translation of the famous Chinese novel Journey to the West, for which he also completed illustrations."
birth_year = 1786
death_year = 1868
link = "https://en.wikipedia.org/wiki/Yashima_Gakutei"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[resource]
script = ExtResource("5_l0p64")
name = "Shard Maps"
main = ExtResource("3_k1afk")
final_image_tex = SubResource("Resource_835j8")
blurb = "The shard maps in Worlds Upon The Wind are composed from an endless remix of elements, based on [url=https://kmalexander.com/2023/12/13/moronobu-mokuhanga-a-free-17th-century-cartography-brush-set-for-fantasy-maps/]K.M. Alexander's brushes[/url], which were made by isolating elements from [url=artist:Hishikawa Moronobu]Hishikawa Moronobu[/url]'s travel guide called [url=art_piece:A Charted Map of the Tōkaidō]A Charted Map of the Tōkaidō[/url].

Although the map started by reusing these brushes, most of the artwork was later redrawn, and many new elements were added while trying to maintain a consistent style."
metadata/_custom_type_script = "uid://dej4hwyskx43"

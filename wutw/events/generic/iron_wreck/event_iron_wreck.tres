[sub_resource type="Resource" id="Resource_k5vk7"]
script = ExtResource("7_hj3uc")
markedup_text = "Study the construction."
requirement = SubResource("Resource_tgx7h")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "The scholars among the group study the structure of the walls. They find them made of two layers of thick metal plates, held together by rivets as thick as a person's arm.

The metal from which the plates are made is covered with a layer of grime, but once cleaned, the rough surface gleams with a dull silvery sheen. Attempts to scratch it yield no results."

[sub_resource type="Resource" id="Resource_o5rge"]
script = ExtResource("9_h0ckm")
relic = ExtResource("16_gae6a")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_ok84n"]
script = ExtResource("15_hhg3u")
aspect_type = ExtResource("17_6h1od")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ko0nn"]
script = ExtResource("7_hj3uc")
markedup_text = "Search for inscriptions."
requirement = SubResource("Resource_ok84n")
outcome = SubResource("Resource_o5rge")
markedup_result_text = "The scholars among the group study the inside of the giant beast looking for sign of writing, but if any inscriptions ever graced the walls, they no longer survive.

Further search, however, uncovers a compartment with several sheets of a thick, waxy material that resembles smooth paper. On it are detailed drawings of complex mechanisms."

[sub_resource type="Resource" id="Resource_2hk7u"]
script = ExtResource("7_hj3uc")
markedup_text = "Leave it alone."
markedup_result_text = "The group decides to leave the beast alone, letting it continue its vigil over the wasteland."

[sub_resource type="Resource" id="Resource_yaxsg"]
script = ExtResource("4_t36ij")
markedup_text = "The huge metal beast stands forlorn among the dry cracks of the wasteland. Even before the Shattering, these giants were considered ancient, the remnants of a civilization long gone.

Until recently, settlers have avoided coming near them, afraid to disturb ancient curses, but today a group of adventurers and scholars have decided to explore one.

Inside they find the decayed remains of levers and gears, most now fused to the metal walls. One wall is full of racks containing large metal eggs. A few are noticeably heavier."
background_image = SubResource("Resource_fb7ua")
background_credit = ExtResource("5_jx6bw")
choices = Array[ExtResource("7_hj3uc")]([SubResource("Resource_bm1ui"), SubResource("Resource_k5vk7"), SubResource("Resource_ko0nn")])
exit_choice = SubResource("Resource_2hk7u")


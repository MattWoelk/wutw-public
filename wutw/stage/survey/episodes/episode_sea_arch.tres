[sub_resource type="Resource" id="Resource_7silw"]
script = ExtResource("2_ryrc3")
label = "Let him deal with it."
aspects = Array[ExtResource("3_r7eoy")]([null])
aspects_per_season = Array[ExtResource("3_r7eoy")]([null])
outcome = SubResource("Resource_arx8d")
outcome_text = "The scout makes it two thirds of the way down before his foot slips on the wet rocks and he comes hurtling down.

He is only a little bruised, but he will remember this fall for a while."

[resource]
script = ExtResource("12_s5yt2")
episode_id = "sea_arch"
title = "The Seashore Arch"
biome_types = Array[int]([1, 10])
text = "The survey team has stopped under a naturally formed stone arch rising above the seashore. As they are busy mapping the coastline, a voice comes calling from above.

One of the scouts has climbed the arch to win a bet, and is now regretting that decision. His triumphant smile faded the moment he tried to descend. It seems climbing down the slick rocks is proving a lot more difficult than getting to the top."
background_image = SubResource("Resource_b6q84")
background_credit = ExtResource("1_ryrc3")
choices = Array[ExtResource("2_ryrc3")]([SubResource("Resource_831j0"), SubResource("Resource_pjkqs"), SubResource("Resource_dxvih"), SubResource("Resource_7silw")])

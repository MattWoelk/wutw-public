[resource]
script = ExtResource("4_ueghy")
name = "Shibata Zeshin"
portrait = SubResource("Resource_o8uy8")
blurb = "Shibata Zeshin was arguably Japan's greatest lacquer painter, who also worked in printmaking. He is notable for his masterful use of urushi-e, a technique where lacquer is applied directly to paper.

By mixing lacquer with traditional pigments, he gave his woodblock prints a stylish glossy finish and rich textures that mimicked expensive lacquerware. He applied this technique to nature studies, still lifes, and depictions of folklore.

Although he was eventually appointed as an official Imperial Household Artist, and was celebrated internationally, his work was criticized in Japan for being too traditional during a time of immense innovation."
birth_year = 1807
death_year = 1891
link = "https://en.wikipedia.org/wiki/Shibata_Zeshin"
schools = Array[ExtResource("2_3rec1")]([ExtResource("3_f573t")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

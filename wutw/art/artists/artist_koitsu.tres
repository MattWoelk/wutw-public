[resource]
script = ExtResource("2_r8a3a")
name = "Tsuchiya Kōitsu"
portrait = SubResource("Resource_7ijot")
blurb = "Tsuchiya Kōitsu was a prominent artist of the [url=art_style:shin-hanga]shin-hanga[/url] movement. He trained under [url=artist:Kobayashi Kiyochika]Kobayashi Kiyochika[/url] for 19 years, and initially focused on works depicting scenes from the First Sino-Japanese War. Later in life, he specialized in highly atmospheric landscape prints.

He is best known for his evocative evening and night scenes, masterfully capturing the warm glow of lanterns against snow, rain, and mist. His most celebrated works focus on serene temples, shrines, and rural settings.

By combining Western approaches to lighting with classic Japanese subjects, his prints became highly popular both domestically and abroad, capturing the beauty of historic sites during a period of rapid modernization."
birth_year = 1870
death_year = 1949
link = "https://en.wikipedia.org/wiki/Tsuchiya_Koitsu"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

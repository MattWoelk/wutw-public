delta = -5
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_7co7c"]
script = ExtResource("6_d1nfr")
markedup_text = "Abandon the project entirely."
outcome = SubResource("Resource_0ri2n")
markedup_result_text = "Defeated by the brevity of human existence, the architect discards the idea.

He decides to stick to designing practical constructions, buildable in a month, and leaves the grand dreams behind."

[sub_resource type="Resource" id="Resource_f6xqx"]
script = ExtResource("4_1odid")
markedup_text = "The architect of the waterwheel has been sitting by the town's resident turtle, daydreaming of future projects.

In his imagination, a sprawling, magnificent castle rises from the ground.

His daydream, however, is spoiled by realizing that such a project is bound to take multiple lifetimes to finish."

[sub_resource type="Resource" id="Resource_aogak"]
script = ExtResource("2_rdu6e")
label = "Hug the cliff face."
requirement = SubResource("Resource_n1bc0")
aspects = Array[ExtResource("3_3sl0g")]([ExtResource("4_ir0fq")])
outcome = SubResource("Resource_m5062")
outcome_text = "The team presses flat against the rock and slowly shuffles across. Unfortunately, just as most of them reach the other side, one scout slips and falls into the sea. He is eventually rescued, but not before suffering minor injuries."


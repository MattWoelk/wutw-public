[sub_resource type="Resource" id="Resource_r8upj"]
script = ExtResource("5_shas5")
markedup_text = "Akiko is right."
requirement = SubResource("Resource_83uqf")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "Akiko lays down her buckets and refuses to return to the flats until Haruko agrees to work beside her, even on market days.

The buckets remain empty for a time, with neither sister agreeing to work at all. At last, Haruko rolls up her sleeves and joins in the work. She proves herself to be industrious, and soon she is bringing back more salt than most of the salters.

Akiko's anger softens, but the merchants find no familiar face to greet them. Some pass through the town without even stopping."

[sub_resource type="Resource" id="Resource_a6ufw"]

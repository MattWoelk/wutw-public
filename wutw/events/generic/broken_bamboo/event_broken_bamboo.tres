[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("5_3tl6q")
markedup_text = "Whittle the broken bamboo into chopsticks."
requirement = SubResource("Resource_ptcwf")
outcome = SubResource("Resource_nthfn")
markedup_result_text = "The settlers gather the fallen stalks, trimming them down into simple tools.

A hundred slender pairs of chopsticks take shape.

Whatever caused the damage, life must go on."


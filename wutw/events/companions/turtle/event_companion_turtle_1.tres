[sub_resource type="Resource" id="Resource_hip1w"]
script = ExtResource("9_ssmio")
markedup_text = "Tell the tale of the straw cape turtle."
requirement = SubResource("Resource_w84c1")
outcome = SubResource("Resource_77ynk")
markedup_result_text = "A young diver recounts the old tale, as told to her by her grandparents.

According to legend, a turtle which lives ten thousand years grows a tail of seaweed that looks like a straw cape. This cape is proof that the turtle had reached complete harmony with nature and became enlightened.

So can humans, the story seems to suggest, attain enlightenment by moving slowly and carefully through life."


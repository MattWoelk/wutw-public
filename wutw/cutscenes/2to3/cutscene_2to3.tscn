[node name="Cutscene_2to3" type="Node2D" unique_id=1375775163]
material = SubResource("ShaderMaterial_h0xtj")
script = ExtResource("4_dh3gf")
texts = Array[String](["We studied the wind and commanded the spirits.
We tapped the hidden powers to force the world whole.", "But the land trembled beneath our spells, and the spirits turned away.
Our force only carved deeper wounds into the land.", "In defeat, we found humility.
We saw, at last, that force without respect only deepens the rift.", "Once more we looked to you, oh Enlightened One, to guide us.
To plead our case before the restless earth, and beg its forgiveness."])
voice_lines = Array[AudioStream]([ExtResource("5_j3bxh"), ExtResource("6_dh3gf"), ExtResource("7_m0ynr"), ExtResource("8_8r6hj")])

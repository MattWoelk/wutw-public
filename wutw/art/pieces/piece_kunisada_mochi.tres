[resource]
script = ExtResource("3_ccy1t")
original_image = SubResource("Resource_bcsnl")
piece_name = "Spring of the Wood Rat Year, Golden Fresh Mochi"
artist = ExtResource("1_8jts5")
styles = Array[ExtResource("4_oqxa5")]([ExtResource("5_ccy1t"), ExtResource("6_oqxa5")])
actual_start_year = 1863
custom_link = "https://artsandculture.google.com/asset/preparations-for-new-year-s-day-pounding-mochi-utagawa-kunisada-toyokuni-iii/EQFFToyXIcLvig?hl=en"
edits_description = "Only the second panel was used, and the text was removed."
final_image_tex = SubResource("Resource_7d811")
blurb = "This five-panel print depicts the lively custom of mochitsuki (\"pounding mochi\") in preparation for the New Year. The custom has existed for millennia, and is still practiced today.

On the right side, men are using a large mortar to pound steaming glutinous rice, while on the left the resulting sticky mass is shaped into individual cakes. In the bottom left corner is a woman grating daikon radish, which is sometimes used as a mochi topping.

The people in the print are actually popular Kabuki actors of the era. It was common in ukiyo-e prints of the era to use celebrities as stand-ins for common people."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

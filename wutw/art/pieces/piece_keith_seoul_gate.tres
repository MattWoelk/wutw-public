[resource]
script = ExtResource("2_l300p")
original_image = SubResource("Resource_bcsnl")
piece_name = "East Gate, Seoul by Moonlight"
artist = ExtResource("1_hgcvq")
styles = Array[ExtResource("4_fnggg")]([ExtResource("5_kwvjr")])
actual_start_year = 1920
actual_end_year = 1920
edits_description = "The person, the pack animal, and the lit buildings in the background were removed."
final_image_tex = SubResource("Resource_5vv68")
blurb = "Depicts the \"Gate of Uplifting Mercy\" (Heunginjimun), the Eastern of the 8 gates of the Seoul City Wall in Seoul, South Korea. Two of the gates are now destroyed, although the others are still standing. This gate was first constructed in 1398, an example of late Joseon period architecture, and rebuilt in 1869.

Elizabth Keith also produced [url=art_piece:East Gate, Seoul by Sunrise]a morning version of this scene[/url] in 1925."

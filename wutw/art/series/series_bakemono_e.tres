[resource]
script = ExtResource("1_h2cwo")
name = "Illustrations of Supernatural Creatures"
blurb = "This is a Japanese picture scroll (e-maki) of the Edo period depicting 35 bakemono (monsters) from Japanese folklore. The figures are hand-painted on paper in vivid color with accents in gold and silver pigments.

Each bakemono is labeled with its name in hand-brushed ink. There is no other writing on the scroll, no colophon, and no artist's signature or seal. Several versions of the scroll exist.

This is a prime example of [url=art_style:Yūrei-zu]Yūrei-zu[/url]."
start_year = 1660
end_year = 1660
link = "https://en.wikipedia.org/wiki/Bakemono_no_e"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

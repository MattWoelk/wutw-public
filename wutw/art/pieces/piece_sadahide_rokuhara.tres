[resource]
script = ExtResource("4_3i21v")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Battle of Rokuhara"
artist = ExtResource("1_yv3pp")
styles = Array[ExtResource("6_yaegu")]([ExtResource("5_yv3pp")])
actual_start_year = 1859
edits_description = "The triptych was stitched, text was removed, and the battle was edited out."
final_image_tex = SubResource("Resource_7th1u")
province = 38
blurb = "Depicts the burning of the Rokuhara Palace in 1333, based on The Chronicle of Great Peace. This historical epic describes the fall of the Kamakura military government in an attempt for imperial restoration led by Emperor Go-Daigo (1288-1339) with the support of the Kusunoki Masashige samurai, Nitta Yoshisada (1301-1338) and Ashikaga Takauji (1305-1358). The latter finally seized power and managed to be named shōgun. The burning of the palace was the final defeat of the Kamakura military government, leading to Japan being ruled by the Ashikaga clan from 1338 to 1573."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[resource]
script = ExtResource("4_4ho7s")
name = "Elizabeth Keith"
portrait = SubResource("Resource_o8uy8")
blurb = "Elizabeth Keith was a Scottish woodblock print artist and writer. She has the rare distinction among ukiyo-e artists of being both Western and a woman.

She traveled to Tōkyō at the age of 28 and remained there for nine years, meeting [url=artist:Shōzaburō Watanabe]Shōzaburō Watanabe[/url] who convinced her to publish her paintings as [url=art_style:shin-hanga]shin-hanga[/url] prints.

Keith's work is centered around Asian life and culture, based on her travels around Japan, China, Korea, and the Philippines. It often features landscapes, cultural rituals, and people in traditional and common dress.

She was elected a Fellow of the Royal Society of Arts in London in the 1930s."
birth_year = 1887
death_year = 1956
link = "https://en.wikipedia.org/wiki/Elizabeth_Keith"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

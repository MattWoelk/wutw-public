[sub_resource type="Resource" id="Resource_03385"]
script = ExtResource("8_hyk2i")
text = "This was a harrowing trip. The guards at the gate refused to let me keep my clothes, and insisted that I purchase a rough hemp tunic sanctioned by the priesthood.

When I tried to pay for my stay at the inn, I found that the only accepted form of payment were tokens issued by the local shrine. The priest at the shrine demanded that I make a large offering before he would even speak to me, but he did eventually give me a few tokens in return for all the money I brought, just enough to spend two nights at the inn.

I decided to leave the next day. As I was sitting on a bench writing this report, I was mobbed by a patrol of priests accusing me of blasphemy for using holy glyphs, and escorted back to the gate."
gained_argument = ExtResource("11_mr4lw")
metadata/_custom_type_script = "uid://ciddaw1laebi3"

[sub_resource type="Resource" id="Resource_y0gv2"]

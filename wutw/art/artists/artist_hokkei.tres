[resource]
script = ExtResource("4_rv881")
name = "Totoya Hokkei"
blurb = "Totoya Hokkei was a Japanese artist best known for his ukiyo-e prints. He was one of [url=artist:Katsushika Hokusai]Hokusai[/url]'s first and best-known students, and worked in a variety of styles and genres.

In addition to mass-produced prints, he produced over 800 [url=art_style:surimono]surimono[/url] and illustrated about a hundred books.

His work also appeared under the art names Aoigazono, Aoigaoka, and Kyōsai."
birth_year = 1780
death_year = 1850
link = "https://en.wikipedia.org/wiki/Hokkei"
schools = Array[ExtResource("2_5holj")]([ExtResource("3_aov1c")])

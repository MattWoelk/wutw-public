[resource]
script = ExtResource("2_60jyf")
name = "Flourishing Business in Jōruri Town"
blurb = "A series of 8 prints depicting characters from famous plays reimagined in mundane roles of Edo-period merchants and customers. This is an example of mitate-e (見立絵), a genre that employs allusions, puns, and incongruities, often to parody classical art or events.

The name of the series references Jōruri, a form of traditional narrative music in which a tayū (太夫) sings to the accompaniment of a shamisen. Jōruri often accompanies bunraku, traditional puppet theater. The name comes from Jōruri Monogatari (The Tale of Princess Jōruri), a foundational 15th-century romantic ballad, which is a fictional romance between the historical samurai leader Minamoto no Yoshitsune and a wealthy, healing-powered Princess Jōruri."
start_year = 1852
end_year = 1852
artist = ExtResource("1_ine5d")
link = "https://commons.wikimedia.org/wiki/Category:J%C5%8Druri-machi_hanka_no_zu_(Flourishing_Business_in_Balladtown)_by_Utagawa_Hiroshige"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

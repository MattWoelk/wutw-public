[sub_resource type="Resource" id="Resource_fhxjv"]
script = ExtResource("7_rtwii")
markedup_text = "Explore the cave despite the miasma."
requirement = SubResource("Resource_j4026")
outcome = SubResource("Resource_mxkqw")
markedup_result_text = "The monks venture into the cave, braving the miasma. After hours of waiting, their fellows suspect the worst and mount a rescue mission.

They find the original explorers passed out, and quickly drag them out into fresh air. When the monks finally awaken, they share their story, punctuated by violent coughing fits.

Soon after they entered the cave, they felt a divine presence. A sense of peace bloomed in their mind, and the dragon spirit appeared to them. It commended them on their courage, and spoke of the Enlightened One's commandments. If the world is to be restored, it said, the people must make an accord with nature, a vow to keep the balance and honor the spirits of the earth."

[sub_resource type="Resource" id="Resource_hda7r"]
script = ExtResource("16_u2k0h")
card_type = ExtResource("15_grr06")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_473nj"]

[sub_resource type="Resource" id="Resource_smgwy"]
script = ExtResource("7_77xuw")
markedup_text = "Investigate the fortress."
requirement = SubResource("Resource_5yb2y")
result_event_step_id = "search"

[sub_resource type="Resource" id="Resource_l8nu6"]
script = ExtResource("7_77xuw")
markedup_text = "Leave well enough alone."
markedup_result_text = "The settlers continue to avoid the fortress, leaving it to its slow journey down into the center of the shard.

Rumors will keep spreading until someone summons the bravery to venture inside."

[sub_resource type="Resource" id="Resource_7ycmo"]
script = ExtResource("4_01lkg")
markedup_text = "In the swamp on the outskirts of town lies an old fortress. Maybe it was founded on unstable soil, or perhaps the Shattering has turned the area into a swamp later.

Several floors have already been claimed by the muck, and the rest of the structure is leaning precariously to one side.

Lately, rumors have been spreading of strange noises coming from this fortress at night, and settlers suspect that spirits have claimed the place."
background_image = SubResource("Resource_78psp")
background_credit = ExtResource("5_etune")
choices = Array[ExtResource("7_77xuw")]([SubResource("Resource_smgwy")])
exit_choice = SubResource("Resource_l8nu6")


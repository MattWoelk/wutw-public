[sub_resource type="Resource" id="Resource_aovay"]
script = ExtResource("6_1rdcd")
markedup_text = "Chase the frog away."
outcome = SubResource("Resource_8nriu")
markedup_result_text = "A settler throws a handful of mud towards the animal, appalled by its behavior, but it quickly hops away, disappearing into the reeds.

Saved from confronting the bizarre behavior, the settlers breathe a sigh of relief."

[sub_resource type="Resource" id="Resource_6464n"]
script = ExtResource("4_4okvm")
markedup_text = "By the side of the trail is a murky pond teeming with tadpoles. One of the tadpoles floats lifelessly on the surface.

A nearby frog suddenly lashes out its tongue, snaps up the dead tadpole, and swallows it whole.

The settlers are horrified by this act of cannibalism."
background_image = SubResource("Resource_8k5ij")
background_credit = ExtResource("5_8xs3i")
choices = Array[ExtResource("6_1rdcd")]([SubResource("Resource_kfxy4"), SubResource("Resource_5t88q"), SubResource("Resource_jsi1l")])
exit_choice = SubResource("Resource_aovay")


[resource]
script = ExtResource("4_i13do")
original_image = SubResource("Resource_bcsnl")
piece_name = "Dancing for the Sun Goddess"
artist = ExtResource("1_gmhkb")
styles = Array[ExtResource("5_encx6")]([ExtResource("5_14hhd")])
actual_start_year = 1879
actual_end_year = 1879
date_type = 1
custom_link = "https://www.fujiarts.com/meiji-era-japanese-prints/yoshitoshi/1093227-dancing-for-the-sun-goddess-amaterasu-omikami-1879"
edits_description = "The triptych was stitched."
final_image_tex = SubResource("Resource_tx7do")
blurb = "Depicts an attempt to lure the sun goddess, Amaterasu Ōmikami, the chief deity of the Shinto pantheon, from her hiding place in a mountain cave, where she had retreated following an argument with her brother, the storm god.

In the center, the goddess of Dawn, Ame no Uzume, dances, accompanied by musicians beating a large drum, and a group of praying monks. Ame-no-Tajikarao, the god of strength, rolls out the rock blocking the cave entrance, while the leader of earthly deities, Sarutahiko-ōkami, looks on from the right side of the print.

After hearing the noise, Amaterasu opens the door of the cave a crack, letting out a sunbeam. With the cave open, the other deities could persuade her to come out and shine on the world again."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

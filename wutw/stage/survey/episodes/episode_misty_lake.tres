[sub_resource type="Resource" id="Resource_ixh2g"]
script = ExtResource("2_jw4r8")
label = "Measure the depth to navigate."
requirement = SubResource("Resource_vshe1")
aspects = Array[ExtResource("3_jcrlg")]([ExtResource("4_qbdh8")])
outcome = SubResource("Resource_3h4vs")
outcome_text = "One of the scouts ties a mallet to a rope and drops it into the water. By repeating this as the group rows around the lake, they are able to find the direction in which the depth decreases, and make their way to shore."


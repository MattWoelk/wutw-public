[resource]
script = ExtResource("4_b87c2")
name = "Narazaki Eishō"
blurb = "Narazaki Eishō was a printmaker active at the turn of the 20th century. He studied under Kobayashi Eitaku and worked at the Printing Bureau of the Ministry of Finance in Tōkyō.

He published several [url=art_style:shin-hanga]shin-hanga[/url] prints with [url=artist:Shōzaburō Watanabe]Shōzaburō Watanabe[/url], including his best-known work, Inside Asakusa Kannon Temple."
birth_year = 1864
death_year = 1936
link = "https://pages.uoregon.edu/jsmacollections/home/artists/eisho-narazaki-1864-1936-.html"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

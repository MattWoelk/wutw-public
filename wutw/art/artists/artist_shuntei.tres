[resource]
script = ExtResource("2_20udl")
name = "Katsukawa Shuntei"
blurb = "Katsukawa Shuntei was a printmaker whose works span [url=art_style:yakushe-e]yakushe-e[/url], [url=art_style:musha-e]musha-e[/url], [url=art_style:bijin-ga]bijin-ga[/url], [url=art_style:surimono]surimono[/url], landscapes, and book illustrations.

He is best known for battle scene triptychs, which were unlike the single-sheet warriror prints of the time.

Relatively few of his works survive."
birth_year = 1770
death_year = 1820
link = "https://woodblockprints.org/index.php/Detail/entities/342"
schools = Array[ExtResource("1_f7d77")]([ExtResource("2_5si1s")])

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("5_00o4p")
markedup_text = "Favor the silkworms."
outcome = SubResource("Resource_qq5wq")
markedup_result_text = "The settlers prioritize their silk production, and decide to risk a poor berry harvest.

The bushes are stripped bare, the berries doomed to wither on the vine.

The folks harvesting the leaves do manage to pluck the occasional early ripened ones as they work."


[sub_resource type="Resource" id="Resource_lu5kx"]
script = ExtResource("5_2nq2x")
markedup_text = "Post guards to protect the supplies."
requirement = SubResource("Resource_30hib")
outcome = SubResource("Resource_of0uw")
markedup_result_text = "The guards keep watch in shifts.

One night, someone rustles in the brush, then flees.

The thefts stop, and the camp returns to its rhythm."

[sub_resource type="Resource" id="Resource_2uh7b"]

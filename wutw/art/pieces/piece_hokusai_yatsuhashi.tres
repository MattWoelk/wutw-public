[resource]
script = ExtResource("3_7mbo3")
original_image = SubResource("Resource_bcsnl")
piece_name = "Ancient View of the Yatsuhashi Bridge in Mikawa Province"
series = ExtResource("4_7mbo3")
artist = ExtResource("1_ikswe")
styles = Array[ExtResource("4_wwccq")]([ExtResource("6_wwccq")])
actual_start_year = 1833
actual_end_year = 1834
date_type = 1
edits_description = "The text and one of the people were removed."
final_image_tex = SubResource("Resource_5vv68")
province = 52
blurb = "Depicts the yatsuhashi (\"eight [parts] bridge\") in the Mikawa Province (present-day Eastern Aichi prefecture), zig-zagging over a marsh full of wild irises. Workmen and travelers stroll along the narrow walkway, one man taking a break and sitting at the edge with his feet hanging over.

The bridge is historically associated with section 9 of the [url=https://en.wikipedia.org/wiki/The_Tales_of_Ise]Tales of Ise[/url], an 11th-century narrative poetry collection, one of the three fundamental works of the Heian period.

In this scene, Ariwara no Narihira composes an acrostic poem at an eight-planked bridge over a bed of irises (\"kakitsubata\"), starting each of its five lines with a syllable from the word \"kakitsubata\". Translated, it reads:

[i]Traveling far away I recall the days wearing Chinese-style robes and being with my beloved wife.[/i]

According to the 11th-century Sarashina Diary, the bridge had already ceased to exist by the middle Heian period, but the scene inspired many artists, and here Hokusai recreates it with figures contemporary to his time."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_jlgob"]
script = ExtResource("5_i6nmk")
markedup_text = "Let the elders mount the rescue."
requirement = SubResource("Resource_3dfey")
outcome = SubResource("Resource_awdfn")
markedup_result_text = "The elders' argument prevails. The volunteers wrap wet scarves around their mouths, gather torches from the shrine, and fell trees to create a makeshift bridge.

They cross carefully, calling out to villagers on the other side, their voices lost in the roaring cataclysm.

When the smoke clears, all of the stranded villagers are accounted for, but several of the elders are nowhere to be found."


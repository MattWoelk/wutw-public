[sub_resource type="Resource" id="Resource_cu0do"]
script = ExtResource("9_vm687")
markedup_text = "Ignore the monkeys."
outcome = SubResource("Resource_xubn0")
markedup_result_text = "The priests decide to ignore the distraction.

The monkeys, offended by the lack of attention, escalate the tantrum.

Before anyone can stop them, they grab several holy scrolls and an incense burner, and scatter them all around the courtyards before fleeing into the canopy."

[sub_resource type="Resource" id="Resource_b0iri"]
script = ExtResource("7_fdiky")
markedup_text = "The island shrine is a popular spot for visitors, who arrive regularly to leave offerings and enjoy the breeze.

Recently, a troop of monkeys has claimed the temple porch. One particularly vocal macaque has climbed a wooden pillar. It is shrieking and pointing frantically at a platter of fruit left as an offering on the altar.

The priests are stroking their chins and debating the theological implications of the monkey's behavior."
background_image = SubResource("Resource_7qq13")
background_credit = ExtResource("8_ynudo")
choices = Array[ExtResource("9_vm687")]([SubResource("Resource_5dxfe"), SubResource("Resource_nm4nr"), SubResource("Resource_ox11q")])
exit_choice = SubResource("Resource_cu0do")


[sub_resource type="Resource" id="Resource_ab2sl"]
script = ExtResource("6_qijx8")
markedup_text = "Throw a pebble to shatter the image."
outcome = SubResource("Resource_2i6xr")
markedup_result_text = "Annoyed by the distraction, a settler tosses a pebble into the center of the reflection, shattering the moon into a dozen ripples.

The monkey chitters in annoyance and retreats high into the canopy."

[sub_resource type="Resource" id="Resource_ubtyj"]
script = ExtResource("4_qp04q")
markedup_text = "The evening air around the hot springs is thick with steam. A few settlers are relaxing by the water, watching a monkey hanging precariously from a low branch.

The creature is stretching its long arm downward, desperately trying to grab the bright reflection of the moon on the still surface of the pool."
background_image = SubResource("Resource_hqs7k")
background_credit = ExtResource("5_0dm8x")
choices = Array[ExtResource("6_qijx8")]([SubResource("Resource_b7bul"), SubResource("Resource_br0a8"), SubResource("Resource_lbfhb")])
exit_choice = SubResource("Resource_ab2sl")


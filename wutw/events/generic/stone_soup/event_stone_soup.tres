[sub_resource type="Resource" id="Resource_g4wdp"]
script = ExtResource("6_priba")
markedup_text = "Offer the traveler some stew instead."
requirement = SubResource("Resource_omq3n")
outcome = SubResource("Resource_d1arc")
markedup_result_text = "Some of the settlers take pity on the traveler, and offer them the same rich stew the workers eat, along with a steamed bun.

The traveler eats ravenously while warming up by the fire.

When they continue on their way, they leave the stone behind."


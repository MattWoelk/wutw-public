min_count = 4

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("5_xyuwe")
markedup_text = "Choose the one seeking safety."
requirement = SubResource("Resource_fmixu")
outcome = SubResource("Resource_ciwob")
markedup_result_text = "The settler carves a careful plea: \"How do we best protect the expedition?\"

That night, new cracks appear. At first no one is able to make any sense of them, but finally someone suggests that they are a map with a marked path. Once followed, the expedition finds itself on a ridge with perfect sightlines, ideal for studying the whole canyon."


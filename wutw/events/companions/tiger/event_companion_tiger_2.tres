[sub_resource type="Resource" id="Resource_fhgkg"]
script = ExtResource("6_fpjml")
markedup_text = "Recite a booming verse to the beast's majesty."
requirement = SubResource("Resource_enybh")
outcome = SubResource("Resource_17q2m")
markedup_result_text = "The poet stands up and delivers a dramatic verse in a low growl, to match the tiger's fierce nature.

The tiger listens intently and seems to relax long enough for the poet to slowly walk away."

[sub_resource type="Resource" id="Resource_hv6og"]
script = ExtResource("13_ief7q")
card_type = ExtResource("16_um4tj")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_nbi8x"]
script = ExtResource("6_fpjml")
markedup_text = "Flee back down the path."
outcome = SubResource("Resource_hv6og")
markedup_result_text = "The poet jumps up and sprints toward the settlement.

This triggers the tiger's hunting instinct, and it bounds after the terrified poet, effortlessly keeping pace all the way to the tree line before losing interest and wandering off."

[sub_resource type="Resource" id="Resource_woamt"]
script = ExtResource("13_ief7q")
card_type = ExtResource("17_bkm56")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_v7q0p"]
script = ExtResource("6_fpjml")
markedup_text = "Jump down from the cliff."
outcome = SubResource("Resource_woamt")
markedup_result_text = "In a panic, the poet decides that the only way to survive the predator is to jump down.

He survives the incident with a broken leg and a life-long fear of wildlife."

[sub_resource type="Resource" id="Resource_2skm6"]
script = ExtResource("4_hgmom")
markedup_text = "A local poet likes to sit at the edge of the cliff to find inspiration in the night sky.

Tonight, the view is particularly breathtaking, with red maple leaves dancing on the wind.

However, the evening is interrupted when a tiger pads out onto the cliff's edge, playing with the leaves and staring at the moon."
background_image = SubResource("Resource_u1ph2")
background_credit = ExtResource("5_ao73i")
choices = Array[ExtResource("6_fpjml")]([SubResource("Resource_a5id8"), SubResource("Resource_fhgkg"), SubResource("Resource_nbi8x")])
exit_choice = SubResource("Resource_v7q0p")


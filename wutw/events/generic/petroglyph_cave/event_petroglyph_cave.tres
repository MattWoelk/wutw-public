[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("5_e7ixb")
markedup_text = "Follow the faint sound of water."
requirement = SubResource("Resource_ptcwf")
outcome = SubResource("Resource_40rqf")
markedup_result_text = "The most adventurous of the group trace the drip, step by step. The passage narrows, then widens sharply.

An underground river rushes through the stone, vanishing into a spiraling whirlpool.

Etched above it is a glyph everyone recognizes."

[sub_resource type="Resource" id="Resource_2stvf"]
script = ExtResource("11_r2a3a")
relic = ExtResource("10_4k50g")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("13_8aji2")
aspect_type = ExtResource("12_e2bkh")
min_count = 3

[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("5_e7ixb")
markedup_text = "Search for sources of light."
requirement = SubResource("Resource_f2op8")
outcome = SubResource("Resource_2stvf")
markedup_result_text = "A few enterprising settlers block the way behind to shut out light, then wait.

Slowly, a faint, greenish light becomes visible in the darkness.

As they descend, glowing fungi mark a sloping tunnel. Beyond it are more glyphs carved into damp pebbles.

One of the glyphs is glowing. It appears that a strange lichen has grown within the carving, giving it a soft green glow."

[sub_resource type="Resource" id="Resource_xxhwh"]
script = ExtResource("11_r2a3a")
relic = ExtResource("14_1v86i")
metadata/_custom_type_script = "uid://c72da5id7avtu"


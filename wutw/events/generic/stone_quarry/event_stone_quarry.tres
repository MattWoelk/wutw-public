[sub_resource type="Resource" id="Resource_a10y6"]
script = ExtResource("5_64d7v")
markedup_text = "Let the nearly crushed settler decide."
requirement = SubResource("Resource_206c7")
outcome = SubResource("Resource_0dnxh")
markedup_result_text = "The shaken firewood hauler is asked to speak in front of a crowd. He declares that the quarry is a danger to everyone, and demands that work stop immediately.

The resulting angry mob raids the worksite, confiscating all the tools and setting fire to the storage sheds."


[resource]
script = ExtResource("8_hqp67")
haunting_id = "raijuu"
name = "Raijū"
name_japanese = "雷獣"
name_realistic = "Thunderstorms"
name_translation = "Thunder Beasts"
description = "Settlers warn of beasts made of lightning that ride the storm clouds, striking the earth wherever a ritual is held."
description_realistic = "Severe thunderstorms frequently pass over the region, bringing lightning strikes that ignite sudden fires."
description_long = "The air grows heavy and smells of burning before the storms hit. Lightning strikes with an uncanny precision, targeting high temple spires where the most holy rituals are performed.

In the Old World, they spoke of the Raijū. These beasts of thunder sleep in the bellies of dark clouds, taking the shapes of wild dogs or badgers wrapped in crackling energy. When divine powers are invoked, these creatures are drawn to strike, leaving a trail of fire in their wake."
image_small = ExtResource("6_ycetp")
image_credit = ExtResource("6_j7hij")
image_small_realistic = ExtResource("7_j7hij")
image_realistic_credit = ExtResource("7_hdf16")

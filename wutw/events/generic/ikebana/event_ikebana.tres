[sub_resource type="Resource" id="Resource_mwbmk"]
script = ExtResource("5_a0mbk")
markedup_text = "Choose the twisted pine, a strong, sacred vessel."
requirement = SubResource("Resource_bxolv")
outcome = SubResource("Resource_rx1a8")
markedup_result_text = "The florist selects the heavy, gnarled pine branch. It is evergreen and unyielding, scarred by harsh seasons, yet stronger for it.

She boldly angles this anchor branch upward, and to complement its harshness, adds a line of stiff, golden grass reaching out from the arrangement.

Finally, she places a massive chrysanthemum on a bed of moss, the soft bloom safely sheltered beneath the protective canopy of the evergreen."


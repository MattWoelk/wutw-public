[sub_resource type="Resource" id="Resource_nd1ll"]
script = ExtResource("6_d1nfr")
markedup_text = "Break the project down into stages."
requirement = SubResource("Resource_6rdjl")
outcome = SubResource("Resource_4wj1w")
markedup_result_text = "Looking at the ancient turtle, the architect considers the long term.

Even if he can't finish the project within his lifetime, he would leave behind a legacy for future generations.

He starts breaking the design down into stages, imagining the plans he would have to hand down to his successors to ensure its success."


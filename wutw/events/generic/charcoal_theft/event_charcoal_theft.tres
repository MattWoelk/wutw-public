[sub_resource type="Resource" id="Resource_h3ugw"]
script = ExtResource("5_2nq2x")
markedup_text = "Let it be."
outcome = SubResource("Resource_2uh7b")
markedup_result_text = "The thefts continue.

Bundles vanish, and the burners continue to grumble.

No more signs appear in the clearing, but the tracks remain."

[sub_resource type="Resource" id="Resource_iw2jf"]
script = ExtResource("3_ysu3o")
markedup_text = "Charcoal has been vanishing from the camp. Never in bulk, but just enough to notice.

At first, the workers thought it was miscounted and blamed each other.

Last night, a burner followed faint footprints to a clearing, where the ashes of a tiny fire and a pile of woven reeds suggest that someone has been camping out in the open swamp."

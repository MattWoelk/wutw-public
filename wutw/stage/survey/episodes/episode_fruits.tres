[resource]
script = ExtResource("15_pyoe3")
episode_id = "fruits"
title = "Wild Fruits"
biome_types = Array[int]([4, 6, 8, 9])
spot_types = Array[ExtResource("17_b2qpm")]([ExtResource("16_sqk3c")])
text = "The team stumbles upon a grove of trees drooping under the weight of plump fruit.

They look a bit like Old World persimmons, but they have grown wild since the Shattering.

The scouts are quite hungry, but they find it suspicious that no birds or insects seem to be touching the fruit."
background_image = SubResource("Resource_p6nwn")
background_credit = ExtResource("1_vhefn")
choices = Array[ExtResource("1_2r1cx")]([SubResource("Resource_1ld54"), SubResource("Resource_vcr2v"), SubResource("Resource_gwm2c"), SubResource("Resource_tf6ca")])

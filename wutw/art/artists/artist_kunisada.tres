[resource]
script = ExtResource("4_5ih7l")
name = "Utagawa Kunisada"
portrait = SubResource("Resource_o8uy8")
blurb = "Utagawa Kunisada was the most popular, prolific and commercially successful designer of ukiyo-e woodblock prints in 19th-century Japan. In his own time, his reputation far exceeded that of his contemporaries [url=artist:Katsushika Hokusai]Hokusai[/url], [url=artist:Utagawa Hiroshige]Hiroshige[/url] and [url=artist:Kuniyoshi]Kuniyoshi[/url], who are much more famous today.

He was also known as Utagawa Toyokuni III."
birth_year = 1786
death_year = 1865
link = "https://en.wikipedia.org/wiki/Kunisada"
schools = Array[ExtResource("2_suil8")]([ExtResource("3_u8jsr")])

[sub_resource type="Resource" id="Resource_b737w"]
script = ExtResource("5_a0mbk")
markedup_text = "Choose the budding plum, a promise of blooms to come."
requirement = SubResource("Resource_ci7e5")
outcome = SubResource("Resource_ciwob")
markedup_result_text = "The florist selects the slender plum branch, dry but for a few tight, pink buds.

She anchors it completely vertical, emphasizing the starkness of the wood, and supports it with a line of pale reeds bowing away leaving a wedge of empty space.

Finally, she adds broad, dark green leaves just above the water level, drawing the eye to the tiny buds, waiting to bloom."


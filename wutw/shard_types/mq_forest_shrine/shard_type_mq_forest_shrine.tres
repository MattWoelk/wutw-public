[sub_resource type="Resource" id="Resource_wmqk8"]
script = ExtResource("8_hyk2i")
text = "As far as I could tell, this shard is no longer inhabited. Perhaps there are people living somewhere, but the town by the gate is nothing but ruins. I traveled along the old paved road for two days before turning back, and saw no people or any signs of recent use. I suppose it would be a miracle if every settled shard survived."
gained_argument = ExtResource("10_4a30k")
metadata/_custom_type_script = "uid://ciddaw1laebi3"


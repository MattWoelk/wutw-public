[resource]
script = ExtResource("4_mebrg")
original_image = SubResource("Resource_bcsnl")
piece_name = "Princess Soto'ori and Spider"
series = ExtResource("5_uap8v")
artist = ExtResource("1_sqyn3")
styles = Array[ExtResource("6_g3d6e")]([ExtResource("7_0mqya"), ExtResource("7_uap8v"), ExtResource("8_sp5y8")])
actual_start_year = 1893
edits_description = "The text overlays were edited out."
final_image_tex = SubResource("Resource_1doh0")
province = 36
blurb = "Depicts the legendary [url=https://en.wikipedia.org/wiki/Princess_Sotoorihime]princess Soto'ori[/url], considered to be one of the three Gods of Poetry.

This print is likely inspired by a famous poem attributed to her:

This is the night
my husband will come.
The little crab-
spider's action
tonight is manifest.

According to the legend, while she was waiting for a late-night visit from Emperor Ingyō, she noticed a spider descending from the ceiling. At the time it was believed that the arrival of a spider was an omen that a lover was coming to visit."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("5_xyuwe")
markedup_text = "Watch the wall all night."
outcome = SubResource("Resource_2myy3")
markedup_result_text = "The expedition camps by the canyon wall, setting a watch through the night. When the dawn arrives, the wall appears unchanged.

Some say they saw movement in the dust, and copy what they thought the pattern looked like."

[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("3_eksga")
markedup_text = "The cracks in the wall of this canyon look suspiciously like written characters. Folks claim that if one carves a question at dusk, by sunrise new cracks will appear as a response.

Several of the settlers want to give this a try, each with a different question to ask."
background_image = SubResource("Resource_46hxp")
background_credit = ExtResource("5_46hxp")
choices = Array[ExtResource("5_xyuwe")]([SubResource("Resource_4xuhh"), SubResource("Resource_3sdrw"), SubResource("Resource_kojkx")])
exit_choice = SubResource("Resource_xh6l0")


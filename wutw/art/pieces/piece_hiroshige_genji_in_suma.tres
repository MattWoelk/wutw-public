[resource]
script = ExtResource("4_gpf8a")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Elegant Prince Genji at Suma"
artist = ExtResource("1_ybnf0")
styles = Array[ExtResource("6_hba2h")]([ExtResource("5_gajdn"), ExtResource("6_73f8b")])
actual_start_year = 1853
date_type = 1
custom_link = "https://www.rijksmuseum.nl/en/collection/object/De-elegante-prins-Genji-te-Suma--bd2e0adf60b17b18fa2e7aad845f7e69"
edits_description = "Only the left frame was used, and the ships were edited out."
final_image_tex = SubResource("Resource_ay8dr")
province = 35
blurb = "This depicts a scene from chapter 12 of the Tale of Genji, a classic work written in the Heian period (11th century) by the noblewoman Murasaki Shikibu, and often considered the world's first novel.

In this chapter, Hikaru Genji goes on a year-long voluntary exile to the rustic Suma coast following one too many scandalous affairs.

The landscape portion of the triptych was designed by Hiroshige, while the figure is the work of [url=artist:Utagawa Kunisada]Utagawa Kunisada (Toyokuni III)[/url]."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

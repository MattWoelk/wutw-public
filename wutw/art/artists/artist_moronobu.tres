[resource]
script = ExtResource("4_1755p")
name = "Hishikawa Moronobu"
portrait = SubResource("Resource_o8uy8")
blurb = "Hishikawa Moronobu is widely considered the first great master and principal founder of ukiyo-e in the late 17th century. He transformed woodblock printing from simple text illustrations into highly prized standalone artworks.

He is known for popularizing the foundational themes of the floating world, particularly [url=art_style:bijin-ga]bijin-ga[/url] and vibrant scenes of the bustling pleasure quarters in Edo."
birth_year = 1618
death_year = 1694
link = "https://en.wikipedia.org/wiki/Hishikawa_Moronobu"

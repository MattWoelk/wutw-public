[resource]
script = ExtResource("2_bu1dy")
name = "Shōzaburō Watanabe"
portrait = SubResource("Resource_vol6j")
blurb = "Shōzaburō Watanabe was a publisher who launched the [url=art_style:shin-hanga]shin-hanga[/url] movement that revitalized ukiyo-e in the early 20th century. Although he only created 2 prints himself, he hired and managed most of the best-known [url=art_style:shin-hanga]shin-hanga[/url] artists, including [url=artist:Kawase Hasui]Kawase Hasui[/url], [url=artist:Ohara Koson]Ohara Koson[/url], [url=artist:Tsuchiya Kōitsu]Tsuchiya Kōitsu[/url], [url=artist:Yoshida Hiroshi]Yoshida Hiroshi[/url], and [url=artist:Charles Bartlett]Charles Bartlett[/url].

Watanabe employed expert carvers and printers, and commissioned artists to design prints that combined traditional Japanese techniques with elements of contemporary Western painting, such as perspective and shadows, exporting most of the prints to the United States and Europe.

Much of his company's stockpile of both prints and their original woodblocks was destroyed in the Great Kantō earthquake of 1923. In the following years, new versions of many of these prints were created, using re-carved blocks. Typically, the re-issued \"post-quake\" prints included changes and revisions in the designs. After the end of World War II, his heirs continued the business, [url=https://hangasw.com/]which still operates[/url]."
birth_year = 1885
death_year = 1962
link = "https://en.wikipedia.org/wiki/Sh%C5%8Dzabur%C5%8D_Watanabe"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

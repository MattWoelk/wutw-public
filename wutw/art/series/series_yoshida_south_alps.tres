script = ExtResource("2_pg24c")
name = "Southern Japan Alps"
blurb = "A series of prints depicting Japan's Southern Alps. Many of the prints depict views from the peaks, featuring pastel expanses of clouds below. Yoshida was an avid mountaineer, and these prints depict sights from his expeditions."

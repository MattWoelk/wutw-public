[sub_resource type="Resource" id="Resource_02t1p"]
script = ExtResource("10_d4c3j")
markedup_text = "Learn patience from the cat."
requirement = SubResource("Resource_mhut4")
outcome = SubResource("Resource_4bvs7")
markedup_result_text = "A monk among the settlers launches into a sermon illustrating the value of patience on the path to enlightenment.

Before he can get a few words out, the cat makes a half-hearted swipe at the toad, misses entirely, and immediately begins grooming its paw with intense focus. It projects an air of absolute certainty that it meant to do exactly that."

[sub_resource type="Resource" id="Resource_er7h7"]

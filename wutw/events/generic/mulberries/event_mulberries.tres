[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("5_00o4p")
markedup_text = "Favor the berries."
outcome = SubResource("Resource_uqh56")
markedup_result_text = "The silkworms are put on a strict diet and indoctrinated into an ascetic lifestyle.

When the berries ripen, the settlers will fill their pantries with mulberry wine and stuff themselves with millet dumplings topped with fresh berries."

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("3_f55fb")
markedup_text = "The mulberry harvest is shared between the humans, who collect the berries, and the silkworms, who feast on the leaves.

The silkworm carers want to pluck most of the leaves for their worms, but leaving the bushes bare risks stunting their growth and leading to a poor berry harvest.

The mulberries are one of the only sweet treats that the scrubland provides, and the settlers are eagerly awaiting their arrival."
background_image = SubResource("Resource_df5af")
background_credit = ExtResource("4_8e1fd")
choices = Array[ExtResource("5_00o4p")]([SubResource("Resource_ptcwf"), SubResource("Resource_f2op8"), SubResource("Resource_tuogj")])
exit_choice = SubResource("Resource_rx1a8")


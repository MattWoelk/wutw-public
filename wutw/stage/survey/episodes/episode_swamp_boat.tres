outcome = SubResource("Resource_6brqd")
outcome_text = "The scouts jump overboard, scattering in all directions.

Some of them, unable to swim, begin to panic until they realize that the water is only chest-deep."

[resource]
script = ExtResource("13_2sv2d")
episode_id = "swamp_boat"
title = "The Sinking Boat"
biome_types = Array[int]([4])
text = "As the scouts row down a stream winding its way through the swamp, one of their boats springs a leak.

As water begins to flood the bottom of the boat, they scramble to find the source and quickly discover a small hole in the hull."

[sub_resource type="Resource" id="Resource_u24rx"]
script = ExtResource("7_hkwuj")
markedup_text = "Throw some rice into the water."
requirement = SubResource("Resource_5ftnh")
outcome = SubResource("Resource_hykqj")
markedup_result_text = "The carp is distracted by the rice, and starts eating.

By the time it's full, it decides to abandon its quest and turns back downstream."

[sub_resource type="Resource" id="Resource_qgy5n"]
script = ExtResource("7_hkwuj")
markedup_text = "Leave the carp alone."
markedup_result_text = "The settlers laugh and keep walking.

The fish continues its struggle."

[sub_resource type="Resource" id="Resource_tbae2"]
script = ExtResource("4_2aqet")
markedup_text = "Folks crossing the pontoon bridge notice a carp trying to swim upstream past them. Since the boats are tied together so tightly, the carp is unable to get through.

For some reason the stubborn fish hasn't realized that it can swim under the boats, and instead keeps ramming them, trying to get them to move out of its way."
background_image = SubResource("Resource_xossu")
background_credit = ExtResource("6_pd4nd")
choices = Array[ExtResource("7_hkwuj")]([SubResource("Resource_te3ja"), SubResource("Resource_h0xwx"), SubResource("Resource_u24rx")])
exit_choice = SubResource("Resource_qgy5n")


[sub_resource type="Resource" id="Resource_qafew"]
script = ExtResource("6_gvlip")
markedup_text = "Place a feeding trough outside the watchpost."
requirement = SubResource("Resource_7js2d")
outcome = SubResource("Resource_4xuhh")
markedup_result_text = "A trough is placed by the wall and the guards refill it with leftovers once in a while.

The deer still come every night, but rather than staring at the settlers, they eat and leave."

[sub_resource type="Resource" id="Resource_h8uf2"]
script = ExtResource("6_gvlip")
markedup_text = "Do nothing and let things be."

[sub_resource type="Resource" id="Resource_1e1wx"]
script = ExtResource("4_3l7fq")
markedup_text = "Each evening a pair of deer approach the watchpost and stand looking at the settlers going about their tasks. They never cross into the town proper, although a leap could easily carry them across the simple bamboo fences.

Several townspeople find the behavior odd, perhaps even eerie, and have complained to the guards, asking them to keep wildlife away."
background_image = SubResource("Resource_qd11l")
background_credit = ExtResource("6_qd11l")
choices = Array[ExtResource("6_gvlip")]([SubResource("Resource_jpktp"), SubResource("Resource_6ye15"), SubResource("Resource_qafew")])
exit_choice = SubResource("Resource_h8uf2")


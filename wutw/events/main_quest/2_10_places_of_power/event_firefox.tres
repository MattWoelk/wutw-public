[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("6_4w352")
markedup_text = "Purify the ground with salt."
requirement = SubResource("Resource_dpp3j")
outcome = SubResource("Resource_ptcwf")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Rings of salt are poured around the withered tree.

The foxes watch from afar, silent, observing.

\"We have claimed these woods,\" The Scribe declares. \"No spirit will dare set foot here again.\""


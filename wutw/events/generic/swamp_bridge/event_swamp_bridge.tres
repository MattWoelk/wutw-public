[sub_resource type="Resource" id="Resource_8crnk"]
script = ExtResource("9_dxqiq")
aspect_type = ExtResource("6_4xjqc")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_prsjv"]
script = ExtResource("5_r38fd")
markedup_text = "Deliver the letter some other way."
requirement = SubResource("Resource_8crnk")
outcome = SubResource("Resource_t2ras")
markedup_result_text = "The young man gives up on the bridge and looks for alternatives.

He ties the letter to a pebble and hurls it with all his might towards the other side. The pebble flies through the air and disappears into the dark.

He hopes his lover will appreciate the romantic gesture."

[sub_resource type="Resource" id="Resource_ye87h"]
script = ExtResource("5_r38fd")
markedup_text = "Wait for someone else to repair the bridge."
markedup_result_text = "The confectioner bemoans his lack of bridge-mending experience and starts his trek back.

He is already running late for his other deliveries.

He is sure his lover will understand."

[sub_resource type="Resource" id="Resource_8e07r"]
script = ExtResource("3_aet83")
markedup_text = "A narrow bridge raised on stilts winds through the swamp, connecting the dry islands that comprise the settlement. A young confectioner has been walking the oldest, least used, section of the bridge every dawn. Each day a new folded poem is hidden under the sweets in his basket, bound for a lucky recipient.

This morning, just before sunrise, he finds one of the stilts rotted, and the whole section around it collapsed."
background_image = SubResource("Resource_4cgrn")
background_credit = ExtResource("4_660av")

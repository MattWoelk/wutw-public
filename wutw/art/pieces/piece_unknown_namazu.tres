[resource]
script = ExtResource("2_pxceb")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Cause of the Great Catfish at Shin Yoshiwara"
actual_start_year = 1855
actual_end_year = 1860
date_type = 1
custom_link = "https://commons.wikimedia.org/wiki/File:Namazu-e.jpg"
edits_description = "The people were edited out and the fish was retextured to match the e-maki style of other yōkai images."
final_image_tex = SubResource("Resource_nquyw")
province = 71
blurb = "Depicts people beating a giant catfish. Apparently, the women of the pleasure quarters blame the catfish for the earthquake, but the catfish is delighted to have these ladies press flesh with it, and threatens to squirm again, causing aftershocks.

This is an example of [url=https://en.wikipedia.org/wiki/Namazu#Namazu-e]namazu-e[/url], depictions of catfish as causes of earthquakes. Over a dozen prints by different artists with this motif exist. This one was made after the 1855 Edo earthquake."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

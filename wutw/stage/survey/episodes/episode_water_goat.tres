[resource]
script = ExtResource("16_egse5")
episode_id = "water_goat"
title = "The Goat"
text = "As the scouts round a narrow bend in the trail, they come face to face with a shaggy goat.

It startles and jumps away, its hooves scraping against loose stones. With a sharp bleat, it falls into the water below.

The scouts look down, and though the animal should be able to swim, it seems to be panicking."
background_image = SubResource("Resource_xdvfo")
background_credit = ExtResource("1_xufbu")
choices = Array[ExtResource("2_xufbu")]([SubResource("Resource_uq31o"), SubResource("Resource_m0fgk"), SubResource("Resource_xebkk"), SubResource("Resource_dl4bs")])

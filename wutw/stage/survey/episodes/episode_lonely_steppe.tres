[sub_resource type="Resource" id="Resource_3e2ia"]
script = ExtResource("2_hs4nh")
label = "Sing to raise morale."
requirement = SubResource("Resource_he10p")
aspects = Array[ExtResource("3_yj6tt")]([ExtResource("10_um53a")])
outcome = SubResource("Resource_w0hxf")
outcome_text = "The group begins to sing a cheerful walking song.

The happy tune sounds hollow at first, lost in the wide expanse, but soon verses are interspersed with bouts of laughter and faces begin to brighten.

The lagging scout can't help but join in when he recognizes a song from his childhood.
"


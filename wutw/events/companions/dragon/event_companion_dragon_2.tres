[sub_resource type="Resource" id="Resource_teqo2"]
script = ExtResource("7_cjhtj")
markedup_text = "Listen to the rumblings."
requirement = SubResource("Resource_f72k4")
outcome = SubResource("Resource_2myy3")
markedup_result_text = "The monks set a watch, taking turns to listen to the sounds coming from within the cave.

Soon they notice a pattern. Whenever a particularly loud rumble is heard, it is soon followed by a small eruption from the volcano.

From now on, they are able to predict these, and decide when an evacuation is in order."


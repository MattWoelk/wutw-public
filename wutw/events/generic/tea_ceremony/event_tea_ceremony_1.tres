[sub_resource type="Resource" id="Resource_40rqf"]
script = ExtResource("5_r42yy")
markedup_text = "Arrange it beautifully."
outcome = SubResource("Resource_4xuhh")
markedup_result_text = "Mats are re-aligned perfectly.

Petals are gathered and arranged on the low table.

The cups are placed carefully on folded cloth.

Few dare to speak, afraid of interrupting the host's immaculate little ritual."


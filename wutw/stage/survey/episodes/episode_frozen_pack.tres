[resource]
script = ExtResource("12_gacio")
episode_id = "frozen_pack"
title = "The Frozen Pack"
biome_types = Array[int]([7])
text = "As the survey team is climbing a steep ridge high among the icy peaks, they notice a traveler's pack, frozen solid to the rock.

The design suggests that the pack was made before the Shattering."
background_image = SubResource("Resource_4gkwy")
background_credit = ExtResource("1_sqech")
choices = Array[ExtResource("2_sqech")]([SubResource("Resource_74enk"), SubResource("Resource_pideu"), SubResource("Resource_bmmv2"), SubResource("Resource_v1c6y")])

[sub_resource type="Resource" id="Resource_esg6e"]
script = ExtResource("5_trgiv")
markedup_text = "Cull the wild animals."
outcome = SubResource("Resource_smijh")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Hunters are called. Traps are set at the forest's edge, arrows loosed into the brush.

Soon the shrine grounds fall quieter. No shuffling can be heard from the undergrowth. No pawprints disturb the soil.

The monks breathe easier, their peace no longer disturbed."


[sub_resource type="Resource" id="Resource_gl7kq"]
script = ExtResource("6_7t3xg")
markedup_text = "Stalk them from a distance."
outcome = SubResource("Resource_ckeg8")
markedup_result_text = "The guards follow the foxes, keeping their distance.

Once the foxes reach the settlement, they make a beeline for the granary. The guards wait patiently, and eventually spot the foxes running back into the marshes, carrying rats in their mouths."

[sub_resource type="Resource" id="Resource_3q1fc"]
script = ExtResource("6_wtdt7")
markedup_text = "Leave the snake undisturbed until dusk."
requirement = SubResource("Resource_bvpdb")
outcome = SubResource("Resource_5rtn8")
markedup_result_text = "The merchant decides to wait until the sun sets, hoping that the snake will leave once the melons cool down.

The plan succeeds, and by the time the market closes and he checks on the melons again, the snake is nowhere to be seen.	"


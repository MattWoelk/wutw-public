[sub_resource type="Resource" id="Resource_3ji6r"]
script = ExtResource("5_ffeea")
markedup_text = "Ritually purify the vessels."
requirement = SubResource("Resource_qibj1")
outcome = SubResource("Resource_j0pxj")
markedup_result_text = "The master potter refuses to destroy his beautiful works. Cloudy-headed and stumbling, he calls a priest instead, and commissions an elaborate ritual to banish the evil spirits haunting the pottery.

The symptoms fade soon afterwards."


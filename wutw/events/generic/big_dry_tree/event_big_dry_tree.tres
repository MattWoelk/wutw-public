extra_per_season = 20

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("5_o2csi")
markedup_text = "Establish a care routine."
requirement = SubResource("Resource_06ahh")
outcome = SubResource("Resource_f2op8")
markedup_result_text = "A schedule is made. Each week, a few woodcutters visit to check the roots and trim dead branches.

They put a small sign to mark the tree as maintained.

Soon, such signs start appearing all around the forest."

[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("5_o2csi")
markedup_text = "Leave the tree untouched."
markedup_result_text = "The woodcutters continue on.

The tree stands unchanged, or perhaps changing too slowly to notice."

[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("3_na4gp")
markedup_text = "Deep in the forest, the woodcutters pause at the foot of a towering tree, easily the largest they've ever seen.

The bark is scarred, and most of the limbs are either broken or bare. A few birds nest in hollows once shaped by age or lightning.

The tree is not dead, though. Two thin branches are lush with pink petals, reaching for the light."
background_image = SubResource("Resource_0qvpj")
background_credit = ExtResource("5_0qvpj")
choices = Array[ExtResource("5_o2csi")]([SubResource("Resource_tuogj"), SubResource("Resource_dpp3j"), SubResource("Resource_ciwob")])
exit_choice = SubResource("Resource_nthfn")


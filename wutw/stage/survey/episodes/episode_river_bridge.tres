outcome_text = "Several scouts sketch the peaceful scene.

One focuses on the graceful curve of the bridge.

Another sketches the weathered beams and moss in detail."

[sub_resource type="Resource" id="Resource_htryv"]
script = ExtResource("2_eh2mk")
label = "Leave it undisturbed. "
aspects = Array[ExtResource("3_b4ftu")]([null])
aspects_per_season = Array[ExtResource("3_b4ftu")]([null])
outcome_text = "The group pauses by the bridge, appreciating the beautiful artisanship and unwilling to risk damaging it."

[resource]
script = ExtResource("19_eoor7")
episode_id = "river_bridge"
title = "The Old Bridge"
spot_types = Array[ExtResource("20_26wmd")]([ExtResource("21_a8b1y")])
text = "As the scouts travel along the riverbank, they come across a beautiful old bridge spanning the quiet water.

Moss clings to the railing, and years of rain and sun have weathered the boards. Though decayed now, it is clear that it was once made with great care."
background_image = SubResource("Resource_2x410")
background_credit = ExtResource("1_eh2mk")
choices = Array[ExtResource("2_eh2mk")]([SubResource("Resource_nk7y4"), SubResource("Resource_51xf1"), SubResource("Resource_csivo"), SubResource("Resource_htryv")])

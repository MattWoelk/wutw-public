[sub_resource type="Resource" id="Resource_vww8x"]
script = ExtResource("4_bomh3")
markedup_text = "The expedition gathers at the edge of a vast meadow where petals sway gently in the breeze, bright and unending. Even the insects seem hushed, afraid to disturb this eternal spring.

This is the place the Scribe named in his plan, a field where the world refuses to change. A place of stillness, of [i]Stability[/i].

Disciples prepare the consecration ritual, going over the Scribe's instructions again and again."
background_image = SubResource("Resource_5c3ku")
background_credit = ExtResource("6_aa4gq")
choices = Array[ExtResource("6_5nvpy")]([SubResource("Resource_mprds"), SubResource("Resource_bco73"), SubResource("Resource_o124c"), SubResource("Resource_a16w5")])


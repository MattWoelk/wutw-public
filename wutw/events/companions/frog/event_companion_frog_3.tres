[sub_resource type="Resource" id="Resource_kfxy4"]
script = ExtResource("6_1rdcd")
markedup_text = "Explain it as practical animal behavior."
requirement = SubResource("Resource_ip8a8")
outcome = SubResource("Resource_7iuum")
markedup_result_text = "A scholar explains that animals do not follow human sensibilities, and in nature, a dead tadpole would just go to waste.

Rather than accuse the frog of cannibalism, she commends it for making the best use of its resources.

The settlers nod, but few are truly convinced."


markedup_text = "Use a mirror to scare the snake with a bright beam."
requirement = SubResource("Resource_aj18e")
outcome = SubResource("Resource_u7iqv")
markedup_result_text = "An inventive woman among the crowd takes out a mirror and uses it to reflect the sunlight right into the snake's eyes.

The snake startles, uncoils, and flees deeper into the field, clearly unhappy."


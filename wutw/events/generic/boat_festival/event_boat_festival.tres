[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("5_dhimx")
markedup_text = "Paint the sailcloth for a future festival."
requirement = SubResource("Resource_f2op8")
outcome = SubResource("Resource_kio1v")
markedup_result_text = "New sails are painted and hung to dry, flapping in the breeze.

It will be a while before they are used. Perhaps by next year there'll be enough boats to host the festival."


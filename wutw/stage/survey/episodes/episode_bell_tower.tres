[resource]
script = ExtResource("19_pl6sh")
episode_id = "bell_tower"
title = "The Bell Tower"
biome_types = Array[int]([9])
text = "Deep in the forest the survey team finds an ancient bell tower, its bronze bell still hanging at the top.

On closer inspection, the scouts realize that the bell is barely attached, and may soon fall."
background_image = SubResource("Resource_ndshu")
background_credit = ExtResource("1_cfqu8")
choices = Array[ExtResource("2_cfqu8")]([SubResource("Resource_0tstc"), SubResource("Resource_4453n"), SubResource("Resource_6m2el"), SubResource("Resource_bji3o")])

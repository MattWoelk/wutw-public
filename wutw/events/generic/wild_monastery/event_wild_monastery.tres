extra_per_season = 50

[sub_resource type="Resource" id="Resource_cowx3"]
script = ExtResource("6_7nk6e")
markedup_text = "Send a search party."
requirement = SubResource("Resource_mpu6r")
outcome = SubResource("Resource_hlhy3")
markedup_result_text = "Two nuns and a monk pack bags of seeds and walk into the wilderness.

They follow the direction in which the crows flew off in the morning, and eventually hear familiar caws in the distance.

They find the birds agitated. The entire flock is gathered, some on bushes, others on the ground, and cawing loudly. In the center is a dead crow."


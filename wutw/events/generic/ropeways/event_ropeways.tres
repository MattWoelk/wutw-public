[sub_resource type="Resource" id="Resource_tt0g2"]
script = ExtResource("5_t3uxx")
markedup_text = "Allow the children to continue."
requirement = SubResource("Resource_hrod0")
outcome = SubResource("Resource_goqhh")
markedup_result_text = "The settlers decide that the ropeways belong to all of the village, not just the farmers.

The children delight in their freedom, racing across the valley like birds in their flying baskets.

One child in particular becomes highly skilled at maintaining the ropes and pulleys, having spent so much time fiddling with them."


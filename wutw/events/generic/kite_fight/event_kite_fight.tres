[sub_resource type="Resource" id="Resource_mn1kc"]
script = ExtResource("5_5hxe2")
markedup_text = "Turn it into an aesthetic competition."
requirement = SubResource("Resource_rp32a")
outcome = SubResource("Resource_yoct5")
markedup_result_text = "The town chief intervenes, declaring that cutting strings is easy, but building a masterpiece is hard.

The abrasive strings are replaced, and instead, the kites are judged on stability and paintwork.

The millers end up victorious, with a massive kite depicting their old teacher comically glaring down on the field.

The kite catches the wind perfectly, and is left floating motionless, as if pinned to the sky."

[sub_resource type="Resource" id="Resource_ew87q"]
script = ExtResource("11_2rgrv")
bonus_type = ExtResource("10_dlotw")
amount = 20
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_b8wfm"]
script = ExtResource("13_nnk1q")
bonus_type = ExtResource("12_lwud3")
min_count = 30
max_count = -1
extra_per_season = 30

[sub_resource type="Resource" id="Resource_10ls2"]
script = ExtResource("5_5hxe2")
markedup_text = "Ban the abrasive strings."
requirement = SubResource("Resource_b8wfm")
outcome = SubResource("Resource_ew87q")
markedup_result_text = "\"We cannot afford injured hands,\" the safety warden declares. \"And this rivalry is bound to escalate.\"

The jagged strings are confiscated and replaced with plain hemp. The wagered goods are returned to their owners.

The settlers fly their kites in polite, distinct circles. It is undeniably safer, but many will miss the excitement that punctuated their months of hard labor."

[sub_resource type="Resource" id="Resource_gcpio"]
script = ExtResource("11_2rgrv")
bonus_type = ExtResource("12_lwud3")
amount = 20
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_twotf"]
script = ExtResource("9_nq21l")
aspect_type = ExtResource("14_xstf2")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_nx2w7"]
script = ExtResource("5_5hxe2")
markedup_text = "Coordinate a synchronized display."
requirement = SubResource("Resource_twotf")
outcome = SubResource("Resource_gcpio")
markedup_result_text = "The competitors are challenged not to cut lines, but to line up their kites perfectly parallel.

The new challenge requires intense focus and cooperation, but soon, more groups join in, and the sky is covered with kites dancing in perfect unison.

When the display finally lands, an impromptu celebration breaks out, uniting the former rivals by the difficulty of the challenge."


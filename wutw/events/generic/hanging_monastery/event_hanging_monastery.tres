bonus_type = ExtResource("14_01ksu")
amount = -10
extra_per_season = -10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("5_1h70n")
markedup_text = "Ignore the incident."
outcome = SubResource("Resource_rx1a8")
markedup_result_text = "Nothing is said aloud. Gossip passes among the brothers, but soon dissipates.

In the days that follow, distant creaks can be heard in the hall, which are also ignored."

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("3_2okkd")
markedup_text = "During routine maintenance, one of the brothers slipped. A link in the chain securing the building to the cliff cracked and gave way beneath his hammer.

Thankfully, the platform held.

Together, the smiths forged a new link before dawn.

Now, as the sunrise gilds the canyon walls, a heavy stillness settles over the common hall. It is time to decide what consequences should follow this mistake."
background_image = SubResource("Resource_fl8ea")
background_credit = ExtResource("5_fl8ea")
choices = Array[ExtResource("5_1h70n")]([SubResource("Resource_df5af"), SubResource("Resource_egt2j"), SubResource("Resource_dpp3j"), SubResource("Resource_trtbi")])
exit_choice = SubResource("Resource_06ahh")


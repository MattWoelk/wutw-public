[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("5_00o4p")
markedup_text = "Leave the bushes with the best berries unplucked."
requirement = SubResource("Resource_4xuhh")
outcome = SubResource("Resource_t0e50")
markedup_result_text = "The farmers carefully inspect each bush and mark ones that seem likely to produce the most berries. The harvest will be meager, but it's an efficient use of resources.

The unmarked bushes are sacrificed to the worms."


[resource]
script = ExtResource("18_xc7go")
episode_id = "big_tree"
title = "The Towering Tree"
biome_types = Array[int]([9])
text = "The team finds themselves standing in a clearing dominated by the biggest tree they'd ever seen.

One of the scouts, a priest, insists that it must be inhabited by a powerful spirit. Another, a scholar's apprentice, wants to measure it and study the factors that have let it grow so large. An adventurous fellow suggests climbing it.

The rest of the group just wants to stay a while and marvel at the size."
background_image = SubResource("Resource_3vr0c")
background_credit = ExtResource("1_p58a3")
choices = Array[ExtResource("2_p58a3")]([SubResource("Resource_vok6u"), SubResource("Resource_l6j16"), SubResource("Resource_oodnd"), SubResource("Resource_hp8qu")])

value = "true"
description = "The gate will be closed forever."
outcome_description = "The gate is closed forever."
metadata/_custom_type_script = "uid://cgvcpdtoqk4ff"

[sub_resource type="Resource" id="Resource_b1pv4"]
script = ExtResource("9_fpfn6")
markedup_text = "Leave the city forever."
outcome = SubResource("Resource_3s1rx")
markedup_result_text = "Having exhausted his questions, the scouts steps back through the gate.

Moments later, the image of the city fades and the gate goes dormant."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_fpfn6"]

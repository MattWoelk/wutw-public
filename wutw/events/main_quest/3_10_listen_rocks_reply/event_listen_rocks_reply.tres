[sub_resource type="Resource" id="Resource_ijqs6"]
script = ExtResource("7_ysv4j")
markedup_text = "Carve \"How do we rebuild the world?\""
outcome = SubResource("Resource_mm8jc")
markedup_result_text = "The question is carved at dusk. The expedition sets up camp and spends the night beneath walls.

At dawn, new cracks have appeared around the carving.

It takes the scholars a while to interpret them, but finally they realize that the glyph they are looking for is an ancient form, unused since long before the Shattering."


[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("9_j1ate")
markedup_text = "Contribute the Heavy Chunk."
requirement = SubResource("Resource_ciwob")
outcome = SubResource("Resource_0eiya")
markedup_result_text = "The smith is immediately impressed by the malleability of the strange material, and the ease with which it melts, but he finds that it lacks the solidity needed for most practical applications.

He tries mixing it into a variety of alloys, until he hit upon a discovery. Mixed with antimony, it retains its low melting point, and becomes sturdy when cooled.

The scholars quickly find a use for the new alloy: a much more durable replacement for wooden printing blocks, which can be be cast into far more intricate shapes than a carver could ever hope to produce."


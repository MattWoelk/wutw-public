[sub_resource type="Resource" id="Resource_fpc8k"]
script = ExtResource("2_rdu6e")
label = "Hammer handholds into the rock."
aspects = Array[ExtResource("3_3sl0g")]([ExtResource("9_kawr2")])
aspects_per_season = Array[ExtResource("3_3sl0g")]([ExtResource("10_yc6mv")])
outcome = SubResource("Resource_qnbnq")
outcome_text = "One scout leads the way, hammering stakes into cracks in the rock for others to use as handholds. It is slow work, but eventually everyone makes it across safely."

[sub_resource type="Resource" id="Resource_h0vfp"]
script = ExtResource("14_j1idn")
aspect = ExtResource("13_6m16w")
metadata/_custom_type_script = "uid://gu7gcielbwdr"

[sub_resource type="Resource" id="Resource_3gd63"]
script = ExtResource("2_rdu6e")
label = "Make a rope team."
aspects = Array[ExtResource("3_3sl0g")]([ExtResource("9_kawr2"), ExtResource("13_6m16w")])
outcome = SubResource("Resource_h0vfp")
outcome_text = "The scouts attach themselves to one long rope and shuffle across. Whenever one of them loses their footing, the others brace themselves to keep their teammate from falling, and everyone makes it across safely."

[sub_resource type="Resource" id="Resource_7b816"]
script = ExtResource("2_rdu6e")
label = "Hike up to the top of the cliff."
aspects = Array[ExtResource("3_3sl0g")]([null, null])
aspects_per_season = Array[ExtResource("3_3sl0g")]([null])
outcome_text = "The safe hike up to the top takes a whole day, but completely avoids the treacherous ledges, ensuring that no one gets hurt."

[resource]
script = ExtResource("16_qywy7")
episode_id = "ocean_cliff"
title = "The Coastal Route"
biome_types = Array[int]([10, 1])
text = "The group comes upon a part of the coast where tall cliffs rise above the sea.

They could try walking along the narrow ledge at the bottom of the cliff, but they risk falling in and getting swept away by the waves."
background_image = SubResource("Resource_ky1xy")
background_credit = ExtResource("1_rdu6e")
choices = Array[ExtResource("2_rdu6e")]([SubResource("Resource_aogak"), SubResource("Resource_fpc8k"), SubResource("Resource_3gd63"), SubResource("Resource_7b816")])

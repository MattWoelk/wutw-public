[sub_resource type="Resource" id="Resource_lp3ut"]
script = ExtResource("2_uakfi")
label = "Rest on the beach."
aspects = Array[ExtResource("3_fi6ru")]([ExtResource("4_cf26e")])
aspects_per_season = Array[ExtResource("3_fi6ru")]([null])
outcome = SubResource("Resource_1qbir")
outcome_text = "The scouts decide to stay on the beach and relax for a while. They lie on the warm sand and watch the clouds pass.

Once they have time to pay attention, they notice that many of the pebbles are made of glass, a luxury even in the Old World. The edges have been polished perfectly smooth by the sea."

[sub_resource type="Resource" id="Resource_j5dtk"]
script = ExtResource("9_uefvn")
card_type = ExtResource("8_l0bwv")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_crfmg"]
script = ExtResource("2_uakfi")
label = "Explore the cliffs."
aspects = Array[ExtResource("3_fi6ru")]([ExtResource("7_vethu")])
aspects_per_season = Array[ExtResource("3_fi6ru")]([null])
outcome = SubResource("Resource_j5dtk")
outcome_text = "The scouts climb the cliffs surrounding the cove. The grass there smells sweet, and bees buzz back and forth among the scattered wildflowers.

At the top of the hill, the group finds a clear pool. One of the surveyors dips her hand into it and instantly recoils as a fierce burning pain spreads across her skin.

Once they take a moment to pay attention, they see that the surrounding stone has been eaten away, and nothing grows within two paces of the pool."


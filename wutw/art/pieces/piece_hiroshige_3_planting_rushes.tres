piece_name = "Planting Rush in Bingo Province"
series = ExtResource("5_xgi8h")
artist = ExtResource("1_l45ci")
styles = Array[ExtResource("6_d0v0c")]([ExtResource("7_6bdtd")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
edits_description = "The text overlays were edited out and the image was cropped."
final_image_tex = SubResource("Resource_grg2k")
province = 22
blurb = "The caption details the process of planting igusa (rush). It mentions that these rushes, used to make tatami mats, are a specialty of the Bingo Province (modern-day Hiroshima), which allegedly has thinner grass that produces smoother mats. It details the categorization of the fibers by length and their preparation, and the practice of steaming them to make them shine."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

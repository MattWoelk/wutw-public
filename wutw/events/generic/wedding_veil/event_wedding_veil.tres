[sub_resource type="Resource" id="Resource_fl7n7"]
script = ExtResource("5_jcp1q")
markedup_text = "Retrieve the veil."
requirement = SubResource("Resource_pk1ig")
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "The groom sends out runners to chase down the bird and retrieve the veil.

Panicked, the bird manages to free itself before the men catch up to it, but the veil is torn and muddy.

The spectacle manages to startle the entire flock. They take flight, loudly croaking their complaints."

[sub_resource type="Resource" id="Resource_2me52"]
script = ExtResource("10_uri5e")
aspect = ExtResource("8_dms30")
metadata/_custom_type_script = "uid://gu7gcielbwdr"

[sub_resource type="Resource" id="Resource_qlb2o"]
script = ExtResource("9_xmdoc")
aspect_type = ExtResource("12_uxu5n")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_1fp57"]
script = ExtResource("5_jcp1q")
markedup_text = "Defuse the situation."
requirement = SubResource("Resource_qlb2o")
outcome = SubResource("Resource_2me52")
markedup_result_text = "The bride is quick to reassure the guests that the mishap is no cause for concern. She asks them to wait in peace, hoping the silence will soothe the trapped creature.

The crowd watches intently as the bird flaps its wings a few times and takes flight, letting the veil flutter free.

The priest in attendance remarks that it is an auspicious omen for the couple's future."

[sub_resource type="Resource" id="Resource_kjam1"]
script = ExtResource("7_dq5wb")
relic = ExtResource("13_kiqyc")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_kg1kv"]
script = ExtResource("9_xmdoc")
aspect_type = ExtResource("14_dtpf3")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2h0mf"]
script = ExtResource("5_jcp1q")
markedup_text = "Find a replacement."
requirement = SubResource("Resource_kg1kv")
outcome = SubResource("Resource_kjam1")
markedup_result_text = "The bride's sisters weave a delicate crown out of soft grass and place it on their sister's head.

The lost veil is quickly forgotten and the ceremony proceeds with no further mishaps."

[sub_resource type="Resource" id="Resource_elj6t"]
script = ExtResource("5_jcp1q")
markedup_text = "Ignore the mishap."
markedup_result_text = "The priest warns that losing a veil is a highly inauspicious omen, advising the couple to wait until next year's festival to wed.

The bride and groom object, however, and the ceremony goes on despite the lost veil."

[sub_resource type="Resource" id="Resource_3qtuf"]
script = ExtResource("3_y1njx")
markedup_text = "Cranes gather in the tall grasses, bowing and calling to each other. They eat their fill of insects and rest, drinking from the shallow steppe pools.

Today the town celebrates the birds in a Crane Festival, an auspicious day for weddings. As the sun is setting, a bride waits for the ceremony to begin. A thin white veil embroidered with cranes covers her hair, falling down her white robes.

As she steps out beneath the streamers, a gust of wind carries the veil away, depositing it on top of a crane, who promptly gets tangled in it."
background_image = SubResource("Resource_oksgv")
background_credit = ExtResource("4_mr54r")
choices = Array[ExtResource("5_jcp1q")]([SubResource("Resource_fl7n7"), SubResource("Resource_1fp57"), SubResource("Resource_2h0mf")])
exit_choice = SubResource("Resource_elj6t")


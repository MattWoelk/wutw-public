[resource]
script = ExtResource("1_i257m")
name = "Yokohama-e"
blurb = "Literally \"Yokohama pictures\", this style boomed during the opening of Japan in the 1860s. It served to document the sudden influx of foreign cultures, Western architecture, international trade, and the daily lives of foreigners living in the port city of Yokohama."
start_year = 1859
end_year = 1890
link = "https://en.wikipedia.org/wiki/Yokohama-e"

[sub_resource type="Resource" id="Resource_84ssb"]
script = ExtResource("11_rjfon")
markedup_text = "Preserve these as relics at the monastery."
requirement = SubResource("Resource_wc30y")
outcome = SubResource("Resource_41oe5")
markedup_result_text = "The stones are carried back to the monastery.

There they are placed on pedestals, and the whole area is sectioned off with sacred ropes.

Visitors are not allowed to approach, and nosy scholars are particularly cautioned to stay away."


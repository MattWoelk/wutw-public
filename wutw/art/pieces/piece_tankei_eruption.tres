[resource]
script = ExtResource("3_xsj0f")
original_image = SubResource("Resource_bcsnl")
piece_name = "Eruption of Mount Bandai"
artist = ExtResource("1_0hmn3")
actual_start_year = 1888
edits_description = "Only the right panel of the triptych was used and the text was removed."
final_image_tex = SubResource("Resource_alwh0")
province = 67
blurb = "Depicts the 1888 eruption of Mount Bandai in Fukushima prefecture. The paragraph on the left outlines the horrific aftermath of the event. The details listed below are augmented with modern statistics.

The eruption occurred on the morning of July 15, 1888, triggered by a relatively minor earthquake. The initial explosion was followed by successive blasts occurring 15 to 20 times per minute. Each explosion was accompanied by thunder and a black eruption column up to 1300 meters high. Several hours later hot rain started falling, transforming the vast quantity of ash into volcanic mudslides.

The eruption transformed hundreds of square kilometers of forest and farmland around the mountain into a wasteland, and several villages were completely buried under landslides. At least 477 people were killed, and hundreds more were injured and rendered homeless."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

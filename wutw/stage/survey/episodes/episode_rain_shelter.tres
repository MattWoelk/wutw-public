[sub_resource type="Resource" id="Resource_a3prj"]
script = ExtResource("1_fmvhx")
label = "Shelter in the hollows."
aspects = Array[ExtResource("2_kxd5k")]([ExtResource("3_d14bg")])
outcome = SubResource("Resource_nlc8n")
outcome_text = "Soon after the team takes shelter, several wolves show up. The scouts raise a racket and posture wildly, roaring and jumping. The wolves observe the display for some time, but eventually decide that the strange creatures are not worth attacking. Nonetheless, the entire team is shaken by the experience."

[sub_resource type="Resource" id="Resource_g8duj"]
script = ExtResource("1_fmvhx")
label = "Construct lean-tos."
aspects = Array[ExtResource("2_kxd5k")]([ExtResource("7_oc4rf")])
aspects_per_season = Array[ExtResource("2_kxd5k")]([null])
outcome_text = "Instead of sheltering in what are clearly animal dens, the scouts construct simple lean-tos. Enough to shelter from the rain, even if they won't last much longer."


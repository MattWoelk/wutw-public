[resource]
script = ExtResource("15_tdj2i")
episode_id = "pace_setter"
title = "The Pace Setter"
biome_types = Array[int]([7])
spot_types = Array[ExtResource("16_ih75m")]([ExtResource("17_ex5xa")])
text = "A naturally athletic surveyor has taken the lead and is setting a blistering pace, completely oblivious to the fact that half the team is panting and struggling to keep up.

When asked to slow down, he argues that moving fast will save them days of travel."
background_image = SubResource("Resource_mtfjs")
background_credit = ExtResource("1_hq2mv")
choices = Array[ExtResource("2_hq2mv")]([SubResource("Resource_6ulmr"), SubResource("Resource_wt0kj"), SubResource("Resource_fhhid"), SubResource("Resource_c8k8f")])

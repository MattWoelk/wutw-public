[sub_resource type="Resource" id="Resource_nvf6m"]
script = ExtResource("5_o10bj")
markedup_text = "Try to make the visits practical."
requirement = SubResource("Resource_n8fdv")
outcome = SubResource("Resource_wva7x")
markedup_result_text = "The woman tries to make her trips to the boneyard more practical.

She chooses the largest, heaviest bones and brings them to the artisans to be made into tools.

The settlers become more accepting of her eccentricity, but she worries that the mysterious creatures are being reduced to scrap."


[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("5_sw23g")
markedup_text = "Explore deeper into the archive."
requirement = SubResource("Resource_fmixu")
outcome = SubResource("Resource_4qwhu")
markedup_result_text = "The scholars clear the rubble of a collapsed wall and find a stair leading down into the darkness.

At the bottom they find another chamber. This one is filled with stacks of stone tiles, many covered in unusual geometric patterns.

It seems that the tiles were once part of a mosaic, but too many are missing to even guess at what the full image was meant to depict."


[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_r42yy")
markedup_text = "We don't have time for this."
outcome = SubResource("Resource_6q8p0")
markedup_result_text = "The fire is doused, and the vessels are set back on the shelves.

The expedition moves on without stopping at the tea house."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("3_6q8p0")
markedup_text = "The new tea house is complete, its doors open to the breeze.

An old couple is serving tea to those moving on with the expedition. They usually serve simple green tea with a few snacks and sweets, but maybe this occasion calls for something more elaborate?"

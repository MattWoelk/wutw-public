[resource]
script = ExtResource("8_ngdxc")
haunting_id = "kotengu"
name = "Kotengu"
name_japanese = "小天狗"
name_realistic = "Rockfalls"
name_translation = "Lesser Heavenly Hounds"
description = "Travelers claim the Kotengu are dropping rocks from the cliffs above, punishing anyone who disturbs their mountain domain."
description_realistic = "Loose stones and unstable cliffs are causing frequent rockfalls."
description_long = "The cliffs shower passers-by with loose stones, followed by mocking laughter from the clifftops.

Folks say it is the work of Kotengu, the lesser bird-like spirits of the peaks. They fiercely guard their domain from the growing village, viewing every new building as an insult. They perch where human eyes cannot reach, waiting for careless settlers to pass beneath the cliff before sending boulders down to crush their efforts."

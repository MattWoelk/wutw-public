[sub_resource type="Resource" id="Resource_6at2x"]
script = ExtResource("5_i00lh")
markedup_text = "Simplify things."
outcome = SubResource("Resource_iu7gc")
markedup_result_text = "The ritual is limited to the first serving. Cups are refilled without fanfare.

Jokes and laughter break the stiffness of the atmosphere.

The custom evolves."

[sub_resource type="Resource" id="Resource_d0keq"]
script = ExtResource("7_iu7gc")
bonus_type = ExtResource("8_8i4ig")
amount = 20
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_8mfyw"]
script = ExtResource("5_i00lh")
markedup_text = "Preserve the ritual. It will grow meaningful again."
outcome = SubResource("Resource_d0keq")
markedup_result_text = "The guests remain silent as the ritual continues.

When the tea hits their lips, followed by exquisite little morsels, their eyes soften.

\"Now I see...\" one guest murmurs."

[sub_resource type="Resource" id="Resource_mxy6s"]
script = ExtResource("10_ekp3u")
relic = ExtResource("9_dhvse")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_40rqf"]
script = ExtResource("5_i00lh")
markedup_text = "Let the guests perform the ceremony."
outcome = SubResource("Resource_mxy6s")
markedup_result_text = "The host sets the whisk down into its special stand and invites a guest to try.

The moment is awkward, unrefined, but there's a new air of excitement.

From the drawer, the host retrieves a whisk and offers it to the guests as a memento."

[sub_resource type="Resource" id="Resource_8i4ig"]
script = ExtResource("7_iu7gc")
bonus_type = ExtResource("6_3x30p")
amount = -20
extra_per_season = -10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_2stvf"]
script = ExtResource("5_i00lh")
markedup_text = "Suggest the guests visit a different establishment."
outcome = SubResource("Resource_8i4ig")
markedup_result_text = "The tea is left to go cold.

The guests leave in a huff.

The host's pride is preserved."

[sub_resource type="Resource" id="Resource_xxhwh"]
script = ExtResource("3_i1mbn")
markedup_text = "Tea Pavilions have become places of refined elegance. Hosts in full traditional dress now guide every tea ceremony with deliberate grace: folding the cloth, whisking the foam, waiting for waterdrops to evaporate from the kettle's surface.

But today, something feels off. The tea is the same, the gestures flawless, and yet the guests hesitate: \"This felt warmer, before...\""

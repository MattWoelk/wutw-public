aspects_per_season = Array[ExtResource("3_8keyg")]([null])
outcome = SubResource("Resource_ex82j")
outcome_text = "The scouts drop their packs and break into a run, dodging trees and vaulting over ditches, their eyes never leaving the flying sheets.

They would surely have recovered their collection, if it weren't for the nest of hornets they dislodged in their wake."


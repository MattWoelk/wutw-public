[sub_resource type="Resource" id="Resource_xl33w"]
script = ExtResource("5_34fwk")
markedup_text = "Draw them away with a better offer."
requirement = SubResource("Resource_bg7yj")
outcome = SubResource("Resource_vdhaj")
markedup_result_text = "Baskets of salted turnips are placed at the meadow's edge, leading away from the flowers.

The herd politely agrees that turnips taste better, and even allows the settlers to walk among them.

They do not stay, but before they leave, they rub against the trees, leaving tufts of coarse hair caught in the bark."


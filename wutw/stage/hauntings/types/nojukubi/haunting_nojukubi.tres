[resource]
script = ExtResource("6_1hk06")
haunting_id = "nojukubi"
name = "Nojukubi"
name_japanese = "野宿火"
name_realistic = "Wildfires"
name_translation = "Wild Living Fires"
description = "These plains are haunted by Nojukubi, fiery spirits of ancient inhabitants."
description_realistic = "Wildfires are ravaging these plains."
description_long = "In the stillness of lands long abandoned, faint streaks of fire begin to wander the grass, reliving the warmth of the people who once lived there. Settlers say these flickering embers murmur snatches of poetry and laughter, the voices of past gatherings echoing through the air.

Legends call them Nojukubi, fires born of memory, igniting even damp ground in flames. They need no fuel, feeding on the restless traces of joy left behind."
image_small = ExtResource("5_0j0cl")
image_credit = ExtResource("4_8wmwd")
image_small_realistic = ExtResource("7_8wmwd")
image_realistic_credit = ExtResource("5_3r5cu")
spot_type = ExtResource("7_ut6lj")

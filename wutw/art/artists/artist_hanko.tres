[resource]
script = ExtResource("3_q1tt4")
name = "Kajita Hanko"
blurb = "Kajita Hanko was a Meiji-period painter and print artist. He specialized in novel and newspaper illustrations, and most of his known work is in the [url=art_style:bijin-ga]bijin-ga[/url] genre.

He was born the son of a metal engraver and studied under Nabeta Gyokuei of the [url=art_school:Shijō School]Shijō School[/url], as well as [url=artist:Ohara Koson]Ohara Koson[/url]. Later in life he participated in forming several arts organizations and taught at several art schools.

Hanko married the writer Kitada Usurai and died of tuberculosis at age 47."
birth_year = 1870
death_year = 1917
link = "https://en.wikipedia.org/wiki/Kajita_Hanko"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_fi5r8"]
script = ExtResource("4_bomh3")
event_step_id = "salt"
markedup_text = "A ring of salt is poured around the center of the field, grains glittering in the sunlight on the petals.

By morning, the blossoms on the edges of the ring have wilted. As days pass, the effect spreads, flowers bowing in turn.

\"The power is draining into the Enlightened One's glyphs,\" the disciples declare. \"This place has given up its energies to aid in the Reunification.\""
background_image = SubResource("Resource_kf17a")
background_credit = ExtResource("6_aa4gq")
exit_choice = SubResource("Resource_scrwq")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


[resource]
script = ExtResource("9_3x5t5")
intro_text = "My home shard is obsessed with adventuring. Even my former husband kept saying I was boring because I don't like it. But I'd just rather be safe and cozy. Ironic, that I need to move to a whole new shard to escape adventure."

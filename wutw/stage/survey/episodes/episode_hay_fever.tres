aspects_per_season = Array[ExtResource("3_56tct")]([null])
outcome = SubResource("Resource_r72o5")
outcome_text = "The scouts blame the bad air on angry spirits haunting the plains, and retreat to a nearby cedar grove.

Unfortunately, their symptoms only worsen there.

Finally, someone notices pollen falling from the canopy in thick yellow clouds, the wind carrying it across the plains."


[sub_resource type="Resource" id="Resource_5buu7"]
script = ExtResource("5_t45cj")
markedup_text = "Tell him to put the book away."
outcome = SubResource("Resource_ah64o")
markedup_result_text = "The librarian sternly instructs the boy to put the book back on its string, explaining that the paper is too damp to handle.

The boy will not be back to the library for a long time."

[sub_resource type="Resource" id="Resource_mjpnx"]
script = ExtResource("3_r7wst")
markedup_text = "The librarians are airing the entire archive, hanging books on strings to let the damp pages dry. 

One of the helpers, a bright child, laughs in delight as one of the books reveals page upon page of colorful illustrations depicting strange-looking beasts. 

One page shows a yellow squirrel with feathered wings. Another, a big blue horse with an improbably long snout. The boy, however, is most fascinated by a giant, wide-eyed creature with pointed ears peeking through a row of reeds.

He asks a librarian what sort of creature this is."
background_image = SubResource("Resource_ljbhq")

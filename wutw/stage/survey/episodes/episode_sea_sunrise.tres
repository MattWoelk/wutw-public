metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_407v5"]
script = ExtResource("2_83645")
label = "Gather seashells."
aspects = Array[ExtResource("3_uogi3")]([ExtResource("6_gl1hv"), ExtResource("7_0lvvq")])
aspects_per_season = Array[ExtResource("3_uogi3")]([null])
outcome = SubResource("Resource_3qwgp")
outcome_text = "The scouts walk along the shoreline as the sun rises.

This shore has not seen people for a long, long time, and the ground is covered in a layer of seashells, each a different shape.

They take a colorful scallop shell with them as a memento."


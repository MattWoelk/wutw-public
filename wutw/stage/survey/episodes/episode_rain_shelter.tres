[sub_resource type="Resource" id="Resource_trtbi"]
script = ExtResource("9_08vb5")
result_text = "The team takes shelter in the hollows. They spend the whole night there, waiting for the rain to stop. Whatever had left the bones and hides fails to show up, and the scouts safely continue on their way."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


[resource]
script = ExtResource("2_2v8sm")
name = "Seven Lucky Gods of the Sumida River"
blurb = "In this series of prints, kabuki actors are shown in costume along the Sumida River. One of the seven gods of good fortune is inset in the right upper corner of each print, drawn by Kuniyoshi's daughter and student, Yoshi (1842-1885), signed as Yoshijo (\"daughter of Yoshi\")."
start_year = 1853
end_year = 1853

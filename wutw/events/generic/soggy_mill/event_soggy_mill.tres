[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("5_psq4f")
markedup_text = "Pound the wet grain into mochi."
requirement = SubResource("Resource_nthfn")
outcome = SubResource("Resource_rx1a8")
markedup_result_text = "The rice is steamed and pounded with mallets in a rhythmic ritual.

The work takes all day, but waste is averted, and by evening stacks of cut mochi line the shelves.

The millers grill a few for dinner, skewered on spare chopsticks."

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("7_t8gnj")
relic = ExtResource("10_vqemt")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_w2hpu"]
script = ExtResource("12_5xpuw")
aspect_type = ExtResource("11_n1pn6")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("5_psq4f")
markedup_text = "Share it freely: porridge for all."
requirement = SubResource("Resource_w2hpu")
outcome = SubResource("Resource_dpp3j")
markedup_result_text = "Settlers gather in the mill yard, each handed a steaming bowl of thin porridge.

Notches are carved into the mill beam to mark each guest.

What could have been a waste of grain turns into an opportunity to bring everyone closer."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("7_t8gnj")
relic = ExtResource("13_bv1o0")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("12_5xpuw")
aspect_type = ExtResource("14_i3ksn")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("5_psq4f")
markedup_text = "Spread the rice to dry as much as possible."
requirement = SubResource("Resource_fmixu")
outcome = SubResource("Resource_06ahh")
markedup_result_text = "Sacks are sliced open and the grain is spread on the warm ground, letting the wind chase away the moisture.

Some of the rice is too far gone, but most returns to the stores, saved for seasons when grain runs low.

The town council gives the millers small wooden tokens to cover the lost grain, redeemable for extra rice from the next harvest."

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("16_8m2b8")
bonus_type = ExtResource("15_jl6ni")
amount = -20
extra_per_season = -10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("5_psq4f")
markedup_text = "Discard the damaged rice."
outcome = SubResource("Resource_ciwob")
markedup_result_text = "The settlers throw the soaked sacks into the river, eager to get rid of the mess.

\"What a waste!\" The head miller grumbles."

[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("3_hadid")
markedup_text = "A crack in the millrace caught the millers unprepared. Several sacks of freshly polished rice lie sodden by the wall.

The millers must act quickly. If left alone, all the rice will spoil, and the rot will spread throughout the mill."
background_image = SubResource("Resource_t4evh")
background_credit = ExtResource("5_t4evh")

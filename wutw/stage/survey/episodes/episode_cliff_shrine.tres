[sub_resource type="Resource" id="Resource_8skht"]
script = ExtResource("2_s55kp")
label = "Take the necklace."
requirement = SubResource("Resource_vuudc")
aspects = Array[ExtResource("3_2epi6")]([ExtResource("5_dum65")])
outcome = SubResource("Resource_5s7yb")
outcome_text = "One of the scouts takes a liking to the necklace and decides to keep it as a memento. She rinses it in the stream, watching it glimmer bright green in the cool water.

Before she can stuff the necklace into her sleeve, one of her teammates demands she hand it over, claiming that he had spotted the shrine first. The others, hearing the commotion, likewise protest.

By the time they resolve the disagreement, the necklace is torn apart, each scout keeping a few of the stones."


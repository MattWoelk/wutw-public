[sub_resource type="Resource" id="Resource_iriya"]
script = ExtResource("5_g852m")
markedup_text = "Hold a formal poetry contest."
requirement = SubResource("Resource_8xg25")
outcome = SubResource("Resource_40rqf")
markedup_result_text = "As the poets start declaiming their verses, more and more settlers gather around them. Some sit on the benches, humming in time with the rhythm.

By nightfall, the air holds more than words.

Much of what was shared will fade, but it will inspire future beauty to bloom."


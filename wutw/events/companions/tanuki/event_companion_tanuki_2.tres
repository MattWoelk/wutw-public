[sub_resource type="Resource" id="Resource_lncp7"]
script = ExtResource("6_ncm4o")
markedup_text = "Untangle the little criminal."
requirement = SubResource("Resource_audfa")
outcome = SubResource("Resource_jqd0k")
markedup_result_text = "A brave brewer steps forward, murmuring soft words of reassurance, and carefully unwinds the vines from the creature's legs.

The animal freezes for a moment, but once freed, it gives the brewer a glazed look, then slowly ambles away into the darkness, hiccuping the entire time."


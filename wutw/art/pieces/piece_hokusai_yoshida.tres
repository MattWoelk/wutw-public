[resource]
script = ExtResource("4_2i2hd")
original_image = SubResource("Resource_bcsnl")
piece_name = "Yoshida on the Tōkaidō"
series = ExtResource("5_2bkgb")
artist = ExtResource("1_6svn3")
styles = Array[ExtResource("6_7jofh")]([ExtResource("7_0jcc3"), ExtResource("8_qausx")])
actual_start_year = 1830
actual_end_year = 1834
date_type = 1
edits_description = "The text and some of the foreground figures were removed."
final_image_tex = SubResource("Resource_af525")
province = 52
blurb = "Depicts travelers in the Fujimi Chaya (\"Fuji-viewing Tea House\", see on the sign in the top center). One woman gazes at Mount Fuji through a large open window, and the other may be ordering cups of tea from a waitress. The waitress appears to be pointing at Mount Fuji, advising her clients to view the mountain while drinking their tea.

On the floor to the left is a palanquin, perhaps used by one of the women. An old man in front of the palanquin repairs a straw sandal, pounding the material to soften it. Two men at the right, apparently exhausted after their long walk, sit on the platform near the entrance, puffing tobacco.

Yoshida, part of the present-day city of Toyohashi, was a famous castle town on the Tōkaidō. Hokusai placed his publisher's name, Eijudō, and its marking, on the round hats near the door post."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

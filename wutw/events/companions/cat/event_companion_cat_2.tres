[sub_resource type="Resource" id="Resource_ybpct"]
script = ExtResource("7_7hbe5")
markedup_text = "Mandate compensation for the cats."
requirement = SubResource("Resource_m7qo2")
outcome = SubResource("Resource_j0giq")
markedup_result_text = "The town council declares that the cats must be compensated for their blessings with at least two meals per day.

The merchants grumble but acquiesce, afraid of losing patronage.

Soon the cats grow plump and lazy, and the fights gradually dwindle."


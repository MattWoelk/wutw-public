[sub_resource type="Resource" id="Resource_hii5v"]
script = ExtResource("9_ssmio")
markedup_text = "Capture the sight in a painting."
requirement = SubResource("Resource_ue0h0")
outcome = SubResource("Resource_6cptf")
markedup_result_text = "An artist quickly mixes some green and brown ink, capturing the majestic creature on parchment.

The work is easy, as the subject was moving so slowly that it might as well have been still."

[sub_resource type="Resource" id="Resource_phg7y"]
script = ExtResource("9_ssmio")
markedup_text = "Leave the turtles to their swim."
markedup_result_text = "The settlers watch until the turtles slowly disappear behind a reef.

It is a peaceful sight, but there is work to be done."

[sub_resource type="Resource" id="Resource_0wiv2"]
script = ExtResource("7_emh6c")
markedup_text = "The waters of the coral garden are clear enough to spot several turtles swimming lazily among the reefs.

One of the turtles is sporting a long cape of green algae trailing from its shell.

The settlers are greatly impressed by the unusual sight, and someone mentions hearing stories from their grandparents about such turtles."
background_image = SubResource("Resource_d1oop")
background_credit = ExtResource("8_100ig")
choices = Array[ExtResource("9_ssmio")]([SubResource("Resource_hip1w"), SubResource("Resource_4bnqf"), SubResource("Resource_hii5v")])
exit_choice = SubResource("Resource_phg7y")


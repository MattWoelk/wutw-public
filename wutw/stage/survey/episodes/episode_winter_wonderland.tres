[sub_resource type="Resource" id="Resource_76f81"]
script = ExtResource("2_xk5i1")
label = "Make a snow fort."
aspects = Array[ExtResource("3_b33sg")]([ExtResource("9_cv8bf")])
outcome = SubResource("Resource_nnrwb")
outcome_text = "One of the surveyors suggests that they build a little fort out of the snow.

\"It's practice for when we need emergency shelter,\" she declares. The others are happy enough with this excuse, and set to work.

By noon they have transformed a pile of snow into a miniature castle, complete with several tunnels and a central hall.

It is surprisingly cozy."


[sub_resource type="Resource" id="Resource_23650"]
script = ExtResource("6_7nk6e")
markedup_text = "Call the crows with a conch trumpet."
requirement = SubResource("Resource_d0qcu")
outcome = SubResource("Resource_esjpc")
markedup_result_text = "The monks decide to blow their largest conch trumpet.

One of the monks climbs to a high balcony and brings the shell to his lips, blowing with all his might into the wooden mouthpiece.

An hour later the crows return. The flock is clearly disturbed, making low, knocking sounds instead of their usual lively caws. One of the birds seems to be missing."

[sub_resource type="Resource" id="Resource_l0o0i"]
script = ExtResource("8_wsawy")
relic = ExtResource("11_op8st")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_hpplq"]
script = ExtResource("10_ecso1")
aspect_type = ExtResource("12_iqf23")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ec5lu"]
script = ExtResource("6_7nk6e")
markedup_text = "Call them back by burning incense."
requirement = SubResource("Resource_hpplq")
outcome = SubResource("Resource_l0o0i")
markedup_result_text = "The novices haul a brazier up to the temple's highest balcony, and fill it with coals and ash, placing several pellets of incense on top.

The air instantly fills with the smell of juniper and mugwort, intimately familiar to the monks and the birds alike.

An hour later the crows return. The flock is clearly disturbed, making low, knocking sounds instead of their usual lively caws. One of the birds seems to be missing."

[sub_resource type="Resource" id="Resource_hlhy3"]
script = ExtResource("8_wsawy")
relic = ExtResource("13_b8wrv")
metadata/_custom_type_script = "uid://c72da5id7avtu"


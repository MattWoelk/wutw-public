[resource]
script = ExtResource("4_47vtb")
name = "Charles Bartlett"
portrait = SubResource("Resource_o8uy8")
blurb = "Charles Bartlett was an English painter and one of the few Western artists who created ukiyo-e prints. He created over 30 [url=art_style:shin-hanga]shin-hanga[/url] designs while working with [url=artist:Shōzaburō Watanabe]Shōzaburō Watanabe[/url].

Bartlett studied at the Royal Academy of Arts in London as well as the Académie Julian in Paris. He embarked on a tour of Asia in 1913, and arrived in Japan in 1915, where he met Shōzaburō, learned to design ukiyo-e, and produced prints depicting scenes from India and Japan.

He settled in Hawaii in 1917, but visited Japan again in 1919 to produce additional prints. He passed away in Honolulu in 1940."
birth_year = 1860
death_year = 1940
link = "https://en.wikipedia.org/wiki/Charles_W._Bartlett"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

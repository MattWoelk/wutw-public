[node name="Cutscene_Outro" type="Node2D" unique_id=1375775163]
material = SubResource("ShaderMaterial_h0xtj")
script = ExtResource("4_pgb0i")
texts = Array[String](["Now one could forget the first Calendar Day.", "Every shard had its own stall in the square. No two dishes tasted the same, and no two songs shared a style.", "Where once we grieved old memories, we now compared plans.", "We opened a fresh scroll, and marked the first day of the new year.", "We did not forget the sins of our ancestors, but from this day on, we started looking ahead.", "When the sun rose again, there was still work to be done. Life, as always, was woven from a thousand small labors.", "Some lived out their lives on one shard, content with a place they could call home.", "Others set out, ready to begin again, in the countless worlds yet to be discovered.", "But no matter what each of us did, we all learned to treasure our ten thousand worlds upon the wind."])
voice_lines = Array[AudioStream]([ExtResource("5_icnhm"), ExtResource("6_hgrfg"), ExtResource("7_cm0k7"), ExtResource("8_j52eu"), ExtResource("9_p2rq0"), ExtResource("8_lpyd4"), ExtResource("9_lj5bd"), ExtResource("10_yhqoe"), ExtResource("11_pgb0i")])
roll_sound = ExtResource("11_mr5rw")
roll_end_sound = ExtResource("12_akh5h")
music_switch = ExtResource("16_7uuie")
initial_wait = 1.5
main_quest_progress = 500

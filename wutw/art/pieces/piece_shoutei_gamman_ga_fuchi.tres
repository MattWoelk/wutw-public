actual_start_year = 1929
actual_end_year = 1929
final_image_tex = SubResource("Resource_h6dpt")
province = 66
blurb = "Depicts an autumn scene of the river gorge known today as the [url=https://www.japan-guide.com/e/e3810.html]Kanman-ga-fuchi Abyss[/url] in Nikko, Tochigi prefecture.

 The short gorge was formed by an eruption of Mount Nantai and today serves as a pleasant riverside walking trail.

According to legend, in 1654 the priest Kōkai established the Jiun-ji Temple near this gorge, and the priests there chanted a mantra than ended with the word \"kanman\" (\"finish firmly\"), for which the gorge was named."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

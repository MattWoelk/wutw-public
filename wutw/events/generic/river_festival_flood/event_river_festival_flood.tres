[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("5_it5ex")
markedup_text = "Use expedition resources to host the festival."
requirement = SubResource("Resource_dpp3j")
outcome = SubResource("Resource_6at2x")
markedup_result_text = "Donations are gathered from across the land.

The expedition members help shape the floats, craft new lanterns from spare scrolls, and pass bowls of simple but warm food along the river's edge.

The festival is smaller in size, but not in spirit.

Grief softens as singing resounds along the muddy banks."


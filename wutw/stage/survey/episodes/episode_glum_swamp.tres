[sub_resource type="Resource" id="Resource_5myv4"]
script = ExtResource("2_im846")
label = "Challenge the pessimist."
aspects = Array[ExtResource("3_msq25")]([ExtResource("7_y7170")])
aspects_per_season = Array[ExtResource("3_msq25")]([null])
outcome = SubResource("Resource_aaood")
outcome_text = "Exhausted by the gloomy surveyor's constant predictions of disaster, the group demands he prove he knows where he is going.

The resulting argument takes up the rest of the day.
"


[resource]
script = ExtResource("15_73mm5")
episode_id = "statued_ledges"
title = "The Statued Ledges"
biome_types = Array[int]([7])
spot_types = Array[ExtResource("16_y2xe3")]([ExtResource("17_7xxwg"), ExtResource("18_4qy4t")])
text = "The team comes up to a jagged cliff. On its ledges are dozens of little statues, their features worn smooth by time.

Most of the scouts agree that this part of the cliff face is by far the easiest to climb, but one objects, afraid to disturb the spirits that surely inhabit these statues."
background_image = SubResource("Resource_cm5im")
background_credit = ExtResource("1_of6db")
choices = Array[ExtResource("2_of6db")]([SubResource("Resource_jh1ib"), SubResource("Resource_xxtvd"), SubResource("Resource_mr1a0"), SubResource("Resource_nvjth")])

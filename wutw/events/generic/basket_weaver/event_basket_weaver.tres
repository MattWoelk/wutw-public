[sub_resource type="Resource" id="Resource_3wnob"]
script = ExtResource("5_6uo6p")
markedup_text = "Search for the lanterns."
requirement = SubResource("Resource_37jtr")
outcome = SubResource("Resource_7a4om")
markedup_result_text = "The weaver, with trembling hands, writes the message down on a piece of paper and tucks it into his sleeve.

Later, when the moon rises over the swamp, he steps out into the dark to begin his search.

He is found the next morning at the edge of a bog, confused and mumbling to himself, the message still in his sleeve."

[sub_resource type="Resource" id="Resource_huudo"]
script = ExtResource("16_5bpb8")
bonus_type = ExtResource("15_r0g2q")
amount = -10
extra_per_season = -15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_0eok6"]
script = ExtResource("5_6uo6p")
markedup_text = "Examine the message more closely."
outcome = SubResource("Resource_huudo")
markedup_result_text = "The weaver looks intently at the spot where he saw the strange message, twisting the edge of the basket this way and that to see more clearly.

Startled, he watches as the glyphs morph into different shapes. First they appear as lanterns, then as a path through tall reeds.

He is absorbed in watching the images for the rest of the day."

[sub_resource type="Resource" id="Resource_nsyyc"]
script = ExtResource("3_r7hca")
markedup_text = "The basket weavers are working diligently, winding the slender yellow stalks into simple yet sturdy shapes.

The master weaver inspects his apprentices' handiwork, setting another basket down when something around its rim catches his eye.

He squints for a moment, then his eyes widen. The woven pattern seems to form tiny glyphs. They read: [i]\"lanterns follow not\"[/i]."

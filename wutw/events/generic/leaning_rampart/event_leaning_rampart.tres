[sub_resource type="Resource" id="Resource_2me52"]
script = ExtResource("5_dxnvu")
markedup_text = "Patch it with scavenged pieces."
requirement = SubResource("Resource_1stri")
outcome = SubResource("Resource_ciwob")
markedup_result_text = "Workers scour the ruins for usable remnants: broken tiles, crooked beams, and stones just the right size to fit the cracks.

It isn't elegant, but it holds.

In the end, more tiles are found than needed."


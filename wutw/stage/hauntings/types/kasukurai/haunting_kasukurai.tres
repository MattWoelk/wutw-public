[resource]
script = ExtResource("9_lltdc")
haunting_id = "kasukurai"
name = "Kasukurai"
name_japanese = "粕食らい"
name_realistic = "Vermin Infestation"
name_translation = "Leftover Eaters"
description = "The expedition is haunted by Kasukurai, little gluttons said to creep in after meals to devour anything left behind."
description_realistic = "A growing rodent infestation is spoiling stored provisions and reducing available food."
description_long = "At night, settlers whisper of soft chewing behind the walls and footprints around the grain stores. Nothing is ever stolen, but radishes are nibbled, and beans go missing.

The locals blame the Kasukurai, spirits of waste and negligence. They say these sneaky figures crawl out from beneath discarded scraps, their thin lips smacking for every morsel left after a meal. Every careless waste draws more of them, until the storerooms echo with a thousand unseen feasts.

Some tales claim they were once cooks who squandered food while others starved, doomed now to consume what no one wants."
image_small = ExtResource("6_adjda")
image_credit = ExtResource("6_w64ov")
image_small_realistic = ExtResource("7_0hmdb")
image_realistic_credit = ExtResource("7_pm3ul")

markedup_text = "Suggest turning them into cooking pots."
requirement = SubResource("Resource_r2a6g")
outcome = SubResource("Resource_ps5l8")
markedup_result_text = "The master potter inspects each piece, nods, and says, \"Not for tea. But these'll hold soup just fine.\"

The teen laughs, then asks for more clay."


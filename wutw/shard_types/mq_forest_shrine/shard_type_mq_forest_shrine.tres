value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_k3dgc"]
script = ExtResource("3_hevnk")
text = "After $nonshrine_town rebelled against the monks' strict rules, the head monk of the First Shrine led a force to pacify the rebels, and the ensuing commotion resulted in more restrictive laws. Today, laypeople are forbidden from learning the Enlightened One's holy glyphs, leaving much of the populace illiterate, and unable to argue with the priesthood."
requirement = SubResource("Resource_y6kl5")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_xbgnq"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "questioning"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_ntoov"]
script = ExtResource("3_hevnk")
text = "Today, $shard_name is an orderly place, with magistrates enforcing strict laws and holding court in austere, windowless tribunal halls. Criminals are punished by imprisonment, and their families are fined heavily. The shard's main event is the Atonement Festival, where citizens gather to confess minor sins in the hope that offering up small transgressions will shield them from more serious accusations."
requirement = SubResource("Resource_xbgnq")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_dj82y"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "forgiven"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_bd4gv"]
script = ExtResource("3_hevnk")
text = "The monks on $shard_name are afforded great respect among the locals. In addition to the shrine maintenance and teaching duties they've performed over generations, they now often serve as mediators whenever conflicts arise. The shrine in $nonshrine_town even serves as a bank, letting people entrust their excess funds to the monks, and take interest-free loans for large projects."
requirement = SubResource("Resource_dj82y")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"


[sub_resource type="Resource" id="Resource_76fkp"]
script = ExtResource("2_t6lx5")
label = "Verify the trunk's sturdiness."
aspects = Array[ExtResource("3_3y6ya")]([ExtResource("7_aajle")])
outcome = SubResource("Resource_qcw3s")
outcome_text = "The group decides to check how sturdy the tree is. They carefully try placing heavier and heavier packs on the trunk, and find it able to support everything they could pile upon it.

In the process they notice that the bark is thicker in some areas. On closer examination, it becomes clear that at some point in the past, footholds had been carved into the trunk. Apparently they aren't the first to consider using it as a bridge."

[sub_resource type="Resource" id="Resource_trtbi"]
script = ExtResource("6_63m8a")
bonus_type = ExtResource("5_gb66p")
amount = 5
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_0mwql"]
script = ExtResource("2_t6lx5")
label = "Camp overnight and deliberate."
aspects = Array[ExtResource("3_3y6ya")]([ExtResource("9_ruagc")])
outcome = SubResource("Resource_trtbi")
outcome_text = "Unable to decide which path to take, the team sets up a camp by the tree bridge.

In the early morning, the first people to wake up are greeted with a group of woolly mountain goats all standing on the tree trunk, staring at the sleeping scouts.

This sight is enough to convince the group of the bridge's safety, and their trust in the goats proves well-earned."

[sub_resource type="Resource" id="Resource_ep71h"]
script = ExtResource("2_t6lx5")
label = "Take the long path."
aspects = Array[ExtResource("3_3y6ya")]([null])
aspects_per_season = Array[ExtResource("3_3y6ya")]([null])
outcome_text = "The team decides to avoid the risk and take the long path around the ravine. It is safe, but costs them extra time."

[resource]
script = ExtResource("10_pmvsv")
episode_id = "tree_bridge"
title = "The Tree Bridge"
biome_types = Array[int]([9, 7])
spot_types = Array[ExtResource("11_8wtso")]([ExtResource("12_6xg5h")])
text = "As the group is walking along the edge of a ravine, they find a living tree growing on the edge, its thick, bent trunk forming a bridge across to the other side.

Crossing it would act as a shortcut, but some of the scouts hesitate, not trusting the tree to hold their weight."
background_image = SubResource("Resource_hmwkx")
background_credit = ExtResource("1_t6lx5")
choices = Array[ExtResource("2_t6lx5")]([SubResource("Resource_oyrbr"), SubResource("Resource_76fkp"), SubResource("Resource_0mwql"), SubResource("Resource_ep71h")])

[resource]
script = ExtResource("1_f7qxh")
dialogue_id = "debate_kind_justice"
record_title = "Debate Speech: Approaches to Justice"
text = "PAGE: historian(PORTAL_NETWORK), AUDIENCE
historian: Have you heard of the shard with no judges or jails?
historian: When someone there commits a crime, the community holds a hearing to list every kind thing that person has ever done.
historian: It might sound ludicrous to us, yet this approach has worked for them all these centuries.
historian: When a society grows too large, it loses this natural goodness.
historian: It has to invent strict justice to keep order.
historian: When a central authority declares laws from a distant capital, they are rigid, blunt tools.
historian: They have to be, to apply in every situation.
historian: But in an independent community, people know each other.
historian: Your friends know your flaws, but they also know your circumstances, and can temper their judgement with care.
historian: If we leave moral judgement to divine commandments, we are forced to trust a blind executioner carrying out orders with no regard for our individuality."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

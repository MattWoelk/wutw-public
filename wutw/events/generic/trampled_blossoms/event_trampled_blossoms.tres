[sub_resource type="Resource" id="Resource_rksgb"]
script = ExtResource("5_34fwk")
markedup_text = "Capture the horses and put them to labor."
requirement = SubResource("Resource_lm8a0")
outcome = SubResource("Resource_6cu08")
markedup_result_text = "Ropes are braided, and halters are fashioned. The boldest settlers approach, confidently surrounding the herd.

In the ensuing scuffle, the horses express their opinion of employment with a precise application of their hind legs, leaving the hapless farmers bruised and scattered around the meadow.

The herd disappears into the distance, leaving only hoofprints and resentment behind."


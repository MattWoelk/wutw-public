[sub_resource type="Resource" id="Resource_xhi8v"]
script = ExtResource("2_3s006")
label = "Carry the cart over."
aspects = Array[ExtResource("3_pkasv")]([ExtResource("4_7up4d"), ExtResource("5_g33fg")])
outcome = SubResource("Resource_ovoh5")
outcome_text = "Three scouts join the settler and raise the whole cart onto their shoulders. Together, they carefully carry it over the bridge and leave it safely on the other end. The whole team finds such shared physical effort inspiring."


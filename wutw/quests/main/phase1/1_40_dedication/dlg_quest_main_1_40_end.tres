script = ExtResource("1_kka54")
dialogue_id = "mq_1_40_end"
record_title = "Era 一: The Dedication"
text = "PAGE: scribe(NONE), monk(NONE)
scribe: We are ready to dedicate the great statue.
scribe: As the scripture tells us, when it reunites the shards, the Enlightened One shall walk among us, and all will be restored.
scribe: Once the expedition is finished, we shall begin the ritual."

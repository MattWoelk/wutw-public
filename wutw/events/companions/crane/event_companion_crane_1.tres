[sub_resource type="Resource" id="Resource_yhvln"]
script = ExtResource("9_5cyru")
markedup_text = "Use smoke to drive them away."
requirement = SubResource("Resource_phq3l")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "The villagers pile damp seaweed onto fire pits to create clouds of thick smoke that fill the beach.

The tactic works, and the birds adjust their route to avoid the noxious hazard.

However, the wind blows the smoke directly back into the village, leaving everyone's eyes watering."


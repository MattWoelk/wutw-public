[sub_resource type="Resource" id="Resource_jh1ib"]
script = ExtResource("2_of6db")
label = "Scramble up together."
aspects = Array[ExtResource("3_csoou")]([ExtResource("4_edomy")])
aspects_per_season = Array[ExtResource("3_csoou")]([null])
outcome = SubResource("Resource_qrug4")
outcome_text = "The scouts scramble up the cliff, the ledges acting as convenient hand-holds.

Before they are halfway up, one of them knocks a statue off its ledge and watches as it shatters at the bottom.

He is now wracked with guilt for not listening to his teammate."


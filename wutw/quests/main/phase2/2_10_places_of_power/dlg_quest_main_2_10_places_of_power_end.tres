[resource]
script = ExtResource("1_njgtm")
dialogue_id = "mq_2_10_end"
record_title = "Era 二: Places of Power Found"
text = "PAGE: historian(STUDIO_SECONDARY), scribe(STUDIO_PRIMARY)
scribe: We return triumphant!
scribe: With our eyes uncovered, we finally see the Enlightened One's signs everywhere.
historian: You call it a triumph, but I hear the priests whisper about hauntings now.
historian: Food going bad overnight.
historian: Fever spreading across the settlements.
scribe: Yes, our powers have not gone unnoticed.
scribe: But every new path is bound to stir old dust.
historian: If the world is resisting, maybe we should listen.
scribe: These spirits are the lifeblood of the world seeping out.
scribe: We must act before they bleed it dry.
historian: We all want to fix the world, but these new powers...
historian: We don't really understand them yet.
scribe: Perhaps you are right.
scribe: I will study these hauntings.
scribe: Observe their responses to the glyphs.
historian: And with the Enlightened One's blessing, I'll be here to record the findings.

PAGE: historian(MUSEUM_PRIMARY), explorer(MUSEUM_SECONDARY)
historian: The Scribe means well, but he is playing with fire.
explorer: I don't mind a little danger.
explorer: And these fox spirits they ran into sound fascinating.
explorer: I hope I get to meet one.
historian: Just... be careful out there."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

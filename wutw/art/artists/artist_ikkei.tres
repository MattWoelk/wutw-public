[resource]
script = ExtResource("4_vk6xe")
name = "Shōsai Ikkei"
blurb = "Shōsai Ikkei was a Meiji-era woodblock print artist and student of [url=artist:Hiroshige III]Hiroshige III[/url].

Active in the 1860s–1870s, he is best known for [url=art_style:kaika-e]kaika-e[/url] depicting Tōkyō's rapid modernization, blending traditional ukiyo-e style with scenes of railways, city life, and cultural change.

His work includes the 48 Views of Famous Places in Tōkyō series and the Comic Scenes of 36 Famous Places in Tōkyō series."
birth_year = 1830
death_year = 1920
custom_date = "Meiji era"
link = "https://www.woodblockprints.org/index.php/Detail/entities/884"
schools = Array[ExtResource("2_o3mrx")]([ExtResource("2_2x2f4")])

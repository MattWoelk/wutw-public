[sub_resource type="Resource" id="Resource_yj1bw"]
script = ExtResource("5_66e8j")
markedup_text = "Pack the hollow with sand."
requirement = SubResource("Resource_g6n8l")
outcome = SubResource("Resource_q7u4g")
markedup_result_text = "The void is filled with gravel and sand, packed tight until the trunk is solid again.

It is safe from falling, anchored by its heavy new core.

However, soon the leaves turn brown and drop, leaving a standing skeleton of branches. It remains as a monument, undeniable and sturdy, but it no longer sings in the wind."


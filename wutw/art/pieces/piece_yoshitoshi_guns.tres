[resource]
script = ExtResource("3_dit3c")
original_image = SubResource("Resource_bcsnl")
piece_name = "Chōsokabe Attacks Hori's Encampment at Night"
artist = ExtResource("1_ibsqb")
styles = Array[ExtResource("4_1g11c")]([ExtResource("5_0048g")])
actual_start_year = 1867
actual_end_year = 1867
custom_link = "https://www.yamada-shoten.com/english/detail.php?item_id=70630"
edits_description = "Only the fire was used."
final_image_tex = SubResource("Resource_jg17w")
blurb = "This print claims to depict a night raid from the [url=https://en.wikipedia.org/wiki/Invasion_of_Shikoku_(1585)]Shikoku Campaign of 1585[/url], where the [url=https://en.wikipedia.org/wiki/Ch%C5%8Dsokabe_clan]Chōsokabe clan[/url] attacked the camp of [url=https://en.wikipedia.org/wiki/Hori_Hidemasa]Hori Hidemasa[/url].

It doesn't take an expert to recognize that the weaponry is unrealistic for a 16th-century battle. Due to the shogunate's strict publishing regulations during Yoshitoshi's time, publication of prints dealing with current events was strictly prohibited, so artists adopted the format of depicting contemporary events thinly disguised as historical scenes. One source claims that this image was in reality intended to depict the [url=https://en.wikipedia.org/wiki/Second_Ch%C5%8Dsh%C5%AB_expedition]Second Chōshū Expedition[/url] of 1866."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

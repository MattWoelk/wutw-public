[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("11_42s7m")
result_text = "The reaction comes fast, with a burst of steam knocking several settlers back.

\"Ah, I forgot to protect against overflow there,\" the alchemist says, recording a note.

As the settlers walk away, they can't help but notice the trees around them withering as they pass. Their leaves curl inwards, turning lifeless and dark."
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


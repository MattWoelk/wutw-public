final_image_tex = SubResource("Resource_5vv68")
blurb = "Depicts Nuppeppō, a yōkai with indistinguishable wrinkles on its face and body, appearing as a blob of flesh. The name comes from nupperi, an old term that meant \"smear\", and refers to the creature smearing its face with white powder. This was used idiomatically to mean feigning ignorance."

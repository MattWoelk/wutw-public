[sub_resource type="Resource" id="Resource_7tn2x"]
script = ExtResource("2_loa4e")
label = "Camp here."
aspects = Array[ExtResource("3_vpa3n")]([ExtResource("11_kv40d")])
aspects_per_season = Array[ExtResource("3_vpa3n")]([null])
outcome = SubResource("Resource_g4pbm")
outcome_text = "The group decides to camp at the edge.

They are unusually somber as they gather around the fire for their meal, contemplating the distant shards.

As they lie down for the night, they are lulled to sleep by the howling wind."

[sub_resource type="Resource" id="Resource_2rdr5"]
script = ExtResource("2_loa4e")
label = "Shout into the void."
aspects = Array[ExtResource("3_vpa3n")]([null])
aspects_per_season = Array[ExtResource("3_vpa3n")]([null])
outcome_text = "One of the scouts yells into the distance with all his might.

Instead of the echo he expects, he hears his voice muted, swallowed by the dense clouds below."

[resource]
script = ExtResource("14_rmxqw")
episode_id = "shard_edge_fog"
title = "Distant Shards"
biome_types = Array[int]([0])
text = "The air is cold when the scouts reach the edge of the shard.

The wind howls against them, as if telling them to stay away from the dangerous edge, but they look on in wonder.

The Cloud Sea stretches into the horizon, scattered shards peeking through the clouds ahead. On one of them rises a staggeringly tall mountain."
background_image = SubResource("Resource_4ni1c")
background_credit = ExtResource("1_loa4e")
choices = Array[ExtResource("2_loa4e")]([SubResource("Resource_viw1w"), SubResource("Resource_j4qby"), SubResource("Resource_7tn2x"), SubResource("Resource_2rdr5")])

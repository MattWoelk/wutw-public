[sub_resource type="Resource" id="Resource_mskpm"]
script = ExtResource("7_c83ds")
markedup_text = "Have the artisans craft him proper plumage."
requirement = SubResource("Resource_e85yy")
outcome = SubResource("Resource_df5af")
markedup_result_text = "If he is to be a bird, he shouldn't have to make do with a frayed robe.

The artisans meticulously fold, layer, and dye paper to create a magnificent cloak of artificial feathers.

When he spreads his arms against the wind, he cries with joy as his spirit soars."

[sub_resource type="Resource" id="Resource_anomo"]
script = ExtResource("17_hvy3g")
card_type = ExtResource("16_c44yi")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_dyeih"]
script = ExtResource("15_inmn7")
aspect_type = ExtResource("18_urj1n")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_66tuy"]
script = ExtResource("7_c83ds")
markedup_text = "Formally recognize his spirit as a patron deity."
requirement = SubResource("Resource_dyeih")
outcome = SubResource("Resource_anomo")
markedup_result_text = "The Enlightened One's blessings work in mysterious ways, the monks declare. Perhaps a sky-bound fragment of the divine spirit tumbled into a human frame.

A small shrine is dedicated to the new avian patron god in a small ceremony.

The settlers now awake each dawn to the trilling song of the bird man, out on the cliff."

[sub_resource type="Resource" id="Resource_nbuck"]
script = ExtResource("17_hvy3g")
card_type = ExtResource("19_t848a")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_xera0"]
script = ExtResource("15_inmn7")
aspect_type = ExtResource("20_baaab")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_igaq2"]
script = ExtResource("7_c83ds")
markedup_text = "Ask if he needs help."
requirement = SubResource("Resource_xera0")
outcome = SubResource("Resource_nbuck")
markedup_result_text = "When asked, the bird man indicates that he needs a nest for himself, one large enough for a human.

His friends set to work under his guidance, bringing woven reeds, dried moss, and bits of cloth.

The result is the strangest nest any of them had seen, but the bird man finds it perfectly comfortable."

[sub_resource type="Resource" id="Resource_nt08v"]
script = ExtResource("7_c83ds")
markedup_text = "Leave him undisturbed."
markedup_result_text = "The world is strange enough without demanding everyone fit into the same mold.

The community agrees to let him be, ensuring someone checks up on him once in a while."

[sub_resource type="Resource" id="Resource_btt8q"]
script = ExtResource("4_p71ga")
markedup_text = "When the expedition first encountered bird nests on the cliffs, one of the settlers felt a particular affinity with the birds.

Only a few days later, he declared that he was a bird, reborn in the wrong vessel. He now spends his days crouching at the edge of the cliff, his robe shaped to resemble plumage.

The other settlers are concerned, but though peculiar, he understands his physical limitations and seems harmless."
background_image = SubResource("Resource_grtev")
background_credit = ExtResource("6_0w1o7")
choices = Array[ExtResource("7_c83ds")]([SubResource("Resource_mskpm"), SubResource("Resource_66tuy"), SubResource("Resource_igaq2")])
exit_choice = SubResource("Resource_nt08v")


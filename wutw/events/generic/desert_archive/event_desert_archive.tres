[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("5_sw23g")
markedup_text = "Let an eager scholar copy everything she can."
requirement = SubResource("Resource_ciwob")
outcome = SubResource("Resource_egt2j")
markedup_result_text = "The scholar starts frantically transcribing every record she sees.

When she runs out of paper, she starts writing directly on the fabric of her robe.

\"I don't understand it all,\" she says. \"But I'll find someone who will.\""


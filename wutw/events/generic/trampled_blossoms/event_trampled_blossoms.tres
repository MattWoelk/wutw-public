[sub_resource type="Resource" id="Resource_trtbi"]
script = ExtResource("5_34fwk")
markedup_text = "Feed them persimmons."
requirement = SubResource("Resource_e7hfo")
show_condition = SubResource("Resource_pakit")
outcome = SubResource("Resource_agcm7")
markedup_result_text = "Baskets of surplus persimmons are placed at the meadow's edge, leading away from the flowers.

The herd descends on the baskets and within an hour all the persimmons are gone.

When the horses depart, they leave behind tufts of coarse hair."

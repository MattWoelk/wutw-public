[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("5_sw23g")
markedup_text = "Let the lead scholar decide."
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The lead scholar steps forward without asking. He lifts a wooden seal from among the scrolls and drops it into his sleeve.

\"This will make a wonderful addition to my collection,\" he says."

[sub_resource type="Resource" id="Resource_xh6l0"]
script = ExtResource("3_4qwhu")
markedup_text = "Buried in the sand behind a storage space of an old ruin is a chamber full of scrolls. Most appear to be from shortly before the Shattering, but a few fragments are much older, written in an unfamiliar script.

It seems that historians were researching an even older civilization here. Translated fragments declare strange laws banning weapons of unclear nature. Redrawn maps show cities the size of a shard.

The settlement's scholars ponder what to do with this treasure trove."
background_image = SubResource("Resource_xabec")
background_credit = ExtResource("5_8jsmc")
choices = Array[ExtResource("5_sw23g")]([SubResource("Resource_dpp3j"), SubResource("Resource_nthfn"), SubResource("Resource_kojkx")])
exit_choice = SubResource("Resource_2myy3")


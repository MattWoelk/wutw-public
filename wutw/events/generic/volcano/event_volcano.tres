[sub_resource type="Resource" id="Resource_ynos6"]
script = ExtResource("5_i6nmk")
markedup_text = "Let the young guide the stranded villagers."
requirement = SubResource("Resource_cyaf3")
outcome = SubResource("Resource_x4eta")
markedup_result_text = "The youngsters convince the crowd that they have the quickest feet and the strongest lungs. The fittest of them gather their torches, ropes, and axes, felling trees to create a makeshift bridge.

They disappear into the smoke, moving quickly through the ruins, calling out loudly to the people lost among the wreckage. 

By daybreak, many of the rescuers return coughing and burned, but some of the families do not return at all."


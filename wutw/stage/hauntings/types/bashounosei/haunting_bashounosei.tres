[resource]
script = ExtResource("7_c56fu")
haunting_id = "bashonosei"
name = "Bashō no Sei"
name_japanese = "芭蕉精"
name_realistic = "Blight"
name_translation = "Banana Spirit"
description = "A rot spirit is haunting this hill, appearing as human faces in the rot on banana leaves."
description_realistic = "Creeping blight is spreading across the area, destroying agricultural yields."
description_long = "The hills have been claimed by a creeping rot that spreads from plant to plant. It started from the banana trees, haunted by the Bashō no Sei, banana spirits who manifest as faces on the leaves. They look at the farmers with blame, and ask passing monks if even plants can attain enlightenment."

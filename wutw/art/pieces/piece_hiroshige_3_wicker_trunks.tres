[resource]
script = ExtResource("3_8k8cl")
original_image = SubResource("Resource_bcsnl")
piece_name = "Making Willow Trunks in Tajima Province"
series = ExtResource("4_846o7")
artist = ExtResource("1_emmpf")
styles = Array[ExtResource("5_p8yig")]([ExtResource("6_b7ck7")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/artists/utagawa-hiroshige-iii-1842-1894/making-willow-baskets-in-tajima-p-cf22d225a73ad835.html"
edits_description = "The image was cropped and the text was removed."
final_image_tex = SubResource("Resource_e7xj6")
province = 32
blurb = "Depicts a group of people making yanagi-gōri (\"willow trunks\") in Tajima province (present-day northern Hyōgo prefecture).

The text explains that these trunks are produced in large quantities in the city of Toyooka. The willow branches are split finely, bleached in the sun, and woven into trunks. They are also sometimes crafted into bento boxes and winnowing baskets. The text further claims that the trunks are durable and appropriate for travel over long distances."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

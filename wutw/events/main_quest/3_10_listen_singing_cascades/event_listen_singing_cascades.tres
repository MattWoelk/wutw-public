run_var = 21
delta = 1
preview_description = "Gain an extra <term_lower:glyph> reward after each <term:foray> the rest of the <term:run>"
outcome_description = "Gained an extra <term_lower:glyph> reward after each <term:foray> the rest of the <term:run>."
metadata/_custom_type_script = "uid://dadces6knf8fj"

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("7_54fbb")
markedup_text = "It is words of wisdom."
outcome = SubResource("Resource_40rqf")
markedup_result_text = "Ink splatters in time with the water, as the scholars frantically brush symbols onto their scrolls, transcribing what they hear.

By the time the sun sets, they have compiled a massive list.

Although the meaning is not immediately intelligible, the scholars are bound to find wisdom in the glyphs once they've had time to study them."

[sub_resource type="Resource" id="Resource_2stvf"]
script = ExtResource("8_ng6g8")
run_var = 20
delta = 1
preview_description = "The <term:draw_pile> will appear in order for the rest of the <term:run>"
outcome_description = "The <term:draw_pile> will appear in order for the rest of the <term:run>."
metadata/_custom_type_script = "uid://dadces6knf8fj"

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("7_54fbb")
markedup_text = "It is a mathematical pattern."
outcome = SubResource("Resource_2stvf")
markedup_result_text = "One of the scholars, a mathematician, begins counting the seconds between the heaviest cascades. \"Three, then five, then two,\" she mutters, drawing charts in the mud.

Although she can't yet pinpoint the meaning in the repeating pattern, she insists that the Enlightened One must be showing them the importance of keeping precise order. \"That is how we stay in harmony with the world,\" she explains."

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("4_dg5bt")
markedup_text = "The waterfall tumbles over countless rocky ledges with a deafening roar. Several scholars from the expedition have gathered by the pool at the foot of the falls, listening intently.

\"This melody... a hymn from the Old World,\" one scholar whispers reverently.

\"I can hear words,\" another says.

\"It sounds just like the rowing songs we used to keep the rhythm,\" a retired sailor chimes in.

The scholars are all convinced that the Enlightened One's fractured spirit is sending a message through the cascade, but none can agree what it is."

[resource]
script = ExtResource("3_jjf0k")
original_image = SubResource("Resource_bcsnl")
piece_name = "Spring Sea"
artist = ExtResource("1_symj8")
styles = Array[ExtResource("4_b6pbr")]([ExtResource("5_aifsx")])
actual_start_year = 1905
edits_description = "The seashells were replaced with bones, the boats and the waves were removed, and the image was flipped and recolored to depict a wasteland."
final_image_tex = SubResource("Resource_alwh0")
blurb = "Depicts a young woman collecting seashells into a handkerchief on a springtime beach. Waves lap gently at the shore and distant boats are fading into the mist against the silhouette of a mountain.

The print uses soft shading and pastel colors, common in Toshikata's style.

This print was published in volume 11, no. 4 of the Bungei Kurabu magazine as a decorative frontispiece. Despite what you might read online, it was not associated with a particular article or story in the issue."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_u7rl7"]
script = ExtResource("5_o10bj")
markedup_text = "Continue visiting the boneyard."
requirement = SubResource("Resource_xgr1x")
outcome = SubResource("Resource_xnbwu")
markedup_result_text = "Unconcerned with public image, the young woman refuses to give up her visits, and they grow longer and more frequent instead.

Her most exciting discovery comes when she starts noticing bits of metal embedded in many of the bones. Some look like splinters, while others resemble little jagged flowers."


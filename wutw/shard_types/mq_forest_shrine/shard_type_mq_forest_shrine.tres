[sub_resource type="Resource" id="Resource_ynuvy"]
script = ExtResource("8_hyk2i")
text = "When I arrived on the shard, I was immediately welcomed and given a flyer showing the town's map, with local inns and eateries annotated in beautiful calligraphy. Gen, the local head priest, came personally to walk me to the inn. As we were strolling along, people would often come up and ask Gen about various upcoming shrine events. Apparently the shrine also acts as a school, a marketplace, and a party venue.

The next morning I went to visit this unusual shrine, and found a bustling market instead. After a breakfast of sweet buns I made my way to the actual shrine building, barely visible behind the stalls. The little hut was empty, and when I asked around, I learned that Gen and his team were out in the fields helping with the harvest. I left a few coins in the donation box before leaving, and noticed that it was already almost full. It didn't even have a lid. On some shards those donations would've disappeared within a day."
gained_argument = ExtResource("13_5g2iv")
metadata/_custom_type_script = "uid://ciddaw1laebi3"


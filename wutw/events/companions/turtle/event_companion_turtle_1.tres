[sub_resource type="Resource" id="Resource_4bnqf"]
script = ExtResource("9_ssmio")
markedup_text = "Clean the algae off the turtle's shell."
requirement = SubResource("Resource_cohi5")
outcome = SubResource("Resource_brxw1")
markedup_result_text = "A few well-meaning swimmers carefully catch the turtle and scrape the heavy algae away.

The turtle looks completely unbothered, but it doesn't seem to benefit from the grooming in any way either."


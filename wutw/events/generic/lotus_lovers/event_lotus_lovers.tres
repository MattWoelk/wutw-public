[sub_resource type="Resource" id="Resource_s3at4"]
script = ExtResource("6_seua0")
markedup_text = "Decline the position to stay together."
requirement = SubResource("Resource_engkq")
outcome = SubResource("Resource_7ovmn")
markedup_result_text = "The scholar delivers her decision to the courier with a pang of grief, but the pain will soften in the warm embrace awaiting her at home.

She has decided to lead a life of wistful, quiet contentment.

The grand archives will have to be filled by someone else."

[sub_resource type="Resource" id="Resource_t1n5e"]

[resource]
script = ExtResource("9_staxs")
episode_id = "fork"
title = "The Fork in the Road"
biome_types = Array[int]([8])
spot_types = Array[ExtResource("10_t35x5")]([ExtResource("11_se6hu")])
text = "The surveyors are trying to pass over a hill when they reach a fork in the road.

One path looks smooth, well-trodden by animals, but it goes all the way around the hill.

The other is steep and covered with loose stones, but is much more direct."

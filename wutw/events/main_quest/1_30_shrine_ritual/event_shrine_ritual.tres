[sub_resource type="Resource" id="Resource_d0keq"]
script = ExtResource("4_5xrqp")
markedup_text = "Burn incense to appease the spirits."
outcome = SubResource("Resource_smijh")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Each visitor arrives with a stick of incense, crafted by their own hand or acquired from artisans.

It is burned before the altar, a curl of smoke rising to meld with the others.

The scent will cling to robes and hallways, a reminder that the spirit world is never far."

[sub_resource type="Resource" id="Resource_h5mfv"]
script = ExtResource("5_eruld")
scope = 1

[sub_resource type="Resource" id="Resource_2stvf"]
script = ExtResource("5_r42yy")
markedup_text = "Focus on simplicity."
outcome = SubResource("Resource_rx1a8")
markedup_result_text = "The group sits quietly, comfortable and relaxed.

No ritual takes place, and no meal is served.

Discussions of settling plans give way to shared memories and quoted poems."


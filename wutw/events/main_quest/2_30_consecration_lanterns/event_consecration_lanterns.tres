[sub_resource type="Resource" id="Resource_ixcym"]
script = ExtResource("4_t2pnp")
event_step_id = "destroy"
markedup_text = "Hammers fall in unison, and the first lantern shatters into the waves below. Others follow, stone crumbling like sand.

The disciples stand among the ruins, proud of their accomplishment.

\"The light has been set free,\" one declares in the darkness. \"It will find its way home.\""
background_image = SubResource("Resource_x7wfp")
background_credit = ExtResource("6_tyksf")
exit_choice = SubResource("Resource_1c3qd")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


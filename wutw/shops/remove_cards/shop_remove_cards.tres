script = ExtResource("4_lvidp")
shop_id = "remove_cards"
title = "Communal Baths"
intro = "Steam rises from the warm baths, its puffs carried away by the cool breeze. The stone walkways are worn smooth with use, and clean buckets are stacked neatly in a row."
action_description = "Take a warm bath and let go of things best forgotten."
action_button_label = "Remove a Glyph"
tooltip = "Steam rises from the warm baths, its puffs carried away by the cool breeze. The stone walkways are worn smooth with use, and clean buckets are stacked neatly in a row.

Here you can purify your <term:card_deck> and <term_lower:remove_card> <term_lower:glyph>s if a given amount of <term:bonus.productivity> has been reached on the shard.

[i]“True work begins by letting go. In these waters, even stubborn thoughts dissolve, leaving only what matters.”[/i]"

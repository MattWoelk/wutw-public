[resource]
script = ExtResource("3_u6t3s")
name = "Itō Sōzan"
blurb = "Itō Sōzan was a [url=art_style:shin-hanga]shin-hanga[/url] artist active around the turn of the 20th century, though little of his biography is known.

In his early career he designed reproductions of [url=artist:Hiroshige]Hiroshige[/url] and [url=artist:Katsushika Hokusai]Hokusai[/url] prints for foreign markets, while later he was known mainly for his [url=art_style:kachō-e]kachō-e[/url] prints.

He is also known to have collaborated with [url=artist:Takahashi Shōtei]Takahashi Shōtei[/url] on several prints, which was very uncommon for ukiyo-e artists."
birth_year = 1884
death_year = 1930
custom_date = "late 19th century - early 20th century"
link = "https://itosozan.com/"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_sjvdb"]
script = ExtResource("2_xod50")
label = "Walk on the stones."
aspects = Array[ExtResource("3_3s22n")]([ExtResource("4_xda7v")])
aspects_per_season = Array[ExtResource("3_3s22n")]([null])
outcome = SubResource("Resource_jiikm")
outcome_text = "Several scouts attempt to approach the waterfall, stepping carefully onto the stones.

The result is chaos. One scout loses both her footing and her pack to the rushing water. Another topples face-first into the stream, thrashing wildly until his teammate pulls him out.

The group quickly realizes the folly of this approach."


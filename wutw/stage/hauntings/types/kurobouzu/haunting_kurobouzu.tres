[resource]
script = ExtResource("7_nxovl")
haunting_id = "kurobouzu"
name = "Kurobōzu"
name_japanese = "黒坊主"
name_realistic = "Epidemic"
name_translation = "Black Monks"
description = "Settlers whisper of dark monks that slip into homes at night to steal the breath from people's lips."
description_realistic = "An epidemic of respiratory illness is sweeping through the settlement, spreading among people who have weakened their bodies from excessive labor."
description_long = "The hardest-working settlers are waking up with pale faces and rattling coughs. Their breaths are stolen by the Kurobōzu, shadowy monks drawn to the exhausted and the ambitious, slipping into homes to lick the sweat from tired brows and steal the breath from those sleeping too deeply. Tales claim the monsters were once greedy priests who traded their health for worldly success, and are now cursed to wander the night."
image_small = ExtResource("6_souxf")
image_credit = ExtResource("6_o1qc1")
image_small_realistic = ExtResource("7_lg4ip")

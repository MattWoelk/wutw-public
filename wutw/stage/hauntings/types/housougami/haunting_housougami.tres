[resource]
script = ExtResource("7_cwp3l")
haunting_id = "housougami"
name = "Hōsōgami"
name_japanese = "疱瘡神"
name_realistic = "Smallpox"
name_translation = "Smallpox Demon"
description = "Settlers whisper that a crimson spirit walks among them, marking the sick with its red touch."
description_realistic = "A contagious disease is spreading rapidly among the settlers."
description_long = "When fever sweeps through a camp, the people hang red ribbons and paper charms, hoping to draw away the gaze of the Hōsōgami. Legends tell of small, scarlet demons traveling from home to home, riding on shoulders and carried in hands, marking people with their red touch. They are said to test each household's kindness: those who hoard medicine fall first, while the generous recover.

Yet the drums and prayers that once sent it away no longer bring comfort. Even the toughest begin to tremble at the sight of red skin."
image_small = ExtResource("7_6r77r")
image_credit = ExtResource("6_iooo0")
image_small_realistic = ExtResource("8_3hr6i")
image_realistic_credit = ExtResource("7_i8cmt")
base_aspect_types = Array[ExtResource("1_uedh0")]([ExtResource("3_iooo0")])

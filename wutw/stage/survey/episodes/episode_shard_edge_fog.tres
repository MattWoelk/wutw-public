aspects_per_season = Array[ExtResource("3_vpa3n")]([null])
outcome = SubResource("Resource_8j6k3")
outcome_text = "The explorers erect a stone cairn at the very edge of the shard.

Once they position the last stone into place, they pause to thank the Enlightened One for the success of their journey thus far."


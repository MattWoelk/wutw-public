piece_name = "Nukekubi and Inugami"
series = ExtResource("3_tb113")
styles = Array[ExtResource("4_upeju")]([ExtResource("5_85pyt"), ExtResource("6_6t1no")])
actual_start_year = 1500
actual_end_year = 1700
date_type = 1
custom_link = "https://en.wikipedia.org/wiki/File:22.Nukekubi.jpg"
edits_description = "The head was reattached, the image was cropped, the background was edited out, and an extra mouth was attached."
final_image_tex = SubResource("Resource_qboy0")
blurb = "Depicts two yōkai, Nukekubi (\"removable neck\") and Inugami (\"dog spirit\").

Nukekubi are women whose heads detach at night and attack people, usually draining their blood. According to legend, if the body is moved, the head cannot reattach itself.

Inugami are dog spirits from western Japan. They were related to a ritual of burying dog heads at a crossroads to inflict curses, which was banned during the Heian period (794-1185)."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_iv1vl"]
script = ExtResource("2_f3eko")
label = "Light a torch."
aspects = Array[ExtResource("3_s7p5p")]([ExtResource("7_ki3nm")])
aspects_per_season = Array[ExtResource("3_s7p5p")]([null])
outcome = SubResource("Resource_iee1s")
outcome_text = "The explorers quickly light their torches. The tigers, wary, back up.

One scout, her hands trembling, accidentally drops hers.

The dry grass begins to smoulder and the group is forced to abandon their route and race ahead of the spreading fire."


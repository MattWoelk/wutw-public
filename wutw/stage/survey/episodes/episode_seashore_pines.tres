[resource]
script = ExtResource("15_caa1e")
episode_id = "seashore_pines"
title = "The Gnarled Pines"
biome_types = Array[int]([1, 10])
text = "The scouts are gathering reeds when they pass a scattered grove of gnarled pines.

Over the years, the harsh coastal winds have twisted the branches into wild shapes, and the sea spray has crusted the bark with layers of salt."
background_image = SubResource("Resource_holvh")
background_credit = ExtResource("1_plm68")
choices = Array[ExtResource("2_plm68")]([SubResource("Resource_jvlif"), SubResource("Resource_h5brj"), SubResource("Resource_c6w1t"), SubResource("Resource_rjxoe")])

[resource]
script = ExtResource("4_vwd50")
original_image = SubResource("Resource_bcsnl")
piece_name = "The Kiyomizu Hall and Shinobazu Pond at Ueno"
series = ExtResource("5_cvscx")
artist = ExtResource("1_a0q1h")
styles = Array[ExtResource("6_tka2l")]([ExtResource("7_vmpj3")])
actual_start_year = 1856
province = 71
blurb = "Depicts the Kiyomizu Kannon Hall, a temple hall dedicated to the Buddhist deity of mercy Kannon. It was built in Ueno Park in 1631 as part of an ambitious plan to establish a great Buddhist temple complex in Edo. Allegedly the goal was to provide spiritual defense from the northeast, the direction from which evil spirits were thought to come.

The hall is famous even today for its view and surrounding cherry blossoms, although the print is exaggerated. Just outside the hall's outer platform is the Moon Pine, named for the circle made by one of its branches. The original pine was destroyed by a typhoon in the 1860s, but was recreated in the 2010s using deliberate horticultural techniques."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

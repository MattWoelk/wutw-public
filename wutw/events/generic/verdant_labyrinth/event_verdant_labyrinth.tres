[sub_resource type="Resource" id="Resource_fnvju"]
script = ExtResource("3_br3hg")
event_step_id = "altar"
markedup_text = "The settlers walk deeper into the cave, away from the light, the steady pattering of their footsteps echoing into the distance. 

They follow the smooth, cold walls until they round a corner and find themselves in a vast chamber.

The hall is held up by thick pillars etched with intricate designs, their patterns gleaming in the torchlight.

The gnarled, ancient roots of the great cedar have pushed through cracks in the ceiling, twisting around the pillars, and splitting several of them in two.

At the far end of the chamber stands a stone altar. On it is a small figurine of an owl, covered with a layer of dust."
background_image = SubResource("Resource_7qlf8")
background_credit = ExtResource("31_xmf1l")
exit_choice = SubResource("Resource_8uipj")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


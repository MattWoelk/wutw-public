[resource]
script = ExtResource("13_qjhec")
episode_id = "flying_papers"
title = "A Thieving Wind"
biome_types = Array[int]([6, 5, 8])
text = "A fierce gust of wind sweeps across the field, bending the long grasses wildly.

Suddenly, the survey team's logs and maps fly from the note-keeper's satchel and scatter into the sky.

Loose pages tumble through the air, chasing a scout's lost hat."
background_image = SubResource("Resource_b8t53")
background_credit = ExtResource("1_dhstj")
choices = Array[ExtResource("2_dhstj")]([SubResource("Resource_rq5d3"), SubResource("Resource_7kagh"), SubResource("Resource_wl03k"), SubResource("Resource_ir2pq")])

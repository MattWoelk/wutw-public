[sub_resource type="Resource" id="Resource_h0xwx"]
script = ExtResource("7_hkwuj")
markedup_text = "Catch the carp and move it over."
outcome = SubResource("Resource_7vboy")
markedup_result_text = "It takes the settlers some time to catch the slippery fish, but once they do, it is quickly transported to the other side, and continues its journey upstream."


[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("5_7wh20")
markedup_text = "Focus on accurate geography."
requirement = SubResource("Resource_nthfn")
outcome = SubResource("Resource_i5ayw")
markedup_result_text = "Journals are unpacked, sketches compared, and arguments are held over the length of each stream.

When the ink dries, the map is a marvel of precision, peaks, canyons, and trails laid out with confidence.

It may not be exciting, but it will help travelers find their way."


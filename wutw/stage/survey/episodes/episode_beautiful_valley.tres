[sub_resource type="Resource" id="Resource_u23im"]
script = ExtResource("2_35bc7")
label = "Let the artist catch up."
aspects = Array[ExtResource("3_aveeh")]([null])
outcome = SubResource("Resource_q5tvv")
outcome_text = "The team moves on, leaving the artist to sketch. By nightfall she has still failed to catch up, so they backtrack. It turns out the poor woman had sprained her ankle, and decided to rest for the night rather than walk the treacherous path in the dark."


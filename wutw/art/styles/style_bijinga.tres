[resource]
script = ExtResource("1_ih6ag")
name = "Bijin-ga"
blurb = "Literally \"beautiful women pictures\", this style focuses on depicting women's beauty. Many bijin-ga artists aimed to express inner beauty, so it was not considered important that the picture resemble the facial features of the model, and the depiction is often stylized rather than an attempt to create a realistic image."
start_year = 1660
end_year = 1920
link = "https://en.wikipedia.org/wiki/Bijin-ga"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

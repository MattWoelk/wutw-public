[resource]
script = ExtResource("3_j2eai")
name = "Ohara Koson"
portrait = SubResource("Resource_o8uy8")
blurb = "Ohara Koson was a printmaker and painter who became the leading master of [url=art_style:kachō-e]kachō-e[/url], or bird-and-flower pictures, during the 20th century [url=art_style:shin-hanga]shin-hanga[/url] movement. He also used the names Ohara Hōson and Ohara Shōson.

Koson revitalized the traditional nature print by combining acute biological observation with soft, painterly woodblock techniques. He is best known for his highly detailed depictions of wildlife, such as eagles in the snow, leaping koi, and delicate songbirds among blossoms.

His works were heavily exported and achieved commercial success in the United States and Europe, playing a major role in shaping Western appreciation for Japanese naturalism."
birth_year = 1877
death_year = 1945
link = "https://en.wikipedia.org/wiki/Ohara_Koson"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

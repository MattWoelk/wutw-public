[resource]
script = ExtResource("2_hi4m5")
haunting_id = "futakuchi_onna"
name = "Futakuchi Onna"
name_japanese = "二口女"
name_realistic = "Corruption"
name_translation = "Two-Mouthed Woman"
description = "Rumors speak of people with a second mouth on the back of their heads, consuming twice the resources."
description_realistic = "Corruption is rife among the leaders of this settler group."
description_long = "Warehouses in this settlement turn up empty overnight. Households run out of food twice as fast.

Whispers speak of people with mouths hiding behind their heads, covered by locks of hair. The most common story is of the Futakuchi Onna, a lady who smiles sweetly while her hair stirs behind her like a nest of living threads, feeding a hidden mouth that demands its share of every meal. Some claim she was once a leader who hoarded plenty while others starved, and that her second mouth belongs to those she wronged, forever consuming what she once denied."
image_small = ExtResource("6_3ywa6")
image_credit = ExtResource("5_a2hat")
image_small_realistic = ExtResource("7_a2hat")
image_realistic_credit = ExtResource("6_4ex50")

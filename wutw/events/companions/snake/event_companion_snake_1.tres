[sub_resource type="Resource" id="Resource_lrob3"]
script = ExtResource("9_dvcb2")
markedup_text = "Knock the snake off with a pole."
requirement = SubResource("Resource_dte5b")
outcome = SubResource("Resource_cve28")
markedup_result_text = "Before the farmers can intervene, one of the townsfolk detaches a bamboo pole from the trellis and nudges the snake with it until it drops into the grass and slithers away.

The crowd is satisfied, but the farm has lost a pest controller."


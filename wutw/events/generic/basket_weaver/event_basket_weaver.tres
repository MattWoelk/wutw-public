[sub_resource type="Resource" id="Resource_3fwpd"]
script = ExtResource("5_6uo6p")
markedup_text = "Show others the message."
requirement = SubResource("Resource_g6srq")
outcome = SubResource("Resource_m508n")
markedup_result_text = "The master weaver summons his favorite apprentice and asks him to read the glyphs. The boy cocks his head, looking at the master in confusion.

The master, suspecting a prank, grows angry. He holds the basket up in front of the entire hut, demanding that each worker step forward to inspect it.

When nobody else admits to seeing the glyphs, he grows pale. He laughs, a bit too loudly, then asks everyone to return to work.

For the rest of the day, his fingers keep returning to the basket, tracing the edge."

[sub_resource type="Resource" id="Resource_28qwu"]
script = ExtResource("10_ea2gv")
delta = 3
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_gqavj"]
script = ExtResource("9_ele88")

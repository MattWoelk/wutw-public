[resource]
script = ExtResource("2_gmt64")
name = "Ogata Gekkō"
portrait = SubResource("Resource_jqjob")
blurb = "Ogata Gekkō was a self-taught artist who helped transition Japanese woodblock printing from the traditional ukiyo-e of the Edo period into the modern era.

Unlike most printmakers of his time, he did not train under an established school but instead developed a unique style that closely mimicked the soft brushstrokes and wash effects of traditional Japanese painting.

He is known for blending painterly techniques with classic subjects like landscapes, historical epics, and scenes of the Sino-Japanese War.

His work won multiple international awards, and helped elevate the global status of Japanese printmaking."
birth_year = 1859
death_year = 1920
link = "https://en.wikipedia.org/wiki/Ogata_Gekk%C5%8D"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[resource]
script = ExtResource("1_1ujmd")
dialogue_id = "mq_2_20_end"
record_title = "Era 二: The Hauntings"
text = "PAGE: scribe(STUDIO_PRIMARY), historian(STUDIO_SECONDARY)
scribe: Our long studies are complete.
scribe: Every haunting followed the same law: appear, respond to the glyphs, then vanish.
historian: Laws, or patterns you chose to see?
scribe: Patterns that repeat are not coincidences.
scribe: The spirits answered us because we used the right incantations, in the right place, at the right time.
historian: How can we be certain it was your glyphs that pacified the spirits?
scribe: The glyphs, the incantations...
scribe: They are merely tools to channel the Enlightened One's powers.
scribe: But it is not just the old records.
scribe: I have seen the miracles myself.
historian: Let's assume you're right.
historian: I can see in your eyes that you have grander designs for these powers.
historian: What's your plan?
scribe: To bring the shards back together, of course!
scribe: Ever since we started on this path, we have dreamed of it.
scribe: I will be the one to bring it about.

PAGE: scribe(SHRINE_PRIMARY), teo(SHRINE_SECONDARY)
scribe: I have studied your glyphs until the ink blurred before my eyes.
scribe: All I need is a sign from you, in these, the holiest of the scriptures.
scribe: \"Together\"
scribe: \"Strength\"
scribe: \"Focus\"
scribe: Use all of the glyphs at the same time?
scribe: No, that can't be...
scribe: Maybe meditate together on our strength?
scribe: I see!
scribe: The places of power.
scribe: We must find a shard with all of them!
scribe: Yes, then we can focus their energies.
scribe: That will be a nexus to draw the other shards closer.
scribe: Thank you, oh Enlightened One!
scribe: Our path is clear now."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("5_ubs0w")
markedup_text = "Approve full excavation."
requirement = SubResource("Resource_egt2j")
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "The scholar gets her way, and digs with obsessive care.

Her notes speak of twinned seeds, taking turns to sprout, one resting while the other blooms.

But the flowers don't grow back. The seeds she replants remain inert, and the field loses some of its magic.

Still, the seeds are preserved. Perhaps they will still sprout one day."

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("15_6u2l3")
result_text = "The scholar spends hours with the plant, but finally shrugs in frustration.

\"Too little to learn,\" she mutters.

The flower withers within an hour."
description = ""
metadata/_custom_type_script = "uid://yxgaymbbt8tk"

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("11_e22jh")
relic = ExtResource("16_d5ier")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("15_6u2l3")
result_text = "The root reveals nothing, but someone in camp takes one of the blossoms as a memento.

It isn't knowledge, but it carries the memory of the wondrous meadow."
description = ""
metadata/_custom_type_script = "uid://yxgaymbbt8tk"


[sub_resource type="Resource" id="Resource_mslio"]
script = ExtResource("3_4aklr")
markedup_text = "Deep in the forest a little glade has formed around a furrow in the ground, hushed and dappled.

The furrow is lined with ancient, towering cedars on both sides. Moss covers the ground in a thick, plush carpet.

The settlers sit for a while, breathing in the smells of the deep forest."

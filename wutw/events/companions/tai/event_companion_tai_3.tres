[sub_resource type="Resource" id="Resource_w36sh"]
script = ExtResource("6_f2nvm")
markedup_text = "Name it after the carp."
outcome = SubResource("Resource_7kadu")
markedup_result_text = "The ship is named the Koi, to honor the persevering carp, in a loud ceremony full of celebratory toasts.

As the cheering dies down, a young deckhand points out that carp live in fresh water, and taking one out to sea doesn't make much sense."


[resource]
script = ExtResource("9_0aol7")
haunting_id = "oomukade"
name = "Ōomukade"
name_japanese = "大百足"
name_realistic = "Sinkholes"
name_translation = "Big Centipede"
description = "The ground here is said to be infested with Ōomukade, giant centipedes that dig their burrows beneath careless feet."
description_realistic = "The ground here is unstable and riddled with sinkholes, making development impossible until the soil is reinforced."
description_long = "Some scrublands are home to Ōomukade, giant centipedes that sleep in tunnels beneath the ground. Their burrows weaken the soil until it suddenly collapses, swallowing homes, roads, and shrines whole. Some claim to hear muffled drums beneath the ground, the skittering of giant legs. Tales are told of brave scouts who drove stakes into the trembling earth, only for the stakes to vanish overnight. Arcane masters often mark the soft ground with glyph-carved pillars, hoping to trap the monsters in their sleep."
image_small = ExtResource("7_68ohv")
image_credit = ExtResource("5_uweat")

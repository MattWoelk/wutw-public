[configuration]

entry_symbol = "wutw_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/libwutw-gdext.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libwutw-gdext.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libwutw-gdext.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libwutw-gdext.linux.template_release.x86_64.so"
macos.debug = "res://bin/libwutw-gdext.macos.template_debug.universal.dylib"
macos.release = "res://bin/libwutw-gdext.macos.template_release.universal.dylib"

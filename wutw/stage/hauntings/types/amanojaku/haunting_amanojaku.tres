[resource]
script = ExtResource("8_acpml")
haunting_id = "amanojaku"
name = "Amanojaku"
name_japanese = "天邪鬼"
name_realistic = "Polarization"
name_translation = "Evil Heavenly Spirits"
description = "Corrupted divine spirits, the Amanojaku, have descended on the town, provoking people into wicked acts, counter to the plans of their comrades."
description_realistic = "Rival teachings have torn this town apart, causing people to act out simply to spite the plans of their comrades."
description_long = "Long, long ago, the Enlightened One crushed the wicked Amanojaku, but now they have returned to spread wickedness among the settlers of the New World. These little ogres look into the hearts of people, and provoke their darkest desires. Some are known to possess people outright, directing their actions to spite the common good of their community."
image_small = ExtResource("5_7eob7")
image_credit = ExtResource("5_2ptm8")
image_small_realistic = ExtResource("6_utdl1")

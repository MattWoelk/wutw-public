[sub_resource type="Resource" id="Resource_x41sx"]
script = ExtResource("5_64d7v")
markedup_text = "Hold a meeting about the issue."
requirement = SubResource("Resource_ldgjy")
outcome = SubResource("Resource_yo0ng")
markedup_result_text = "The town council calls a meeting to hear all sides of the argument and help calm tensions between the settlers.

The result is a new law, maintaining that the quarry is only allowed to operate during the middle of the day, when most settlers are away from their homes and the roads are empty."

[sub_resource type="Resource" id="Resource_8wlxb"]
script = ExtResource("7_ouvhn")
bonus_type = ExtResource("12_tq0y5")
amount = -15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_83r3c"]
script = ExtResource("5_64d7v")
markedup_text = "Ignore the protesting villagers."
outcome = SubResource("Resource_8wlxb")
markedup_result_text = "The quarry foremen ignore the settlers' complaints and instruct the workers to continue as usual.

People have to learn to live with the incessant deafening booms and the risk of getting crushed by a stray boulder.
"

[sub_resource type="Resource" id="Resource_hymtl"]
script = ExtResource("3_chm36")
markedup_text = "The quarriers have developed a time-saving technique of rolling the stones they cut out down the hill instead of dragging them by hand. All day, boulders tumble down the hillside with a roaring boom.

When one boulder rolls to a stop at the center of the settlement's main road, narrowly missing a settler towing a cart of firewood, the neighbors declare that they've had enough."
background_image = SubResource("Resource_gf5wr")
background_credit = ExtResource("4_ee2bl")
choices = Array[ExtResource("5_64d7v")]([SubResource("Resource_a10y6"), SubResource("Resource_bmlkn"), SubResource("Resource_x41sx")])
exit_choice = SubResource("Resource_83r3c")


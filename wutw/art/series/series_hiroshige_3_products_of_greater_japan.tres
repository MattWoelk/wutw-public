[resource]
script = ExtResource("2_4k6pi")
name = "Products of Greater Japan"
blurb = "This series of 118 prints depicts regional scenes of farming, fishing, mining and other economic activities. The series was issued in August 1877 to coincide with the opening of Japan's first National Industrial Exposition (Naikoku Kangyō Hakurankai) held in Tōkyō's Ueno Park.

Although not well known, the series was a treasure trove for Worlds Upon The Wind, as it depicted many everyday activities rarely seen in ukiyo-e."
start_year = 1877
end_year = 1877
artist = ExtResource("1_vgowi")
link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

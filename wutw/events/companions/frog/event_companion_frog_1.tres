[sub_resource type="Resource" id="Resource_1dxtn"]
script = ExtResource("9_y5dt8")
markedup_text = "Marry the frog."
requirement = SubResource("Resource_ch4xi")
outcome = SubResource("Resource_kws1i")
markedup_result_text = "The local priest is taken aback by the man's request. Still, he eventually agrees, hoping the ritual will help the poet move on from his sorrow.

It does not. The man treats the ceremony with absolute solemnity, and as the days pass, his grip on reality slips further and further."

[sub_resource type="Resource" id="Resource_rauco"]
script = ExtResource("19_766xt")
card_type = ExtResource("23_hpcft")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_kr64n"]
script = ExtResource("9_y5dt8")
markedup_text = "Try to move on."
outcome = SubResource("Resource_rauco")
markedup_result_text = "The man's friends gently but firmly tell him that his wife is gone, and getting obsessed with a frog will not bring her back.

He bristles at their bluntness. To him, their practical advice just proves that no one understands the depth of his loss.

He turns his back on friendship, isolating himself further in his grief."

[sub_resource type="Resource" id="Resource_0b4ng"]
script = ExtResource("7_nm0ft")
markedup_text = "A local poet has become fascinated by a frog living on the riverbank. Every day, he stands by the river and watches it jumping up towards the willow branches. The frog misses every time, splashing back into the water with a dull plop.

He has come to believe that the frog is a reincarnation of his late wife, who would often sit by this very willow, playing her koto."
background_image = SubResource("Resource_ijqs6")
background_credit = ExtResource("8_4kvse")
choices = Array[ExtResource("9_y5dt8")]([SubResource("Resource_eyvo4"), SubResource("Resource_o44fc"), SubResource("Resource_1dxtn")])
exit_choice = SubResource("Resource_kr64n")


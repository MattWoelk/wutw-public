[sub_resource type="Resource" id="Resource_vwblo"]
script = ExtResource("5_66e8j")
markedup_text = "Cut it down and replace it with a sapling."
requirement = SubResource("Resource_20h0a")
outcome = SubResource("Resource_caumw")
markedup_result_text = "The cycle must turn. The old giant is felled with reverence, its fall shaking the whole grove.

In the center of the fresh stump, a young sapling is planted, bathed in sunlight that hasn't touched this patch of earth for centuries.

The wood of the elder is cut into small blocks and given to the settlers. \"A memento of the elder,\" the caretaker says, \"while we wait for the new one to grow.\""


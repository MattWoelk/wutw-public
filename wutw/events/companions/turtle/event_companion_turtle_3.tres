min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_7cjke"]
script = ExtResource("6_d1nfr")
markedup_text = "Design a way for the castle to move on wheels."
requirement = SubResource("Resource_5duxa")
outcome = SubResource("Resource_w4r1p")
markedup_result_text = "Inspired by the turtle carrying its home, the architect begins imagining a fortress that rolls on massive wooden wheels.

It takes about five minutes of math for him to realize the idea is completely absurd, but the image is highly entertaining."

[sub_resource type="Resource" id="Resource_0ri2n"]

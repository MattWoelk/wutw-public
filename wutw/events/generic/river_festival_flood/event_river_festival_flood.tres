[sub_resource type="Resource" id="Resource_1stri"]
script = ExtResource("5_it5ex")
markedup_text = "Hold the festival as if nothing happened."
outcome = SubResource("Resource_2stvf")
markedup_result_text = "Decorations hang limp from broken rafters.

The food runs out before sundown.

A few lanterns sputter out, and more than a few sink.

Whispers of \"this is a waste\" and \"we should've waited\" spread through the town."

[sub_resource type="Resource" id="Resource_2me52"]
script = ExtResource("3_wbymv")
markedup_text = "The rains came hard this season.

The river swelled, spilled, and took more than it should have. A few homes were washed away. Stores of grain, precious records, and whole crates of tools were swallowed up.

As festival season arrives, settlers debate whether the celebration should be canceled, or if this is the time it is needed most."
background_image = SubResource("Resource_1ex4l")
background_credit = ExtResource("5_1ex4l")
choices = Array[ExtResource("5_it5ex")]([SubResource("Resource_06ahh"), SubResource("Resource_fmixu"), SubResource("Resource_xh6l0")])
exit_choice = SubResource("Resource_1stri")


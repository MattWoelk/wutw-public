[sub_resource type="Resource" id="Resource_28h8g"]
script = ExtResource("6_koc0d")
markedup_text = "Look away in mild disgust."
outcome = SubResource("Resource_fkhth")
markedup_result_text = "The artisan cringes and looks away.

The image stays in her mind, though. She wakes up at night from a nightmare of eating a bowl of noodles and realizing that she is slurping up moist, sticky frog skin."

[sub_resource type="Resource" id="Resource_nfn3c"]
script = ExtResource("4_bh3y5")
markedup_text = "The lotus plantation has become home to a large number of frogs. Every other leaf seems to harbor a tiny amphibian.

One of the artisans notices a frog molting. Rather than discarding an empty husk, the frog pulls the skin off its limbs and stuffs it right back into its mouth."
background_image = SubResource("Resource_v8cfp")
background_credit = ExtResource("5_ul123")
choices = Array[ExtResource("6_koc0d")]([SubResource("Resource_66cdk"), SubResource("Resource_gbl3t"), SubResource("Resource_hlcrb")])
exit_choice = SubResource("Resource_28h8g")


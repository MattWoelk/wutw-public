[sub_resource type="Resource" id="Resource_l87xm"]
script = ExtResource("5_acqq1")
markedup_text = "Add to the image."
requirement = SubResource("Resource_0vd6g")
outcome = SubResource("Resource_0eiya")
markedup_result_text = "The men's faces break out into grins, and they take turns adding details to the dragon.

One scrapes away a line, forking it at the end, and suddenly the dragon has a long curled tongue.

The other presses two clumps of moss into place and the dragon looks on, cross-eyed.

They laugh so hard their baskets begin to sway."


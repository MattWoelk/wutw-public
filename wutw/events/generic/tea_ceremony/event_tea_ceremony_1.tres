[sub_resource type="Resource" id="Resource_8mfyw"]
script = ExtResource("5_r42yy")
markedup_text = "Make it a proper feast."
outcome = SubResource("Resource_egt2j")
markedup_result_text = "Snacks and sweets are preceded by soup, rice, and grilled skewers.

Tea bowls, once emptied, are refilled with beer and rice wine.

The ceremony turns into a lively gathering, with laughter and seconds for all."


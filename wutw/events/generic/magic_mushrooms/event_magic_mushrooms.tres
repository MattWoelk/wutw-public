[sub_resource type="Resource" id="Resource_1802j"]
script = ExtResource("5_vg4ul")
markedup_text = "Continue using the mushrooms as a staple food."
requirement = SubResource("Resource_mlx4q")
outcome = SubResource("Resource_8mfyw")
markedup_result_text = "The settlers continue to harvest the mushrooms, consuming them almost daily.

Only a few people suffer the strange visions, and once the novelty wears off, they mostly ignore them.

The mushrooms do become a draw for pilgrims eager to commune with the spirits, though most are disappointed when they end up unaffected."

[sub_resource type="Resource" id="Resource_40rqf"]
script = ExtResource("11_pp6qy")
card_type = ExtResource("10_f0ro3")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_ekbn6"]
script = ExtResource("13_7ilbi")
aspect_type = ExtResource("12_8kbyh")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_gqh3h"]
script = ExtResource("5_vg4ul")
markedup_text = "Only use the mushrooms during spiritual ceremonies."
requirement = SubResource("Resource_ekbn6")
outcome = SubResource("Resource_40rqf")
markedup_result_text = "The local priests adopt the mushrooms into their spirit communion ceremonies. The rare few who can see the spirits consult them about portents and omens, sharing their knowledge with the rest of the order, and incidentally quickly rising to positions of leadership.

A little mushroom-shaped shrine is built, and pilgrims arrive regularly to pay their respects to the little blue people guarding this town."

[sub_resource type="Resource" id="Resource_2stvf"]
script = ExtResource("11_pp6qy")
card_type = ExtResource("14_fyqd3")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_0w4cj"]
script = ExtResource("9_r7nks")
bonus_type = ExtResource("15_gjfr5")
min_count = 15
max_count = -1
extra_per_season = 15

[sub_resource type="Resource" id="Resource_uc6my"]
script = ExtResource("5_vg4ul")
markedup_text = "Ban the mushrooms completely."
requirement = SubResource("Resource_0w4cj")
outcome = SubResource("Resource_2stvf")
markedup_result_text = "The healers insist that the mushrooms are dangerous. Who knows what these spirits might make people do.

After some deliberation, the town council assents and consumption of these mushrooms is declared banned, punishable by exile."

[sub_resource type="Resource" id="Resource_kc1aq"]
script = ExtResource("5_vg4ul")
markedup_text = "Discourage their use, but leave the decision up to each person."
markedup_result_text = "Once the effects of the mushrooms become widely known, most settlers turn to other foods, wary of being among the few who get affected.

Some who received visions from the mushrooms still consume them, but tend to do so in secret, afraid of being judged."

[sub_resource type="Resource" id="Resource_owotm"]
script = ExtResource("3_o4mha")
markedup_text = "The foragers have discovered a new kind of mushroom in the glade. Plump, brown, and juicy, they sizzle when cooked and fill the air with a glorious aroma.

As these mushrooms become a major food source in the budding settlement, several settlers report that they start seeing spirits after their meals, little blue figures flitting around.

The priests are overjoyed at this window into the spirit world, but the healers claim that these visions are dangerous, and demand the mushrooms be banned."
background_image = SubResource("Resource_c4u6w")
background_credit = ExtResource("5_c4u6w")
choices = Array[ExtResource("5_vg4ul")]([SubResource("Resource_1802j"), SubResource("Resource_gqh3h"), SubResource("Resource_uc6my")])
exit_choice = SubResource("Resource_kc1aq")


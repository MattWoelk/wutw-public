metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_35xva"]
script = ExtResource("2_vmpkk")
label = "Rush inland."
aspects = Array[ExtResource("3_j5utr")]([ExtResource("4_y4unl")])
aspects_per_season = Array[ExtResource("3_j5utr")]([null])
outcome = SubResource("Resource_61j28")
outcome_text = "The scouts abandon their campsite and rush away from the shore.

They find a sheltered ditch, where they lie flat and watch in terror as trees crash around them.

By morning, they are thoroughly soaked, but at least they are safe."

[sub_resource type="Resource" id="Resource_8lsgb"]

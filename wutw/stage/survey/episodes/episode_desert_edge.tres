label = "Keep going."
aspects = Array[ExtResource("3_wnfoi")]([null])
outcome = SubResource("Resource_8ooav")
outcome_text = "The explorers are so close to leaving the desert behind them that they decide to press forward despite their companions' pale faces and trembling limbs.

The plan quickly falls apart when one of the two sick people faints, and the other begins to hallucinate.
"

[resource]
script = ExtResource("13_fot1k")
episode_id = "desert_edge"
title = "The Desert's Edge"
biome_types = Array[int]([2])
text = "The scouts are crossing a stretch of desert, the edge of it now only hours away.

The afternoon sun is at its worst, and the heat feels unbearable.

Water is running low, and two of the surveyors are beginning to show signs of heat exhaustion."
background_image = SubResource("Resource_850hn")
background_credit = ExtResource("1_kdr0i")

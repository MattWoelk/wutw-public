[sub_resource type="Resource" id="Resource_5efhl"]
script = ExtResource("2_s55kp")
label = "Rest by the stream."
aspects = Array[ExtResource("3_2epi6")]([null])
aspects_per_season = Array[ExtResource("3_2epi6")]([null])
outcome = SubResource("Resource_ycsfn")
outcome_text = "The team ignores the shrine, instead spending an hour basking in the cool spray.

They fill their canteens, rinse their headbands, and continue on fully refreshed."

[resource]
script = ExtResource("18_2pd0f")
episode_id = "cliff_shrine"
title = "The Little Cliff Shrine"
biome_types = Array[int]([0])
spot_types = Array[ExtResource("19_xvrh1")]([ExtResource("20_jq28v")])
text = "The air is oppressively hot and humid as the survey team makes its way to the top of a cliff.

As they crest the final rise, they see an old bridge crossing over a stream ending in a roaring waterfall.

A tiny shrine overlooks the site, sheltering a little stone pillar wrapped in a beautiful jade necklace."
background_image = SubResource("Resource_0wrne")
background_credit = ExtResource("1_s55kp")
choices = Array[ExtResource("2_s55kp")]([SubResource("Resource_lkr2a"), SubResource("Resource_1gdhi"), SubResource("Resource_8skht"), SubResource("Resource_5efhl")])

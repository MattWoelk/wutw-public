[resource]
script = ExtResource("2_78t81")
name = "Suzuki Harunobu"
blurb = "Suzuki Harunobu was a prolific ukiyo-e artist and innovator, the first to produce full-color prints in 1765, rendering obsolete the former modes of two- and three-color prints. He left behind over a thousand different prints.

He is primarily known for his [url=art_style:bijin-ga]bijin-ga[/url] prints, often depicting women as unusually youthful. When asked why he does not paint actors, as was common at the time, he allegedly responded \"Why should I paint pictures of such trash as Kabuki actors?\".

Unlike most ukiyo-e artists, Harunobu used his real name rather than an artist name."
birth_year = 1725
death_year = 1770
link = "https://en.wikipedia.org/wiki/Suzuki_Harunobu"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

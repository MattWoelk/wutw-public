[sub_resource type="Resource" id="Resource_ps5l8"]
script = ExtResource("4_wgvh1")
markedup_text = "Save the cicada from the sparrow."
requirement = SubResource("Resource_p2fdq")
outcome = SubResource("Resource_xxhwh")
markedup_result_text = "Hands rise, clapping sharply.

The sparrow startles, its quarry escapes, and the air fills with a self-satisfied cry of survival.

It won't be the last cicada the settlers see on this shard."


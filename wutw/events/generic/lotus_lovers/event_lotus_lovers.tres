[sub_resource type="Resource" id="Resource_eivrh"]
script = ExtResource("6_seua0")
markedup_text = "Attempt a long-distance relationship."
requirement = SubResource("Resource_rx8pe")
outcome = SubResource("Resource_t1n5e")
markedup_result_text = "The desperate lovers refuse to say goodbye. They make a pact: one will go to the capital to secure a future, while the other stays to ensure her grandmother lives out her life in comfort.

Before they part, they unspool a length of red thread and tie it around each other's wrists. The small gesture is a promise for them to hold onto when their love is far away."

[sub_resource type="Resource" id="Resource_ivd4d"]
script = ExtResource("8_ymofu")
card_type = ExtResource("13_tag66")
metadata/_custom_type_script = "uid://cqnoecri6xisf"


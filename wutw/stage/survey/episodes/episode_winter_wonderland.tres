metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_np4uc"]
script = ExtResource("2_xk5i1")
label = "Go sledding."
aspects = Array[ExtResource("3_b33sg")]([ExtResource("7_35vpx")])
outcome = SubResource("Resource_wdnic")
outcome_text = "The scouts gather their straw hats.

Each of them plants themself in the center of their hat and slides down the little icy slope leading down to their camp.

A few crash into trees or each other, but it isn't enough to stop them from going back up the slope again and again."


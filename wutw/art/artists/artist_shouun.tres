[resource]
script = ExtResource("4_pf7u1")
name = "Yamamoto Shōun"
blurb = "Yamamoto Shōun, also known as Matsutani Shōun, was a print designer, painter, and illustrator. He was born in Kōchi into a family of retainers of the shōgun and was given the name Mosaburō.

As a teenager, he studied with the [url=art_school:Kanō School]Kanō school[/url]. At age 17 he moved to Tōkyō, and by age 20 was employed as an illustrator for Fugoku Gahō, a pictorial magazine dealing with the sights in and around Tōkyō.

He is known for [url=art_style:bijin-ga]bijin-ga[/url] woodblock prints and his contributions to [url=art_style:shin-hanga]shin-hanga[/url], though in his later career he primarily produced paintings."
birth_year = 1870
death_year = 1965
link = "https://en.wikipedia.org/wiki/Yamamoto_Sh%C5%8Dun"
schools = Array[ExtResource("2_jhpry")]([ExtResource("2_f5hnp")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_02t1p"]
script = ExtResource("7_7hbe5")
markedup_text = "Declare the luckiest cat the town's patron spirit."
requirement = SubResource("Resource_nswlb")
outcome = SubResource("Resource_bs8v5")
markedup_result_text = "The mayor declares that the luckiest cat is to be the town's patron spirit.

As a result, traders start baiting the cats into fights, each eager to be associated with the town mascot.

Folks begin putting wagers on the fights. Some traders begin to file their cats' claws, or even dress them in armor.

The competition continues to escalate until finally, the local monks decide that a line has been crossed, and usher all the cats back to the wilderness."

[sub_resource type="Resource" id="Resource_j0giq"]

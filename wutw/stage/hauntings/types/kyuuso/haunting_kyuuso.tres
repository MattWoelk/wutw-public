[resource]
script = ExtResource("8_snwus")
haunting_id = "kyuuso"
name = "Kyūso"
name_japanese = "旧鼠"
name_realistic = "Rodent Infestation"
name_translation = "Giant Rodents"
description = "An enormous, chubby rat spirit is said to haunt these steppes, devouring everything in its path."
description_realistic = "A severe rodent infestation is consuming all yields produced in these steppes."
description_long = "At first, settlers blamed thieves for their vanishing harvests. Then they began finding bite-marks the size of fists and tracks larger than a badger's. The elders remembered the Kyūso, a rat so old it perfected gluttony and forgot fear.

They say it waddles from granary to granary on moonless nights, its stubby tail leaving a trail in the dirt, its mouth wide enough to swallow a rice sack whole. Unafraid of cats or dogs, it will even chase foxes away.

In some tellings it was once a farmer, cursed for hoarding food through a famine."
image_small = ExtResource("5_cbr6m")
image_credit = ExtResource("4_44obr")

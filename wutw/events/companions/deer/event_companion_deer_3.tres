[sub_resource type="Resource" id="Resource_io7bj"]
script = ExtResource("6_io7bj")
markedup_text = "Carve the shrine in the shape of the deer."
requirement = SubResource("Resource_3pw1p")
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The hermit works long hours to reshape the stone. The result may not be a masterpiece, but no one could mistake it for anything but a deer.

Once the locals learn of the new deer shrine, many visit to pay their respects.

Ironically, all the activity ends up driving the deer back into the forest."

[sub_resource type="Resource" id="Resource_3tleo"]
script = ExtResource("4_grph5")
markedup_text = "The hermit maintaining the shrine has noticed deer regularly wandering out of the forest to graze nearby. He is sure that these are no ordinary animals, but spirits staking a claim on the area.

Perhaps the shrine could be dedicated to them, or their interest could be acknowledged with offerings."
background_image = SubResource("Resource_yhtrs")
background_credit = ExtResource("6_3tleo")
choices = Array[ExtResource("6_io7bj")]([SubResource("Resource_p8chl"), SubResource("Resource_grph5"), SubResource("Resource_io7bj")])


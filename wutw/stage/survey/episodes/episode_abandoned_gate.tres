[sub_resource type="Resource" id="Resource_skang"]
script = ExtResource("2_l4pq5")
label = "Explore the huts."
aspects = Array[ExtResource("3_kigac")]([ExtResource("7_qqlbt")])
aspects_per_season = Array[ExtResource("3_kigac")]([null])
outcome = SubResource("Resource_0w2uk")
outcome_text = "The scouts split up and search the huts. Some find the huts empty, save for earthen pots among the ashes in the hearths.

However, most of the huts contain human remains, bones stripped by time and beast. They take a few of the bones for scholars to study in the future."

[sub_resource type="Resource" id="Resource_7btt3"]
script = ExtResource("12_k6o13")
relic = ExtResource("11_3utld")
metadata/_custom_type_script = "uid://c72da5id7avtu"

[sub_resource type="Resource" id="Resource_bacoh"]
script = ExtResource("2_l4pq5")
label = "Investigate the shrine."
aspects = Array[ExtResource("3_kigac")]([ExtResource("10_ldn2y")])
aspects_per_season = Array[ExtResource("3_kigac")]([null])
outcome = SubResource("Resource_7btt3")
outcome_text = "As the scouts approach the weathered shrine, they spot rows of wooden prayer tablets hanging on the walls. The ones outside have been worn smooth by the elements, but ones hanging from the rafters inside the shrine are still legible.

The language is too old to understand full sentences, but they recognize a few familiar characters, the most frequent being Disease, Cough, and Cure."


[resource]
script = ExtResource("4_krtrl")
original_image = SubResource("Resource_bcsnl")
piece_name = "Illustration of the Disastrous Flood"
artist = ExtResource("1_0rf6e")
styles = Array[ExtResource("5_uf0wd")]([ExtResource("6_onysg")])
actual_start_year = 1896
actual_end_year = 1896
date_type = 1
custom_link = "https://pages.uoregon.edu/jsmacollections/home/artists/kokyo-1877-1904/illustration-of-the-disastrous-flood.html"
edits_description = "Only the left frame was used, and people were edited out."
final_image_tex = SubResource("Resource_g1cr7")
province = 74
blurb = "Depicts a devastating flood which occurred in Tōkyō in September 1896, after weeks of torrential rain caused the city's major rivers to breach their banks. This triptych captures the inundated Mukojima district near the Mimeguri Shrine, where the collapse of the Nakagawa embankment transformed the landscape into a vast, navigable lake.

Beyond its artistic value, the print documents a pivotal moment in Japanese history: the catastrophe spurred the enactment of the 1896 River Law, which shifted the responsibility for large-scale flood control to the central government. Despite engineering and legislative efforts, the low-lying regions depicted here remain a focal point of Tōkyō's urban vulnerability today."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

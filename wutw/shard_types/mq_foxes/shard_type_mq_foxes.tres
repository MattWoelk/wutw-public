[sub_resource type="Resource" id="Resource_mh0e4"]
script = ExtResource("8_4ui0s")
text = "I wasn't able to do much exploration on this shard. When I tried to check into an inn, I discovered that the only currency accepted here is salt, and having not brought any with me, I couldn't pay.

A local miller took pity on me and let me stay in a spare room, but before she even let me into the house I had to go through a purification ritual, bathing in ice water and being dusted with some sort of metallic shavings.

Having no means of paying for food or passage to other towns, I had to return the next day."
gained_argument = ExtResource("11_vo6ed")
metadata/_custom_type_script = "uid://ciddaw1laebi3"

[sub_resource type="Resource" id="Resource_waq3m"]
script = ExtResource("9_hk6ad")
trip_reward = SubResource("Resource_mh0e4")

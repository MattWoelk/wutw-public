[sub_resource type="Resource" id="Resource_sd4c2"]
script = ExtResource("9_5cyru")
markedup_text = "Declare the bird calls to be voices of spirits."
requirement = SubResource("Resource_dvew1")
outcome = SubResource("Resource_d174p")
markedup_result_text = "Instead of fighting the flock, the priests declare the sudden arrival to be an auspicious sign.

They call on the locals to appease the spirits by folding intricate paper cranes, and leaving them as offerings at the shrine.

The real birds remain just as loud, but the villagers find the noise much more tolerable now that it is considered holy."

[sub_resource type="Resource" id="Resource_pakit"]
script = ExtResource("11_phjt6")
card_type = ExtResource("22_mxvck")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_fdpua"]
script = ExtResource("9_5cyru")
markedup_text = "Make a lot of noise to scare them off."
outcome = SubResource("Resource_pakit")
markedup_result_text = "The settlers grab pots, pans, and wooden spoons, marching down to the beach to create a terrible racket.

The cranes are offended by the commotion and eventually fly away.

The villagers win the battle for the beach, but end up with even worse headaches than they started with."

[sub_resource type="Resource" id="Resource_uga4j"]
script = ExtResource("7_fetss")
markedup_text = "The sky above the beach is filled with cranes, crossing the sea to their feeding grounds.

The massive flock is incredibly loud, their constant calls echoing off the rocks all day.

The villagers are rubbing their temples and debating how to reclaim their peace and quiet."
background_image = SubResource("Resource_fx40s")
background_credit = ExtResource("8_sny0a")
choices = Array[ExtResource("9_5cyru")]([SubResource("Resource_yhvln"), SubResource("Resource_gyan4"), SubResource("Resource_sd4c2")])
exit_choice = SubResource("Resource_fdpua")


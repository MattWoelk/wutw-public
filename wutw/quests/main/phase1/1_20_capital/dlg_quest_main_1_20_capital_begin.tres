[resource]
script = ExtResource("1_vbrm2")
dialogue_id = "mq_1_20_begin"
record_title = "Era 一: The Shard Capital"
text = "PAGE: scribe(STUDIO_PRIMARY), explorer(STUDIO_SECONDARY)
explorer: The expedition was a success!
explorer: The shards are full of new adventures, new places to explore!
scribe: You have done the Enlightened One a great service.
scribe: The maps you bring shall serve us well in days to come.

PAGE: scribe(SHRINE_PRIMARY), teo(SHRINE_SECONDARY)
scribe: Oh Enlightened One, the shards are ready to receive us.
scribe: On the next expedition, we shall raise a capital.
scribe: With that, the scattered can begin healing in earnest."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

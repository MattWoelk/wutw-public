edits_description = "The image was cropped."
final_image_tex = SubResource("Resource_t233q")
province = 49
blurb = "Depicts two rocks joined by a shimenawa (a heavy rope of rice straw, sacred in Shinto) on the beach near Futami Okitama Shrine in present-day Ise, Mie prefecture.

Several such rock formations exist and are called Meoto Iwa (\"married couple rocks\"). According to Shinto, the rocks represent the union of the creator deities Izanagi and Izanami, and therefore celebrate the idea of union in marriage."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

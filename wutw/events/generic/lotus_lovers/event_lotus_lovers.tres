[sub_resource type="Resource" id="Resource_ymhky"]
script = ExtResource("6_seua0")
markedup_text = "Elope to the capital together."
requirement = SubResource("Resource_a3xh7")
outcome = SubResource("Resource_ivd4d")
markedup_result_text = "In the dead of night, they pack a single bag and slip away. Their trip is uneventful, and the scholar promptly assumes her new position.

Not a month passes before a letter arrives, announcing that the grandmother had passed away."


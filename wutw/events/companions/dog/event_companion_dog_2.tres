[sub_resource type="Resource" id="Resource_ra0k3"]
script = ExtResource("6_hihtd")
markedup_text = "Leave the dog outside the hall."
requirement = SubResource("Resource_71l8t")
outcome = SubResource("Resource_ydw5v")
markedup_result_text = "The man takes the offer, leaving the dog by the entrance.

The hearth is warm, and the floor is dry, but the man barely sleeps.

Every time the wind howls, he looks toward the door, wondering how his friend is doing.

By dawn the guilt overwhelms him and he takes off, with the dog walking alongside."


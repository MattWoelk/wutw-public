[resource]
script = ExtResource("1_x8kcs")
name = "Mitate-e"
blurb = "Literally \"likened pictures\", this genre uses puns, allusions, and deliberate incongruities, usually to parody classical art or events. The term mitate arose from the haiku tradition in the Heian period (794-1185). Works which are today called mitate-e used different labels at the time, such as fūryū (風流, \"fashionable\")."
start_year = 1650
end_year = 2026
link = "https://en.wikipedia.org/wiki/Mitate-e"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

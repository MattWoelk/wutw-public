custom_link = "https://asia.si.edu/explore-art-culture/collections/search/edanmdm:fsg_F1975.28/"
province = 70
blurb = "This is a small portion from a pair of long handscrolls which depict sites in Kyōto, the imperial capital of Japan.

The full scrolls, available from the link above, show dozens of different places, from temples and festivals, to horse races and farms. The scroll is filled with hundreds of people of all ages and all walks of life. Many of the figures are repeated with identical postures but different clothing colors.

In addition to inked lines and watercolor shading, the scroll is decorated with metallic dust, possibly gold, but more likely gold-colored brass."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

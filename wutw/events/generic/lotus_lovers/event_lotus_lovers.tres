[sub_resource type="Resource" id="Resource_jfrgx"]
script = ExtResource("6_seua0")
markedup_text = "End the relationship so each can fulfill their duty."
outcome = SubResource("Resource_dwt7e")
markedup_result_text = "They stand on the bridge and face the harsh reality of the world they live in. Love alone cannot cure the grandmother, or fill the archives.

They hold each other one last time, tears falling onto the broad green leaves below, and walk away carrying the heavy, hollow weight of duty."

[sub_resource type="Resource" id="Resource_qst14"]
script = ExtResource("4_tykps")
markedup_text = "The air above the lake is fresh with the sweet, subtle scent of lotus blooms. A couple is standing on the stone bridge, gazing silently at the green expanse below.

A courier had arrived from the capital with extraordinary news: one of the women has been offered the position of Head Record-Keeper, her lifelong dream. However, her partner cannot leave her ailing grandmother, who is much too frail for a trek to the capital.

Silence stretches as neither has the courage to voice the decision they must make before the courier departs at dawn."
background_image = SubResource("Resource_gy11a")
background_credit = ExtResource("6_gy11a")
choices = Array[ExtResource("6_seua0")]([SubResource("Resource_s3at4"), SubResource("Resource_eivrh"), SubResource("Resource_ymhky")])
exit_choice = SubResource("Resource_jfrgx")


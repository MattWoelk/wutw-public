[resource]
script = ExtResource("2_ivfcq")
name = "Arai Yoshimune"
blurb = "Arai Yoshimune was a woodblock illustrator and print designer in the [url=art_style:shin-hanga]shin-hanga[/url] movement. He was the youngest son of Utagawa Yoshimune I, and after his father's death assumed the name Utagawa Yoshimune II. He was also a disciple of [url=artist:Tsukioka Yoshitoshi]Tsukioka Yoshitoshi[/url] under the name Tosetsu.

In 1882, together with [url=artist:Tsukioka Yoshitoshi]Tsukioka Yoshitoshi[/url], he joined the staff of the Illustrated Free Newspaper, and later drew many illustrations for newspapers and magazines."
birth_year = 1863
death_year = 1941
link = "https://en.wikipedia.org/wiki/Arai_Yoshimune"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

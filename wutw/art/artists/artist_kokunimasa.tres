[resource]
script = ExtResource("3_jwmpb")
name = "Utagawa Kokunimasa"
blurb = "Utagawa Kokunimasa, son of Kunimasa IV, was a prolific woodblock print artist who worked across the Meiji, Taishō and Shōwa periods. Many of his prints are sensō-e, or \"war prints\", that depicted the Sino-Japanese (1894-1895) and Russo-Japanese (1904-1905) wars, and were used as propaganda.

He also published works under the names Baido, Ryukei, and Kunimasa V, although another [url=art_school:Utagawa School]Utagawa school[/url] member, Takeuchi Yanagi, used the Kunimasa V name as well."
birth_year = 1874
death_year = 1944
link = "https://www.roningallery.com/artists/Kokunimasa-kunimasa-v"
schools = Array[ExtResource("1_vfnpt")]([ExtResource("2_6vvdn")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

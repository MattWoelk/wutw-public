[sub_resource type="Resource" id="Resource_m5fys"]
script = ExtResource("10_7tf88")
markedup_text = "Trap the spider under a cup."
outcome = SubResource("Resource_5tiqf")
markedup_result_text = "The tea maker calmly places a cup over the creature, slides a thick piece of parchment underneath, and escorts the angry arachnid outside.

It is a sensible, highly effective, and utterly unadventurous solution."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


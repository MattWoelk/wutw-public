[sub_resource type="Resource" id="Resource_5bjr4"]
script = ExtResource("2_1i7gn")
label = "Climb a ridge."
aspects = Array[ExtResource("3_6qc1q")]([ExtResource("4_3qjpv")])
outcome = SubResource("Resource_d66tv")
outcome_text = "The team decides to climb a nearby rocky ridge to scout out the weather. They watch the dark, ominous clouds drift ever closer, their tops growing taller by the minute.

By the time the group returns to the camp to report that the storm is headed in their direction, it has already begun to rain."

[sub_resource type="Resource" id="Resource_bp7gf"]
script = ExtResource("5_vkcgt")
delta = -3
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_87l1h"]
script = ExtResource("2_1i7gn")
label = "Seek shelter elsewhere."
aspects = Array[ExtResource("3_6qc1q")]([ExtResource("6_gruky")])
outcome = SubResource("Resource_bp7gf")
outcome_text = "The group ignores the minority who believe that the storm will miss them. They break camp and walk back the way they came, seeking shelter under rocky overhangs. Although they remain dry, the team loses valuable time and misses dinner."

[sub_resource type="Resource" id="Resource_87830"]
script = ExtResource("2_1i7gn")
label = "Reinforce the camp."
aspects = Array[ExtResource("3_6qc1q")]([ExtResource("7_1jos1")])
outcome_text = "The group decides to stay in the camp, but not to ignore the storm. They layer extra cloth over their tents, secure them with pegs, and bring the firewood inside to keep it dry. The work is tiring, but when the storm arrives, they easily withstand the worst of the wind and rain."

[sub_resource type="Resource" id="Resource_dfrdl"]
script = ExtResource("9_67ugm")
card_type = ExtResource("8_r5hgn")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_gmnme"]
script = ExtResource("2_1i7gn")
label = "Ignore the clouds."
aspects = Array[ExtResource("3_6qc1q")]([null])
outcome = SubResource("Resource_dfrdl")
outcome_text = "One member of the group, confident in his weather-watching abilities, assures the rest that the storm will pass far to the north. The scouts continue their meal and settle in for the night. Soon, however, the winds shift and the group wakes up to soaked supplies and dead fires."

[resource]
script = ExtResource("10_8tvew")
episode_id = "wasteland_camp"
title = "Preparing for a Storm"
biome_types = Array[int]([7, 3])
text = "As evening falls and the group prepares dinner, the surveyors notice dark clouds gathering in the distance.

Most of the team argues that they should seek shelter somewhere more secluded, but a few of the scouts think that the storm will probably pass them by."
background_image = SubResource("Resource_ksty6")
background_credit = ExtResource("1_1i7gn")
choices = Array[ExtResource("2_1i7gn")]([SubResource("Resource_5bjr4"), SubResource("Resource_87l1h"), SubResource("Resource_87830"), SubResource("Resource_gmnme")])

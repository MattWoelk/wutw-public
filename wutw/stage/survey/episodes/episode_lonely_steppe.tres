[sub_resource type="Resource" id="Resource_i4uxt"]
script = ExtResource("2_hs4nh")
label = "Let him be."
aspects = Array[ExtResource("3_yj6tt")]([null])
aspects_per_season = Array[ExtResource("3_yj6tt")]([null])
outcome = SubResource("Resource_1ktv4")
outcome_text = "Not wanting to pry and thinking it best to leave the man in peace, the group continues on without stopping.

As the day wears on and the shadows grow longer, the scouts realize that the familiar lonely figure is nowhere to be seen.

The explorers make camp for the night and wait for him, but he does not return."

[resource]
script = ExtResource("14_imud2")
episode_id = "lonely_steppe"
title = "The Lonely Steppe"
biome_types = Array[int]([5])
text = "The surveyors make their way through a lonely steppe. The wind howls mournfully in the tall grasses, rustling the leaves of the few scattered trees.

The days pass with no sign of the bleak landscape ending, and melancholy spreads among the group.

One of the explorers has grown increasingly withdrawn. He begins lagging behind, walking with his head down."
background_image = SubResource("Resource_pmwi5")
background_credit = ExtResource("1_hs4nh")
choices = Array[ExtResource("2_hs4nh")]([SubResource("Resource_ieqcu"), SubResource("Resource_d4ncq"), SubResource("Resource_3e2ia"), SubResource("Resource_i4uxt")])

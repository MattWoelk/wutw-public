[sub_resource type="Resource" id="Resource_ra1er"]
script = ExtResource("2_a1k6a")
label = "Delve deep into the cave."
requirement = SubResource("Resource_se7l4")
aspects = Array[ExtResource("3_eepx8")]([ExtResource("14_k53br"), ExtResource("15_h3xrp")])
aspects_per_season = Array[ExtResource("3_eepx8")]([null])
outcome = SubResource("Resource_pc2tf")
outcome_text = "The survey team ties a rope to a nearby rock and slowly descends into the depths.

Their torches are too smoky to keep lit in the narrow tunnel, so they navigate mostly by touch.

The bottom of the shaft is filled with rubble, some of which they haul back up.

Among the rocks is a relic."


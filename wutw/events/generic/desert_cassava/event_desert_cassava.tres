[sub_resource type="Resource" id="Resource_uuoae"]
script = ExtResource("5_6xn7f")
markedup_text = "Listen to the priest."
requirement = SubResource("Resource_bbaej")
outcome = SubResource("Resource_hjr8q")
markedup_result_text = "Panicked, the whole settlement rushes into the fields and tears up every cassava root they can find before sunset.

When the storm strikes, the untouched crops remain undamaged, while the harvested roots are now bruised and already beginning to spoil."

[sub_resource type="Resource" id="Resource_wh43h"]

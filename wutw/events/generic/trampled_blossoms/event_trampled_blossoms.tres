min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ionoq"]
script = ExtResource("5_34fwk")
markedup_text = "Drive them off."
requirement = SubResource("Resource_cvbe2")
outcome = SubResource("Resource_0kiy2")
markedup_result_text = "Settlers stand shoulder to shoulder, banging pots and singing chants. They see it as a personal boundary reinforced.

The wall of noise pushes the herd back, away from the delicate blooms.

The flowers are saved, but the horses are never seen again."


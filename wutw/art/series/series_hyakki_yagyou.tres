[resource]
script = ExtResource("1_5vsyf")
name = "Night Parade of One Hundred Demons"
blurb = "This is a Japanese picture scroll (e-maki) from the Edo period depicting the [url=https://en.wikipedia.org/wiki/Hyakki_Yagy%C5%8D]Hyakki Yagyō[/url], a legendary procession of 100 demons from Japanese folklore. Sometimes an orderly procession, other times a riot, it refers to a huge parade of supernatural creatures known as oni and yōkai that march through the streets of Japan at night.

The original authorship is uncertain, but multiple versions of this scroll were made during the Edo period, each depicting several demons not found in other versions. One of these scrolls is attributed to a 12th-century priest-painter [url=https://en.wikipedia.org/wiki/Toba_S%C5%8Dj%C5%8D]Toba Sōjō[/url]. Another is attributed to the 15th-century painter [url=https://en.wikipedia.org/wiki/Tosa_Mitsunobu]Tosa Mitsunobu[/url]. Yet another to the 17th-century painter [url=https://en.wikipedia.org/wiki/Tosa_Mitsuoki]Tosa Mitsuoki[/url].

This is a prime example of [url=art_style:Yūrei-zu]Yūrei-zu[/url]."
start_year = 1603
end_year = 1868
link = "https://dl.ndl.go.jp/pid/2540972/1"

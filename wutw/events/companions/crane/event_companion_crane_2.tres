[sub_resource type="Resource" id="Resource_cspul"]
script = ExtResource("6_g2ppe")
markedup_text = "Regularly leave rice in the nest."
requirement = SubResource("Resource_2x6s0")
outcome = SubResource("Resource_1pgeq")
markedup_result_text = "The forester pours portions of rice into the nest every day, hoping the extra food will keep both chicks full.

Unfortunately, this diet proves inadequate for the hatchlings, and neither survives the season."

[sub_resource type="Resource" id="Resource_nodvx"]
script = ExtResource("10_ptbnp")
card_type = ExtResource("16_ii5oy")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_k30gb"]
script = ExtResource("6_g2ppe")
markedup_text = "Let nature take its course."
outcome = SubResource("Resource_nodvx")
markedup_result_text = "The forester sighs and steps back, deciding it is not her place to interfere with the wild.

Nature is highly efficient, but not always kind.

The stronger chick thrives under the undivided attention of its parent, while the weaker one soon perishes."

[sub_resource type="Resource" id="Resource_xxghv"]
script = ExtResource("4_f2ymd")
markedup_text = "Deep in the wildlife sanctuary, a forester has been observing a crane nest in an old pine.

Two chicks have hatched, but they fight relentlessly. The forester notes that the parent crane seems to favor the stronger chick, offering it most of the food.

It is a harsh reality of nature, but the forester is determined to see both of the fuzzy little creatures survive the season."
background_image = SubResource("Resource_16gl5")
background_credit = ExtResource("5_sx1ib")
choices = Array[ExtResource("6_g2ppe")]([SubResource("Resource_cdx74"), SubResource("Resource_ldoka"), SubResource("Resource_cspul")])
exit_choice = SubResource("Resource_k30gb")


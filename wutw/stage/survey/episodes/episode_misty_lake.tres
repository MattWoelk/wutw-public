[sub_resource type="Resource" id="Resource_bqjio"]
script = ExtResource("2_jw4r8")
label = "Judge direction by a trailing string."
requirement = SubResource("Resource_b5ql5")
aspects = Array[ExtResource("3_jcrlg")]([ExtResource("7_3uo2v")])
outcome = SubResource("Resource_pakit")
outcome_text = "A scout ties a long string to the stern and watches it as the others row. By keeping the trailing string straight, the group ensures that they are rowing in a straight line, and they eventually make their way to the shore."


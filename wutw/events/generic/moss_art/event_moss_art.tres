[sub_resource type="Resource" id="Resource_l2j2w"]
script = ExtResource("11_aspx6")
aspect_type = ExtResource("10_4241g")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_x6rnd"]
script = ExtResource("5_acqq1")
markedup_text = "Declare it a work of art."
requirement = SubResource("Resource_l2j2w")
outcome = SubResource("Resource_d174p")
markedup_result_text = "The men decide that the image must be the work of a great artist.

They return to the settlement to tell their fellow settlers of the strange artwork they found on the canyon wall.

Before the day ends, there's a queue of people lined up for a chance to go down in the baskets and admire the sight."

[sub_resource type="Resource" id="Resource_pakit"]
script = ExtResource("13_be266")
card_type = ExtResource("12_ifgkb")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_dkx1g"]
script = ExtResource("11_aspx6")
aspect_type = ExtResource("14_40lpe")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_weh2w"]
script = ExtResource("5_acqq1")
markedup_text = "Consider it a message from the spirits."
requirement = SubResource("Resource_dkx1g")
outcome = SubResource("Resource_pakit")
markedup_result_text = "The men see a deeper message in the image.

The canyon's spirit is widely known to grant wisdom through the cracks in the wall, so this pattern cannot be a coincidence.

When they consult the local priestess, she confirms their guess. The dragon represents wisdom, she explains, so the spirit is saying that scholars have tied wisdom into knots, preventing the common people from learning."

[sub_resource type="Resource" id="Resource_e7hfo"]
script = ExtResource("9_pfjmg")
bonus_type = ExtResource("7_fb82t")
amount = -10
extra_per_season = -10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_avonx"]
script = ExtResource("5_acqq1")
markedup_text = "Remove the moss dragon."
outcome = SubResource("Resource_e7hfo")
markedup_result_text = "After the initial surprise wears out, the men decide that some of the village youths must have tried to prank them.

They grumble as they scrape every last bit of moss that makes up the pattern."

[sub_resource type="Resource" id="Resource_h06kr"]
script = ExtResource("3_iij3x")
markedup_text = "Two men are gathering moss in the canyon, sitting in large baskets suspended by ropes. As one of them prepares to scrape another handful from the wet stone, he pauses and looks at the wall in surprise.

Further along the cliff face the moss is cleared in a pattern that looks strikingly like a dragon tied into a knot, its scales clumps of raised moss."

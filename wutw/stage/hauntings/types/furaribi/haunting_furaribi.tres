[resource]
script = ExtResource("10_sslpk")
haunting_id = "furaribi"
name = "Furaribi"
name_japanese = "ふらり火"
name_realistic = "Extreme Heat"
name_translation = "Aimless Fire"
description = "Settlers working outside risk being attacked by Furaribi, fiery birds with dog faces who dive down from the sky to steal souls from those too weak to resist their clutches."
description_realistic = "Extreme heat stops settlers from spending long hours working outside."
description_long = "The area has become known for Furaribi, fiery birds with dog faces who dive down from the sky to steal souls from those too weak to resist their clutches. Even if the person manages to fight them off, they usually end up unconscious, their spirit wounded by the struggle.

It is said that one can feel the approach of Furaribi when the air becomes unnaturally hot."

extra_per_season = 50

[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("5_e7ixb")
markedup_text = "Secure a route downward."
requirement = SubResource("Resource_tuogj")
outcome = SubResource("Resource_xxhwh")
markedup_result_text = "A crack in the rock quickly expands into a shaft disappearing into the darkness below.

Safety experts rig a descent with rope and wedges. It's slow going, but steady.

At the bottom is a new chamber. Half-finished statues litter the cave floor: animal limbs, human faces, and shapes none of the settlers recognize.

One of these stands out in particular: a peculiarly accurate heart carved from a single piece of stone."

[sub_resource type="Resource" id="Resource_kio1v"]
script = ExtResource("17_ploc3")

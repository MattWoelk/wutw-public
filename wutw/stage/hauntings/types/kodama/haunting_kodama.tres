[resource]
script = ExtResource("8_aoktp")
haunting_id = "kodama"
name = "Kodama"
name_japanese = "木霊"
name_realistic = "Thick Vegetation"
name_translation = "Tree Spirits"
description = "The forest is said to be guarded by Kodama, tree spirits who punish anyone who fells a tree."
description_realistic = "The forest's growth has turned uncontrollable. Dense underbrush and creeping vines choke the trails, making work slow and hazardous."
description_long = "These woods are watched over by mysterious guardians. Settlers speak of glowing lights with faint faces surrounding the ancient trees. Wherever they pass, roots surge from the soil, grasping at ankles, and trails vanish overnight.

Some swear these are Kodama, spirits of ancient trees driven from their trunks to defend the forest against any who dare harm it. Though not malicious, they punish humans who forget that nature is not a plaything to be toyed with."

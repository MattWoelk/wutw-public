[sub_resource type="Resource" id="Resource_lx7x4"]
script = ExtResource("3_hevnk")
text = "As the population of predators dwindled due to the monthly hunts, rodents became more and more common, and learned to better hide in the walls and crevices of the towns' buildings. Today, it isn't unusual for half the harvest to end up being destroyed by vermin, leading to a cycle of blame that continues to inflame the hatred of animals prevalent among the locals."
requirement = SubResource("Resource_1v2om")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"

[sub_resource type="Resource" id="Resource_y6kl5"]
script = ExtResource("4_hevnk")
scope = 1
event_id = "defiled_shrine"
var_id = "guards"

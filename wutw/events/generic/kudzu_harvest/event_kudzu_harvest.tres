[sub_resource type="Resource" id="Resource_nliq7"]
script = ExtResource("5_ryhf4")
markedup_text = "Refine the starch and make delicate cakes."
requirement = SubResource("Resource_t3nkt")
outcome = SubResource("Resource_d0keq")
markedup_result_text = "The settlers grind the tubers and wash the starch repeatedly in fresh water until it is chalk-white.

The starch is pressed into nuggets, steamed, and dusted with soybean flour, resulting in sweet, wobbly treats.

\"It's like eating a cloud that fell in the mud,\" a child laughs, poking one of the cakes."

[sub_resource type="Resource" id="Resource_l1gue"]
script = ExtResource("11_0pc16")

[sub_resource type="Resource" id="Resource_vew3g"]
script = ExtResource("2_362po")
label = "Look for anything unusual."
aspects = Array[ExtResource("3_kjoqt")]([ExtResource("8_nnom0"), null])
aspects_per_season = Array[ExtResource("3_kjoqt")]([null])
outcome = SubResource("Resource_0eiya")
outcome_text = "A few brave members of the team climb the stairs to the temple's upper level, hoping to investigate the strange noises before setting up camp. Afraid to ignite the dry wood, they conduct the search in the dark.

Although they fail to find the source of the alleged noises, they return with a little statuette, surprisingly unlike the image of the Enlightened One they are used to."

[sub_resource type="Resource" id="Resource_d174p"]
script = ExtResource("13_ldh7b")
delta = 3
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_t8iha"]
script = ExtResource("2_362po")
label = "Perform a cleansing ritual."
aspects = Array[ExtResource("3_kjoqt")]([ExtResource("11_wlqv1"), ExtResource("12_qdvhg")])
outcome = SubResource("Resource_d174p")
outcome_text = "One of the scouts, the most familiar with sacred rites, performs a simple cleansing ritual to pacify any restless spirits, chanting and spraying water on the ground.

The night passes without incident, and in the morning, as they are leaving, they spot an auspicious omen: a bear cub walking towards the temple grounds."

[sub_resource type="Resource" id="Resource_a6ufw"]

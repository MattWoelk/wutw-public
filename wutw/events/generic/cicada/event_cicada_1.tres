[sub_resource type="Resource" id="Resource_6at2x"]
script = ExtResource("4_wgvh1")
markedup_text = "Study the interaction."
requirement = SubResource("Resource_wgvh1")
outcome = SubResource("Resource_kio1v")
markedup_result_text = "The cicada is easily caught mid-air, and the sparrow lands on the ground, the prey secure in its beak.

After methodically pulling off the cicada's legs, the sparrow enjoys its meal, emits a satisfied chirrup, and flies away."

[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("9_nmgxw")
bonus_type = ExtResource("8_mlo2d")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_8mfyw"]
script = ExtResource("4_wgvh1")
markedup_text = "Meditate on the balance of nature."
outcome = SubResource("Resource_df5af")
markedup_result_text = "The cicada is caught. The sparrow flies on. The grass continues to sway in the wind.

All things in nature rise and fall.

Perhaps beauty lies in the transition."

[sub_resource type="Resource" id="Resource_4r7bv"]
script = ExtResource("4_wgvh1")
markedup_text = "Ignore the chase."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_40rqf"]
script = ExtResource("3_p2fdq")
markedup_text = "A sparrow dives on a cicada in a sudden motion that seems to split the air in two.

Settlers pause mid-step, enthralled. It is an everyday occurrence, yet it feels significant.

There's a brief moment to intervene."
background_image = SubResource("Resource_na3kr")
background_credit = ExtResource("5_wgvh1")
choices = Array[ExtResource("4_wgvh1")]([SubResource("Resource_ps5l8"), SubResource("Resource_6at2x"), SubResource("Resource_8mfyw")])
exit_choice = SubResource("Resource_4r7bv")


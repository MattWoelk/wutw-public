[resource]
script = ExtResource("12_1uc6c")
episode_id = "cloud_shapes"
title = "The Shape of a Cloud"
biome_types = Array[int]([0])
text = "At the shard's edge, the scouts stop to watch the clouds below. They twist then separate, briefly forming into shapes before dissolving again.

The shapes look different to each person. Soon the entire group is pointing at the same cloud, calling out details to support their interpretation."
background_image = SubResource("Resource_swiy7")
background_credit = ExtResource("1_psv77")
choices = Array[ExtResource("2_psv77")]([SubResource("Resource_7shn7"), SubResource("Resource_henwa"), SubResource("Resource_3wsyl"), SubResource("Resource_ajufd")])

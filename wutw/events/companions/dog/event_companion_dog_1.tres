[sub_resource type="Resource" id="Resource_m0sij"]
script = ExtResource("8_8oh54")
markedup_text = "Teach it to pull a saw."
requirement = SubResource("Resource_kpq5r")
outcome = SubResource("Resource_5ck20")
markedup_result_text = "The woman spends several days trying to train the dog in the art of sawing.

The dog listens politely, wags its tail, but completely fails to follow the instructions.

Most of the time it gets bored and ends up falling asleep on a pile of logs."

[sub_resource type="Resource" id="Resource_5js2u"]
script = ExtResource("12_uf0qx")
card_type = ExtResource("13_y6p2g")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_aox5c"]
script = ExtResource("8_8oh54")
markedup_text = "Give the dog away."
outcome = SubResource("Resource_5js2u")
markedup_result_text = "The woman decides that she is no longer able to take care of an elderly dog, given her busy job.

The dog is rehomed to a nice family on the other side of the settlement.

It looks on mournfully as the woman walks away for the last time."

[sub_resource type="Resource" id="Resource_1ea03"]
script = ExtResource("6_0u2kj")
markedup_text = "One of the woodworkers has inherited an old dog from her father, who has become her constant companion.

In its younger days, the dog helped drag logs to the lumber yard, and carry planks to the storage shed, but now it's too old to do such hard labor. Still, it insists on following the woodworker around.

The woman has to decide how to deal with the mild annoyance of a dog always getting in the way."
background_image = SubResource("Resource_mclkw")
background_credit = ExtResource("9_i8imy")
choices = Array[ExtResource("8_8oh54")]([SubResource("Resource_htdcv"), SubResource("Resource_ldbl8"), SubResource("Resource_m0sij")])
exit_choice = SubResource("Resource_aox5c")


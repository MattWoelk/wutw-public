[resource]
script = ExtResource("8_j54wq")
haunting_id = "kappa"
name = "Kappa"
name_japanese = "河童"
name_realistic = "Slippery Rocks"
name_translation = "Children of the River"
description = "Settlers blame the mischievous Kappa for dragging their goods and children into the river."
description_realistic = "Algae and moss have made the river stones slick, causing folks to lose their footing."
description_long = "Work by the river has become treacherous. People slip and tumble into the rapids, coming back soaked and shivering, claiming webbed hands grabbed at their ankles from just beneath the surface.

The locals say the Kappa have claimed the banks. These river children have a hollow dish of water set into the top of their heads, granting them the strength to drag humans into the rushing stream. Tradition dictates that offering them a cucumber might buy safe passage, but priests suggest bowing instead. The creatures are compelled to bow in return, spilling the life-giving water from their heads and losing their strength."
image_small = ExtResource("4_nrcy0")
image_credit = ExtResource("4_nnx6r")
image_small_realistic = ExtResource("5_nnx6r")
image_realistic_credit = ExtResource("5_oaybg")
spot_type = ExtResource("7_oaybg")

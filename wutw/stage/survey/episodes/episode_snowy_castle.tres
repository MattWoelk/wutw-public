[sub_resource type="Resource" id="Resource_q4vs1"]
script = ExtResource("2_mxp1c")
label = "Take the ornaments."
aspects = Array[ExtResource("3_cgir6")]([ExtResource("4_co0p6"), ExtResource("5_wq2cs")])
outcome = SubResource("Resource_m7vo7")
outcome_text = "The scouts fill their satchels with golden treasure, snatching every trinket within their reach.

The next day the group finds two of their teammates missing, along with all the gold."

[sub_resource type="Resource" id="Resource_sw2y7"]
script = ExtResource("7_pgl7k")
card_type = ExtResource("10_k2mbh")

[sub_resource type="Resource" id="Resource_nl734"]
script = ExtResource("11_44i3v")
result_text = "The scouts cut through the corroded ring attaching the bell to the roof of the tower, but it turns out to be heavier than they had expected.

It falls on their feet and rolls down the stairs before disappearing into the forest.

They take it as a sign to leave it alone."

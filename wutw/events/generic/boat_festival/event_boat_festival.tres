[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("5_dhimx")
markedup_text = "Host a small gathering to share stories of old boat festivals."
requirement = SubResource("Resource_tuogj")
outcome = SubResource("Resource_df5af")
markedup_result_text = "Settlers gather to hear old festival tales, how boats once symbolized promises to future generations.

Someone traces a glyph in the dirt."

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_dhimx")
markedup_text = "Pass the day in quiet contemplation."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("3_dkqqg")
markedup_text = "The lake is still in the pale light of dawn. A few settlers have taken sailboats out to catch the morning breeze.

Several canoes are tied by the shore, one loaded with baskets and sailcloth.

\"In the Old World, we used to launch boats with painted sails to mark a year's guiding glyph.\" One settler reminisces. \"But perhaps it is not yet time for such extravagance.\""
background_image = SubResource("Resource_wyxwf")
background_credit = ExtResource("5_wyxwf")
choices = Array[ExtResource("5_dhimx")]([SubResource("Resource_egt2j"), SubResource("Resource_4xuhh"), SubResource("Resource_rx1a8")])
exit_choice = SubResource("Resource_dpp3j")


original_image = SubResource("Resource_bcsnl")
piece_name = "Poem by Yamabe no Akahito, from One Hundred Poems by One Hundred Poets"
artist = ExtResource("1_o8dp1")
styles = Array[ExtResource("4_6x08n")]([ExtResource("5_g180i")])
actual_start_year = 1767
actual_end_year = 1769
date_type = 1
edits_description = "The image was cropped and the text was removed."
final_image_tex = SubResource("Resource_alwh0")
province = 55
blurb = "Depicts two young women collecting brine in buckets at Tago Bay (present-day Shizuoka prefecture), with Mount Fuji in the distance. Although the exact location is unknown, it was a scenic coastal inlet famous for its salt flats, turbulent waters, and iconic views of Mount Fuji, as well as being the subject of many ukiyo-e prints.

The inscription at the top is a poem about the area by Yamabe no Akahito, a famous 8th-century poet:

[i]In Tago Bay,
if you look in the distance,
on the pure white
peaks of Mount Fuji
the snow continues to fall.[/i]"
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

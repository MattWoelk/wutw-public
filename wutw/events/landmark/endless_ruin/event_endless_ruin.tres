[sub_resource type="Resource" id="Resource_pf411"]
script = ExtResource("5_4vlme")
markedup_text = "Explore the lower chambers."
requirement = SubResource("Resource_ijqs6")
outcome = SubResource("Resource_4fpj6")
markedup_result_text = "A team rigs lines and descends. Echoes trail behind them: metal clangs, murmurs, and the crack of loosening stone.

They emerge scraped and winded, but triumphant. One carries a bundle wrapped in old, frayed fabric.

\"Worth it,\" they say."

[sub_resource type="Resource" id="Resource_2rpah"]
script = ExtResource("25_eo8ry")
card_type = ExtResource("24_d6xpt")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_eyvo4"]
script = ExtResource("27_a77qp")
aspect_type = ExtResource("26_q6isb")
min_count = 2

[sub_resource type="Resource" id="Resource_658i2"]
script = ExtResource("5_4vlme")
markedup_text = "Catalog existing findings."
requirement = SubResource("Resource_eyvo4")
outcome = SubResource("Resource_2rpah")
markedup_result_text = "Instead of braving the caves, the settlers dig through crates of neglected past findings.

Pottery shards and unusually shaped stones are dusted and carefully recorded into a ledger.

No grand discoveries today. Just orderly documenting and shared nods."

[sub_resource type="Resource" id="Resource_3dyre"]
script = ExtResource("25_eo8ry")
card_type = ExtResource("28_wpmeb")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_o44fc"]
script = ExtResource("5_4vlme")
markedup_text = "Collect fragments from the upper tunnels."
outcome = SubResource("Resource_3dyre")
markedup_result_text = "The settlers collect chipped fragments of ancient tools and weapons, tablets with illegible markings, and pottery embedded in the cavern walls.

None of these are useful by themselves, but someday they may fit into a larger puzzle."

[sub_resource type="Resource" id="Resource_ch4xi"]
script = ExtResource("5_4vlme")
markedup_text = "Leave exploration for another day."
markedup_result_text = "The sun sets with the ruins undisturbed.

The wind whistles through ancient corridors and buried arches.

They'll still be here tomorrow."

[sub_resource type="Resource" id="Resource_1dxtn"]
script = ExtResource("3_jawht")
markedup_text = "The entrance yawns dark below the iron giant, leading into a catacomb of tunnels glimmering with buried glass and bits of metal.

Down in the tunnels, makeshift beams strain under rope rigs and pulleys, as voices echo faintly from further below.

\"This level's stable,\" an archaeologist says, as the ceiling groans in protest.
\"We could keep descending, if enough of you are willing to hold the ropes.\"

The deeper chambers promise ancient mechanisms and forgotten knowledge, but a slipped rope strike could mean a loss of lives."
background_image = SubResource("Resource_nwrj1")
background_credit = ExtResource("10_a1pu3")
choices = Array[ExtResource("5_4vlme")]([SubResource("Resource_pf411"), SubResource("Resource_658i2"), SubResource("Resource_o44fc")])
exit_choice = SubResource("Resource_ch4xi")


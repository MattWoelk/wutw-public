[sub_resource type="Resource" id="Resource_tjnww"]
script = ExtResource("2_xk5i1")
label = "Throw snowballs."
aspects = Array[ExtResource("3_b33sg")]([ExtResource("4_v3fpp")])
outcome = SubResource("Resource_wpc33")
outcome_text = "A scout cups some snow into her hands and hurls it towards one of her teammates.

The retaliation is swift, and others are quick to join in.

Soon the entire survey team is covered in snow as their laughter echoes through the valley below."

[sub_resource type="Resource" id="Resource_wdnic"]
script = ExtResource("6_u8qsa")

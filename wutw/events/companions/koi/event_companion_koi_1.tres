[sub_resource type="Resource" id="Resource_q4scc"]
script = ExtResource("10_foms3")
markedup_text = "Drag all the hemp out before untangling it."
outcome = SubResource("Resource_w3xbw")
markedup_result_text = "The workers drag all the hemp onto dry land, and leave it to dry out.

In the evening, the tangled bundles are unraveled to reveal a carp that had gotten caught in the long strands. Unfortunately, it is too late to save the fish."


[resource]
script = ExtResource("8_766aa")
haunting_id = "gaki"
name = "Gaki"
name_japanese = "餓鬼"
name_realistic = "Insect Swarms"
name_translation = "Hungry Ghosts"
description = "These lands are haunted by the Gaki, hungry ghosts cursed to devour everything yet never be filled."
description_realistic = "Swarms of insects have infested the area, consuming every trace of food."
description_long = "Tales abound of ancient sinners from this land returning as Gaki, eternally hungry ghosts devouring every planted seed and stored grain. In life, they were said to have hoarded food from others. In death, their bellies swell while their throats remain narrow, dooming them to eternal hunger.

Some settlers still leave offerings of rice and water in the night, hoping the monsters will turn elsewhere, but they never do."
image_small = ExtResource("6_j2qqi")
image_credit = ExtResource("5_j2qqi")

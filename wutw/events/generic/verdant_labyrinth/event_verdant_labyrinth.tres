[sub_resource type="Resource" id="Resource_oq5cu"]
script = ExtResource("3_br3hg")
event_step_id = "cedar_door"
markedup_text = "Following the thinnest trail the settlers reach a giant cedar tree with low, drooping branches.

As they take shelter under them from the sudden downpour, they see a small opening in the trunk near the ground, a welcome refuge from the elements.

They find themselves inside a chamber of living wood, the interior etched with winding vines and animal figures.

Marveling at the strangeness of their shelter, one settler steps backward and stumbles. There, at the back of the chamber, is a series of steps leading underground. 

The air grows cold and damp as they descend the ancient stone staircase. At the foot of the stairs is a cave, one side leading toward a faint light."
background_image = SubResource("Resource_nwyap")
background_credit = ExtResource("27_ax2pp")
choices = Array[ExtResource("5_scwy6")]([SubResource("Resource_soubs"), SubResource("Resource_y16w7")])
exit_choice = SubResource("Resource_hov1k")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


[resource]
script = ExtResource("9_qj400")
haunting_id = "yume_no_seirei"
name = "Yume no Seirei"
name_japanese = "夢の精霊"
name_realistic = "Disenchantment"
name_translation = "Dream Ghost"
description = "The dream spirit, Yume no Seirei, is feasting on the dreams of the settlers in this town, rendering them unable to find beauty in their life."
description_realistic = "Excessive intellectualism has caused many of the settlers to be disenchanted with the mysteries of life, finding beauty in neither nature nor human activities."
description_long = "Many settlers in this town have found their life force drained after a visit from Yume no Seirei, a ghastly spirit appearing as a decrepit old man by their bedsides and stealing their dreams. When they awake, they find their days turning into an endless cycle of drudgery, bereft of higher meaning."
image_small = ExtResource("6_14m6t")
image_credit = ExtResource("5_rei83")
image_small_realistic = ExtResource("7_opsnk")
image_realistic_credit = ExtResource("6_fdjv0")

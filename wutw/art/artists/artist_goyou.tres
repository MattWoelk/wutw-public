[resource]
script = ExtResource("2_hir6e")
name = "Hashiguchi Goyō"
portrait = SubResource("Resource_utp5m")
blurb = "Hashiguchi Goyō was a painter and [url=art_style:shin-hanga]shin-hanga[/url] artist active in the early 20th century.

He studied at the Tōkyō School of Fine Arts, graduating best in his class in 1905, and published many articles about the history and techniques of ukiyo-e. His first commission was designing the layout and illustrations for Natsume Sōseki's famous novel I Am a Cat.

He only released 14 woodblock prints during his lifetime, but they are often regarded as masterpieces of the genre."
birth_year = 1880
death_year = 1921
link = "https://en.wikipedia.org/wiki/Goy%C5%8D_Hashiguchi"

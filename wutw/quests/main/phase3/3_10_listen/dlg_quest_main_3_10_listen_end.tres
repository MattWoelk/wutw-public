[resource]
script = ExtResource("1_co7mh")
dialogue_id = "mq_3_10_end"
record_title = "Era 三: Nature's Advice 二"
text = "PAGE: scribe(PORTAL_NETWORK), AUDIENCE
scribe: We have seen the signs.
scribe: The Enlightened One does speak to us through the land.
scribe: But the fractured spirits are faint.
scribe: They do not yet trust us, or they would not appear as hauntings.
scribe: We must learn to live in harmony with the land.
scribe: To prove our worth by action, or even sacrifice.
scribe: Our efforts have broken the long silence, but we must find a place of quiet communion, out in the wilderness.
scribe: A place where the spirits of the wild feel welcome to approach us."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

extra_per_season = 20

[sub_resource type="Resource" id="Resource_x0wto"]
script = ExtResource("5_ryhf4")
markedup_text = "Process the stems into paper."
requirement = SubResource("Resource_p26hk")
outcome = SubResource("Resource_06ahh")
markedup_result_text = "The tubers are left untouched, ready to sprout again, while the vines are cut.

The woody stems are boiled and beaten into a pulp, then mixed into a slurry. Craftspeople use screens to form thin sheets and dry them into paper.

This paper will be used to make painted screens and sliding doors, perfect to keep houses cool while adding a touch of refinement."

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("11_0pc16")
bonus_type = ExtResource("16_knwn6")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_u5csk"]
script = ExtResource("5_ryhf4")
markedup_text = "Boil the tubers into a hearty survival paste."
outcome = SubResource("Resource_ciwob")
markedup_result_text = "There is no time for fancy sweets. The tubers are boiled down into a thick, flavorless, but incredibly filling glue.

It is not a meal anyone will sing songs about, but it will keep the hunger away for a long time."

[sub_resource type="Resource" id="Resource_fbr55"]
script = ExtResource("3_oh3gi")
markedup_text = "The kudzu harvest has been more than plentiful. The vines threatened to swallow the toolshed by the time they were ripe, and the tubers have grown to the size of a person's thigh.

The tubers can be ground into starch, while the vines could be turned into fiber for baskets or paper.

There aren't enough farmers to process everything, so the settlers have to decide what to focus on."
background_image = SubResource("Resource_a4hru")
background_credit = ExtResource("5_a4hru")
choices = Array[ExtResource("5_ryhf4")]([SubResource("Resource_nliq7"), SubResource("Resource_nr4mk"), SubResource("Resource_x0wto")])
exit_choice = SubResource("Resource_u5csk")


[sub_resource type="Resource" id="Resource_j44wq"]
script = ExtResource("5_trgiv")
markedup_text = "Forgive and move on."
requirement = SubResource("Resource_p0604")
outcome = SubResource("Resource_t01g5")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "The fences are raised again, and the grounds are swept clean.

Those who drank in excess are the most eager to volunteer help.

The incident is soon forgotten.

The monks breathe easier, their peace no longer disturbed."

[sub_resource type="Resource" id="Resource_3v022"]
script = ExtResource("4_fute0")
markedup_text = "Morning finds the shrine defiled. Fences crushed, offerings overturned, and sacred ground soiled.

Rumors mutter of drunk settlers, stumbling home from the shrine dedication. Those formerly drunk settlers point the finger at wild beasts, drawn by food left over from the celebration.

Monks discuss whether to set guards at the shrine, question the people, or deter the animals. Unable to settle on a solution, they meditate to receive the Enlightened One's wisdom."
background_image = SubResource("Resource_8hh1b")
background_credit = ExtResource("6_48pdk")
choices = Array[ExtResource("5_trgiv")]([SubResource("Resource_esg6e"), SubResource("Resource_tv6vb"), SubResource("Resource_6dhhf"), SubResource("Resource_j44wq")])


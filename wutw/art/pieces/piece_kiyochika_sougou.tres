[resource]
script = ExtResource("3_hdjsx")
original_image = SubResource("Resource_bcsnl")
piece_name = "Sōgorō at the Ferry Landing"
artist = ExtResource("1_eppde")
actual_start_year = 1884
actual_end_year = 1884
date_type = 1
edits_description = "The background was removed and the image was flipped. Only the ferryman was used."
final_image_tex = SubResource("Resource_h6dpt")
province = 62
blurb = "Depicts [url=https://en.wikipedia.org/wiki/Sakura_S%C5%8Dgor%C5%8D]Sakura Sōgorō[/url] asking for passage from a ferryman named Jinbei.

Sōgorō is a legendary figure said to have been a 17th-century farmer executed for appealing to the shōgun to reduce the heavy taxation of peasant, for which he was executed.

This scene is based on the kabkui play Toeizan Nofu no Negaisho (A Farmer's Petition at Mt. Toei)."

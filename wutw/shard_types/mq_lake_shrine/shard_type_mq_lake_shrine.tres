metadata/_custom_type_script = "uid://bt2jv4savcrpl"

[sub_resource type="Resource" id="Resource_4nsyt"]
script = ExtResource("4_6wk7u")
scope = 1
event_id = "shrine_ritual"
var_id = "rice_pot"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_iffm1"]
script = ExtResource("8_n1bg2")
text = "The dining culture of this shard is its most distinctive feature. It seems that the people of each town have all of their meals together at a single eatery. The lines can be a bit long, but all the food is free, and I can say from personal experience that it does taste very good.

The eateries are maintained by the local priesthood, and the townsfolk regularly contribute ingredients into the common pot. Multiple people asked if I had brought any ingredients from off the shard, and seemed disappointed when I said that I hadn't known of the custom before arriving here.

I visited one more town before coming back. On my way there I camped by the road for the night and had some of my travel rations. As I was doing so, an old woman passing by came over to chastise me. Apparently it's bad manners here to eat alone. The next day I got to have a meal at my destination, which was served the same way, but tasted quite different, heavy with ginger and mustard seed."
metadata/_custom_type_script = "uid://ciddaw1laebi3"

[sub_resource type="Resource" id="Resource_mpawi"]
script = ExtResource("9_cbk7m")
trip_reward = SubResource("Resource_iffm1")
requirement = SubResource("Resource_4nsyt")
metadata/_custom_type_script = "uid://bt2jv4savcrpl"

[sub_resource type="Resource" id="Resource_ak2g4"]
script = ExtResource("4_6wk7u")
scope = 1
event_id = "shrine_ritual"
var_id = "compost"
var_type = 1
value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_xlbtf"]
script = ExtResource("8_n1bg2")
text = "I arrived on this shard at a fortunate time. The leaves had just started to turn red, and the local artists were at the peak of their activity. Each morning from the window of my inn I saw groups of people arranging leaves into great murals, which were swept into the lake by evening. My favorite was one that showed a lone deer standing on a cliff looking at a sunset.

I didn't have time to visit the famous lake shrine, but I did go to the smaller shrine in the town where I was staying. The priest there was particularly proud of their graveyard, which looked like an oddly orderly forest. They don't burn their dead here, and they don't put memorial stones either. Instead, they bury the bodies under a sapling, and the deceased's family cares for the tree. They see it as maintaining the cycle of nature."
metadata/_custom_type_script = "uid://ciddaw1laebi3"

[sub_resource type="Resource" id="Resource_uqq01"]
script = ExtResource("9_cbk7m")
trip_reward = SubResource("Resource_xlbtf")
requirement = SubResource("Resource_ak2g4")
metadata/_custom_type_script = "uid://bt2jv4savcrpl"


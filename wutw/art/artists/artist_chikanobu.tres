[resource]
script = ExtResource("4_d3xmg")
name = "Toyohara Chikanobu"
blurb = "Toyohara Chikanobu was a printmaker of the Meiji period who began his career depicting battle scenes, but is best known for his detailed illustrations of the Imperial family and the changing fashions of Japanese society.

His works documented traditional aristocratic customs that were slowly fading, while simultaneously capturing the introduction of Western clothing and modern hairstyles, often in a triptych format."
birth_year = 1838
death_year = 1912
link = "https://en.wikipedia.org/wiki/Toyohara_Chikanobu"

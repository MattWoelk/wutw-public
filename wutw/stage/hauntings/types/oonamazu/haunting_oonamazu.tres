[resource]
script = ExtResource("7_qrlfc")
haunting_id = "oonamazu"
name = "Ōnamazu"
name_japanese = "大鯰"
name_realistic = "Floods"
name_translation = "Giant Catfish"
description = "Settlers warn of a monstrous catfish sleeping beneath the mud, whose restless thrashing turns the shores into an endless expanse of mud."
description_realistic = "The lake is subject to flash floods that turn the whole area into a muddy mess."
description_long = "The clear waters of the lake have turned a thick, churning brown. Settlers who live on the shores claim to feel a deep thumping through the soles of their feet.

This is the work of Ōnamazu, a catfish of impossible size sleeping beneath the waves. When humans grow arrogant and build their homes too close to the water, the beast wakes to remind them of their proper place. Its angry thrashing stirs up the lake, sending its waters out across the plains."
image_small = ExtResource("6_peyhq")
image_credit = ExtResource("6_508kr")
image_small_realistic = ExtResource("7_fj62k")
image_realistic_credit = ExtResource("7_508kr")

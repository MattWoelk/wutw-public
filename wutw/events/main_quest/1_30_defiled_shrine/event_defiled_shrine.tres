[sub_resource type="Resource" id="Resource_6dhhf"]
script = ExtResource("5_trgiv")
markedup_text = "Question the locals."
outcome = SubResource("Resource_8m1fb")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "The monks summon the village in, one household at a time.

Sharp questions fall, faces pale, and denials echo hollow.

Finally some admit the drink had erased last night's memory. Their friends confirm the crime, eager to be spared suspicion.

The culprits are made to clean the shrine for the next month, and no further incidents occur.

The monks breathe easier, their peace no longer disturbed."


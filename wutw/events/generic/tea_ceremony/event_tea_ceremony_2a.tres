[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("6_0d60t")
markedup_text = "Ignore the issue and move on."
outcome = SubResource("Resource_4jjkj")
markedup_result_text = "The spilled kettle is righted, the burn wrapped, and the feast continues, albeit with less joy."

[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("4_tfh5k")
markedup_text = "The custom of turning tea breaks into feasts has traveled across the shard with the expedition. Now, each ceremony at the pavilion ends with more dishes than hands to carry, and more cups than lips to sip with.

Someone pours water into three kettles at once, and another rushes to stack serving trays.

Suddenly, a sharp cry cuts through the warm chatter. A kettle has spilled. The scald is minor, but the host is beginning to panic."
background_image = SubResource("Resource_e1dej")
background_credit = ExtResource("6_4jjkj")
choices = Array[ExtResource("6_0d60t")]([SubResource("Resource_f2op8"), SubResource("Resource_4xuhh"), SubResource("Resource_tuogj")])
exit_choice = SubResource("Resource_rx1a8")


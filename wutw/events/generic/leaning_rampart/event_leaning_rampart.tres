[sub_resource type="Resource" id="Resource_r0oeh"]
script = ExtResource("5_dxnvu")
markedup_text = "Rebuild it properly."
requirement = SubResource("Resource_kjam1")
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "Resources are brought from the nearby settlement. Proper tools, sturdy timber, hewn stone.

As the final tile is laid, the workers look on in pride.

This piece of the past is no longer a ruin."

[sub_resource type="Resource" id="Resource_fmixu"]

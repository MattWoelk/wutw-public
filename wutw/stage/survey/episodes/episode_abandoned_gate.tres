label = "Search the gatehouse."
aspects = Array[ExtResource("3_kigac")]([ExtResource("4_61jmq")])
aspects_per_season = Array[ExtResource("3_kigac")]([null])
outcome = SubResource("Resource_13h7a")
outcome_text = "The group searches the gatehouse. Among the crumbling furniture they manage to find several spears. They collect their iron tips for blacksmiths to reforge later."


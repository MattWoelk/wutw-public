[resource]
script = ExtResource("3_6fbmm")
original_image = SubResource("Resource_bcsnl")
piece_name = "Okabe: The Story of the Cat Stone"
series = ExtResource("4_5bdyf")
artist = ExtResource("1_6fbmm")
styles = Array[ExtResource("4_iobtl")]([ExtResource("6_i34pv"), ExtResource("7_aajlj")])
actual_start_year = 1845
actual_end_year = 1846
date_type = 1
edits_description = "Only the old woman was used."
final_image_tex = SubResource("Resource_jg17w")
province = 55
blurb = "Depicts a folklore scene associated with the village of Okabe (in present-day Shizuoka prefecture). A young woman is being menaced by an old, monstrous woman. In the background, a giant ghostly apparition of a cat appears through shredded blinds. The text at the top gives context:

[i]Along a narrow ivy path above the shrine plain, beside the edge of six or seven old pine trees, lies the Cat Stone, a giant boulder resembling the shape of a crouching cat.

Long ago, there was a solitary house in this place. An ancient mountain cat transformed into an old woman here and harmed many people. It tormented the locals until a Lesser Tengu exterminated it.

According to folklore, the beast finally died and its spirit transformed into this stone, though the exact details of this legend remain uncertain.[/i]"
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

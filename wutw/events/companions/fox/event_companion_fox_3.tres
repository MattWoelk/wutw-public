[sub_resource type="Resource" id="Resource_32k5o"]
script = ExtResource("6_7t3xg")
markedup_text = "Build lanterns to keep the road lit."
requirement = SubResource("Resource_grohw")
outcome = SubResource("Resource_ajmsu")
markedup_result_text = "The guards decide to let the foxes go this time, and instead invest in a long-term deterrent.

They hire masons to erect stone lanterns along the path, lit every night. The foxes no longer show up, and the granaries remain quiet. Some townsfolk whisper that their spirits must have been appeased."


[sub_resource type="Resource" id="Resource_1akde"]
script = ExtResource("5_a0mbk")
markedup_text = "Choose the supple willow, graceful in its resilience."
requirement = SubResource("Resource_ounhi")
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "The florist selects the supple willow. She coaxes the main stem upward before letting its trailing foliage cascade over the lip of the basin.

To harmonize with the weeping figure, she adds bellflowers that trail closely along the willow's arch.

Finally, she places a cluster of smooth, water-worn stones at the base, to emphasize the resilience in yielding to the flow."

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("11_oyj2m")
card_type = ExtResource("20_lnd2f")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_hsrnq"]
script = ExtResource("5_a0mbk")
markedup_text = "Choose a dead branch of unclear origin."
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "The florist selects the withered piece of wood, fated to never bloom again.

She anchors it firmly, treating its twisted form with reverence. Around the base, she places fleshy succulents and tall, crimson wildflowers wrapped intimately around the lifeless wood.

The result is a striking contrast, vibrant new life rising from the unchangeable bones of the past."

[sub_resource type="Resource" id="Resource_mt2y1"]
script = ExtResource("3_cqeyj")
markedup_text = "The garden's master florist is preparing an arrangement for the township's founding ceremony.

She must choose the anchor, a single strong branch reaching up into the heavens. Everything else will bend and flow around this anchor to complete the arrangement.

She studies the available choices, noting the true essence of each branch."
background_image = SubResource("Resource_igx6w")
background_credit = ExtResource("5_igx6w")
choices = Array[ExtResource("5_a0mbk")]([SubResource("Resource_mwbmk"), SubResource("Resource_b737w"), SubResource("Resource_1akde")])
exit_choice = SubResource("Resource_hsrnq")


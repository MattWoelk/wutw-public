[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_3xl68")
markedup_text = "Burn the fruit as a ceremonial offering."
requirement = SubResource("Resource_rx1a8")
outcome = SubResource("Resource_df5af")
markedup_result_text = "The fallen fruit is gathered into neat mounds.

Fire is lit, and prayers are murmured, some old, some invented on the spot.

The ashes smell faintly of sugar.

The elders shake their heads, saying at least it should have fed someone.

The younger settlers mutter that spirits belong in the Old World."


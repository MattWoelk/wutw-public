metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_ybpct"]
script = ExtResource("10_d4c3j")
markedup_text = "Save the toad."
outcome = SubResource("Resource_er7h7")
markedup_result_text = "A settler yells out, trying to alert the toad, and succeeds in scaring both animals.

The toad quickly disappears into the water.

The cat, once recovered from a momentary panic, shoots the settlers a profound look of disapproval and slowly walks away."

[sub_resource type="Resource" id="Resource_yu5w1"]

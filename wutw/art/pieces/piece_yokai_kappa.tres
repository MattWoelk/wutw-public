piece_name = "Kappa and Friends"
styles = Array[ExtResource("4_l05um")]([ExtResource("4_aq6i4"), ExtResource("5_im5nd")])
date_type = 30
custom_link = "https://da.nichibun.ac.jp/en/item/005465943"
edits_description = "The background was edited out and only the kappa was used."
final_image_tex = SubResource("Resource_e30o6")
blurb = "Depicts several yōkai including a Kappa (\"river child\"), one of the most well-known yōkai. It is said to be an amphibian, about the size of a child, living in the lakes and rivers of Japan.

The kappa has webbed feet and hands, scaly or slippery skin, often with a turtle-like shell on its back. Most depictions of kappa have a dish-like structure on the top of their head, filled with some kind of liquid. Kappa enjoy sumo wrestling, eating cucumbers, and causing trouble in various ways.

This image is part of a yōkai scroll of unknown authorship from the late Edo period, linked above."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_es5j5"]
script = ExtResource("5_jputc")
markedup_text = "Let the stalls remain."
requirement = SubResource("Resource_8sbdo")
outcome = SubResource("Resource_3cxsd")
markedup_result_text = "The safety warden shrugs his shoulders and plops down onto a crowded bench.

The stall keeper serves tea for the whole crowd, pouring from a huge jug until the tea spills into the saucers below.

\"There is time for strictness,\" he says, \"but there must also be time for excess.\""


[resource]
script = ExtResource("3_86x75")
name = "Konishi Hirosada"
blurb = "Konishi Hirosada was the most prolific Ōsaka-based designer of ukiyo-e woodblock prints during the late Edo period. He specialized in [url=art_style:yakusha-e]yakusha-e[/url] and is particularly known for his diptychs and triptychs, as well as many ōkubi-e portraits of the leading actors on the Ōsaka kabuki stage during his day.

He is also known as Gosōtei Hirosada, Gorakutei Hirosada and Utagawa Hirosada. Some scholars suspect he was also Utagawa Sadahiro."
birth_year = 1819
death_year = 1865
link = "https://en.wikipedia.org/wiki/Konishi_Hirosada"
schools = Array[ExtResource("1_ccmpk")]([ExtResource("2_hrcg0")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("5_ehx26")
markedup_text = "Offer to mend her cups."
requirement = SubResource("Resource_dpp3j")
outcome = SubResource("Resource_4xuhh")
markedup_result_text = "After tea service is finished, an artisan mixes lacquer with rice flour to fill in the chips and cracks.

Once the paste cures, each crack is polished with gold powder.

The host insists that the guests take one cup as a memento."

[sub_resource type="Resource" id="Resource_tuogj"]

[sub_resource type="Resource" id="Resource_h6j88"]
script = ExtResource("13_mciqf")
aspect_type = ExtResource("17_xcjcc")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_8bk2h"]
script = ExtResource("5_jbj2b")
markedup_text = "Spread the hulls on the earthen floors."
requirement = SubResource("Resource_h6j88")
outcome = SubResource("Resource_4xuhh")
markedup_result_text = "The hulls are spread inside every dwelling, carpets to soften the hard ground.

The damp cold no longer seeps into the sleeping mats, but it is dusty, and the sound of skittering is now an ever-present nuisance."

[sub_resource type="Resource" id="Resource_ht6bl"]
script = ExtResource("5_jbj2b")
markedup_text = "Burn the hulls."
markedup_result_text = "The farmers are too tired to put it more effort. They opt for the quickest way to clear the field instead.

The pile is lit, filling the settlement with heavy, pungent smoke for days."

[sub_resource type="Resource" id="Resource_tlhrq"]
script = ExtResource("3_wjykd")
markedup_text = "The threshing is finished, the grain safely stored in the granary, and the hulls gathered in huge piles. The wind rattles through the piles with a dry, whispering sound.

The settlers, exhausted from the harvest, complain of backaches, claiming that the straw mats offer little relief from the hard, cold ground of the new world.

A seamstress offers to make pillows out of the hulls. \"They hold their shape,\" she explains, \"and they breathe.\"

The farmers are tempted, but they could also compost the hulls so the soil remains fertile, though that will take some effort."
background_image = SubResource("Resource_sw005")
background_credit = ExtResource("5_sw005")
choices = Array[ExtResource("5_jbj2b")]([SubResource("Resource_fea22"), SubResource("Resource_h2fiq"), SubResource("Resource_8bk2h")])
exit_choice = SubResource("Resource_ht6bl")


"AppBuild"
{
	"AppID" "4567730"
	"Desc" "Worlds Upon The Wind Demo"

	"ContentRoot" "builds\"
	"BuildOutput" "steamworks_sdk\tools\ContentBuilder\output\"
	"SetLive" "release-candidate"

	"Depots"
	{
		"4567731"
		{
			"FileMapping"
			{
				"LocalPath" "win_demo\*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
		"4567732"
		{
			"FileMapping"
			{
				"LocalPath" "linux_demo\*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
	}
}

[sub_resource type="Resource" id="Resource_pogdi"]
script = ExtResource("2_klaar")
label = "Take a nap."
aspects = Array[ExtResource("3_iifpr")]([ExtResource("4_mjrwy")])
outcome = SubResource("Resource_v03f7")
outcome_text = "The surveyors stretch out in the sun and fall asleep. 

When they awake, the trees are casting long shadows across their faces in the afternoon sun.

A herd of deer is grazing only steps away from them. When one of the scouts rises, the whole herd takes off in a rush."


[resource]
script = ExtResource("8_yxl0j")
haunting_id = "akaname"
name = "Akaname"
name_japanese = "垢嘗"
name_realistic = "Sickness"
name_translation = "Filth Licker"
description = "Filth-licking goblins are said to gather in these dirty ruins, spreading sickness wherever they crawl."
description_realistic = "Illness spreads quickly among the unwashed. Poor sanitation in this settlement has turned homes and baths into breeding grounds for disease."
description_long = "At first, settlers only complained of sluggishness and fever. Then came the slime, a damp sheen creeping across the walls. Those who spent the night by the ruins swore they heard faint slurping sounds, as if something small and eager were licking at their bedrolls.

In the Old World they spoke of Akaname, goblins born of neglect, living off the waste and grime of the careless. Their tongues are said to stretch across rooms, leaving behind sickness in their wake. Cleanliness alone keeps these creatures at bay."
image_small = ExtResource("5_pk248")
image_credit = ExtResource("5_ssidw")
image_small_realistic = ExtResource("6_ssidw")
image_realistic_credit = ExtResource("6_dooth")

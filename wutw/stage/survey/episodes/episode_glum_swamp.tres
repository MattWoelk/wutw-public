[sub_resource type="Resource" id="Resource_ycthf"]
script = ExtResource("2_im846")
label = "Ignore the pessimist."
aspects = Array[ExtResource("3_msq25")]([null])
aspects_per_season = Array[ExtResource("3_msq25")]([null])
outcome = SubResource("Resource_x1ga2")
outcome_text = "The group decides to ignore the gloomy man's grumbling. They take the tree as a sign of drier land nearby. They rush ahead towards the next tree, letting their glum teammate trail behind.

The ground seems firmer at first, but then rapidly gives way under their feet.

The rescue takes up the rest of the day."

[resource]
script = ExtResource("12_js153")
episode_id = "glum_swamp"
title = "Lost in the Swamp"
biome_types = Array[int]([4])
text = "The scouts' sandals cling to the muck as they swat at clouds of insects. They have been circling the same pools and arguing over the same landmarks under the overcast sky all day.

At last, they come upon something new: a small blooming cherry tree alone in the swamp.

\"Probably the last tree we'll ever see,\" mutters one of the scouts."
background_image = SubResource("Resource_uk5o6")
background_credit = ExtResource("1_im846")
choices = Array[ExtResource("2_im846")]([SubResource("Resource_1ut1l"), SubResource("Resource_5myv4"), SubResource("Resource_vhj8x"), SubResource("Resource_ycthf")])

[sub_resource type="Resource" id="Resource_b7bul"]
script = ExtResource("6_qijx8")
markedup_text = "Discuss the illusory nature of ambition."
requirement = SubResource("Resource_4ec7n")
outcome = SubResource("Resource_8pb08")
markedup_result_text = "A scholar seizes the moment to deliver an impromptu lecture.

\"Behold,\" he announces to the bathers, \"a perfect metaphor for human craving. We reach for illusions, grasping...\"

His speech is cut short when the monkey loses its grip and plummets into the spring, splashing water all over the scholar's robes and eliciting a few stifled chuckles from his audience."


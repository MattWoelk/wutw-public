[resource]
script = ExtResource("4_v45gw")
name = "Adachi Ginkō"
blurb = "Adachi Ginkō was an ukiyo-e artist of the Utagawa school. He worked in a variety of genres, including [url=art_style:bijin-ga]bijin-ga[/url], [url=art_style:yakusha-e]yakusha-e[/url], landscapes, book illustrations, and satirical works.

He produced many prints of contemporary events such as the Satsuma Rebellion and the First Sino-Japanese War. His most popular work is the series of triptychs titled Pictorial Outline of Japanese History, published from 1885 to 1889.

He is also famous for printing a satirical cartoon that portrayed the Meiji Emperor as a skeleton (as a pun on the name of the publisher), for which he was imprisoned for a year."
birth_year = 1853
death_year = 1908
link = "https://en.wikipedia.org/wiki/Adachi_Gink%C5%8D"
schools = Array[ExtResource("2_7xoh8")]([ExtResource("2_f75y6")])

[sub_resource type="Resource" id="Resource_tty1q"]
script = ExtResource("5_5n47g")
markedup_text = "Throw pebbles at the singing workers."
requirement = SubResource("Resource_p6a6q")
outcome = SubResource("Resource_772cm")
markedup_result_text = "The carriers, fed up with the relentless singing, begin throwing pebbles in the direction of the quarrymen.

The songs stop at once and the workers hurl insults back.

Soon the whole worksite is arguing, and very little work ends up finished by the end of the day."

[sub_resource type="Resource" id="Resource_oxefd"]
script = ExtResource("11_nuhf8")
card_type = ExtResource("10_vshoq")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_7l5cn"]
script = ExtResource("13_qmjp2")
aspect_type = ExtResource("12_jg1d8")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2iidw"]
script = ExtResource("5_5n47g")
markedup_text = "Let a passing monk mediate."
requirement = SubResource("Resource_7l5cn")
outcome = SubResource("Resource_oxefd")
markedup_result_text = "One of the granite haulers spots a monk walking by the cliff, a basket of petals in his hand. The worker bows, and asks the monk to settle the dispute. 

The monk considers, contemplating the blossoming tree standing nearby. He instructs the singers to work in silence while the tree is in bloom. Until the last petal falls from the tree, the workers must listen to the sound of birds, wind, and their picks hitting the stone."


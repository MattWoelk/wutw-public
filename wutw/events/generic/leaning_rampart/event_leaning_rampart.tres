[sub_resource type="Resource" id="Resource_jiini"]
script = ExtResource("5_dxnvu")
markedup_text = "Do nothing."
outcome = SubResource("Resource_fmixu")
markedup_result_text = "The wall groans, shivers, then settles.

For a while, it still stands. But weeks later, during a windstorm, it collapses with a crack like thunder.

No one is hurt, but some of the shelters lose their windbreak."

[sub_resource type="Resource" id="Resource_mm8jc"]
script = ExtResource("3_oln24")
markedup_text = "One of the old ramparts was too ramshackle to restore when the outpost was resettled, but now it has started to crumble piece by piece.

The stones shift underfoot, and each gust of wind brings a faint groan from the structure. If left alone, it will fall.

Shall we let it fall on our terms, or its own?"

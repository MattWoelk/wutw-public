[resource]
script = ExtResource("1_06k3v")
name = "Katsukawa School"
blurb = "The Katsukawa school was a major lineage of ukiyo-e artists that revolutionized the depiction of kabuki actors in the late 18th century.

Founded by Katsukawa Shunshō, the school introduced a new level of realism to actor prints. Rather than relying on generic, idealized faces to represent specific roles, Katsukawa artists captured the distinct facial characteristics, personalities, and dramatic expressions of individual performers.

The Katsukawa workshop also served as the early training ground for several prominent printmakers, including a young [url=artist:Katsushika Hokusai]Katsushika Hokusai[/url], before its influence was eclipsed by the rising [url=art_school:Utagawa school]Utagawa school[/url]."
start_year = 1750
end_year = 1840
link = "https://en.wikipedia.org/wiki/Katsukawa_school"
metadata/_custom_type_script = "uid://dht2n55p5x21w"

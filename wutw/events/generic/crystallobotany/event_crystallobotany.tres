[sub_resource type="Resource" id="Resource_70qbh"]
script = ExtResource("5_tc14c")
markedup_text = "Use the Dead Branch."
requirement = SubResource("Resource_d174p")
show_condition = SubResource("Resource_wbl45")
outcome = SubResource("Resource_trtbi")
markedup_result_text = "The branch doesn't seem to react at first, but a minute later crystals start growing around its tip.

\"Smart,\" the alchemist nods, \"it must be safer with a dead one.\""
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_ymvbb"]
script = ExtResource("5_tc14c")
markedup_text = "Do not engage with the madman."

[sub_resource type="Resource" id="Resource_sdqv8"]
script = ExtResource("3_ukb65")
markedup_text = "The swamp path turns rigid underfoot. A crystal-crusted lily pad shimmers on stagnant water. A crystal squirrel perches motionless on a branch. A settler cries out after stepping on a bed of crystallized mushrooms.

In front of a ramshackle hut, the alchemist is elbow-deep in a great steaming cauldron.

\"It began with moss. Then algae. Now root, stem, flower, and beast!\" He breaks off a branch and gestures excitedly. \"Try it! The bigger the ingredient, the bigger the reaction!\""
background_image = SubResource("Resource_3lj2l")
background_credit = ExtResource("5_3lj2l")
choices = Array[ExtResource("5_tc14c")]([SubResource("Resource_r0oeh"), SubResource("Resource_jiini"), SubResource("Resource_mm8jc"), SubResource("Resource_70qbh")])
exit_choice = SubResource("Resource_ymvbb")


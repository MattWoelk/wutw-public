[resource]
script = ExtResource("3_ey3ig")
original_image = SubResource("Resource_bcsnl")
piece_name = "Monkey: Yojirō"
series = ExtResource("4_ey3ig")
artist = ExtResource("1_ulrhn")
styles = Array[ExtResource("4_egy1x")]([ExtResource("5_68kce"), ExtResource("7_egy1x")])

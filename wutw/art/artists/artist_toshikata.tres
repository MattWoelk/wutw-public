[resource]
script = ExtResource("2_0dca6")
name = "Mizuno Toshikata"
blurb = "Mizuno Toshikata was an ukiyo-e artist and painter active during the Meiji period. He apprenticed from age 13 under [url=artist:Tsukioka Yoshitoshi]Tsukioka Yoshitoshi[/url], and also studied traditional and ceramic painting.

His works include [url=art_style:rekishi-ga]rekishi-ga[/url], [url=art_style:bijin-ga]bijin-ga[/url], newspaper illustrations, and sensō-e (war pictures) depicting the First Sino-Japanese War.

Toshikata worked during the decline of traditional ukiyo-e, and passed away at age 43, before the [url=art_style:shin-hanga]shin-hanga[/url] revival. Nonetheless, it is easy to see a connection between the two in his style."
birth_year = 1866
death_year = 1908
link = "https://artsofjapan.com/en/profiles/mizuno-toshikata"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

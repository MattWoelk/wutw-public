script = ExtResource("1_pyoi1")
dialogue_id = "mq_2_10_lanterns"
record_title = "Era 二: Places of Power: Ghost Lanterns"
text = "PAGE: scribe(NONE)
scribe: The dead still whisper through these lanterns.
scribe: This glowing path... It is a gateway of Change. A portal to powers from beyond our lifetimes.
scribe: If we are to bring our world back from the dead, we will need this. We must have the power to Change death to life."

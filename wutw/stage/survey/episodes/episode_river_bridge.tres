[sub_resource type="Resource" id="Resource_51xf1"]
script = ExtResource("2_eh2mk")
label = "Cross it."
aspects = Array[ExtResource("3_b4ftu")]([ExtResource("10_6dres")])
aspects_per_season = Array[ExtResource("3_b4ftu")]([null])
outcome = SubResource("Resource_y4unl")
outcome_text = "The surveyors attempt to cross the bridge, testing each board carefully before stepping down.

On the other side, they find crumbling walls which must have once surrounded a grove. The space is now choked with weeds, but the old trees still grow in unnaturally straight rows.

It is clear that this place was once special."


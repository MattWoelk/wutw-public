[sub_resource type="Resource" id="Resource_76ena"]
script = ExtResource("4_t2pnp")
event_step_id = "blood"
markedup_text = "The disciples kneel between the lanterns, marking the dock with splatters of crimson. The sea ripples as they chant, echoing the rhythm of their incantations.

Before long, the incantations evolve, words in languages unknown spilling from the tongues of the bloodied men and women. Cries follow, and laughter, and new glyphs traced in the air with hand and foot.

Eventually exhaustion overtakes the group and they retreat, leaving unmistakable stains behind.

\"The sea spoke through us,\" they declare in the morning. \"It is prepared to glorify the Enlightened One.\""
background_image = SubResource("Resource_tyksf")
background_credit = ExtResource("6_tyksf")
exit_choice = SubResource("Resource_m8kax")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


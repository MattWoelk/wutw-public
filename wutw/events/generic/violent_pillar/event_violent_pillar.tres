[sub_resource type="Resource" id="Resource_r0oeh"]
script = ExtResource("5_bjt5s")
markedup_text = "Repaint the scene with a peaceful one, in the same style."
requirement = SubResource("Resource_kjam1")
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "The original image is painted over, preserving the brushwork and palette.

It now shows a harvest procession and a bonfire feast. The pillar keeps its style, but not its story.

The protesting settlers nod, satisfied.

The scholars shake their heads.

Most agree it's easier to visit now."

[sub_resource type="Resource" id="Resource_3sdrw"]

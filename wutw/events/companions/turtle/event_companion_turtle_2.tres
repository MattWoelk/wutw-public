[sub_resource type="Resource" id="Resource_aldqr"]
script = ExtResource("6_mwanf")
markedup_text = "Go to sleep."
outcome = SubResource("Resource_dybbs")
markedup_result_text = "Inspired by the turtle's unrushed effort, the student decides to pace himself.

He rolls up his scroll and lies down, falling asleep within minutes.

He will retain more knowledge after a good rest."

[sub_resource type="Resource" id="Resource_xp747"]
script = ExtResource("4_tsvnb")
markedup_text = "A diligent student has been sitting outside the archives all night, frantically studying for his apprenticeship exam.

He is exhausted, his eyes are blurry, and the words stopped making sense hours ago.

A small turtle slowly climbs the slope beside him, moving at a remarkably consistent, unhurried pace."

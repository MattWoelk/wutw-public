[sub_resource type="Resource" id="Resource_8bsgh"]
script = ExtResource("6_ncm4o")
markedup_text = "Leave it tangled as a lesson."
outcome = SubResource("Resource_e6cps")
markedup_result_text = "The brewers decide that a night in the vines is exactly the sort of punishment a thief deserves.

When morning comes, the creature is still there, having simply given up and fallen fast asleep."

[sub_resource type="Resource" id="Resource_mjju6"]
script = ExtResource("4_bho5i")
markedup_text = "The brewers at the lodge have recently found some of their aging vats broken, the precious liquid spilled all around them.

One night they hide, hoping to catch the thief. By midnight they hear a rustling from behind the lodge, and rush to find the culprit.

They are greeted by a tanuki stumbling away into the dark, only to be caught in the vines. The animal turns around, a look of sheepish confusion on its face."
background_image = SubResource("Resource_fwouk")
background_credit = ExtResource("6_fwouk")
choices = Array[ExtResource("6_ncm4o")]([SubResource("Resource_lncp7"), SubResource("Resource_ejiuu"), SubResource("Resource_jo6jf")])
exit_choice = SubResource("Resource_8bsgh")


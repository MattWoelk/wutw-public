[sub_resource type="Resource" id="Resource_jqltq"]
script = ExtResource("2_f3eko")
label = "Watch the tigers' behavior."
aspects = Array[ExtResource("3_s7p5p")]([ExtResource("9_vj8j7")])
aspects_per_season = Array[ExtResource("3_s7p5p")]([null])
outcome = SubResource("Resource_j7d8j")
outcome_text = "The group remains motionless, cautiously observing the beasts.

One scout slowly points behind him. Lying on top of a patch of flattened grass is a fresh animal carcass. 

The group slowly moves out of the tigers' way, and are ignored as a reward."

[sub_resource type="Resource" id="Resource_atoiu"]

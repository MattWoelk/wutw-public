[resource]
script = ExtResource("7_p3cvs")
haunting_id = "jikininki"
name = "Jikininki"
name_japanese = "食人鬼"
name_realistic = "Dangerous Wildlife"
name_translation = "Human-Eating Demons"
description = "A ravenous spirit stalks the night, devouring all who linger too long among the dead."
description_realistic = "Predatory beasts roam the night, drawn by the smell of food. Fear multiplies each time one of the settlers is injured."
description_long = "Travelers whisper of nights when the land stirs with hunger. They say the Jikininki walk these lands, monks who turned their prayers into coin and their faith into appetite. Now they haunt the scattered ruins and toppled gates, their faces pale as bone dust, their mouths full of teeth too sharp for penance.

Those who sleep in the open find their packs torn open in the morning. The less lucky ones are woken up by vicious attacks from the darkness. While some claim the Jikininki only feed on corpses, they seem to see little difference between the sleeping and the dead."
image_small = ExtResource("6_04kni")
image_credit = ExtResource("5_tfm8c")
image_small_realistic = ExtResource("5_m62vu")
image_realistic_credit = ExtResource("7_bl8hb")
base_aspect_types = Array[ExtResource("1_m62vu")]([ExtResource("3_04kni")])

[sub_resource type="Resource" id="Resource_2f7jm"]
script = ExtResource("5_j4ysv")
markedup_text = "Curtly demand payment for the food already consumed."
requirement = SubResource("Resource_b5cog")
outcome = SubResource("Resource_fmixu")
markedup_result_text = "The cook taps the counter and points at the staggering stack of empty boxes.

The monk blinks in surprise, as if the concept of currency had never occurred to him.

He rummages through his deep robes, produces a handful of coins, and leaves with a slightly wounded expression."

[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("11_tp7l6")
card_type = ExtResource("16_4c3xh")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_b2v2u"]
script = ExtResource("5_j4ysv")
markedup_text = "Serve him an empty box."
outcome = SubResource("Resource_kojkx")
markedup_result_text = "The cook places an empty wooden box before the monk with absolute solemnity.

The monk stares at it for a moment, then lets out a booming laugh.

He bows to the cook, and declares his hunger completely cured."

[sub_resource type="Resource" id="Resource_5pap3"]
script = ExtResource("3_0ywqo")
markedup_text = "A monk has been at the noodle stall for hours, eating box after box of noodles.

The cook is starting to look at him askance as a towering stack of empty boxes continues to grow, but is wary of offending a customer.

Before long, the monk requests yet another serving."

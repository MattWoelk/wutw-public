[sub_resource type="Resource" id="Resource_trtbi"]
script = ExtResource("5_1h70n")
markedup_text = "Prioritize unity."
requirement = SubResource("Resource_e7hfo")
show_condition = SubResource("Resource_b7llu")
outcome = SubResource("Resource_kj1sh")
markedup_result_text = "The abbot holds a meeting to address the incident.

He explains that to blame a single individual betrays the very principle of unity that their rings symbolize.

From now on, the monk who made the mistake is to lead a maintenance team, sharing with them the wisdom gained from his own mistake."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_rx1a8"]

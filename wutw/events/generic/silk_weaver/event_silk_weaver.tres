[sub_resource type="Resource" id="Resource_dmlww"]
script = ExtResource("5_dmlww")
markedup_text = "Discourage the weaver, gently but firmly."
outcome = SubResource("Resource_egt2j")
markedup_result_text = "The community asks for uniformity, as customers shun such garish cloth. The weaver unrolls and unravels it by hand.

No one challenges the decision, and before long the town has one less weaver."

[sub_resource type="Resource" id="Resource_xnfiy"]
script = ExtResource("5_dmlww")
markedup_text = "Let them keep weaving."
markedup_result_text = "The colorful cloths dry behind the hut, where the wind still finds them, even if the settlers do not.

They don't ask for any further accommodation.

The loom continues to spin."

[sub_resource type="Resource" id="Resource_jj6yl"]
script = ExtResource("3_jm8w5")
markedup_text = "One of the weavers spins thread that doesn't match. Unlike the traditional reserved palette, they weave a rainbow of threads in wild patterns.

They don't boast or argue, but they don't follow the traditions either. Their cloth shimmers with iridescent silk: garish to some, beautiful to others.

Murmurs spread among the workers. Someone asks if it's time to decide what kind of weaving belongs here."
background_image = SubResource("Resource_ar033")
background_credit = ExtResource("5_ptldf")
choices = Array[ExtResource("5_dmlww")]([SubResource("Resource_ptldf"), SubResource("Resource_nra34"), SubResource("Resource_dmlww")])
exit_choice = SubResource("Resource_xnfiy")


[sub_resource type="Resource" id="Resource_0bb2h"]
script = ExtResource("6_ec7aj")
markedup_text = "Distract the dog with food."
requirement = SubResource("Resource_6x08g")
outcome = SubResource("Resource_1stri")
markedup_result_text = "The chairman pours some beans into the dog's bowl. The dog hesitates, but then lets go of the robe.

A moment later, the ground heaves as a mild earthquake rattles the hall.

Both the man and the dog manage to scramble under a heavy desk, but end up with a few scrapes and bruises."


[resource]
script = ExtResource("3_fegbr")
original_image = SubResource("Resource_bcsnl")
piece_name = "Women Airing Books and Clothes"
artist = ExtResource("1_a144n")
actual_start_year = 1750
actual_end_year = 1800
date_type = 1
custom_link = "https://asia.si.edu/explore-art-culture/collections/search/edanmdm:fsg_F1905.309/"
edits_description = "The image was cropped."
final_image_tex = SubResource("Resource_x4myr")
blurb = "Depicts four women and a young boy drying out books. One of the women is distracted by what she finds in an open book.

This annual practice was called mushiboshi (\"drying bugs\"). During the late summer, people at homes and temples would remove books, scrolls, and clothes from storage and hang them over a line to air out and prevent mildew and insect damage.

The cuckoo at the very top of the image is often associated with poetry expressing love and longing (or alternatively, courtesans)."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

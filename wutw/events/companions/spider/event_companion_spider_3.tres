[sub_resource type="Resource" id="Resource_mnhbo"]
script = ExtResource("6_c3i2k")
markedup_text = "Release the spider far away."
outcome = SubResource("Resource_juwxj")
markedup_result_text = "The apothecary refuses to risk an extraction, dumping the spider back into the swamp.

The town will simply have to endure the bites for the time being."

[sub_resource type="Resource" id="Resource_4414k"]
script = ExtResource("4_elrvq")
markedup_text = "The town has been plagued by painful spider bites. What's worse, they seem to put victims into a depression that lasts for days.

An apothecary has finally identified the exact type of spider responsible for the affliction, and one is now hanging on its web in her hut.

She thinks she could use its venom to brew an antidote, but extracting it from such an aggressive creature is a delicate matter."
background_image = SubResource("Resource_8f1tl")
background_credit = ExtResource("6_8f1tl")
choices = Array[ExtResource("6_c3i2k")]([SubResource("Resource_jetgi"), SubResource("Resource_hrsh3"), SubResource("Resource_l0et7")])
exit_choice = SubResource("Resource_mnhbo")


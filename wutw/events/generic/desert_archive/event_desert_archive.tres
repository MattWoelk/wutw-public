[sub_resource type="Resource" id="Resource_dpp3j"]
script = ExtResource("5_sw23g")
markedup_text = "Leave a mark and seal the place once more."
requirement = SubResource("Resource_rx1a8")
outcome = SubResource("Resource_ptcwf")
markedup_result_text = "The settlers leave a scroll of their own, a contribution to this treasure trove of knowledge.

The chamber is then resealed, the entrance hidden again under the sand.

Someday people wiser than us will make use of this archive."

[sub_resource type="Resource" id="Resource_egt2j"]

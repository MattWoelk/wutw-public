[sub_resource type="Resource" id="Resource_wrxym"]
script = ExtResource("8_4ui0s")
text = "I arrived just before the shard's famous Summer Bonfire festival. I joined the townsfolk who were in charge of setting up one of the fires as they climbed up the mountain. They were clearly experts, cutting up grass, layering sticks in the shape of the spirit glyph, and surrounding it with gravel to prevent a wildfire.

Two days later, back in town, everyone gathered in the evening to watch the burning glyphs. I have to admit it was an impressive sight, the bright yellow flames blazing in such a clear shape against the dark mountainside. Later the same night, the kids burned a large fox effigy in the town square. They assured me that no one bears foxes any grudges, and this is simply a fun ancient tradition they keep to this day."
gained_argument = ExtResource("13_y1x2n")
metadata/_custom_type_script = "uid://ciddaw1laebi3"


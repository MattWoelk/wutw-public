[resource]
script = ExtResource("17_hfy4p")
episode_id = "waterfall_cave"
title = "The Hidden Recess"
biome_types = Array[int]([7])
spot_types = Array[ExtResource("18_vd4pn")]([ExtResource("19_asxyt")])
requirement = SubResource("Resource_trtbi")
text = "The day's trek has exhausted the survey team.

As they stop by a swift waterfall to refill their water, a scout notices a dark recess behind the waterfall.

The curtain of water may be concealing a cave, but reaching it would require crossing the slippery rocks."
background_image = SubResource("Resource_vo6yk")
background_credit = ExtResource("1_xod50")
choices = Array[ExtResource("2_xod50")]([SubResource("Resource_sjvdb"), SubResource("Resource_222v2"), SubResource("Resource_fdj48"), SubResource("Resource_85w7m")])

[sub_resource type="Resource" id="Resource_hewjp"]
script = ExtResource("6_ec7aj")
markedup_text = "Lock the dog in another room until it calms down."
outcome = SubResource("Resource_2me52")
markedup_result_text = "Deciding that the dog may be rabid, the chairman locks the animal in a sturdy storeroom.

A moment later, the ground shakes.

The chairman barely stumbles out of the hall before the ceiling caves in.

The dog is less fortunate."


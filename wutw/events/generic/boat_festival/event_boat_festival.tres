[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("5_dhimx")
markedup_text = "Host a guiding boat festival."
requirement = SubResource("Resource_ptcwf")
outcome = SubResource("Resource_xxhwh")
markedup_result_text = "The settlers sing as they sew.

The sails are painted with a guiding glyph to carry forward.

As the sun sets, boats are pushed out into the lake, floating away.

\"We'll remember that one,\" an old shipwright remarks."


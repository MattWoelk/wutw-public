[sub_resource type="Resource" id="Resource_fea22"]
script = ExtResource("5_jbj2b")
markedup_text = "Sew pillows for the community."
requirement = SubResource("Resource_11e5e")
outcome = SubResource("Resource_6at2x")
markedup_result_text = "The seamstress works late, stitching rough cloth into sacks.

The hulls are stuffed inside, creating firm, cool cushions that cradle the head.

That night, for the first time, the farmers get a good night's sleep. The soil may be hungry, but the people are rested."

[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("15_ry88k")
card_type = ExtResource("14_bvrj8")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_guqoh"]
script = ExtResource("13_mciqf")
aspect_type = ExtResource("16_3h4si")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_h2fiq"]
script = ExtResource("5_jbj2b")
markedup_text = "Plow the hulls back into the earth"
requirement = SubResource("Resource_guqoh")
outcome = SubResource("Resource_f2op8")
markedup_result_text = "The farmers resist the temptation, and get to work again.

The mountain of hulls is leveled and turned into the soil. Some look on wistfully as the potential comfort is buried in the mud.

\"We eat first,\" a farmer says, rubbing a sore shoulder. \"We sleep later.\""


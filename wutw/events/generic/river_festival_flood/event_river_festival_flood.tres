[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("5_it5ex")
markedup_text = "Cancel the festival to focus on recovery."
requirement = SubResource("Resource_3sdrw")
outcome = SubResource("Resource_8mfyw")
markedup_result_text = "No lanterns are lit. No river songs are sung.

Instead, walls are mended, floors swept, and water lines rerouted.

Even the rice paper from the lanterns is recycled for screens, leaving behind empty frames resting by the riverside."


[sub_resource type="Resource" id="Resource_x2cvc"]
script = ExtResource("9_elucr")
aspect_type = ExtResource("12_tngee")
min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_bm2ma"]
script = ExtResource("5_pida8")
markedup_text = "Lighten her workload."
requirement = SubResource("Resource_x2cvc")
outcome = SubResource("Resource_4l2h7")
markedup_result_text = "The pale weaver's friends pretend not to notice when she coughs or pauses to catch her breath.

They give her the lightest bundles, and pass her the softest reeds to weave. A small mercy."

[sub_resource type="Resource" id="Resource_qck1n"]
script = ExtResource("11_j5keh")
bonus_type = ExtResource("13_ysauv")
amount = 5
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_npn1d"]
script = ExtResource("9_elucr")
aspect_type = ExtResource("14_eotty")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_ywboy"]
script = ExtResource("5_pida8")
markedup_text = "Isolate her."
requirement = SubResource("Resource_npn1d")
outcome = SubResource("Resource_qck1n")
markedup_result_text = "The women love their friend, but they fear contagion.

They inform the settlement's healer, who gently instructs the ailing woman to stay away from public places until she gets better.

The funeral is held the following month."

[sub_resource type="Resource" id="Resource_33knq"]
script = ExtResource("5_pida8")
markedup_text = "Let her keep her peace."
markedup_result_text = "The friends are careful not to speak of sadness or endings. The women let her laugh, weave, and pretend as long as she can."

[sub_resource type="Resource" id="Resource_anbcg"]
script = ExtResource("3_fgmqv")
markedup_text = "Women are weaving tatami mats as the cool evening breeze rustles the trees, scattering a flock of birds into the sunset. Each woman warms her fingers inside her sleeve before taking up a new bundle of reeds.

They laugh softly as they discuss the latest happenings, exchanging comments and little jokes. Despite their light manner, all but one of them are hiding grief.

One smiles faintly, however, her skin pale yet her nose and cheeks bright red. She coughs into her sleeve before joining in the laughter."
background_image = SubResource("Resource_hlbni")
background_credit = ExtResource("4_8cubl")
choices = Array[ExtResource("5_pida8")]([SubResource("Resource_d3da3"), SubResource("Resource_bm2ma"), SubResource("Resource_ywboy")])
exit_choice = SubResource("Resource_33knq")


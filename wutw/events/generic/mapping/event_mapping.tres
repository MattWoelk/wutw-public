[sub_resource type="Resource" id="Resource_kojkx"]
script = ExtResource("5_7wh20")
markedup_text = "Emphasize sites of danger, mystery, and excitement."
requirement = SubResource("Resource_fmixu")
outcome = SubResource("Resource_06ahh")
markedup_result_text = "The map is filled with swirling marks and jagged notations: cave entrances, spots where past explorers disappeared, and alleged habitats of mythical beasts.

Still, this mess of guesswork and outright fiction can't help but instill a thrill for exploration."

[sub_resource type="Resource" id="Resource_ciwob"]

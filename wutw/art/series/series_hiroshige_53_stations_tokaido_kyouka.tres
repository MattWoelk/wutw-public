[resource]
script = ExtResource("2_hhst3")
name = "53 Stations of the Tōkaidō - Kyōka Edition"
blurb = "This extremely popular series depicts the towns and rest stops along the Tōkaidō (\"eastern sea route\") connecting Kyōto to Tōkyō (then called Edo), the most important of the Five Routes of the Edo period.

Hiroshige published multiple editions of the series with the same title, each containing different prints, including:[ul]
[url=art_series:53 Stations of the Tōkaidō - Hōeidō Edition]Hōeidō Edition, 1833 - 1834[/url]
[url=art_series:53 Stations of the Tōkaidō - Kyōka Edition]Kyōka Edition, 1840 - 1842[/url]
[url=art_series:53 Stations of the Tōkaidō - Gyōsho Edition]Gyōsho Edition, 1841 - 1844[/url]
[url=art_series:53 Stations of the Tōkaidō - Reisho Edition]Reisho Edition, 1847 - 1852[/url]
[url=art_series:53 Stations of the Tōkaidō - Kichizō Edition]Kichizō Edition, 1850 - 1851[/url]
[url=art_series:53 Stations of the Tōkaidō - Jinbutsu Edition]Jinbutsu Edition, 1851 - 1853[/url]
[/ul]"
start_year = 1840
end_year = 1842
artist = ExtResource("1_phwol")
link = "https://www.hiroshige.org.uk/Tokaido_Series/Tokaido_Kyoka.htm"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

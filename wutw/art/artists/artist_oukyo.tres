[resource]
script = ExtResource("2_6gccd")
name = "Maruyama Ōkyo"
blurb = "Maruyama Ōkyo was an artist active in the late 18th century. He studied artworks from Chinese, Japanese and Western sources while living in Kyōto.

He apprenticed under masters from the [url=art_school:Kanō school]Kanō school[/url], but later founded the Maruyama school which subsequently evolved into the [url=art_school:Shijō school]Shijō school[/url].

He is known for mixing Western naturalism with Eastern decorative design. He followed the Eastern tradition in depicting objects with very little setting, often featuring a single subject on a plain background. His style, despite its popularity, was criticized by contemporary artists for being too realistic."
birth_year = 1733
death_year = 1795
link = "https://en.wikipedia.org/wiki/Maruyama_%C5%8Ckyo"
schools = Array[ExtResource("1_msqyg")]([ExtResource("2_8qjmr"), ExtResource("3_imn1s")])

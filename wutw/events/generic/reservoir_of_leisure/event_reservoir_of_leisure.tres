[sub_resource type="Resource" id="Resource_oc1ps"]
script = ExtResource("5_jputc")
markedup_text = "Rearrange the stalls to ensure access."
requirement = SubResource("Resource_jputc")
outcome = SubResource("Resource_rdn40")
markedup_result_text = "The stalls are allowed to remain, but the wardens insist that they be moved to leave clear access paths.

Fire lanes are set up with bamboo fences, which soon become adorned with festive lanterns.

The crowd flows smoothly, the wardens have their clear paths, and the stall owners find they can serve customers even faster."


[sub_resource type="Resource" id="Resource_ybpct"]
script = ExtResource("10_7kapl")
markedup_text = "Put down a blanket on the windowsill."
outcome = SubResource("Resource_ahho5")
markedup_result_text = "The farmers wait for the cat to depart that night, and the next day put down a warm blanket on the windowsill.

When the cat shows up, he seems taken aback for a moment, but soon settles in as usual.

Later that night, a farmer finds the cat fast asleep on the blanket."

[sub_resource type="Resource" id="Resource_5wq3a"]
script = ExtResource("10_7kapl")
markedup_text = "Keep the shutters closed in the future."
outcome = SubResource("Resource_y1mii")
markedup_result_text = "The farmers shoo the cat away and keep the second floor shutters closed from now on.

The cat shows up a few more times, but finding no way in, eventually moves on."

[sub_resource type="Resource" id="Resource_wt43v"]
script = ExtResource("10_7kapl")
markedup_text = "Leave the cat alone."
outcome = SubResource("Resource_y1mii")
markedup_result_text = "The farmers decide that the cat isn't ready for an introduction yet.

They keep ignoring him, and one day he stops showing up."

[sub_resource type="Resource" id="Resource_uedco"]
script = ExtResource("7_65f64")
markedup_text = "A grumpy-looking stray tomcat has been regularly showing up at the farmhouse.

Every day at dusk he climbs up to the second floor, slips in through the open window, and makes himself comfortable on the windowsill. He spends the evening relaxed, looking over the fields with his eyes half-closed.

The farmers haven't tried approaching the cat yet, wary of his grumpy looks, and he hasn't tried approaching anyone either."
background_image = SubResource("Resource_vibau")
background_credit = ExtResource("6_y1mii")
choices = Array[ExtResource("10_7kapl")]([SubResource("Resource_02t1p"), SubResource("Resource_ybpct"), SubResource("Resource_5wq3a")])
exit_choice = SubResource("Resource_wt43v")


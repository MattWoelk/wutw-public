[sub_resource type="Resource" id="Resource_rx1a8"]
script = ExtResource("6_4w352")
markedup_text = "Banish the spirits with a drop of blood."
requirement = SubResource("Resource_tuogj")
outcome = SubResource("Resource_df5af")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "The Scribe and his disciples surround the tree.

A shallow cut, a whispered incantation, and the foxes scatter like embers in the wind.

\"With our lifeblood, we have cleansed these woods,\" the Scribe declares. \"No spirit will dare set foot here again.\""


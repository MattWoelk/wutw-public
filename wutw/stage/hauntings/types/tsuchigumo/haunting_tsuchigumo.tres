[resource]
script = ExtResource("8_t0stu")
haunting_id = "tsuchigumo"
name = "Tsuchigumo"
name_japanese = "土蜘蛛"
name_realistic = "Dissent"
name_translation = "Earth Spiders"
description = "Multiple leaders in this settlement have gone missing and or have been found poisoned. The prime suspect is the Tsuchigumo, giant spiders that ambush powerful people with poison and trap them in their nets."
description_realistic = "The people are in open dissent against the leaders of this settlement, constantly sabotaging their efforts."
description_long = "When people rise to power, they become the target of Tsuchigumo, giant spiders that sleep in tunnels beneath the ground. They come out at night, using illusion to hide their bulk, to challenge people who have obtained too much influence. They ambush their victims with poison that no medicine can heal, and drag them into their underground burrows, to be kept captive in silk cocoons."
image_small = ExtResource("6_e0mcg")
image_credit = ExtResource("5_xkxot")
image_small_realistic = ExtResource("7_yamqw")
image_realistic_credit = ExtResource("6_xkxot")

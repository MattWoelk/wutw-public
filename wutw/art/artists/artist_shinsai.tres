script = ExtResource("4_2kum1")
name = "Ryūryūkyo Shinsai"
blurb = "Ryūryūkyo Shinsai was a printmaker and an alleged pupil of [url=artist:Katsushika Hokusai]Katsushika Hokusai[/url].

While Shinsai illustrated books and designed single-sheet prints throughout his career, he is best known for his [url=art_style:surimono]surimono[/url]."
birth_year = 1764
death_year = 1820

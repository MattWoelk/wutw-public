[sub_resource type="Resource" id="Resource_7jpru"]
script = ExtResource("6_f2nvm")
markedup_text = "Name it after the sea bream."
outcome = SubResource("Resource_211fg")
markedup_result_text = "The ship is named the Tai, after the plump red fish which has become a symbol of abundance.

The name fits the wide, sturdy vessel perfectly as it sits low in the water, heavy with cargo.

The sea bream is well on its way to being adopted as the patron spirit of good fortune."

[sub_resource type="Resource" id="Resource_bjbvw"]

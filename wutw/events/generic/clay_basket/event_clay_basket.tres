[sub_resource type="Resource" id="Resource_57nyf"]
script = ExtResource("5_u85t3")
markedup_text = "Offer to teach the kid."
requirement = SubResource("Resource_cqpl6")
outcome = SubResource("Resource_6at2x")
markedup_result_text = "\"You've got a spark,\" the potter says. \"If you're willing to learn, I'll teach you to throw a bowl that sings.\"

The teen blinks, then grins wider than the kiln mouth."


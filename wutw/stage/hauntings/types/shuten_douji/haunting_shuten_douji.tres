[resource]
script = ExtResource("8_r5ghp")
haunting_id = "shuten_douji"
name = "Shuten Dōji"
name_japanese = "酒吞童子"
name_realistic = "Alcoholism"
name_translation = "Little Lord Drunkard"
description = "Settlers have started honoring Shuten Dōji, the Drunken King, whose revels never end, and neither does the hangover."
description_realistic = "Alcohol abuse has spread among the settlers, sapping morale and productivity."
description_long = "In the nights when work is done, settlers speak of deep laughter rolling down from the tents. They say it is Shuten Dōji, once a man too proud for company, now the demon king of endless drink. He tempts the weary to raise their cups and forget their tasks, promising courage that burns away before morning.

It is said that his head was once severed but never silenced, its grin still whispering of comfort in every bottle. Where his name is remembered, work slows, words slur, and spirits of both kinds run dry."
image_small = ExtResource("6_r23ji")
image_credit = ExtResource("6_jsfcr")
image_small_realistic = ExtResource("8_e4532")
image_realistic_credit = ExtResource("7_ot3s2")

[sub_resource type="Resource" id="Resource_my31n"]
script = ExtResource("5_scwy6")
markedup_text = "Set up camp."
requirement = SubResource("Resource_c1qtp")
outcome = SubResource("Resource_m6plk")
markedup_result_text = "Thirst and exhaustion wins out, and the group settles in for the evening, making camp beside the stream.

As the sun sets, they gather twigs and dry weeds to start a fire, which burns with a thick, fragrant smoke.

Within minutes, warmth begins to spread throughout their bodies. As they lie down, the stars above twinkle brightly at them, as if wishing them goodnight."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_ur7ta"]
script = ExtResource("5_scwy6")
markedup_text = "Try to backtrack."

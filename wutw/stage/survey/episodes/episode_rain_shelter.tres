[resource]
script = ExtResource("8_5kkdk")
episode_id = "rain_shelter"
title = "Caught in the Rain"
biome_types = Array[int]([7, 9])
spot_types = Array[ExtResource("10_kxd5k")]([ExtResource("9_4dd1j")])
text = "A sudden downpour catches the survey team on an exposed ridge.

Just ahead is a small pine grove, full of natural hollows.

They seem perfect for sheltering a small group, but the ground is strewn with animal bones and bits of hide."
background_image = SubResource("Resource_2kcba")
background_credit = ExtResource("1_pijum")
choices = Array[ExtResource("1_fmvhx")]([SubResource("Resource_a3prj"), SubResource("Resource_g8duj"), SubResource("Resource_g1ano")])

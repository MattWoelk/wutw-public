[resource]
script = ExtResource("8_4qkmt")
haunting_id = "uwabami"
name = "Uwabami"
name_japanese = "蟒蛇"
name_realistic = "Quicksand"
name_translation = "Giant Snakes"
description = "The desert is said to hide Uwabami, great serpents that swallow travelers whole without leaving a trace."
description_realistic = "Treacherous quicksand pockets have formed beneath the dunes. Travelers who cross carelessly are lost to the shifting earth."
description_long = "The desert sands are home to the Uwabami, vast serpents swimming beneath the dunes, their scales shimmering like heat on the horizon. They coil themselves around anything they encounter, pulling it deep into the sands.

Some say they were driven mad by betrayal, when a mountain god tricked such a serpent into tying itself into a knot."

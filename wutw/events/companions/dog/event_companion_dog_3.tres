[sub_resource type="Resource" id="Resource_h0id1"]
script = ExtResource("6_ec7aj")
markedup_text = "Shout loudly to scare the dog away."
outcome = SubResource("Resource_f2bue")
markedup_result_text = "The chairman loses his patience, waving his arms and shouting for the dog to get out.

Startled, the animal lets go of the robe and bolts out the door.

A moment later, the ground shakes and the roof starts to buckle.

The chairman scrambles outside, but not before a falling timber catches him on the shoulder."

[sub_resource type="Resource" id="Resource_uputh"]
script = ExtResource("4_gbkxx")
markedup_text = "The town council chairman is organizing the records when his dog companion, usually a calm and friendly creature, suddenly becomes agitated.

It barks loudly and keeps tugging at his robe, trying to drag him outside.

Nothing the man does seems to calm the dog, and it is becoming more and more aggressive."
background_image = SubResource("Resource_xef7c")
background_credit = ExtResource("6_xef7c")
choices = Array[ExtResource("6_ec7aj")]([SubResource("Resource_0bb2h"), SubResource("Resource_hewjp"), SubResource("Resource_bcijt")])
exit_choice = SubResource("Resource_h0id1")


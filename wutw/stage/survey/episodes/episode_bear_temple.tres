metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_5fpco"]
script = ExtResource("2_362po")
label = "Post guards and camp outside."
aspects = Array[ExtResource("3_kjoqt")]([null])
aspects_per_season = Array[ExtResource("3_kjoqt")]([null])
outcome = SubResource("Resource_a6ufw")
outcome_text = "The team decides to be extra careful and camp outside the temple.

Two of the scouts stand guard all night, and spot no danger.

In the morning, they can't stop complaining about forgoing sleep for no good reason."

[resource]
script = ExtResource("14_rh1s0")
episode_id = "bear_temple"
title = "The Abandoned Temple"
biome_types = Array[int]([9])
spot_types = Array[ExtResource("15_fd2fi")]([ExtResource("16_ng6ip")])
text = "After a tiring all-day hike, the survey team stumbles upon an old, pre-Shattering temple, abandoned but in surprisingly good repair.

The scouts are happy to find shelter for the night, especially knowing that boars and bears frequent the area.

Some among the group feel hesitant, though, claiming that they hear strange creaking noises and feel an eerie presence in the air inside."
background_image = SubResource("Resource_30h7h")
background_credit = ExtResource("1_362po")
choices = Array[ExtResource("2_362po")]([SubResource("Resource_uffrp"), SubResource("Resource_vew3g"), SubResource("Resource_t8iha"), SubResource("Resource_5fpco")])

[sub_resource type="Resource" id="Resource_dkqcl"]
script = ExtResource("2_bbjpt")
label = "Dig the box out."
requirement = SubResource("Resource_4mfl3")
aspects = Array[ExtResource("3_wwac5")]([ExtResource("4_gm4fm")])
aspects_per_season = Array[ExtResource("3_wwac5")]([null])
outcome = SubResource("Resource_trtbi")
outcome_text = "The scouts tear up the earth, slashing at the roots with their knives.

They eventually manage to dig the box out from among the tangled mass.

When the lid is pried open, the scouts find jars of a sweet-smelling liquid, which shimmers golden-amber in the setting sun once poured out."


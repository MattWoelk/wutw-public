[sub_resource type="Resource" id="Resource_co8my"]
script = ExtResource("5_g852m")
markedup_text = "Set the poems to music."
requirement = SubResource("Resource_iherd")
outcome = SubResource("Resource_kjam1")
markedup_result_text = "Musicians from the expedition join the aspiring poets, carrying string, reed, and drum.

The verses are transformed, lifted, and carried further than words alone could reach.

The evening is long and filled with merriment."

[sub_resource type="Resource" id="Resource_0b4bk"]
script = ExtResource("5_g852m")
markedup_text = "Let the square remain quiet."

[sub_resource type="Resource" id="Resource_aidwo"]
script = ExtResource("3_5e3q1")
markedup_text = "In the corner of the square several aspiring poets are gathered around a vase of flowers.

They sit quietly, occasionally remarking on the sound of the drooping blossoms or the taste of the wind.

Each is waiting for someone more daring to let the first verse drop."
background_image = SubResource("Resource_kf6pg")
background_credit = ExtResource("10_kf6pg")
choices = Array[ExtResource("5_g852m")]([SubResource("Resource_iriya"), SubResource("Resource_hj3b6"), SubResource("Resource_co8my")])

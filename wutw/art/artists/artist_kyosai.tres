[resource]
script = ExtResource("3_pvavq")
name = "Kawanabe Kyōsai"
portrait = SubResource("Resource_a4dg7")
blurb = "Kawanabe Kyōsai was a highly individualistic artist who bridged the gap between traditional Japanese painting and modern caricature during the tumultuous transition from the Edo to the Meiji period.

After training in both the [url=art_school:Kanō School]Kanō school[/url] and the [url=art_school:Utagawa School]Utagawa school[/url], he developed a fiercely independent and often satirical style.

He is best known for his vivid, energetic, and sometimes grotesque depictions of folklore, particularly his chaotic scenes of ghosts, demons, and animals acting like humans.

He earned a reputation as a master of kyōga, or crazy pictures, with his humorous and exaggerated figures serving as a direct precursor to modern manga."
birth_year = 1831
death_year = 1889
link = "https://en.wikipedia.org/wiki/Kawanabe_Ky%C5%8Dsai"
schools = Array[ExtResource("2_2s2qs")]([ExtResource("3_nf4ex"), ExtResource("4_v1u5g")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[sub_resource type="Resource" id="Resource_6in3u"]
script = ExtResource("2_3s006")
label = "Dismantle the cart first."
aspects = Array[ExtResource("3_pkasv")]([ExtResource("7_f3acn")])
aspects_per_season = Array[ExtResource("3_pkasv")]([null])
outcome = SubResource("Resource_mvbfe")
outcome_text = "One of the scouts suggests taking the cart apart and carrying it piece by piece. The plan works perfectly until someone manages to drop one of the wheels, which is quickly carried off by the current. The settler is left heartbroken, waiting for the rest of the expedition to catch up."


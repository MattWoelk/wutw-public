[sub_resource type="Resource" id="Resource_npbag"]
script = ExtResource("5_qv0b1")
markedup_text = "Process it into medicine for the town."
requirement = SubResource("Resource_ginix")
outcome = SubResource("Resource_qrspt")
markedup_result_text = "The herbalist assembles a crew and brings ladders to harvest the leaves. They are dried, ground, and mixed with honey to temper the bitterness.

The taste is still challenging, but the sheer volume means that every cough, ache, and fever in the settlement will be treated for the next year."


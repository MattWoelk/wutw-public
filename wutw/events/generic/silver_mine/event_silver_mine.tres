[sub_resource type="Resource" id="Resource_4307i"]
script = ExtResource("6_13ipv")
markedup_text = "Leave this shaft and reinforce the rest."
requirement = SubResource("Resource_xcjhn")
outcome = SubResource("Resource_r0oeh")
markedup_result_text = "The miners abandon the collapsed shaft and spend days carefully inspecting the remaining shafts, reinforcing any beams that are in need of repair.

Much time and material is spent on the effort, but they are confident that it will prevent another collapse for a long time."


label = "Ward insects off with torches."
aspects = Array[ExtResource("3_qbtgn")]([null])
aspects_per_season = Array[ExtResource("3_qbtgn")]([null])
outcome = SubResource("Resource_4st7x")
outcome_text = "The scouts light torches, hoping to fend off the swarm.

To their surprise, this only seems to attract the insects, and by the time the work is finished everyone is covered in dozens of bug bites."

[resource]
script = ExtResource("16_m1p2j")
episode_id = "swamp_bridge"
title = "The Biting Swarm"
biome_types = Array[int]([4])
text = "The survey team has reached a particularly treacherous swamp.

In order to prepare for the rest of the expedition, they have spent several days constructing a narrow bridge raised on bamboo stilts above the muck.

As they are nearing the end of their construction, a thick swarm of biting insects descends on the area, making the work unbearable."
background_image = SubResource("Resource_1683s")
background_credit = ExtResource("1_jnkcl")
choices = Array[ExtResource("2_jnkcl")]([SubResource("Resource_jfwyh"), SubResource("Resource_ytr5i"), SubResource("Resource_m28nf"), SubResource("Resource_4xq5o")])

[sub_resource type="Resource" id="Resource_r4lul"]
script = ExtResource("10_r3tsp")
markedup_text = "Let it be."
outcome = SubResource("Resource_owrgg")
markedup_result_text = "The farmers decide to leave the trespasser to its midnight digestion.

The creature remains perfectly still, its paws resting on its round belly.

As the moonlight hits its face, one farmer swears the plump little thief is smiling."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_1ea03"]
script = ExtResource("7_4qoui")
markedup_text = "One night, farmers stumble upon a chubby tanuki sitting in the middle of their field.

The animal seems content, patting its belly and wistfully looking up at the moon. It is surrounded by a circle of trampled buckwheat, clearly picked clean of grain.

On the one hand, the farmers want to banish the pest. On the other hand, many of them can empathize with the contented lethargy the animal must be experiencing."
background_image = SubResource("Resource_heifq")
background_credit = ExtResource("9_heifq")
choices = Array[ExtResource("10_r3tsp")]([SubResource("Resource_2sb8d"), SubResource("Resource_hqsr2"), SubResource("Resource_m5fys")])
exit_choice = SubResource("Resource_r4lul")


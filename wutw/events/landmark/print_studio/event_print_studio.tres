[sub_resource type="Resource" id="Resource_lw3he"]
script = ExtResource("10_4cd6q")
markedup_text = "Reproduce past records."
requirement = SubResource("Resource_ww0g6")
outcome = SubResource("Resource_ptcwf")
markedup_result_text = "Old scrolls are unrolled, their ink faded and their meaning almost forgotten.

The carvers trace every mark with reverence, careful to make perfect copies.

When the blocks are inked and pressed, memory survives another generation."

[sub_resource type="Resource" id="Resource_4xuhh"]
script = ExtResource("20_s2roi")
bonus_type = ExtResource("17_qpmr3")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_u6a4q"]
script = ExtResource("10_4cd6q")
markedup_text = "Focus on recording local customs and events."
outcome = SubResource("Resource_4xuhh")
markedup_result_text = "Artists visit farmers, masons, and monks in their research, capturing ceremonies, labor methods, and local architecture.

The carvers transform the sketches into blocks and the printers dutifully set them to paper.

Each sheet is dated and signed."

[sub_resource type="Resource" id="Resource_tuogj"]
script = ExtResource("20_s2roi")
bonus_type = ExtResource("20_7xywg")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_wdu67"]
script = ExtResource("10_4cd6q")
markedup_text = "Focus on landscape paintings."
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The carvers hike out into the wilderness and return with stories of endless hills and uncooperative clouds.

The resulting prints are richly colored, mist rolling in with the gradients.

One could swear they can smell the rain when looking at one of these."

[sub_resource type="Resource" id="Resource_1e1n1"]
script = ExtResource("20_s2roi")
bonus_type = ExtResource("19_2y3je")
amount = 10
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_oauft"]
script = ExtResource("10_4cd6q")
markedup_text = "Focus on scenes of daily life."
outcome = SubResource("Resource_1e1n1")
markedup_result_text = "The artists linger in kitchens and marketplaces, sketching laughter, spilled tea, and the tilt of tired shoulders.

When the prints are hung to dry, the whole settlement gathers to point and chuckle. Everyone recognizes someone they know.

Perhaps one way to make art beloved is to make it familiar."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_owcjq"]
script = ExtResource("8_7dqvq")
markedup_text = "The studio hums with the sound of chisels hitting wood and brushes swiping rapidly across wet paper.

Artists, carvers, and printers are working in perfect concert to make woodblock prints worth spreading all across the shard.

Today, they are deciding on their next project."
background_image = SubResource("Resource_fr3df")
background_credit = ExtResource("10_1e1n1")
choices = Array[ExtResource("10_4cd6q")]([SubResource("Resource_lw3he"), SubResource("Resource_u6a4q"), SubResource("Resource_wdu67"), SubResource("Resource_oauft")])


[sub_resource type="Resource" id="Resource_r4lul"]
script = ExtResource("10_7tf88")
markedup_text = "Flee the pavilion."
outcome = SubResource("Resource_owrgg")
markedup_result_text = "The tea maker follows her instinct and flees, leaving the problem to her cat companion.

Once the hubbub dies down, she returns to find a whole tea set strewn all around the tea house, and one of the paper screens seriously damaged.

The cat looks exceedingly pleased with itself though."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_1ea03"]
script = ExtResource("7_pyk6g")
markedup_text = "Today, the tea pavilion is a battlefield. A cat is chasing a large, exceptionally hairy spider around the room, knocking cups and scratching the delicate paper screens.

The spider seems to be winning so far, holding its ground against a beast fifty times its size, but the feline is not giving up."
background_image = SubResource("Resource_cqcsb")
background_credit = ExtResource("11_cqcsb")
choices = Array[ExtResource("10_7tf88")]([SubResource("Resource_2sb8d"), SubResource("Resource_hqsr2"), SubResource("Resource_m5fys")])
exit_choice = SubResource("Resource_r4lul")


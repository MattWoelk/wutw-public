[sub_resource type="Resource" id="Resource_5wq3a"]
script = ExtResource("7_7hbe5")
markedup_text = "Merge stalls to pool the blessings."
requirement = SubResource("Resource_y6s55")
outcome = SubResource("Resource_4s7vr")
markedup_result_text = "An enterprising merchant comes up with an idea: if two stalls are merged, they will have two cats, and therefore double the blessings.

At first she has trouble convincing the others, but after the first merged stall ends up with a monopoly on sake sales, the rest of the merchants catch on, planting the seeds of a cartel economy in the shard's future."

[sub_resource type="Resource" id="Resource_ef84h"]
script = ExtResource("9_ef84h")
bonus_type = ExtResource("21_7w82j")
amount = 20
extra_per_season = 10
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_wt43v"]
script = ExtResource("7_7hbe5")
markedup_text = "Ask scholars to explain the symbolism."
outcome = SubResource("Resource_ef84h")
markedup_result_text = "Scholars are called to study the cats' blessings. They consult old books and come back with an explanation.

They claim that the cats are fighting over territory and food, not to bestow divine economic favor.

Most merchants refuse to believe this, but the excitement surrounding the fights soon fades, and few people pay attention to it anymore."

[sub_resource type="Resource" id="Resource_uedco"]
script = ExtResource("4_ik4t3")
markedup_text = "The market's roofs have become a home for many stray cats. They started showing up out of the wilderness one by one, and by now every stall has its own stall cat.

The merchants consider the cats to be good luck charms, spirits blessing their businesses. As such, whenever cats from competing shops squabble, everyone watches with bated breath; the winning cat is thought to bring great luck to the business it patronizes."
background_image = SubResource("Resource_7w82j")
background_credit = ExtResource("6_ef84h")
choices = Array[ExtResource("7_7hbe5")]([SubResource("Resource_02t1p"), SubResource("Resource_ybpct"), SubResource("Resource_5wq3a")])
exit_choice = SubResource("Resource_wt43v")


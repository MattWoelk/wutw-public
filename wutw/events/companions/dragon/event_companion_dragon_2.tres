[sub_resource type="Resource" id="Resource_eb43h"]
script = ExtResource("7_cjhtj")
markedup_text = "Explore deeper into the cave."
requirement = SubResource("Resource_uvonq")
outcome = SubResource("Resource_nthfn")
markedup_result_text = "The monks descend deep into the shafts. As they explore, they find messages on the wall, carved neatly, almost like placards. The script is old, from long before the Shattering.

It takes days to interpret the glyphs, and the monks have to fill in the gaps, but the tale they tell is familiar. They speak of the pillars of the earth turning unstable, of poison rising from the ground when the heart of the mountain is pierced. They caution not to ignore the signs, and promise the end of days for those who let greed disturb the balance of nature.

The monks adopt this wisdom into their teachings, and thank the dragon spirit for its wise counsel."


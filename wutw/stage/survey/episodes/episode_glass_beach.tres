[sub_resource type="Resource" id="Resource_mvdw0"]
script = ExtResource("2_uakfi")
label = "Row along the shore."
aspects = Array[ExtResource("3_fi6ru")]([ExtResource("10_tcldj")])
aspects_per_season = Array[ExtResource("3_fi6ru")]([null])
outcome = SubResource("Resource_ef40v")
outcome_text = "The surveyors get into their boats and let the current carry them along the shoreline.

As they watch the cliffs drift by, they spot a nearly perfect hole cut into the stone, too regular to be natural. The inside of the hole appears to be covered in rusted, barnacle-clad metal."


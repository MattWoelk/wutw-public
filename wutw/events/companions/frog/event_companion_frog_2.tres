[sub_resource type="Resource" id="Resource_gbl3t"]
script = ExtResource("6_koc0d")
markedup_text = "Rid the pond of these unclean creatures."
requirement = SubResource("Resource_awwqo")
outcome = SubResource("Resource_5iqy7")
markedup_result_text = "The artisan calls her fellow workers and describes the foul scene she witnessed.

With some effort, they are convinced that the foul creatures cannot be allowed to remain.

Instead of following the regular work schedule, they spend the next day wading through the pond and shooing away every frog that can be found."


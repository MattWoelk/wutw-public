[sub_resource type="Resource" id="Resource_wt43v"]
script = ExtResource("10_d4c3j")
markedup_text = "Leave the animals alone."
outcome = SubResource("Resource_lcg14")
markedup_result_text = "The settlers look on as the cat finally makes its move.

Despite its lightning-fast swipe, the toad manages to escape. The cat looks sheepish for just a moment, before immediately beginning to groom its paw with intense focus. It projects an air of absolute certainty that it meant to do exactly that."

[sub_resource type="Resource" id="Resource_uedco"]
script = ExtResource("7_urm2b")
markedup_text = "Ever since the Shattering, the cats of the shards have had to adapt to the new environment. The transition was surprisingly easy, especially for the strays, who were already used to foraging for food.

The settlers notice one such cat standing motionless by the water's edge, waiting for just the right moment to pounce on a toad, who is blissfully unaware of the mortal danger it is in."
background_image = SubResource("Resource_oomnv")
background_credit = ExtResource("9_witg6")
choices = Array[ExtResource("10_d4c3j")]([SubResource("Resource_02t1p"), SubResource("Resource_ybpct"), SubResource("Resource_5wq3a")])
exit_choice = SubResource("Resource_wt43v")


requirement = SubResource("Resource_vw1jo")
outcome = SubResource("Resource_5ody7")
markedup_result_text = "The settlers decide to climb up the rocky cliff, hoping to get a better view of the labyrinthine forest.

When they reach the top, they can see the canopy spreading far beyond.

Looking in the direction they came from, they see an enormous cedar rising far above the other trees."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


[resource]
script = ExtResource("4_xfsoq")
original_image = SubResource("Resource_bcsnl")
piece_name = "Chapter 44: Bamboo River (Takegawa)"
series = ExtResource("5_yy27c")
artist = ExtResource("1_h7dq7")
styles = Array[ExtResource("6_m5x8p")]([ExtResource("7_uke0c"), ExtResource("7_h7dq7")])
actual_start_year = 1892
custom_link = "https://ogatagekko.com/print/chapter-44-takekawa-bamboo-river/"
edits_description = "Text and cloud overlays were edited out, and a campfire was added."
final_image_tex = SubResource("Resource_g4dao")
province = 70
blurb = "Depicts a scene from chapter 44 of the Tale of Genji, where Kaoru (nominally Genji's son, but in reality the son of his nephew) sits with Fujiwara Chamberlain. The scenery of the wisteria-draped pine tree likely references Kaoru's poem:

[i]If it were a thing
that one could take in the hand,
the wisteria,
would I have ever seen the
color that outdoes the pine.[/i]"
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_jpktp"]
script = ExtResource("6_gvlip")
markedup_text = "Remove the fences entirely."
requirement = SubResource("Resource_jv5s7")
outcome = SubResource("Resource_egt2j")
markedup_result_text = "The fence is taken down.

For a while, the deer continue to stay by the watchpost, but eventually they grow more confident and start roaming the streets.

A few townspeople grumble, but most find the new neighbors charming."


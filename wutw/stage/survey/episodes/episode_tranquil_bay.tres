label = "Leave an offering."
requirement = SubResource("Resource_tox85")
aspects = Array[ExtResource("3_wwac5")]([null])
aspects_per_season = Array[ExtResource("3_wwac5")]([null])
outcome = SubResource("Resource_a6ufw")
outcome_text = "The surveyors dock their boat and walk onto the islet, their feet sinking into the sand.

As they approach the gate, the woody fragrance of fresh pine fills their nostrils.

The scouts leave a bowl of dried fruit behind the gate, content with the knowledge that they've paid their respects to the local spirits."


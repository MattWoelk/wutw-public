[resource]
script = ExtResource("1_q3j1j")
dialogue_id = "debate_warlords"
record_title = "Debate Speech: Bullies"
text = "PAGE: avatar_adult(PORTAL_NETWORK), AUDIENCE
avatar_adult: The Explorer told me of a shard where neighbors only look at each other from behind high walls.
avatar_adult: They spend their whole lives waiting for an attack, treating anyone from the next village over as a monster.
avatar_adult: It breaks my heart.
avatar_adult: But I think I understand why it happens.
avatar_adult: When a town stands completely alone, every stranger looks like a threat.
avatar_adult: Fear takes root when people feel isolated.
avatar_adult: And fear makes us do cruel things.
avatar_adult: If we agree to support each other across the Cloud Sea, we remove that fear.
avatar_adult: We become a safety net for those who need it most.
avatar_adult: We can make sure that no local chief gets to bully their people.
avatar_adult: We can finally tear down those walls, knowing there is a vast community looking out for us all.
avatar_adult: Let us be brave enough to hold hands, and build a world where we treat each other with kindness."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

min_count = 1
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2myy3"]
script = ExtResource("5_3xl68")
markedup_text = "Sort and mulch what can't be saved."
requirement = SubResource("Resource_nthfn")
outcome = SubResource("Resource_egt2j")
markedup_result_text = "Settlers carefully gather the firm fruit and lay the rest in compost pits.

The scent changes, inviting grumbles from the townspeople.

When the soil is turned weeks later, it's already richer."


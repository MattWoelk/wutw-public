[sub_resource type="Resource" id="Resource_f2op8"]
script = ExtResource("5_00o4p")
markedup_text = "Wait until the berry harvest before plucking the leaves."
requirement = SubResource("Resource_egt2j")
outcome = SubResource("Resource_k5hlc")
markedup_result_text = "The settlers forbid leaf harvesting until the berries are ripe.

Once the berries are gathered, the silkworm carers pluck the leaves.

Unfortunately, the silkworms refuse these, unimpressed by their lack of freshness."


[sub_resource type="Resource" id="Resource_8t6fe"]
script = ExtResource("5_t3uxx")
markedup_text = "Forbid the games."
outcome = SubResource("Resource_4spnk")
markedup_result_text = "The villagers prohibit the children from using the sky ropeways for games anymore.

The harvest work resumes as it always has, but the farmers miss the sound of the merry laughter that used to echo among the rocks."

[sub_resource type="Resource" id="Resource_ntft6"]
script = ExtResource("3_onmye")
markedup_text = "The settlement is separated from its fields by a deep valley. The villagers have stretched ropes between the cliffs and attached baskets that could be pulled from one side to the other. 

As harvest time approaches, the villagers face a new problem. The children of the settlement have discovered that playing in the baskets is their favorite way to pass the time. They spend their entire days racing each other across the gorge and inventing new games in their baskets.

The farmers shake their heads in exasperation as baskets are left stranded on the wrong side of the valley. Their harvest loads end up delayed, the fruits and vegetables left to wilt in the sun."
background_image = SubResource("Resource_eybaj")
background_credit = ExtResource("4_qes2l")
choices = Array[ExtResource("5_t3uxx")]([SubResource("Resource_tt0g2"), SubResource("Resource_tr52n"), SubResource("Resource_ua32x")])
exit_choice = SubResource("Resource_8t6fe")


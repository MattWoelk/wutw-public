[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("5_3tl6q")
markedup_text = "Carve a shakuhachi flute from the bamboo."
requirement = SubResource("Resource_dpp3j")
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "A few stalks, strong and straight, are chosen with care.

The soft rasp of carving blades soon gives way to the first tentative notes of a shakuhachi flute.

Several musicians hold a performance in the grove at dusk."

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("7_3lvlp")
card_type = ExtResource("19_g6x3l")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("5_3tl6q")
markedup_text = "Store the bamboo for future use."
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "The broken pieces are bundled carefully and stacked at the foot of the hill.

There they rest, waiting for future carvers to decide their fate."

[sub_resource type="Resource" id="Resource_fmixu"]
script = ExtResource("3_c7try")
markedup_text = "At dawn, the bamboo grove lies unsettled. Several of the younger stalks have been snapped halfway up.

No claw marks or footprints mar the ground. Only the wind whistles through hollowed joints, rustling the leaves in its wake.

It could be last night's rainstorm, or wild beasts, or perhaps travelers taking a shortcut.

The broken stalks lie waiting. It seems wrong to leave them untouched."
background_image = SubResource("Resource_lt1hu")
background_credit = ExtResource("5_lt1hu")
choices = Array[ExtResource("5_3tl6q")]([SubResource("Resource_egt2j"), SubResource("Resource_rx1a8"), SubResource("Resource_06ahh")])
exit_choice = SubResource("Resource_ciwob")


metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_boqcy"]
script = ExtResource("13_b7ecx")
bonus_type = ExtResource("14_hu5wq")
min_count = 25
max_count = -1
extra_per_season = 50

[sub_resource type="Resource" id="Resource_5f07b"]
script = ExtResource("5_sbpf2")
markedup_text = "Let some run the baths while others bathe."
requirement = SubResource("Resource_boqcy")
outcome = SubResource("Resource_ciwob")
markedup_result_text = "Buckets are passed in silence. Half the visitors fill them, heat them, and test the temperature with care. The other half lowers themselves into the pools with content sighs.

Those who serve do not ask for thanks. Those who rest do not offer apologies. The roles shift naturally over the course of the day."

[sub_resource type="Resource" id="Resource_1weil"]
script = ExtResource("5_sbpf2")
markedup_text = "Let the water rest."
markedup_result_text = "The expedition leaves the baths behind.

There is talk of trying again another day, but the plan is as substantial as the rising steam."

[sub_resource type="Resource" id="Resource_ynifa"]
script = ExtResource("3_lto1w")
markedup_text = "Steam curls over the water's surface. Robes hang beside the changing screens. Buckets rest on worn floors.

The baths are warm, but there's only space for one or two people at a time.

\"The old baths weren't just for washing,\" someone says. \"They were for letting go of one's burdens. For clarifying one's thoughts.\"

If we invest some effort, this humble bath could be turned into a large communal bathhouse."
background_image = SubResource("Resource_u4gra")
background_credit = ExtResource("10_u4gra")
choices = Array[ExtResource("5_sbpf2")]([SubResource("Resource_odeuh"), SubResource("Resource_wq75o"), SubResource("Resource_5f07b")])
exit_choice = SubResource("Resource_1weil")


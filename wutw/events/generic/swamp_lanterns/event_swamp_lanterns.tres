[sub_resource type="Resource" id="Resource_snkbq"]
script = ExtResource("9_utqk7")
aspect_type = ExtResource("15_3csa1")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_didtq"]
script = ExtResource("5_kufry")
markedup_text = "Venture off the main path."
requirement = SubResource("Resource_snkbq")
outcome = SubResource("Resource_owmt7")
markedup_result_text = "Having walked past the last lantern with nothing to show for it, Hiroshi decides to step off the main path. He follows the sound of a croaking frog, his own little lantern lighting his way.

He soon finds his feet ankle-deep in water. As he raises his lantern, he catches a glimpse of a dark slanted rooftop at the edge of the black pool, half-hidden by reeds."

[sub_resource type="Resource" id="Resource_6siy8"]
script = ExtResource("5_kufry")
markedup_text = "Give up and return home."
markedup_result_text = "Hiroshi grows ashamed of himself for chasing a child's story through the swamp and turns back.

On the way home, he finds Makoto waiting at the edge of the settlement, worried about his brother. Before Hiroshi can speak, Makoto points behind him. But Hiroshi turns too late, and he sees nothing but an empty path among the dark trees."

[sub_resource type="Resource" id="Resource_kubpu"]
script = ExtResource("3_gitqq")
markedup_text = "A young man, Hiroshi, is wandering through the rainy swamp at night, the dark trees towering over his head. The raindrops fall heavily on his sturdy umbrella as he passes between the glowing lanterns guiding him along the path.

His younger brother, Makoto, spoke of meeting a giant, grinning spirit bounding through the trees one evening. The other children in the village are making fun of the boy, and calling him a liar.

Hoping to uphold his brother's honor, Hiroshi presses further into the swamp's depth.
"

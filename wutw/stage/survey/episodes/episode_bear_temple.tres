[sub_resource type="Resource" id="Resource_uffrp"]
script = ExtResource("2_362po")
label = "Camp despite misgivings."
requirement = SubResource("Resource_ncsyd")
aspects = Array[ExtResource("3_kjoqt")]([null])
outcome = SubResource("Resource_trtbi")
outcome_text = "The scouts disregard the naysayers and camp inside the temple anyway.

During the night, they wake up to scratching noises, and as they raise their torches, they find a group of brown bear cubs ransacking their packs, spilling supplies everywhere.

After the commotion dies down and the scouts are safe outside, they realize that they had to leave most of their supplies behind."

[sub_resource type="Resource" id="Resource_0eiya"]
script = ExtResource("10_r4oyg")
relic = ExtResource("9_3pwku")

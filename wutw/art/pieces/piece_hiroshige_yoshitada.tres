[resource]
script = ExtResource("3_l4sxn")
original_image = SubResource("Resource_bcsnl")
piece_name = "Poem by Sone no Yoshitada: Princess Usuyuki and the Ferryman"
artist = ExtResource("1_onvbc")
actual_start_year = 1845
actual_end_year = 1848
date_type = 1
edits_description = "Only the ferryman was used."
final_image_tex = SubResource("Resource_jg17w")
blurb = "Depicts princess Usuyuki in a traveling robe arriving at a ferry stop. The ferryman is looking at her and scratching his head. At the top is a poem by the 10th-century Heian poet Sone no Yoshitada:

[i]Over the Yura Strait
cross boatmen
their oars lost,
adrift
on the path of love.[/i]

The scene itself is based on the 17th-century Tale of Usuyuki, which recounts a brief love affair between a married woman (Usuyuki) and her lover (Sonobe no Emon), climaxing with Usuyuki's untimely death after Sonobe departs on a journey.

The love letters featured in this story were so popular that they became a model for letter writing during the seventeenth century, and the story was adapted into several puppet and Kabuki plays.

The inscription in the corner of the image by Ryūkatei Tanekazu, a popular Edo-period fiction writer, describes an alternative ending where Usuyuki follows Sonobe on his journey instead."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

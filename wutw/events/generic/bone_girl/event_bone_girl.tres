[sub_resource type="Resource" id="Resource_arkyb"]
script = ExtResource("5_o10bj")
markedup_text = "Seek advice."
requirement = SubResource("Resource_mg51f")
outcome = SubResource("Resource_182w5")
markedup_result_text = "The woman turns to a passing scholar for advice.

She is surprised when he shows great interest in her sketches and discusses her ideas with clear excitement. They spend days studying the bones together, before he has to leave.

She will one day hear of the great bone scholar who had discovered a treasure trove of bones in the wasteland, all by himself."


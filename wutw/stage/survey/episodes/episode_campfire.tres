[sub_resource type="Resource" id="Resource_g72kf"]
script = ExtResource("2_jqjvj")
label = "Discuss how to avoid inefficiencies."
aspects = Array[ExtResource("3_igv2q")]([ExtResource("4_ic0lq")])
aspects_per_season = Array[ExtResource("3_igv2q")]([null])
outcome = SubResource("Resource_im02d")
outcome_text = "The team spends the evening discussing ways to pack lighter and to find better shortcuts. They compare the weights of different foods, and the advantages of using a single tool to do multiple tasks. By the end of the discussion, they are certain that they can achieve more with less."


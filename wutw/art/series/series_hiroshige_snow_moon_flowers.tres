[resource]
script = ExtResource("2_5k8m5")
name = "Snow, Moon and Flowers"
blurb = "Although not officially named, this is a recognized set of 3 triptychs, completed one year before Hiroshige's death, representing the theme of snow, moon, and flowers. The last triptych depicts a scene of whirlpools to evoke the shape of flowers."
start_year = 1857
end_year = 1857

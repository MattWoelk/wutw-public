[resource]
script = ExtResource("2_0slnd")
name = "Famous Views of the Sixty-odd Provinces"
blurb = "A series of 70 prints depicting famous places in each of Japan's then 68 provinces, plus a print of Edo, the capital, and a contents page.

Hiroshige based many of his designs on old Japanese guidebooks called meisho zue. In particular, at least 26 of the designs are believed to have been based on drawings from the 8 volume series of guidebooks called Sansui Kikan (Exceptional Mountain and Water Landscapes) written and illustrated by Fuchigami Kyokkō (1753–1816) published between 1800 and 1802."
start_year = 1853
end_year = 1856
artist = ExtResource("1_rnahy")
link = "https://en.wikipedia.org/wiki/Famous_Views_of_the_Sixty-odd_Provinces"
metadata/_custom_type_script = "uid://dwukodn1s8aar"

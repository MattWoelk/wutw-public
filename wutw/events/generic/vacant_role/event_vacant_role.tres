[sub_resource type="Resource" id="Resource_1quea"]
script = ExtResource("5_kfg61")
markedup_text = "Quietly bang a drum in place of his lines."
requirement = SubResource("Resource_uhnow")
outcome = SubResource("Resource_dpp3j")
markedup_result_text = "When the founder's lines arrive, no one steps forward.

Instead, a soft, deliberate beat echoes through the stage. One strike for a greeting, two for a remark, and a triplet for a farewell.

The crowd is surprised, but soon the news spreads among them in nudges and whispers."

[sub_resource type="Resource" id="Resource_06ahh"]
script = ExtResource("11_8qfjl")
card_type = ExtResource("10_53xhr")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_ntqyf"]
script = ExtResource("13_fbx0u")
aspect_type = ExtResource("12_0n6ff")
min_count = 2
extra_per_season = 1

[sub_resource type="Resource" id="Resource_vrioe"]
script = ExtResource("5_kfg61")
markedup_text = "Perform a new play about his life instead."
requirement = SubResource("Resource_ntqyf")
outcome = SubResource("Resource_06ahh")
markedup_result_text = "The troupe rewrites everything.

From his childhood among traveling bards to the day he put together his first stage with salvaged planks.

The show is unpolished, and a little too dramatized, but the feeling carries through and when the final bow comes, the whole crowd erupts in shouts of \"Dragonfly!\" and a rain of paper-wrapped coins showers the stage."

[sub_resource type="Resource" id="Resource_ciwob"]
script = ExtResource("11_8qfjl")
card_type = ExtResource("14_mmc7t")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_kfg61"]
script = ExtResource("13_fbx0u")
aspect_type = ExtResource("15_nfa8o")
min_count = 4
extra_per_season = 1

[sub_resource type="Resource" id="Resource_yyvn4"]
script = ExtResource("5_kfg61")
markedup_text = "Let troupe members take turns performing his roles."
requirement = SubResource("Resource_kfg61")
outcome = SubResource("Resource_ciwob")
markedup_result_text = "Each performance is slightly different.

Sometimes his lines are echoed, sometimes adjusted, but always delivered with care. A remembered gesture is repeated, or a familiar facial expression mimicked.

The spirit of the founder lives on in the details."

[sub_resource type="Resource" id="Resource_nthfn"]
script = ExtResource("17_8whmy")
card_tier_bonus = 50
aspect = ExtResource("16_df4j6")
metadata/_custom_type_script = "uid://gu7gcielbwdr"

[sub_resource type="Resource" id="Resource_javtj"]
script = ExtResource("5_kfg61")
markedup_text = "Have his protégé take on the roles from now on."
outcome = SubResource("Resource_nthfn")
markedup_result_text = "The protégé bows once before stepping into costume.

Their voice is different, their timing sharper, but the air around them shifts in that familiar way.

The founder's most ardent admirers say the transition is too seamless, but the average audience member considers it perfect."

[sub_resource type="Resource" id="Resource_o6x5y"]
script = ExtResource("3_ntqyf")
markedup_text = "The founder of this shard's Dragonfly Troupe passed away just the other day.

In his later years, he only took small roles: a shopkeeper here, a wandering monk there, sometimes a silent passerby. Nonetheless, he never missed a rehearsal or let a show go unperformed.

Now, the troupe prepares their next production. His roles are already written in, but now no one is there to perform them."
background_image = SubResource("Resource_6lkh4")
background_credit = ExtResource("5_1quea")
choices = Array[ExtResource("5_kfg61")]([SubResource("Resource_1quea"), SubResource("Resource_vrioe"), SubResource("Resource_yyvn4")])
exit_choice = SubResource("Resource_javtj")


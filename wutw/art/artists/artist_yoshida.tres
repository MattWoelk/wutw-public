[resource]
script = ExtResource("3_l4fb0")
name = "Yoshida Hiroshi"
portrait = SubResource("Resource_a4dg7")
blurb = "Yoshida Hiroshi was a leading figure of the [url=art_style:shin-hanga]shin-hanga[/url] movement who blended Western oil painting techniques with traditional Japanese woodblock printing. He is distinct among his peers for his intense involvement in the entire production process, often supervising the carving and printing himself to achieve his exact vision.

He was known as a mountain painter and spent about half of the year on sketching travels. As a mountaineer, he climbed the mountains of the Japanese Alps every summer and created his large paintings and woodblock prints after returning home.

As a world traveler, Yoshida expanded the traditional subjects of Japanese prints to include global landmarks, creating renowned series depicting the Swiss Alps, the Grand Canyon, and the Taj Mahal."
birth_year = 1876
death_year = 1950
link = "https://en.wikipedia.org/wiki/Hiroshi_Yoshida"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

[resource]
script = ExtResource("3_5tsmf")
name = "Inoue Tankei"
blurb = "Inoue Tankei, also known as Inoue Yasuji, was an ukiyo-e artist active during the Meiji era.

Born in Asakusa, Edo (present-day Tōkyō), he briefly apprenticed under [url=artist:Tsukioka Yoshitoshi]Tsukioka Yoshitoshi[/url] before becoming the main disciple of [url=artist:Kobayashi Kiyochika]Kobayashi Kiyochika[/url] at age 15.

Most of his works deal with Tōkyō, and specifically his home neighborhood of Asakusa, but he also depicted sumo wrestlers and designed illustrations for comic novels. His style is based on Kiyochika's, defined by subdued color, the use of white space, and eschewing the traditional thick black outlines of ukiyo-e.

He died of beriberi at age 26."
birth_year = 1864
death_year = 1889
link = "https://www.geographicus.com/P/ctgy&Category_Code=inoueyasuji"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

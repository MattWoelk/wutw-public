[sub_resource type="Resource" id="Resource_df5af"]
script = ExtResource("5_qd7hq")
markedup_text = "Build a little lost-and-found box."
requirement = SubResource("Resource_7ucq0")
outcome = SubResource("Resource_40rqf")
markedup_result_text = "It won't solve everything, but it's a start.

The settlers leave a tiny wooden box with a polite sign, and trust that it will be put to good use."

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("5_qd7hq")
markedup_text = "Leave it be."
markedup_result_text = "Maybe its owner will return. Maybe it was left on purpose.

Either way, the pouch remains on the bench."

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("3_albkb")
markedup_text = "The rest stop is quiet, save for birdsong and breeze. But someone was here recently, and forgot something.

A pouch lies on the bench, a modest thing with no markings. It doesn't seem to contain much, so perhaps its absence won't even be noticed."
background_image = SubResource("Resource_qh8br")
background_credit = ExtResource("4_as6xq")
choices = Array[ExtResource("5_qd7hq")]([SubResource("Resource_2stvf"), SubResource("Resource_kio1v"), SubResource("Resource_df5af")])
exit_choice = SubResource("Resource_ptcwf")


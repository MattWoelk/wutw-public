[resource]
script = ExtResource("1_dnwce")
name = "Shin-hanga"
blurb = "Literally \"new prints\", this movement was started by [url=artist:Shōzaburō Watanabe]Shōzaburō Watanabe[/url] in the early 20th century to revitalize the tradition of ukiyo-e art.

Shin-hanga was more realistic, and heavily incorporated Western elements such as atmospheric light sources, shadow, and perspective. It also eschewed the ukiyo-e tradition of emulating hand-drawn brushstrokes, and often featured \"mottled\" impressions rather than being limited to planes of solid color or gradients."
start_year = 1910
end_year = 1960
link = "https://en.wikipedia.org/wiki/Shin-hanga"
metadata/_custom_type_script = "uid://bgguqqmww2r4l"

[resource]
script = ExtResource("3_i23nu")
original_image = SubResource("Resource_bcsnl")
piece_name = "Young Woman Jumping from the Kiyomizu Temple Balcony with an Umbrella"
artist = ExtResource("1_t2fwq")
styles = Array[ExtResource("4_6hlcc")]([ExtResource("5_pln3d")])
actual_start_year = 1765
actual_end_year = 1765
date_type = 1
edits_description = "The background was removed and the image was recolored."
final_image_tex = SubResource("Resource_alwh0")
blurb = "Depicts a young woman falling through the air holding an umbrella. The origin of her jump is a platform in the Kiyomizu Dera, one of the main Buddhist temples in Kyōto, established in 778. The temple is still active today, serving as a major tourist destination, but given the crowds, I can't recommend it unless you go in the off-season.

The expression \"to jump off the stage at Kiyomizu\" is the Japanese equivalent of the English expression \"to take the plunge\". This refers to an Edo-period tradition that held that if one survived a 13-meter jump from the stage, one's wish would be granted. During the Edo period, 234 jumps were recorded, and of the jumpers, 85% survived. The practice was banned in 1872."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

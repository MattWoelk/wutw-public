[resource]
script = ExtResource("1_w6ve2")
name = "Kanō School"
blurb = "The Kanō school was the longest-lived and most influential lineage of painters in Japanese history, serving as the official artists of the shogunate for over 4 centuries.

Founded in the 15th century, the school established itself by blending the strong, expressive brushwork of Chinese ink painting with the colorful, highly decorative elements of traditional Japanese aesthetics.

They are renowned for their monumental works on sliding doors and folding screens, frequently using lavish gold leaf backgrounds to project the power of their samurai patrons. Through a strict system of workshops and hereditary succession, they defined the official visual style of the ruling class and shaped the foundations of early modern Japanese art."
start_year = 1460
end_year = 1860
link = "https://en.wikipedia.org/wiki/Kan%C5%8D_school"
metadata/_custom_type_script = "uid://dht2n55p5x21w"

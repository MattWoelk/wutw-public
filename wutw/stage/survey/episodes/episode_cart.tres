outcome_text = "The survey team bows an apology and carries on, certain that their mission is too important to stop and help bystanders."

[resource]
script = ExtResource("16_3twa1")
episode_id = "cart"
title = "The Hapless Carter"
biome_types = Array[int]([8])
text = "The survey team comes upon a cart stuck before a little stream.

The settler pulling the cart had decided to go ahead of the expedition, and is now stuck, unable to get the wide cart over the narrow bridge."
background_image = SubResource("Resource_p687i")
background_credit = ExtResource("1_3s006")
choices = Array[ExtResource("2_3s006")]([SubResource("Resource_xhi8v"), SubResource("Resource_6in3u"), SubResource("Resource_jaeo7"), SubResource("Resource_ece21")])

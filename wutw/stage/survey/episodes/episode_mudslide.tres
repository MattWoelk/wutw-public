label = "Build a causeway over it."
aspects = Array[ExtResource("4_eq361")]([ExtResource("14_vgu4g")])
aspects_per_season = Array[ExtResource("4_eq361")]([null])
outcome = SubResource("Resource_oc4rf")
outcome_text = "The surveyors lay logs over the mud and pack the gaps with smaller branches until the mud is barely visible underneath. They get across safely, and the causeway will help the rest of the expedition once they catch up."

[sub_resource type="Resource" id="Resource_l0jxe"]

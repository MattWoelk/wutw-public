[resource]
script = ExtResource("3_jj4p5")
original_image = SubResource("Resource_bcsnl")
piece_name = "Kappa"
series = ExtResource("4_k2k4v")
styles = Array[ExtResource("5_i1fi2")]([ExtResource("6_jpitm"), ExtResource("6_cq54o")])
actual_start_year = 1500
actual_end_year = 1700
date_type = 1
custom_link = "https://commons.wikimedia.org/wiki/File:8.Kappa.jpg"
edits_description = "The head was edited to remove the indentation, the face was edited to express suffering, and the background was removed."
final_image_tex = SubResource("Resource_kq4gv")
blurb = "Depicts Kappa (\"river child\"), one of the most well-known yōkai. It is said to be an amphibian, about the size of a child, living in the lakes and rivers of Japan.

The kappa has webbed feet and hands, scaly or slippery skin, often with a turtle-like shell on its back. Most depictions of kappa have a dish-like structure on the top of its head, filled with some kind of liquid. Kappa enjoy sumo wrestling, eating cucumbers, and causing trouble in various ways."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

[sub_resource type="Resource" id="Resource_a5id8"]
script = ExtResource("6_fpjml")
markedup_text = "Remain on the cliff."
requirement = SubResource("Resource_1tihe")
outcome = SubResource("Resource_ob40c")
markedup_result_text = "The poet swallows hard but remains still, unwilling to show the tiger a hint of fear.

For an hour, human and beast sit side by side, admiring the moon.

The experience provides the poet with enough inspiration for a long time."


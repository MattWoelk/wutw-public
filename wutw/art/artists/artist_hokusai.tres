[resource]
script = ExtResource("1_uj4ld")
name = "Katsushika Hokusai"
portrait = SubResource("Resource_818be")
blurb = "Katsushika Hokusai was a master printmaker who fundamentally transformed the Japanese art of ukiyo-e, from a focus on portraits of actors and courtesans to include landscapes, plants, animals, and scenes of daily life.

He is known for integrating traditional Japanese techniques with Western approaches to perspective and imported pigments like Prussian blue. His best known series is [url=art_series:36 Views of Mount Fuji]36 Views of Mount Fuji[/url], which includes the famous [url=art_piece:great wave off kanagawa]Great Wave off Kanagawa[/url].

His works went on to influence Western artists like Vincent van Gogh and Claude Monet, and he is arguably the best known ukiyo-e artist today."
birth_year = 1760
death_year = 1849
link = "https://en.wikipedia.org/wiki/Hokusai"
schools = Array[ExtResource("2_cn57d")]([ExtResource("3_v7aap")])
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

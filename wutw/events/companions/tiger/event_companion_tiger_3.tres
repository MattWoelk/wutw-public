[sub_resource type="Resource" id="Resource_eb6hi"]
script = ExtResource("6_bp8nn")
markedup_text = "Roar a fierce challenge down into the quarry."
requirement = SubResource("Resource_p4k68")
outcome = SubResource("Resource_0gamc")
markedup_result_text = "A brave settler steps to the edge of the pit, cups her hands, and lets out a booming roar.

The tiger snaps to attention, its eyes flashing with renewed intensity.

It rises to the challenge, and lets out a deafening roar, before proudly stalking away into the wilderness."

[sub_resource type="Resource" id="Resource_uvt4r"]
script = ExtResource("13_qja8r")
card_type = ExtResource("17_uek88")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_1u8hi"]
script = ExtResource("9_ieos0")
aspect_type = ExtResource("19_7pkaw")
min_count = 3
extra_per_season = 1

[sub_resource type="Resource" id="Resource_2cv3q"]
script = ExtResource("6_bp8nn")
markedup_text = "Build a makeshift roof to keep the rain off."
requirement = SubResource("Resource_1u8hi")
outcome = SubResource("Resource_uvt4r")
markedup_result_text = "The townsfolk tie some bamboo together into a canopy above the ivy overhang.

The tiger doesn't seem to notice, and continues to sit in the cold dampness, whimpering once in a while.

Rarely can a physical solution fix a mental problem."

[sub_resource type="Resource" id="Resource_u1ph2"]
script = ExtResource("9_ieos0")
aspect_type = ExtResource("20_ptoyh")
min_count = 5
extra_per_season = 1

[sub_resource type="Resource" id="Resource_1tihe"]
script = ExtResource("6_bp8nn")
markedup_text = "Scare the beast away."
requirement = SubResource("Resource_u1ph2")
outcome = SubResource("Resource_uvt4r")
markedup_result_text = "The settlers throw pebbles down, trying to scare the tiger away.

The beast watches the falling rocks with disinterest, shifts its position closer to the wall, but continues to sit in the cold dampness, whimpering once in a while."

[sub_resource type="Resource" id="Resource_a5id8"]
script = ExtResource("6_bp8nn")
markedup_text = "Leave the beast to its misery."
outcome = SubResource("Resource_uvt4r")
markedup_result_text = "The settlers agree to stay out of the quarry until the tiger decides to leave.

The tiger remains in the quarry for days, inconsolable in its grief.

It leaves eventually, stepping softly, its shoulders hunched and its gaze fixed on the ground."

[sub_resource type="Resource" id="Resource_enybh"]
script = ExtResource("4_fee3o")
markedup_text = "Heavy rains have turned the bottom of the quarry into a muddy pit. In this pit, huddled under a small overhang of ivy, is a tiger.

The beast has been there for days, looking miserable, occasionally emitting sorrowful moans. A wildlife warden reports that it had recently lost its cubs to a rockslide."
background_image = SubResource("Resource_rqf0c")
background_credit = ExtResource("5_bp8nn")
choices = Array[ExtResource("6_bp8nn")]([SubResource("Resource_eb6hi"), SubResource("Resource_2cv3q"), SubResource("Resource_1tihe")])
exit_choice = SubResource("Resource_a5id8")


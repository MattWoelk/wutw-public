[sub_resource type="Resource" id="Resource_c1moe"]
script = ExtResource("9_mwh3o")
relic = ExtResource("13_ttq5v")

[sub_resource type="Resource" id="Resource_ttq5v"]
script = ExtResource("5_28qwu")
markedup_text = "Wash the ink off a robe."
requirement = SubResource("Resource_c1moe")
outcome = SubResource("Resource_3eiwn")
markedup_result_text = "The rinsers are surprised to receive only a single robe, and surprised again to find it covered in strange and unfamiliar glyphs.

Still, they have a job, and they take it seriously.

After a few washes the ink is mostly gone. It looks more like a single abstract pattern now."

[sub_resource type="Resource" id="Resource_a6ufw"]
script = ExtResource("15_65yex")
card_type = ExtResource("14_htux4")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_htux4"]
script = ExtResource("5_28qwu")
markedup_text = "Wash assorted robes and underclothes."
outcome = SubResource("Resource_a6ufw")
markedup_result_text = "The settlers are taken aback by the mountain of garments they receive, but they persevere.

They work late into the night, and the expeditions members are amazed to wake up to stacks and stacks of clean, neatly folded clothes."

[sub_resource type="Resource" id="Resource_65yex"]
script = ExtResource("3_oi8po")
markedup_text = "The cloth rinsers are done with their work early today.

They offer to handle the expedition's laundry."
background_image = SubResource("Resource_3nrog")

requirement = SubResource("Resource_iqftw")
outcome = SubResource("Resource_8bgp1")
markedup_result_text = "The settlers push through the sticky silk, enduring the terrifying feeling of heavy spiders dropping onto their shoulders and crawling across their backs.

They retrieve a cache of ancient scrolls without destroying the nest, but everyone is jittery for days afterwards."


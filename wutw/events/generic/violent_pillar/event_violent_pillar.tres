extra_per_season = 25

[sub_resource type="Resource" id="Resource_mm8jc"]
script = ExtResource("5_bjt5s")
markedup_text = "Record it and repaint in a new style."
requirement = SubResource("Resource_jiini")
outcome = SubResource("Resource_3sdrw")
markedup_result_text = "The violent image is sketched, annotated, and stored.

The pillar is painted anew, replacing the dragon slayer with abstract shapes in green and silver.

The style doesn't match the others. Artists call it dishonest, but visitors are no longer disturbed."


[resource]
script = ExtResource("3_ntiqx")
original_image = SubResource("Resource_bcsnl")
piece_name = "Gold Mine in Sado Province"
series = ExtResource("4_mvtrc")
artist = ExtResource("1_b6aug")
styles = Array[ExtResource("5_er5up")]([ExtResource("6_gabot")])
actual_start_year = 1877
custom_link = "https://pages.uoregon.edu/jsmacollections/home/articles/dai-nippon-bussan-zue-the-greater-bc77ec8603f40022.html"
edits_description = "Several edited versions are used in the game, including ones with just the text removed, and cropped ones with some people removed."
final_image_tex = SubResource("Resource_kvhf6")
province = 45
blurb = "Depicts miners at the entrance of a gold mine in Sado province (modern-day Niigata prefecture). The mines in this area, founded around 1600, were the primary source of gold in Japan for centuries, only closing in 1989.

The text on the top right praises the quality of the gold produced by this mine, and claims that about 500,000 [i]me[/i] (1.9 tons) of gold was produced annually. Other historical records suggest that the real annual production at this time was closer to 400kg.

It also mentions that gold was first discovered in Japan in 749, during the reign of the 46th emperor (Empress Kōken), which appears to be inaccurate. More reliable sources state that it was during the reign of the 45th emperor (Emperor Shōmu)."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

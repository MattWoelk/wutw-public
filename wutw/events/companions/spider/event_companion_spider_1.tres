[sub_resource type="Resource" id="Resource_hqsr2"]
script = ExtResource("10_7tf88")
markedup_text = "Cheer the cat on."
requirement = SubResource("Resource_058lx")
outcome = SubResource("Resource_1vxhf")
markedup_result_text = "The chase goes on for a while yet, but finally the cat pounces, sealing the spider's fate.

The aftermath leaves a whole tea set strewn all around the tea house, and one of the paper screens seriously damaged.

The cat looks exceedingly pleased with itself though."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


[sub_resource type="Resource" id="Resource_djpx3"]
script = ExtResource("5_scwy6")
markedup_text = "Find a way out."
outcome = SubResource("Resource_vxoy1")
markedup_result_text = "A settler watches a squirrel scramble up a nearby trunk, and decides to follow.

He climbs up the towering tree, and sees the settlement only a small distance away.

Follow his directions, the group eventually makes its way out of the labyrinth."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_1ekye"]
script = ExtResource("3_br3hg")
event_step_id = "give_up"
markedup_text = "The settlers decide to abandon the maze and retrace their steps, but can't seem to agree on which way looks the most familiar.

Paths seem to wind in all directions, and the same dense walls of greenery repeat endlessly."

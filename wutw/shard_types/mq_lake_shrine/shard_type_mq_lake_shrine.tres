value = "true"
metadata/_custom_type_script = "uid://d16r7o1hw8apt"

[sub_resource type="Resource" id="Resource_5rfs0"]
script = ExtResource("8_n1bg2")
text = "The famous lake on this shard is really beautiful. The waters are crystal clear, and the island with the shrine looks like a little jungle in the middle. When I asked the priest how they got it to look like that, she said it was a divine blessing. Another visitor asked if it had always been this way, to which she conceded that it took a lot of hard work from the priests over the generations.

I asked around and learned that generations back the lake was full of black sludge from incense ash, but it's a sore topic for the priesthood. They've since overcorrected, and don't allow fire on the island at all. They even follow a strict raw diet because cooking would involve burning.

A shifty fellow offered to sell me a stick of ancient incense, which is illegal in the town, but I decided not to get in trouble for such a mundane item."
metadata/_custom_type_script = "uid://ciddaw1laebi3"

[sub_resource type="Resource" id="Resource_uu0vg"]
script = ExtResource("9_cbk7m")
trip_reward = SubResource("Resource_5rfs0")

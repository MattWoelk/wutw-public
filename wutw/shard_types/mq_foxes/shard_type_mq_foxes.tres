[sub_resource type="Resource" id="Resource_4ui0s"]
script = ExtResource("3_6gm55")
text = "$shard_name was the first place where the settlers of the New World encountered hauntings, a group of fox spirits. They led the expedition deep into the woods, and when they finally found their way out, the foxes were gathering around an old tree on the edge of the forest. The Scribe and his acolytes shed blood from their own palms to banish the haunting once and for all."
requirement = SubResource("Resource_g51qk")
metadata/_custom_type_script = "uid://cy8bar8yxvc7q"


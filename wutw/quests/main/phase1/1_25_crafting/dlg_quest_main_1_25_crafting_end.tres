[resource]
script = ExtResource("1_7p51o")
dialogue_id = "mq_1_25_end"
record_title = "Era 一: Preserved Wisdom"
text = "PAGE: scribe(SHRINE_PRIMARY), teo(SHRINE_SECONDARY)
scribe: Oh Enlightened One, we have begun sealing your wisdom in parchment and ink.
scribe: We shall carry these glyphs with us across the shards, so by your will, we may bring the world together once more.

PAGE: scribe(STUDIO_PRIMARY), monk(STUDIO_SECONDARY)
scribe: I can feel divine grace resonating through the glyphs!
scribe: The world's restoration is close at hand.
monk: What's left for us to do now?
scribe: While ink preserves wisdom, without practice it is but a record.
scribe: We must raise shrines across the shards, so each day's breath carries the Enlightened One's teachings.
"
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

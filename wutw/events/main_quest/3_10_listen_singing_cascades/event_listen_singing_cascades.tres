[sub_resource type="Resource" id="Resource_kio1v"]
script = ExtResource("7_54fbb")
markedup_text = "It is an uplifting hymn."
outcome = SubResource("Resource_6at2x")
markedup_result_text = "The scholar who first heard the hymn hums along to help the rest of the group recognize it.

Soon everyone can hear it, and some invent verses on the spot to go with the melody.

By the time the expedition moves on, they are newly inspired, confident that the Enlightened One had blessed their path."


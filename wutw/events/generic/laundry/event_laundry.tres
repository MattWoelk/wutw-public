[sub_resource type="Resource" id="Resource_mar6s"]
script = ExtResource("5_28qwu")
markedup_text = "Wash the overperfumed sleeve."
requirement = SubResource("Resource_x7x1g")
outcome = SubResource("Resource_ua5wu")
markedup_result_text = "The rinsers are confused when presented with a single sleeve, not even attached to a robe.

It takes all day to wash away the stench of perfume clinging to the cloth, and by the end there's still a trace remaining, but it is certainly a big improvement."


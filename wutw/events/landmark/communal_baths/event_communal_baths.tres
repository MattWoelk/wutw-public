[sub_resource type="Resource" id="Resource_odeuh"]
script = ExtResource("5_sbpf2")
markedup_text = "Build a proper bathhouse."
requirement = SubResource("Resource_f8c4y")
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The new bathhouse takes time to build, but it's finally finished. Pipes gurgle. Buckets clatter. The steam stays floating, confined by the ceiling.

When someone leaves the water, they seem just a little lighter."


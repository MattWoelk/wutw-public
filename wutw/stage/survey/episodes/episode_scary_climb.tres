[resource]
script = ExtResource("14_q7lqm")
episode_id = "scary_climb"
title = "The Anxious Descent"
biome_types = Array[int]([7])
text = "The sun is setting behind the rocky peaks as the survey team makes its way down an ancient mountain path. The trail is steep and narrow, making for a daunting descent.

As the evening mist surrounds them, they can just barely make out the shadowy pine forest below.

Suddenly, a scout looks over the edge and freezes in fear, overwhelmed by the sheer drop."
background_image = SubResource("Resource_ggyeo")
background_credit = ExtResource("1_8dyke")
choices = Array[ExtResource("2_8dyke")]([SubResource("Resource_u6fhw"), SubResource("Resource_bch5c"), SubResource("Resource_tq0cv"), SubResource("Resource_t5axi")])

[resource]
script = ExtResource("3_vd22b")
original_image = SubResource("Resource_bcsnl")
piece_name = "East Gate, Seoul by Sunrise"
artist = ExtResource("1_p5ikl")
styles = Array[ExtResource("4_s67jm")]([ExtResource("5_alf3a")])
actual_start_year = 1925
actual_end_year = 1925
edits_description = "The image was cropped and the hut in the background was removed."
final_image_tex = SubResource("Resource_5vv68")
blurb = "Depicts the \"Gate of Uplifting Mercy\" (Heunginjimun), the Eastern of the 8 gates of the Seoul City Wall in Seoul, South Korea. Two of the gates are now destroyed, although the others are still standing. This gate was first constructed in 1398, an example of late Joseon period architecture, and rebuilt in 1869.

Elizabth Keith also produced [url=art_piece:East Gate, Seoul by Moonlight]a night version of this scene[/url] in 1920."
metadata/_custom_type_script = "uid://6kpsqyb2pk7a"

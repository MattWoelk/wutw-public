[sub_resource type="Resource" id="Resource_2me52"]
script = ExtResource("6_aqgc1")
markedup_text = "Build a bridge over the spot the fox is pointing to."
requirement = SubResource("Resource_1stri")
outcome = SubResource("Resource_w2hpu")
markedup_result_text = "The settlers consider the fox's pointing a sign from the Enlightened One.

Early the next morning they gather their tools and start building a new bridge over the exact spot that the fox was pointing at.

Once finished, the bridge will surely make the river safer to cross, but all the construction noises end up driving the foxes away."


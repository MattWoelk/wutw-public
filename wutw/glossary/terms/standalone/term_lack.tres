term_id = "lack"
term_name = "Shortage"
long_term_name = "Settlement Shortage"
markedup_description = "A type of <term:bonus> that a <term:settlement> is lacking. During <term:harmonization>, you can <term:satisfy_lack> these directly or by <term_lower:connect_settlement>ing the <term:settlement>. Each un<term_lower:satisfy_lack>ed shortage results in a loss of 5 <term_lower:inspiration>."

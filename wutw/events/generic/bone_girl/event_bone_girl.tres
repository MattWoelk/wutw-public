[sub_resource type="Resource" id="Resource_ig61n"]
script = ExtResource("5_o10bj")
markedup_text = "Stop going to the boneyard."
outcome = SubResource("Resource_3666r")
markedup_result_text = "The young woman gives in to the social pressure and stops wandering among the ancient bones.

She resolves to take up more acceptable pastimes, like cooking and mending clothes."

[sub_resource type="Resource" id="Resource_55jvu"]
script = ExtResource("3_2mwq7")
markedup_text = "A young woman has taken to spending all her time at the ancient boneyard out in the wasteland.

As soon as she finishes her morning chores, she arrives to wander among the bones, lost in thought, imagining the great creatures that once walked these lands.

She begins sketching the giant bones, and fitting fragments together. Before long the settlers are giving her strange looks and calling her Bone Girl behind her back."

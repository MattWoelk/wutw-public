[sub_resource type="Resource" id="Resource_mwh3o"]
script = ExtResource("5_28qwu")
markedup_text = "Wash the dirty veil."
requirement = SubResource("Resource_dwqid")
outcome = SubResource("Resource_4qtvf")
markedup_result_text = "The rinsers are puzzled when the only garment they receive is a wedding veil.

Perhaps an explorer couple married during the expedition, they suppose.

The veil is quickly washed in the lake, rinsed again in a bucket of well water, and finally rubbed with yuzu peel. It has never been cleaner."


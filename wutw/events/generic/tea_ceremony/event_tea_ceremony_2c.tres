min_count = 2

[sub_resource type="Resource" id="Resource_w2hpu"]
script = ExtResource("5_ehx26")
markedup_text = "Offer her cups carried by the expedition."
requirement = SubResource("Resource_2myy3")
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The host bows deeply and accepts the gift.

The old cups go on a higher shelf, and the new ones are used for the tea service.

When the expedition departs, there is a basket of packed lunches prepared for them."

[sub_resource type="Resource" id="Resource_vpu3v"]
script = ExtResource("7_17gcy")
bonus_type = ExtResource("14_qhfta")

[resource]
script = ExtResource("8_l7ox4")
haunting_id = "yamabiko"
name = "Yamabiko"
name_japanese = "山彦"
name_realistic = "Landslides"
name_translation = "Mountain Boys"
description = "Settlers claim that little mocking mountain spirits are sliding down the canyon walls, crumbling the stone in their wake."
description_realistic = "The canyon walls are unstable, with even minor disturbances triggering dangerous landslides."
description_long = "Settlers working in the canyon are often ambushed by debris sliding down the walls, starting with a snapping sound and followed by a stream of echoes.

The old tales speak of the Yamabiko, the mountain boys. These little beasts look like a mix between dogs and monkeys, and thrive on mimicking humans. When the settlers make too much racket, the Yamabiko eagerly join in, clapping and jumping up and down, breaking off pieces of the canyon walls."

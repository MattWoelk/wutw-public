[resource]
script = ExtResource("4_k6ohw")
name = "Kawase Hasui"
portrait = SubResource("Resource_dkhkc")
blurb = "Kawase Hasui was a leading figure in [url=art_style:shin-hanga]shin-hanga[/url], the 20th-century movement to revitalize traditional woodblock printing by incorporating Western realism.

He is known for his elaborate detailing and atmospheric depictions of seasons, weather, and light, often capturing tranquil landscapes and townscapes bathed in snow, rain, or evening glow.

In addition to over 600 prints, he left behind many watercolor paintings, as well as some oil paintings, hanging scrolls, and painted folding screens.

You can watch the master at work in [url=https://www.youtube.com/watch?v=BQmF3HHyWwI]this YouTube video[/url]."
birth_year = 1883
death_year = 1957
link = "https://en.wikipedia.org/wiki/Hasui_Kawase"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

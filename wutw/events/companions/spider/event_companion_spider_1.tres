[sub_resource type="Resource" id="Resource_2sb8d"]
script = ExtResource("10_7tf88")
markedup_text = "Grab the spider and deposit it outside."
requirement = SubResource("Resource_d4vpm")
outcome = SubResource("Resource_fstow")
markedup_result_text = "Despite her fear of spiders, the tea maker bends down and snatches the arachnid before the cat can strike.

She endures the unsettling sensation of eight prickly legs scrambling over her bare skin, but calmly deposits the spider on the porch.

The battle is finished, and the spider survives to spin another day."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"


[sub_resource type="Resource" id="Resource_tv6vb"]
script = ExtResource("5_trgiv")
markedup_text = "Station guards and only admit monks."
requirement = SubResource("Resource_c5dec")
outcome = SubResource("Resource_qid86")
markedup_outcome_hint = "This will leave a mark on history."
markedup_result_text = "Fences are rebuilt taller, with gates that open only to monks.

Guards are hired to stand watch with staves at all hours.

The sacred grounds remain protected, villagers and animals alike maintaining their distance.

The monks breathe easier, their peace no longer disturbed."

[sub_resource type="Resource" id="Resource_8m1fb"]

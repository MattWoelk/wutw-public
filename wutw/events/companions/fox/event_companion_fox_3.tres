[sub_resource type="Resource" id="Resource_cb64p"]
script = ExtResource("6_7t3xg")
markedup_text = "Set up baited traps."
requirement = SubResource("Resource_ouvaa")
outcome = SubResource("Resource_7t3xg")
markedup_result_text = "The guards decide to let the foxes go this time, and instead invest in a long-term deterrent.

Simple traps are set around the granaries and the path leading up the settlement.

The very next night, all the traps are sprung, the food is gone, but the foxes are nowhere to be found.

Food starts to go missing from the granaries."


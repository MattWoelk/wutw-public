[sub_resource type="Resource" id="Resource_8eh3j"]
script = ExtResource("6_f2nvm")
markedup_text = "Name it after the dragon."
requirement = SubResource("Resource_c7rj6")
outcome = SubResource("Resource_bjbvw")
markedup_result_text = "The ship is named the Ryū, after the sleek flowing shape of the sky dragons of legend.

The name sounds impressive, and the workers spend a long time carving a magnificent figurehead to mount at the front of the bow.

However, the heavy cargo ship makes for a very chubby, slow-moving dragon, and the crews of smaller vessels sometimes make fun of the Dragon for being slower than even their tiny boats."

[sub_resource type="Resource" id="Resource_8tjya"]
script = ExtResource("8_lx6ln")
card_type = ExtResource("20_hn0e3")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_hncfj"]
script = ExtResource("6_f2nvm")
markedup_text = "Name it after the wind."
outcome = SubResource("Resource_8tjya")
markedup_result_text = "The ship is named the Kaze, after the wind that animates its sails.

However, during its very first trip out of the harbor, a sudden gale catches the rigging and tears away the sail.

It is quickly reattached, but the crew snicker about the irony of being foiled by one's own namesake."

[sub_resource type="Resource" id="Resource_jmpfu"]
script = ExtResource("4_katl1")
markedup_text = "The shipwrights have finally finished their latest vessel.

It is a sturdy, wide-bellied cargo ship built to haul heavy crates across the rougher waters of the shard.

The workers are gathered around, debating what name will bring the ship the most fortune."
background_image = SubResource("Resource_mg1wm")

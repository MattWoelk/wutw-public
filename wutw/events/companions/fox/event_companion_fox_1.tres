[sub_resource type="Resource" id="Resource_hdwsh"]
script = ExtResource("4_1fult")
markedup_text = "Stand very still."
outcome = SubResource("Resource_k37nd")
markedup_result_text = "After a prolonged staring contest, the fox decides that there's no escape for it but to jump into the river.

Luckily, the current is gentle here, by the bank, so after a moment of struggle the fox relaxes and drifts downstream, eventually jumping out at the next bend, soaked and annoyed."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_vhbjf"]
script = ExtResource("2_q5etu")
markedup_text = "A group of settlers walking at night by the river hear a rustle in the reeds. They follow it to the source, and discover a lone fox, hesitating at the edge of the river.

The fox seems to have been too engrossed in its hunt to notice them approaching, and is now surrounded by villagers who are just as surprised as it is."
background_image = SubResource("Resource_hpjf5")
background_credit = ExtResource("9_isc74")
choices = Array[ExtResource("4_1fult")]([SubResource("Resource_isc74"), SubResource("Resource_magjj"), SubResource("Resource_cwl7n")])
exit_choice = SubResource("Resource_hdwsh")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


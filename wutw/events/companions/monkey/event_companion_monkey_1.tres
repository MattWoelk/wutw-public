[sub_resource type="Resource" id="Resource_ox11q"]
script = ExtResource("9_vm687")
markedup_text = "Dedicate the shrine to the monkey spirits."
requirement = SubResource("Resource_3ulm8")
outcome = SubResource("Resource_r4yd3")
markedup_result_text = "The priests decide to name the monkeys the shrine's patron deities.

They begin pampering the animals, presenting them with elaborate offerings and sweet treats.

The monkeys grow progressively bolder. Soon they are stealing hats and throwing pinecones at the visitors, forcing the priests to start turning pilgrims away."


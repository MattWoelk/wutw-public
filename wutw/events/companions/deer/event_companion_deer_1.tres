markedup_text = "Build fences around the grove."
requirement = SubResource("Resource_7gwgg")
outcome = SubResource("Resource_gv0ex")
markedup_result_text = "Simple bamboo fences are built, surrounding the grove.

At first the deterrent seems to work, but soon the deer learn to simply leap over them, and the pestering persists."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

[sub_resource type="Resource" id="Resource_ptcwf"]
script = ExtResource("5_ygj25")
markedup_text = "Gently shoo the deer out of the grove."
markedup_result_text = "The deer flee into the woods.

Work resumes."

[sub_resource type="Resource" id="Resource_egt2j"]
script = ExtResource("3_0xf22")
markedup_text = "The fruit trees hang heavy with pears and plums. So heavy, in fact, that some have fallen on the ground and attracted deer from the nearby forest. The fruit pickers are now constantly accosted by hungry deer asking for sweet treats.

They have long stopped being skittish, and have all but claimed the grove as their home. The fruit pickers are getting more annoyed by the day."
background_image = SubResource("Resource_uvoue")
background_credit = ExtResource("9_uvoue")
choices = Array[ExtResource("5_ygj25")]([SubResource("Resource_xxhwh"), SubResource("Resource_df5af"), SubResource("Resource_aqw7m")])
exit_choice = SubResource("Resource_ptcwf")


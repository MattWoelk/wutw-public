label = "Drink it despite the taste."
aspects = Array[ExtResource("3_pcrjt")]([ExtResource("7_1lso3")])
outcome = SubResource("Resource_ul4cq")
outcome_text = "The scouts decide that they are too thirsty to wait.

They fill their vessels with the clear water and drink deeply.

Several hours later, everyone is violently sick."


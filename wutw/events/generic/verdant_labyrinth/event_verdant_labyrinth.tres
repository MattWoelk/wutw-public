[sub_resource type="Resource" id="Resource_dmj6w"]
script = ExtResource("3_br3hg")
event_step_id = "owl_attack"
markedup_text = "The settlers are led deeper into the forest. As time passes, the air grows cooler, and the trees on either side of their path slowly thin.

By nightfall the trail ends in a grassy clearing surrounding a small pond.

The animal tracks leading to the clearing abruptly disappear here, and dark stains cover the ground nearby.

Looking up, the settlers see a large brown owl with enormous yellow eyes staring at them."
background_image = SubResource("Resource_fdi0j")
background_credit = ExtResource("18_rctiv")
exit_choice = SubResource("Resource_kj1sh")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


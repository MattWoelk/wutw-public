[sub_resource type="Resource" id="Resource_viw1w"]
script = ExtResource("2_loa4e")
label = "Sketch the scene."
requirement = SubResource("Resource_q53r4")
aspects = Array[ExtResource("3_vpa3n")]([ExtResource("4_k5ni4")])
aspects_per_season = Array[ExtResource("3_vpa3n")]([null])
outcome = SubResource("Resource_urk6g")
outcome_text = "One of the surveyors, an artist, sketches the scene.

She takes liberties with the colors, painting the clouds a pale azure and giving the distant mountain a purple hue, with a blush of rose at the peak.

The group crowds around her, admiring her work just as much as the scene itself."


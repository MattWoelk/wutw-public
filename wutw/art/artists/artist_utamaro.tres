[resource]
script = ExtResource("2_0ytsn")
name = "Kitagawa Utamaro"
portrait = SubResource("Resource_7hk08")
blurb = "Kitagawa Utamaro was one of the most highly regarded masters of ukiyo-e, fundamentally defining the golden age of [url=art_style:bijin-ga]bijin-ga[/url].

He is best known for popularizing ōkubi-e, or large-headed portraits, which focused tightly on the faces and upper bodies of his subjects. Instead of relying on generic facial types, his close-up compositions captured subtle psychological states, distinct personalities, and the intimate daily routines of women from various social classes.

When his prints reached Europe in the late 19th century, his masterful linework and domestic subject matter profoundly influenced Western artists, particularly the Impressionist painter Mary Cassatt."
birth_year = 1753
death_year = 1806
link = "https://en.wikipedia.org/wiki/Utamaro"
metadata/_custom_type_script = "uid://bxxcxslxqv5g0"

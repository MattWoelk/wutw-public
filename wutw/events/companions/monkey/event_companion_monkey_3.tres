[sub_resource type="Resource" id="Resource_8uymi"]
script = ExtResource("6_ml7uw")
markedup_text = "Take bets on the winner."
requirement = SubResource("Resource_0gxbx")
outcome = SubResource("Resource_4cqxb")
markedup_result_text = "The settlers gather around, cheering and placing wagers on which monkey will pin the other.

Just as the bets are finalized, a large butterfly flutters over the grass.

Both monkeys stop, release their grips, and chase the insect back into the bushes."

[sub_resource type="Resource" id="Resource_rtn7q"]

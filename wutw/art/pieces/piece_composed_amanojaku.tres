[resource]
script = ExtResource("2_r7mnk")
name = "Amanojaku"
main = ExtResource("4_qgn2b")
additional = Array[ExtResource("1_w3lut")]([ExtResource("2_24048")])
edits_description = "This image was composed by combining the body from the Yamawarō painting with the head from the Ushi-oni one."
final_image_tex = SubResource("Resource_ei3m7")
blurb = "This composite attempts to approximate the legendary appearance of Amanojaku, a yōkai with origins in both Buddhist iconography and Shinto mythology.

In the Buddhist origin, they are said to be demons trampled by the Four Heavenly Kings, gods resposible for the cardinal directions.

In the Shinto origin, they are the disgraced young servants of the sun goddess Amaterasu. One of these servants, Amenosagume (\"heavenly spy woman\"), was said to be able to read the human heart and use that knowledge to play contrarian pranks, which became a major theme associated with the yōkai."
metadata/_custom_type_script = "uid://dej4hwyskx43"

amount = 15
extra_per_season = 15
metadata/_custom_type_script = "uid://dkas1jvkeluf4"

[sub_resource type="Resource" id="Resource_a3bkh"]
script = ExtResource("2_dfnxa")
label = "Observe the visions."
aspects = Array[ExtResource("3_hel5c")]([ExtResource("6_nikb8")])
outcome = SubResource("Resource_tc7qr")
outcome_text = "Fascinated by the phenomenon, the surveyors decide to take a break and spend an hour observing the mirage.

They see the images shifting and glimmering in the sunlight. A few of the scouts take out paper and sketch what they see, then compare their drawings, finding each of them entirely unlike the others.

By the time the sun sets, the visions fade away."

[sub_resource type="Resource" id="Resource_th04d"]
script = ExtResource("5_58j3a")
delta = 5
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_hs3nk"]
script = ExtResource("2_dfnxa")
label = "Investigate the dessert."
aspects = Array[ExtResource("3_hel5c")]([ExtResource("9_3grmq")])
outcome = SubResource("Resource_th04d")
outcome_text = "The team leader, who has been sharing her food too freely and has ended up particularly hungry, becomes convinced that the mirage resembles an enormous white mochi.

It takes the efforts of the entire team to convince her to give up on the idea of pursuing the confection. The group spends the next few hours joking about desserts and imagining all the delicious foods awaiting them when they rejoin the expedition."

[sub_resource type="Resource" id="Resource_jfs6m"]
script = ExtResource("2_dfnxa")
label = "Ignore the visions."
aspects = Array[ExtResource("3_hel5c")]([null])
outcome_text = "Many of the scouts, although tired and thirsty, have seen mirages before and refuse to be distracted.

It proves difficult to persuade the younger teammates to continue their original path, and they lose precious time arguing that finding a glittering castle in the middle of the desert is highly unlikely."

[resource]
script = ExtResource("10_xwa7j")
episode_id = "empty_desert"
title = "Visions in the Desert"
biome_types = Array[int]([2])
text = "The surveyors have been traveling the desert for days, the sun beating down on their backs.

One afternoon, a scout suddenly points into the distance and describes what she sees there: a beautiful oasis with glittering water and green trees. Her teammate shakes his head, disagreeing with her vision. He claims to see a tall, snow-white fortress surrounded by a moat instead.

The group can't come to a consensus on what they are looking at, the shapes seeming to shift and shimmer in the sun."
background_image = SubResource("Resource_y7v3x")
background_credit = ExtResource("1_dfnxa")
choices = Array[ExtResource("2_dfnxa")]([SubResource("Resource_205m6"), SubResource("Resource_a3bkh"), SubResource("Resource_hs3nk"), SubResource("Resource_jfs6m")])

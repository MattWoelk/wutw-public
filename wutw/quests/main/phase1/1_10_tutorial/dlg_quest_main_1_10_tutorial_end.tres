[resource]
script = ExtResource("1_qwyu2")
dialogue_id = "mq_1_10_end"
record_title = "Era 一: The First Step 二"
text = "PAGE: monk(NONE), teo(NONE)
monk: My heart is full, oh Enlightened One!
monk: Thank you for seeing us through.
monk: We are exhausted now, so we're going to rest and get used to our new home.
monk: To think... I was actually there.
monk: The very first time we stepped back out into the world.
monk: Tales of this journey will be told for generations.
monk: It won't be me on the next expedition, but I know you will look after my sisters and brothers just as you have looked after us.
monk: No doubt is left in my heart that soon you will restore the world to its former glory."
metadata/_custom_type_script = "uid://jtkfcsyiryo4"

[sub_resource type="Resource" id="Resource_enujo"]
script = ExtResource("2_jqjvj")
label = "Play music instead."
requirement = SubResource("Resource_kbrbd")
aspects = Array[ExtResource("3_igv2q")]([null])
outcome = SubResource("Resource_sufir")
outcome_text = "One of the scouts takes out a flute and starts playing an old melody, one that everybody recognizes. Another joins by drumming on a hollow log. The group grows closer, though no words are exchanged."

[sub_resource type="Resource" id="Resource_a07nq"]

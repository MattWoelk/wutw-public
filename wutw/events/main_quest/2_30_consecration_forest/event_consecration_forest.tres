[sub_resource type="Resource" id="Resource_u8tnk"]
script = ExtResource("4_utf66")
event_step_id = "science"
markedup_text = "The disciples move carefully among the trees, tracing glyphs in the air and waiting for a response. Some leaves rustle, others fall. Each movement is faithfully recorded as evidence of resonance.

By the end of the day, strips of paper hang from the tree trunks, each marked with the glyphs that resonated with each tree.

\"We have learned which glyphs resonate with Life,\" the disciples conclude. \"The Enlightened One's grand design is becoming clearer each day.\""
background_image = SubResource("Resource_50hmy")
background_credit = ExtResource("6_50hmy")
exit_choice = SubResource("Resource_242uo")
metadata/_custom_type_script = "uid://b3ryo56yig0k3"


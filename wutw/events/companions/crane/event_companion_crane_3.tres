delta = 5
metadata/_custom_type_script = "uid://c23hf0l6630h1"

[sub_resource type="Resource" id="Resource_gydhs"]
script = ExtResource("6_y5ee4")
markedup_text = "Stand back and enjoy the show."
outcome = SubResource("Resource_quleu")
markedup_result_text = "The farmers lean on their tools, wiping the sweat from their brows, and watch.

It is a rare moment of pure elegance in an otherwise muddy, backbreaking workday.

They find the dedication of the mating pair inspiring."

[sub_resource type="Resource" id="Resource_x66co"]
script = ExtResource("8_wjng4")
card_type = ExtResource("22_s1myj")
metadata/_custom_type_script = "uid://cqnoecri6xisf"

[sub_resource type="Resource" id="Resource_8kg4k"]
script = ExtResource("6_y5ee4")
markedup_text = "Give them some privacy."
outcome = SubResource("Resource_x66co")
markedup_result_text = "The farmers decide that it is rude to stare at a private reunion.

They gather their tools and move to the other side of the paddy to finish their chores.

The elegant dancers are soon gone, and the episode is quickly forgotten."

[sub_resource type="Resource" id="Resource_11ed1"]
script = ExtResource("4_2t6c8")
markedup_text = "A lone crane has been standing perfectly still in a shallow pool by the rice paddy all day.

The bird refuses to hunt or move, looking like a slender statue rising from the water. The farmers are beginning to find its endless patience a bit eerie.

Just before dusk, a second crane glides down from the sky, and the two immediately spring to life. They bow to one another, spread their wings, and begin a complex, leaping dance."
background_image = SubResource("Resource_8r3t7")
background_credit = ExtResource("5_e0a3i")
choices = Array[ExtResource("6_y5ee4")]([SubResource("Resource_simhe"), SubResource("Resource_10wrw"), SubResource("Resource_gydhs")])
exit_choice = SubResource("Resource_8kg4k")


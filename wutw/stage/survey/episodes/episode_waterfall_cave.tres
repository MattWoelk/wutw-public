label = "Look for another entrance."
aspects = Array[ExtResource("3_3s22n")]([ExtResource("7_xax7u"), null])
aspects_per_season = Array[ExtResource("3_3s22n")]([null])
outcome = SubResource("Resource_qywm5")
outcome_text = "The scouts climb the cliffs looking for another entrance to the cave. 

At the top they find an opening, partially blocked by a fallen tree trunk.

Working together, the scouts heave the tree aside, just enough to squeeze into the opening .

They find the cave filled with fireflies, their lights casting a pale green glow on the walls."


[sub_resource type="Resource" id="Resource_tnw5c"]
script = ExtResource("3_br3hg")
event_step_id = "stream_choice"
markedup_text = "A merrily rushing brook cuts through the green maze of trees, rays of sunlight dancing off its blue waters.

One of the settlers suggests camping here and backtracking in the morning.

Others object, wanting to follow the stream instead, in the hope of finding a way out."

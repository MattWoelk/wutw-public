[sub_resource type="Resource" id="Resource_w2hpu"]
script = ExtResource("5_3xl68")
markedup_text = "Gather everything and store it."
outcome = SubResource("Resource_tuogj")
markedup_result_text = "The settlers work hard, filling baskets and jars and sealed clay urns.

Some of the fruit is still good, but not much.

By the end of the week, the smell of rot seeps into the granary, inviting flies. It is soon unofficially renamed \"the sticky room\"."

[sub_resource type="Resource" id="Resource_3sdrw"]
script = ExtResource("3_g2tml")
markedup_text = "The harvest was late. By the time anyone noticed, the grove's bounty had begun to fall.

Bright persimmons now lie bruised and soft beneath the trees, their skins splitting in the sun.

There's enough food in the stores, but the elders remember lean winters, and say letting this much spoil is a betrayal.

Youngsters point to the scent of ferment and the slowly gathering wasps, and suggest that the fruit has already chosen its fate."
background_image = SubResource("Resource_ettik")
background_credit = ExtResource("5_ettik")
choices = Array[ExtResource("5_3xl68")]([SubResource("Resource_dpp3j"), SubResource("Resource_ciwob"), SubResource("Resource_2myy3")])
exit_choice = SubResource("Resource_w2hpu")


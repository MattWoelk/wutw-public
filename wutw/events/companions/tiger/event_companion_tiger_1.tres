[sub_resource type="Resource" id="Resource_7axqe"]
script = ExtResource("9_u2t6u")
markedup_text = "Keep watch in the dark to discover the truth."
requirement = SubResource("Resource_il2yw")
outcome = SubResource("Resource_oonmf")
markedup_result_text = "A few brave settlers hide in the bushes near the shrine.

Just past midnight, a massive, very real tiger walks into the clearing. It sniffs the painting, lets out a roar, and lays down to rest.

The danger remains, but thanks to the settlers' bravery, they are now aware of their fearsome neighbor."


title = "The Odd Rock"
biome_types = Array[int]([5, 6, 8])
spot_types = Array[ExtResource("13_o7lac")]([ExtResource("14_de04i"), ExtResource("15_x5liu"), ExtResource("16_0u5qv"), ExtResource("17_sm32c"), ExtResource("18_hyq0k"), ExtResource("19_kuljv"), ExtResource("20_m52ks")])
text = "The survey team comes upon an odd boulder in the middle of a path. It is unnaturally round and smooth, a little dome rising from the ground.

On closer inspection, it appears to have faint carvings on the surface."

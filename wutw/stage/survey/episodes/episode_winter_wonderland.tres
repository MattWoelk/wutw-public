[sub_resource type="Resource" id="Resource_it7ig"]
script = ExtResource("2_xk5i1")
label = "Admire the snow."
aspects = Array[ExtResource("3_b33sg")]([null])
outcome = SubResource("Resource_evnkl")
outcome_text = "The group decides to sit by the fire and admire the wonderful view around them.

They stay until the embers turn to ash."

[resource]
script = ExtResource("12_ksh3u")
episode_id = "winter_wonderland"
title = "Playing in the Snow"
biome_types = Array[int]([7])
text = "Waking up before dawn high in the mountains, the explorers blink as they look at the landscape stretching before them.

The entire mountain range has gained a thick blanket of fresh snow overnight.

Standing in front of the campfire, they warm their hands and discuss how to spend the morning."
background_image = SubResource("Resource_sglgl")
background_credit = ExtResource("1_xk5i1")
choices = Array[ExtResource("2_xk5i1")]([SubResource("Resource_tjnww"), SubResource("Resource_np4uc"), SubResource("Resource_76f81"), SubResource("Resource_it7ig")])

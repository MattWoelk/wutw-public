[resource]
script = ExtResource("2_5t7tw")
name = "100 Poems as Told by the Nurse"
blurb = "This was Hokusai's last major single sheet series before he devoted his remaining years mainly to commissions. Of the intended series of 100, only 27 prints are known to have been completed. An additional 64 designs survive in the form of preparatory drawings.

Hokusai based this series on the well-known anthology of poems, the Hyakunin Isshu (100 People, One Poem Each), compiled by the poet Fujiwara no Teika in 1235. The collected verses were familiar to most Japanese, and even today there are card games that involve recognizing the ending of a verse from this collection based on its starting lines.

Hokusai approaches the poems from the perspective of an uneducated wet-nurse, allowing for seemingly simple-minded mistakes or misinterpretations which add a light-hearted quality to his renditions."
start_year = 1835
end_year = 1836
artist = ExtResource("1_shpgm")
metadata/_custom_type_script = "uid://dwukodn1s8aar"

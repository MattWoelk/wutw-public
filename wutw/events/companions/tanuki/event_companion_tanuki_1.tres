[sub_resource type="Resource" id="Resource_m5fys"]
script = ExtResource("10_r3tsp")
markedup_text = "Sit next to it."
requirement = SubResource("Resource_vkspb")
outcome = SubResource("Resource_d3ma4")
markedup_result_text = "All four farmers sit next to it, mimicking its posture.

The tanuki doesn't react immediately, but soon looks around, confused.

It eventually decides to get away from these odd mimicking creatures."
metadata/_custom_type_script = "uid://ch6bcu3nqxr1j"

